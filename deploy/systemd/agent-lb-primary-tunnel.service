[Unit]
Description=ssh forward from this box straight to the agent-lb primary front, so box traffic skips Studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/agent-lb/primary-tunnel.env
ExecStart=/usr/bin/ssh -N -F none -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=15 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=%h/.config/agent-lb/primary-tunnel.known_hosts -i %h/.ssh/agent-lb-primary-tunnel -L 127.0.0.1:${AGENT_LB_TUNNEL_LOCAL_PORT}:127.0.0.1:${AGENT_LB_TUNNEL_REMOTE_PORT} ${AGENT_LB_TUNNEL_TARGET}
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
