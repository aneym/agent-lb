[Unit]
Description=Box-local agent-lb failover proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
RuntimeDirectory=agent-lb-proxy
RuntimeDirectoryMode=0700
Environment=AGENT_LB_ADMIN_SOCKET=%t/agent-lb-proxy/admin.sock
EnvironmentFile=%h/.config/agent-lb/lb-proxy.env
ExecStart=%h/.local/bin/caddy run --config %h/.config/agent-lb/lb-proxy/Caddyfile --adapter caddyfile
ExecReload=%h/.local/bin/caddy reload --config %h/.config/agent-lb/lb-proxy/Caddyfile --adapter caddyfile --address unix/%t/agent-lb-proxy/admin.sock --force
TimeoutStopSec=11min
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
