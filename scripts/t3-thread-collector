#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import sys
import time
from datetime import datetime, timedelta, timezone
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

OVERLAP = timedelta(minutes=15)
FULL_EVERY_SECONDS = 6 * 3600
CHUNK = 1000
PENDING_PREFIX = "pending:"
SCHEMA = {
    "orchestration_v2_projection_threads": {
        "thread_id",
        "project_id",
        "title",
        "created_at",
        "updated_at",
        "archived_at",
        "deleted_at",
        "payload_json",
        "provider_instance_id",
    },
    "orchestration_v2_projection_provider_threads": {
        "thread_id",
        "driver",
        "provider_instance_id",
        "updated_at",
        "payload_json",
    },
    "projection_projects": {"project_id", "title", "workspace_root"},
}


class Drift(Exception):
    pass


def parse_args(argv=None):
    home = os.environ.get("T3CODE_HOME") or os.path.join(os.path.expanduser("~"), ".t3")
    parser = argparse.ArgumentParser(description="Send T3 thread names and native session ids to agent-lb.")
    parser.add_argument("--host", required=True)
    parser.add_argument("--db", default=os.path.join(home, "userdata", "statev2.sqlite"))
    parser.add_argument("--base-url", default=os.environ.get("AGENT_LB_BASE_URL") or "http://127.0.0.1:2455")
    parser.add_argument("--state", default=os.path.join(os.path.expanduser("~"), ".agent-lb", "state", "t3-collector.json"))
    parser.add_argument("--full", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)
    if not re.match(r"^[a-z0-9-]{1,32}$", args.host):
        parser.error("--host must match ^[a-z0-9-]{1,32}$")
    return args


def open_readonly(path):
    if not os.path.exists(path):
        raise Drift("no T3 database at " + path)
    uri = "file:" + path.replace("?", "%3f").replace("#", "%23") + "?mode=ro"
    connection = sqlite3.connect(uri, uri=True, timeout=10)
    connection.execute("PRAGMA query_only=ON")
    connection.row_factory = sqlite3.Row
    return connection


def check_schema(connection):
    for table, wanted in SCHEMA.items():
        have = {row[1] for row in connection.execute("PRAGMA table_info(%s)" % table)}
        missing = wanted - have
        if missing:
            raise Drift("T3 schema drift in %s: missing %s" % (table, ",".join(sorted(missing))))


def load_state(path):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def save_state(path, state):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = path + ".tmp"
    with open(temporary, "w") as handle:
        json.dump(state, handle)
    os.replace(temporary, path)


def parse_time(value):
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%S.%fZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def format_time(value):
    return value.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.") + "%03dZ" % (value.microsecond // 1000)


def since_of(state, full):
    if full or not state.get("cursor"):
        return None
    cursor = parse_time(state["cursor"])
    return format_time(cursor - OVERLAP) if cursor else None


def payload_of(row):
    try:
        value = json.loads(row["payload_json"] or "{}")
    except ValueError:
        return {}
    return value if isinstance(value, dict) else {}


def clip(value, limit):
    return value[:limit] if isinstance(value, str) else None


def collect(connection, since):
    projects = {
        row["project_id"]: (row["title"], row["workspace_root"])
        for row in connection.execute("SELECT project_id, title, workspace_root FROM projection_projects")
    }
    where = " WHERE updated_at >= ?" if since else ""
    params = (since,) if since else ()
    threads, sessions, newest = [], [], since or ""
    query = (
        "SELECT thread_id, project_id, title, created_at, updated_at, archived_at, deleted_at, payload_json,"
        " provider_instance_id FROM orchestration_v2_projection_threads"
    )
    for row in connection.execute(query + where, params):
        payload = payload_of(row)
        lineage = payload.get("lineage") or {}
        selection = payload.get("modelSelection") or {}
        title, workspace = projects.get(row["project_id"], (None, None))
        threads.append(
            {
                "threadId": row["thread_id"],
                "projectId": clip(row["project_id"], 64),
                "projectTitle": title,
                "workspaceRoot": workspace,
                "title": row["title"],
                "providerInstance": clip(row["provider_instance_id"], 64),
                "model": clip(selection.get("model"), 64),
                "parentThreadId": lineage.get("parentThreadId"),
                "rootThreadId": lineage.get("rootThreadId") or row["thread_id"],
                "relationship": clip(lineage.get("relationshipToParent"), 32),
                "createdBy": clip(payload.get("createdBy"), 16),
                "creationSource": clip(payload.get("creationSource"), 16),
                "createdAt": row["created_at"],
                "updatedAt": row["updated_at"],
                "archivedAt": row["archived_at"],
                "deletedAt": row["deleted_at"],
            }
        )
        newest = max(newest, row["updated_at"] or "")
    query = (
        "SELECT thread_id, driver, provider_instance_id, updated_at, payload_json"
        " FROM orchestration_v2_projection_provider_threads"
    )
    for row in connection.execute(query + where, params):
        newest = max(newest, row["updated_at"] or "")
        native = (payload_of(row).get("nativeThreadRef") or {}).get("nativeId")
        if not isinstance(native, str) or not native or native.startswith(PENDING_PREFIX) or len(native) > 64:
            continue
        sessions.append(
            {
                "nativeId": native,
                "threadId": row["thread_id"],
                "driver": clip(row["driver"], 32) or "unknown",
                "providerInstance": clip(row["provider_instance_id"], 64),
            }
        )
    return threads, sessions, newest


def post(base_url, body):
    request = Request(
        base_url.rstrip("/") + "/api/t3/threads/sync",
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json", "Accept": "application/json"},
        method="POST",
    )
    with urlopen(request, timeout=60) as response:
        if response.status < 200 or response.status >= 300:
            raise URLError("HTTP %s" % response.status)


def send(base_url, host, threads, sessions):
    for start in range(0, max(len(threads), len(sessions), 1), CHUNK):
        post(
            base_url,
            {
                "host": host,
                "threads": threads[start : start + CHUNK],
                "nativeSessions": sessions[start : start + CHUNK],
            },
        )


def main(argv=None):
    args = parse_args(argv)
    try:
        connection = open_readonly(args.db)
        try:
            check_schema(connection)
            state = load_state(args.state)
            full = args.full or time.time() - state.get("lastFull", 0) >= FULL_EVERY_SECONDS
            threads, sessions, newest = collect(connection, since_of(state, full))
        finally:
            connection.close()
    except (Drift, sqlite3.Error) as error:
        print("t3-thread-collector: %s" % error, file=sys.stderr)
        return 3
    summary = {"host": args.host, "full": full, "threads": len(threads), "nativeSessions": len(sessions)}
    if args.dry_run:
        summary["sampleThreads"] = threads[:5]
        summary["sampleNativeSessions"] = sessions[:5]
        print(json.dumps(summary, indent=2))
        return 0
    try:
        send(args.base_url, args.host, threads, sessions)
    except (HTTPError, URLError, OSError) as error:
        print("t3-thread-collector: sync failed: %s" % error, file=sys.stderr)
        return 1
    if newest:
        state["cursor"] = max(newest, state.get("cursor", ""))
    if full:
        state["lastFull"] = time.time()
    save_state(args.state, state)
    print(json.dumps(summary))
    return 0


if __name__ == "__main__":
    sys.exit(main())
