#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import json
import os
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


REFUSED_PREFIXES = ("25600cac", "86fe250c", "bfb49472")


def auto_reauth_enrolled():
    path = Path.home() / ".agent-lb/state/auto-reauth-enrolled.json"
    try:
        accounts = json.loads(path.read_text()).get("accounts")
    except (OSError, ValueError, AttributeError):
        return set()
    return set(accounts) if isinstance(accounts, dict) else set()


def key_headers():
    path = Path.home() / ".agent-rails/custody/agent-secret/agent-lb-key-account-health"
    try:
        value = path.read_text(encoding="utf-8").strip()
    except OSError:
        return {}
    return {"Authorization": "Bearer " + value} if value.startswith("sk-clb-") else {}


def snapshot():
    base = os.environ.get("BASE_URL", "http://127.0.0.1:2455").rstrip("/")
    headers = {"Accept": "application/json", **key_headers()}
    if cookie := os.environ.get("AGENT_LB_STATUS_COOKIE"):
        headers["Cookie"] = cookie
    opener = build_opener(ProxyHandler({}), NoRedirect())
    with opener.open(Request(base + "/api/accounts", headers=headers), timeout=15) as response:
        payload = json.load(response)
    current = {}
    enrolled = auto_reauth_enrolled()
    for account in payload["accounts"]:
        if account["provider"] == "openai" or account["accountId"].startswith(REFUSED_PREFIXES):
            continue
        for problem in account["problems"]:
            if problem["code"] == "reauth_required" and account["accountId"] in enrolled:
                continue
            key = json.dumps([account["accountId"], problem["code"]])
            message = f"{account['email']} ({account['provider']}) {problem['code']}: {problem['message']}"
            current[key] = " ".join(message.split())[:799]
    return current


def local_host(host):
    names = {socket.gethostname().split(".")[0].lower(), os.environ.get("FACTORY_HOST", "").lower()}
    return not host or host.lower() in names


def send(thread_id, host, text):
    if local_host(host):
        t3 = shutil.which("t3")
        command = [t3, "thread", "send", thread_id, "-", "--mode", "queue"] if t3 else None
    else:
        remote = f"t3 thread send {shlex.quote(thread_id)} - --mode queue"
        command = ["/usr/bin/ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", host, remote]
    if command is None:
        return False
    try:
        return subprocess.run(command, input=text, text=True, timeout=60).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def inspect(state_path, dry_run):
    previous = json.loads(state_path.read_text()) if state_path.exists() else {}
    current = snapshot()
    fresh = {key: message for key, message in current.items() if key not in previous}
    for message in fresh.values():
        print(message)
    if dry_run:
        return
    saved = dict(current)
    if fresh:
        record = json.loads((Path.home() / ".agent-rails/agents/rails/agent.json").read_text())["t3"]
        text = "agent-lb account health:\n" + "\n".join(f"- {message}" for message in fresh.values())
        posted = send(record["thread_id"], record.get("host"), text)
        if not posted:
            for key in fresh:
                saved.pop(key)
        with state_path.with_suffix(".log").open("a") as log:
            stamp = datetime.now(timezone.utc).isoformat()
            for message in fresh.values():
                log.write(f"{stamp} {'posted' if posted else 'retry'} {message}\n")
    fd, temporary = tempfile.mkstemp(dir=state_path.parent, prefix=".account-health-")
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(saved, stream, sort_keys=True)
            stream.write("\n")
        os.replace(temporary, state_path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    state = Path.home() / ".agent-lb/state/account-health.json"
    if args.dry_run:
        inspect(state, True)
        return
    state.parent.mkdir(parents=True, exist_ok=True)
    with state.with_suffix(".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        inspect(state, False)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"account-health-watch failed: {type(exc).__name__}", file=sys.stderr)
        sys.exit(1)
