#!/usr/bin/env python3
"""lb-sandbox-check: the live check for scripts/lb-sandbox (Studio only).

    lb-sandbox-check --out DIR [--lb-sandbox ~/.agent-lb/bin/lb-sandbox]

Runs the installed lb-sandbox end to end: start a sandbox that mirrors the live
pool, send one tiny Anthropic and one tiny Codex turn straight to its front,
inject an account 429 on each edge, restart it blue/green while the edge holds
a stream open across the cutover, scan files and every sandbox process's exec
environment for leaked tokens, stop it, and prove the live agent-lb kept the
same pids and preferred port. This script never reads a credential: every
token stays inside lb-sandbox. Every lb-sandbox stdout and stderr is saved in
DIR; the verdict is DIR/result.json (schema 1, build/CONTRACT.md). DIR must be new or
empty and belongs to one run: a used DIR is refused (exit 2) and left untouched.

It authorizes agent-lb restarts, so any doubt is a fail: zero streams in flight
at cutover, a hold released by its timeout, an incomplete scan or a hit in a
teardown scan each fail the run.

Spend: four real turns, each under 50 output tokens (the held stream is served
by the sandbox edge, no provider call); no paid credits.
"""

from __future__ import annotations

import argparse
import datetime as dt
import http.client
import json
import os
import re
import shutil
import socket
import stat
import subprocess
import sys
import threading
import time
from pathlib import Path

HOME = Path.home()
LIVE_LABEL = "com.aneyman.agent-lb"
LIVE_FRONT_LABEL = "com.aneyman.agent-lb-front"
LIVE_FRONT_STATE = HOME / ".agent-lb" / "state" / "front.json"
# lb-restart appends one line per live restart here and holds this lock (holder line inside) while one runs.
LIVE_SYNC_LOG = HOME / ".agent-lb" / "runtime" / "sync.log"
LIVE_RESTART_LOCK = HOME / ".agent-lb" / "runtime" / "lb-restart.lock"
SYNC_RESTART_RE = re.compile(r"^\S+ lb-restart (ok|FAILED)\b")
GATE_ALLOWED = {("GET", "/api/federation/mirror"), ("GET", "/api/federation/status")}
HOLD_S = 30  # the edge holds the restart stream at most this long; the check releases it right after cutover
CUTOVER_RE = re.compile(r"front -> :(\d+); primary pid (\d+) had (-?\d+|None) in flight")
RESTART_MARKS = {
    "standby_boot": "standby healthy on",
    "front_switch": "front -> :",
    "drain": "old primary exited",
    "restore": "new primary healthy",
    "standby_stopped": "stopped listening",
}


def utc() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


class Check:
    def __init__(self, out: Path, lb_sandbox: Path) -> None:
        self.out = out
        self.lb_sandbox = lb_sandbox
        self.n = 0
        self.lock = threading.Lock()
        self.steps: list[dict] = []
        self.env_infra: str | None = None  # a concurrent live deploy: environment, not a slice defect
        self.unverified = [
            "Other hosts: Studio only; boxes use their own follower agent-lb.",
            "OAuth refresh in the sandbox: mirrored accounts carry access tokens only; refresh is refused in code.",
            "Websocket upstream: the sandbox forces http so the edge can see and cut streams.",
            "The live restart: only the sandbox restarts; the live service is read, never restarted.",
        ]

    def step(self, name: str, ok: bool, detail: str, evidence: list[str]) -> bool:
        self.steps.append({"name": name, "result": "pass" if ok else "fail", "detail": detail, "evidence": evidence})
        print(f"[{utc()}] {'PASS' if ok else 'FAIL'} {name}: {detail}", flush=True)
        return ok

    def sb(self, name: str, *args: str, timeout: float = 600) -> tuple[int, dict, Path]:
        """Run the installed lb-sandbox; stdout and stderr go to files in --out. Safe to call from two threads."""
        with self.lock:
            self.n += 1
            stem = self.out / f"{self.n:02d}-{name}"
        argv = [str(self.lb_sandbox), *args, "--json"]
        with open(f"{stem}.out", "w") as so, open(f"{stem}.err", "w") as se:
            try:
                rc = subprocess.run(argv, stdout=so, stderr=se, timeout=timeout, check=False).returncode
            except subprocess.TimeoutExpired:
                rc = 124
        try:
            data = json.loads(Path(f"{stem}.out").read_text() or "{}")
        except ValueError:
            data = {}
        return rc, data, Path(f"{stem}.out")


def sh(*argv: str) -> str:
    return subprocess.run(argv, capture_output=True, text=True, timeout=30, check=False).stdout


def launchd_pid(label: str) -> int | None:
    for line in sh("/bin/launchctl", "print", f"gui/{os.getuid()}/{label}").splitlines():
        line = line.strip()
        if line.startswith("pid = "):
            return int(line.split("=", 1)[1])
    return None


def listener_pids(port: int) -> list[int]:
    return sorted({int(p) for p in sh("/usr/sbin/lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t").split()})


def live_identity() -> dict:
    try:
        preferred = json.loads(LIVE_FRONT_STATE.read_text()).get("preferred")
    except (OSError, ValueError):
        preferred = None
    return {
        "primary_pid": launchd_pid(LIVE_LABEL),
        "front_pid": launchd_pid(LIVE_FRONT_LABEL),
        "listeners_2455": listener_pids(2455),
        "listeners_2457": listener_pids(2457),
        "preferred_port": preferred,
    }


def sync_log_size() -> int:
    """Bytes in the live restart log now: the mark after which a line is a restart during this run."""
    try:
        return LIVE_SYNC_LOG.stat().st_size
    except OSError:
        return 0


def live_restarts_since(offset: int) -> list[str]:
    """The live restarts lb-restart logged after offset (another lane's deploy), one line each, shortened."""
    try:
        with open(LIVE_SYNC_LOG, "rb") as fh:
            fh.seek(offset)
            text = fh.read(1 << 20).decode("utf-8", "replace")
    except OSError:
        return []
    return [line[:300] for line in text.splitlines() if SYNC_RESTART_RE.match(line)]


def live_restart_holder() -> str | None:
    """The holder line of the live lb-restart lock (pid, since, reason) while a live restart runs, else None.
    Read only: the lock is never taken."""
    try:
        text = LIVE_RESTART_LOCK.read_text(errors="replace").strip()
    except OSError:
        return None
    return text[:300] or None


def live_untouched(before: dict, after: dict, restarts: list[str], holders: list[str]) -> tuple[str, str]:
    """('pass' | 'infra_error' | 'fail', why) for the live identity across the run.

    A changed identity with a live lb-restart logged or holding its lock during the run is another lane's
    deploy, not this sandbox's doing: infra_error naming that restart, never pass (the run proved nothing about
    the live service) and never a bare fail (build lead, 2026-10-07). A change with no such restart is a fail.
    """
    if after == before:
        return "pass", f"before {before}; after {after}"
    named = [f"logged: {line}" for line in restarts] + [f"in progress: {line}" for line in holders]
    if named:
        return "infra_error", (
            f"live agent-lb restarted by another lane during the run ({'; '.join(named)}); "
            f"before {before}; after {after}"
        )
    return "fail", f"live identity changed with no live lb-restart logged or running: before {before}; after {after}"


def resolve_model(alias: str, fallback: str) -> str:
    route = shutil.which("route")
    if route:
        value = sh(route, "resolve", alias).strip().splitlines()
        if value and value[0].strip():
            return value[0].strip()
    return fallback


MAX_TURN_BYTES = 256 << 10  # a tiny turn's whole response is a few KiB
MAX_TURN_TEXT = 200  # about 50 output tokens of visible text
TURN_DEADLINE = 120.0


class TurnBudgetExceeded(Exception):
    pass


def post(port: int, path: str, body: dict, headers: dict, text_of=None) -> tuple[int, bytes]:
    """POST and read the body incrementally under a byte budget and an overall deadline.

    text_of(raw) returns the visible output so far; past MAX_TURN_TEXT the connection is closed,
    which cancels the upstream turn. Any breach raises TurnBudgetExceeded.
    """
    deadline = time.monotonic() + TURN_DEADLINE
    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=30)
    try:
        conn.request("POST", path, body=json.dumps(body), headers={"content-type": "application/json", **headers})
        resp = conn.getresponse()
        raw = b""
        while True:
            if time.monotonic() > deadline:
                raise TurnBudgetExceeded("deadline")
            chunk = resp.read1(16384)
            if not chunk:
                return resp.status, raw
            raw += chunk
            if len(raw) > MAX_TURN_BYTES:
                raise TurnBudgetExceeded("bytes")
            if text_of is not None and len(text_of(raw)) > MAX_TURN_TEXT:
                raise TurnBudgetExceeded("output text")
    finally:
        conn.close()


def sse_events(raw: bytes):
    for line in raw.decode(errors="replace").splitlines():
        if line.startswith("data:"):
            try:
                event = json.loads(line[5:])
            except ValueError:
                continue
            if isinstance(event, dict):
                yield event


def anthropic_text(raw: bytes) -> str:
    return "".join(
        e.get("delta", {}).get("text", "") for e in sse_events(raw) if e.get("type") == "content_block_delta"
    )


def codex_text(raw: bytes) -> str:
    return "".join(e.get("delta", "") for e in sse_events(raw) if e.get("type") == "response.output_text.delta")


def anthropic_turn(port: int, model: str, stream: bool = False) -> dict:
    body = {
        "model": model,
        "max_tokens": 48 if stream else 16,
        "messages": [
            {"role": "user", "content": "Count from 1 to 15, comma separated." if stream else "Reply with exactly: OK"}
        ],
    }
    if stream:
        body["stream"] = True
    started = time.monotonic()
    try:
        status, raw = post(
            port, "/v1/messages", body, {"anthropic-version": "2023-06-01"}, anthropic_text if stream else None
        )
    except TurnBudgetExceeded as exc:
        return {"status": 0, "error": f"budget: {exc}", "text": "", "complete": False}
    except (OSError, http.client.HTTPException) as exc:
        return {"status": 0, "error": exc.__class__.__name__, "text": "", "complete": False}
    text = ""
    if stream:
        text = anthropic_text(raw)
        complete = b"message_stop" in raw
    else:
        try:
            text = "".join(c.get("text", "") for c in json.loads(raw).get("content", []))
        except (ValueError, AttributeError):
            text = ""
        complete = bool(text)
    return {"status": status, "text": text[:200], "complete": complete, "seconds": round(time.monotonic() - started, 2)}


def codex_turn(port: int, model: str) -> dict:
    body = {
        "model": model,
        "instructions": "You are a terse test responder.",
        "input": [
            {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "Reply with exactly: OK"}]}
        ],
        "stream": True,
        "store": False,
        "reasoning": {"effort": "low"},
    }
    started = time.monotonic()
    try:
        status, raw = post(port, "/backend-api/codex/responses", body, {}, codex_text)
    except TurnBudgetExceeded as exc:
        return {"status": 0, "error": f"budget: {exc}", "text": "", "complete": False, "output_tokens": None}
    except (OSError, http.client.HTTPException) as exc:
        return {"status": 0, "error": exc.__class__.__name__, "text": "", "complete": False, "output_tokens": None}
    text = codex_text(raw)
    usage = {}
    for event in sse_events(raw):
        if event.get("type") == "response.completed":
            usage = (event.get("response") or {}).get("usage") or {}
    complete = b"response.completed" in raw
    return {
        "status": status,
        "text": text[:200],
        "complete": complete,
        "output_tokens": usage.get("output_tokens"),
        "seconds": round(time.monotonic() - started, 2),
    }


def within_budget(edge: str, turn: dict) -> bool:
    """Spend bound: a Codex turn must report its usage and stay under 50 output tokens (reasoning included).

    Anthropic turns are bounded by max_tokens in the request itself.
    """
    if edge != "openai":
        return True
    tokens = turn.get("output_tokens")
    return isinstance(tokens, int) and not isinstance(tokens, bool) and tokens < 50


def edge_lines(path: Path, skip: int) -> list[dict]:
    try:
        lines = path.read_text().splitlines()[skip:]
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def count_lines(path: Path) -> int:
    try:
        return len(path.read_text().splitlines())
    except OSError:
        return 0


def dashboard_export_status(port: int, forged_user: str | None = None) -> int:
    """Status of an unauthenticated local POST to the account export API; the body is never read.

    forged_user sends the identity header a trusted reverse proxy would set, plus an X-Forwarded-For
    claiming the sandbox's trusted proxy address.
    """
    headers = {"content-type": "application/json"}
    if forged_user:
        headers["Remote-User"] = forged_user
        headers["X-Forwarded-For"] = "192.0.2.1"
    try:
        conn = http.client.HTTPConnection("127.0.0.1", port, timeout=15)
        conn.request("POST", "/api/accounts/lbsbx-probe/export/auth", body=b"{}", headers=headers)
        status = conn.getresponse().status
        conn.close()
        return status
    except (OSError, http.client.HTTPException):
        return 0


def in_flight(port: int) -> int:
    try:
        conn = http.client.HTTPConnection("127.0.0.1", port, timeout=1)
        conn.request("GET", "/internal/drain/status")
        data = json.loads(conn.getresponse().read())
        conn.close()
        return int(data["checks"]["in_flight"])
    except (OSError, ValueError, KeyError, TypeError, http.client.HTTPException):
        return -1


# ---------------------------------------------------------------- verdicts
# Each returns the reasons a step does not count; empty means pass. Any missing or unexpected value is a
# reason: this check authorizes agent-lb restarts, so doubt never passes.


def parse_cutover(log_text: str) -> dict | None:
    """The cutover line lb-restart prints when it moves the front to the standby."""
    match = CUTOVER_RE.search(log_text)
    if not match:
        return None
    flight = match.group(3)
    return {
        "standby_port": int(match.group(1)),
        "old_pid": int(match.group(2)),
        "in_flight": int(flight) if flight.lstrip("-").isdigit() else None,
    }


def restart_problems(
    cutover: dict | None,
    hold: dict | None,
    released_after_cutover: bool,
    rc: int | None,
    restart: dict,
    marks: dict,
    switched: bool,
    stream: dict,
    stream_done: bool,
) -> list[str]:
    problems = []
    if not cutover:
        problems.append("no cutover line in the lb-restart log")
    elif not isinstance(cutover.get("in_flight"), int) or cutover["in_flight"] < 1:
        problems.append(f"{cutover.get('in_flight')} in flight on the primary at cutover (need >= 1)")
    if not hold:
        problems.append("the edge served no held stream")
    elif hold.get("released_by") != "clear":
        problems.append(f"the held stream ended by {hold.get('released_by')}, not by the check's release")
    if not released_after_cutover:
        problems.append("the check did not release the hold after the cutover")
    if rc != 0 or restart.get("lb_restart_exit") != 0:
        problems.append(f"lb-sandbox restart exit {rc}, lb-restart exit {restart.get('lb_restart_exit')}")
    missing = sorted(name for name, seen in marks.items() if not seen)
    if not marks or missing:
        problems.append(f"lb-restart log lacks {missing or 'every mark'}")
    if not switched:
        problems.append("the front did not switch to the standby and back")
    if not stream_done:
        problems.append("the held stream was still open after the restart")
    if stream.get("status") != 200 or stream.get("complete") is not True:
        problems.append(f"stream status {stream.get('status')} complete {stream.get('complete')}")
    return problems


def scan_problems(name: str, rc: int | None, scan: dict, min_secrets: int = 2, keyed: bool = False) -> list[str]:
    """A file or process scan counts only when it ran, loaded the secrets, read everything and found nothing.

    keyed: the scan must also have held the store key, so any ciphertext it opens (a store snapshot taken
    before a mirror cycle re-encrypted the rows) is a hit.
    """
    problems = []
    if keyed and scan.get("ciphertext_keys") != 1:
        problems.append(f"{name}: scanned without the store key ({scan.get('ciphertext_keys')})")
    if rc != 0:
        problems.append(f"{name}: exit {rc}")
    if scan.get("found") is not False:
        problems.append(f"{name}: found {scan.get('found')} hits {scan.get('hits')}")
    if scan.get("complete") is not True:
        problems.append(f"{name}: incomplete ({scan.get('unreadable')} unreadable)")
    if not isinstance(scan.get("secrets_loaded"), int) or scan["secrets_loaded"] < min_secrets:
        problems.append(f"{name}: {scan.get('secrets_loaded')} secrets loaded (need >= {min_secrets})")
    return problems


def process_scan_problems(rc: int | None, scan: dict, must_see: dict[str, int | None]) -> list[str]:
    """Every named sandbox process must have had its exec environment read (visible) and hold no secret."""
    procs = scan.get("processes") or {}
    problems = scan_problems("process scan", rc, scan)
    if procs.get("found") is not False or procs.get("complete") is not True:
        problems.append(f"process scan: found {procs.get('found')} complete {procs.get('complete')}")
    visible = set(procs.get("visible_pids") or [])
    unseen = sorted(set(procs.get("pids") or []) - visible) + list(procs.get("invisible_pids") or [])
    if unseen:
        # Any process of the run, named role or not, whose environment ps did not show could hold the token.
        problems.append(f"process scan did not read the environment of pids {sorted(set(unseen))}")
    for role, pid in must_see.items():
        if not isinstance(pid, int) or pid not in visible:
            problems.append(f"process scan did not read the environment of the {role} (pid {pid})")
    return problems


def stop_problems(rc: int | None, stop: dict, leftover: list[str], labels: str, run_id: str) -> list[str]:
    logs = stop.get("logs") or {}
    custody = stop.get("custody") or {}
    problems = []
    if rc != 0 or stop.get("clean") is not True:
        problems.append(f"stop exit {rc} clean {stop.get('clean')}")
    if leftover:
        problems.append(f"processes naming the run remain: {leftover}")
    if f"sbx-{run_id}" in labels:
        problems.append("a run label is still loaded")
    if logs.get("scan_scope") != "root":
        problems.append(f"teardown scanned {logs.get('scan_scope')}, not the whole sandbox root")
    if logs.get("scan_found") is not False or logs.get("scan_complete") is not True:
        problems.append(f"teardown scan found {logs.get('scan_found')} complete {logs.get('scan_complete')}")
    if logs.get("secret_load_error") or logs.get("copy_error") or logs.get("copied") is not True:
        problems.append(f"log export: {logs}")
    if logs.get("export_found") or logs.get("export_scanned") is not True or not logs.get("files_copied"):
        problems.append(
            f"log export not scanned byte for byte: export_scanned {logs.get('export_scanned')} "
            f"found {logs.get('export_found')} files {logs.get('files_copied')}"
        )
    if logs.get("ciphertext_keys") != 1:
        problems.append(f"teardown scan ran without the store key ({logs.get('ciphertext_keys')})")
    if custody.get("key_unlinked") is not True:
        problems.append(f"store key unlinked: {custody.get('key_unlinked')}")
    return problems


def custody_problems(sandboxes: Path, root: Path) -> list[str]:
    """Custody parity with live: 0700 directories, a 0600 single-link key. stat only; nothing is read."""
    problems = []
    for path, want in ((sandboxes, 0o700), (root, 0o700)):
        try:
            info = path.lstat()
        except OSError as exc:
            problems.append(f"{path}: {exc.__class__.__name__}")
            continue
        if not stat.S_ISDIR(info.st_mode) or stat.S_IMODE(info.st_mode) != want:
            problems.append(f"{path} mode {oct(stat.S_IMODE(info.st_mode))} (want {oct(want)}, a real directory)")
    key = root / "data" / "encryption.key"
    try:
        info = key.lstat()
    except OSError as exc:
        return [*problems, f"key: {exc.__class__.__name__}"]
    if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1:
        problems.append(f"key mode {oct(stat.S_IMODE(info.st_mode))} links {info.st_nlink} (want 0o600, 1)")
    return problems


def run_check(c: Check, args) -> None:  # noqa: C901 - one scenario, steps in order
    out = c.out
    run_id = f"lbsbx-{dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dt%H%M%Sz')}-{os.getpid()}"
    c.run_id = run_id
    anthropic_model = resolve_model("sonnet-latest", "claude-sonnet-5-5")
    codex_model = resolve_model("sol-latest", "gpt-6.1-sol")

    # 1. live identity and marker
    marker = out / "marker"
    marker.write_text(f"{run_id} {utc()}\n")
    time.sleep(1.1)  # mtime resolution: anything written after this is newer than the marker
    sync_mark = sync_log_size()
    holder_before = live_restart_holder()
    before = live_identity()
    (out / "live-before.json").write_text(json.dumps(before, indent=1))
    c.step(
        "live-identity-before",
        bool(before["primary_pid"] and before["front_pid"] and before["listeners_2455"]),
        f"live primary pid {before['primary_pid']}, front pid {before['front_pid']}, "
        f"2455 {before['listeners_2455']}, 2457 {before['listeners_2457']}, preferred {before['preferred_port']}",
        [str(out / "live-before.json"), str(marker)],
    )

    # 2. start
    rc, start, start_out = c.sb("start", "start", "--from-live", "--run-id", run_id, timeout=300)
    c.started = rc == 0 or (HOME / ".agent-lb" / "sandboxes" / run_id).exists()
    if not c.step(
        "start",
        rc == 0 and bool(start.get("front_port")),
        f"lb-sandbox start exit {rc}; front {start.get('front_port')}, primary {start.get('primary_port')}, "
        f"standby {start.get('standby_port')}, gate {start.get('gate_port')}, edges {start.get('edge_ports')}; "
        f"usable accounts {start.get('accounts_per_vendor')}; ready in {start.get('ready_s')} s"
        + (f"; error {start.get('error')}" if rc else ""),
        [str(start_out), str(start_out.with_suffix(".err"))],
    ):
        c.infra = f"sandbox never got healthy: {start.get('error')}"
        return
    front, primary = start["front_port"], start["primary_port"]
    root = Path(start["root"])

    # 3. status: accounts and listeners
    rc, status, status_out = c.sb("status", "status", "--run-id", run_id)
    counts = status.get("accounts_per_vendor", {})
    ports = status.get("ports", {})
    pids = sorted({p for port in ports.values() for p in listener_pids(port)})
    listen = sh("/usr/sbin/lsof", "-nP", "-a", "-p", ",".join(map(str, pids)), "-iTCP", "-sTCP:LISTEN") if pids else ""
    addresses = [line.split()[8] for line in listen.splitlines()[1:] if len(line.split()) >= 9]
    (out / "sandbox-listeners.txt").write_text(listen)
    # The dashboard must be locked: the account export API answers 401 to a local caller. Only the status is kept.
    export_status = dashboard_export_status(front)
    forged_status = dashboard_export_status(front, forged_user="admin")
    c.step(
        "status-accounts-and-listeners",
        rc == 0
        and counts.get("anthropic", 0) >= 2
        and counts.get("openai", 0) >= 2
        and bool(addresses)
        and all(a.startswith("127.0.0.1:") for a in addresses)
        and export_status == 401
        and forged_status == 401,
        f"healthy {status.get('healthy')}; usable per vendor {counts}; run pids {pids} listen on {addresses}; "
        f"account export API answered {export_status}, with forged Remote-User and X-Forwarded-For "
        f"{forged_status} (want 401, 401)",
        [str(status_out), str(out / "sandbox-listeners.txt")],
    )

    # 3b. custody parity: modes and the key file (stat only)
    problems = custody_problems(root.parent, root)
    # The kernel rules behind every name-based open the app and the front make: the root is its own volume (no
    # hard link reaches a live file) and the primary, aux and front run under the root's Seatbelt profile.
    if status.get("own_volume") is not True:
        problems.append(f"root on its own volume: {status.get('own_volume')}")
    confined = status.get("confined") or {}
    if any(confined.get(role) is not True for role in ("primary", "aux", "front")):
        problems.append(f"confined: {confined}")
    c.step(
        "custody-parity",
        not problems,
        f"sandboxes dir and root 0700, store key 0600 with one link, root its own volume, primary/aux/front "
        f"confined {confined}: {problems or 'yes'}",
        [str(status_out)],
    )

    # 3c. no token in the exec environment of any sandbox process (ps eww), matched inside lb-sandbox
    rc_p, procs, procs_out = c.sb("scan-processes", "scan", "--run-id", run_id, "--processes")
    must_see = {"primary": status.get("primary_pid"), "aux": status.get("aux_pid"), "front": status.get("front_pid")}
    problems = process_scan_problems(rc_p, procs, must_see)
    p = procs.get("processes") or {}
    c.step(
        "process-env-scan",
        not problems,
        f"ps eww of {p.get('processes_scanned')} run processes {p.get('pids')}: environments read "
        f"{p.get('visible_pids')}, hits {p.get('hits')}; must read {must_see}: {problems or 'ok'}",
        [str(procs_out)],
    )

    # 4. one tiny turn per vendor, no client credential
    a = anthropic_turn(front, anthropic_model)
    x = codex_turn(front, codex_model)
    (out / "turns-baseline.json").write_text(json.dumps({"anthropic": a, "codex": x}, indent=1))
    c.step(
        "baseline-turns",
        a["status"] == 200
        and bool(a["text"])
        and x["status"] == 200
        and bool(x["text"])
        and x["complete"]
        and within_budget("openai", x),
        f"Anthropic {anthropic_model}: {a['status']} {a['text']!r}; Codex {codex_model}: {x['status']} {x['text']!r} "
        f"output_tokens {x.get('output_tokens')}",
        [str(out / "turns-baseline.json")],
    )

    # 5. injected account 429 per edge
    edge_log = root / "logs" / "edge.jsonl"
    for edge, turn in (
        ("anthropic", lambda: anthropic_turn(front, anthropic_model)),
        ("openai", lambda: codex_turn(front, codex_model)),
    ):
        skip = count_lines(edge_log)
        rc_arm, _, arm_out = c.sb(f"fault-{edge}", "fault", "--run-id", run_id, "--edge", edge, "--arm", "account_429")
        result = turn()
        time.sleep(1.5)  # the edge logs a streamed request when it ends
        lines = [ln for ln in edge_lines(edge_log, skip) if ln.get("edge") == edge]
        failed = [ln for ln in lines if ln.get("status") == 429 and ln.get("fault") == "account_429"]
        h1 = failed[0]["auth_hash12"] if failed else None
        served = [ln for ln in lines if ln.get("status") == 200 and ln.get("auth_hash12") not in (None, "", h1)]
        rc_st, st, st_out = c.sb(f"status-after-429-{edge}", "status", "--run-id", run_id)
        cooled = [acc for acc in st.get("accounts", []) if acc.get("auth_hash12") == h1]
        acct = cooled[0] if cooled else {}
        rc_clr, _, clr_out = c.sb(f"fault-clear-{edge}", "fault", "--run-id", run_id, "--edge", edge, "--clear")
        (out / f"turn-429-{edge}.json").write_text(json.dumps({"turn": result, "edge_lines": lines}, indent=1))
        c.step(
            f"account-429-{edge}",
            rc_arm == 0
            and result["status"] == 200
            and bool(result["text"])
            and bool(h1)
            and bool(served)
            and bool(acct.get("in_cooldown"))
            and rc_clr == 0
            and within_budget(edge, result),
            f"turn {result['status']} {result['text']!r} output_tokens {result.get('output_tokens')}; "
            f"edge 429 on hash {h1}, then 200 on "
            f"{served[0]['auth_hash12'] if served else None}; account {acct.get('id')} status {acct.get('status')} "
            f"in_cooldown {acct.get('in_cooldown')} until {acct.get('cooldown_until')}",
            [str(arm_out), str(out / f"turn-429-{edge}.json"), str(st_out), str(clr_out), str(edge_log)],
        )

    # 6. blue/green restart while the edge holds a stream open across the cutover
    rc_hold, _, hold_out = c.sb(
        "fault-hold", "fault", "--run-id", run_id, "--edge", "anthropic", "--arm", f"hold_stream:{HOLD_S}"
    )
    skip = count_lines(edge_log)
    restart_log = root / "logs" / "lb-restart.log"
    log_start = restart_log.stat().st_size if restart_log.exists() else 0
    holder: dict = {}
    stream_thread = threading.Thread(
        target=lambda: holder.update(anthropic_turn(front, anthropic_model, stream=True)), daemon=True
    )
    stream_thread.start()
    seen, deadline = -1, time.monotonic() + 20
    while time.monotonic() < deadline and stream_thread.is_alive():
        seen = in_flight(primary)
        if seen >= 1:
            break
        time.sleep(0.05)
    rc_flight, flight, flight_out = c.sb("status-in-flight", "status", "--run-id", run_id)
    restarted: dict = {}

    def do_restart() -> None:
        rc, data, path = c.sb("restart", "restart", "--run-id", run_id, "--reason", f"lb-sandbox-check {run_id}")
        restarted.update({"rc": rc, "data": data, "out": path})

    restart_thread = threading.Thread(target=do_restart, daemon=True)
    restart_thread.start()
    cutover, deadline = None, time.monotonic() + HOLD_S
    while cutover is None and time.monotonic() < deadline and restart_thread.is_alive():
        try:
            with restart_log.open("rb") as fh:
                fh.seek(log_start)
                cutover = parse_cutover(fh.read().decode(errors="replace"))
        except OSError:
            pass
        if cutover is None:
            time.sleep(0.1)
    # While the old primary drains the held stream and the standby serves: every sandbox process, read again.
    procs_mid, rc_pm, pm_out = {}, None, None
    if cutover is not None:
        rc_pm, procs_mid, pm_out = c.sb("scan-processes-at-cutover", "scan", "--run-id", run_id, "--processes")
    # The cutover is done: release the held stream (always, so a failed run never leaves it hanging).
    rc_rel, _, rel_out = c.sb("release-hold", "fault", "--run-id", run_id, "--edge", "anthropic", "--clear")
    released_after_cutover = cutover is not None and rc_rel == 0
    restart_thread.join(timeout=300)
    stream_thread.join(timeout=60)
    restart = restarted.get("data", {})
    restart_out = restarted.get("out", out / "restart-missing")
    log_text = ""
    try:
        with restart_log.open("rb") as fh:
            fh.seek(log_start)
            log_text = fh.read().decode(errors="replace")
    except OSError:
        pass
    (out / "lb-restart.log").write_text(log_text)
    marks = {name: needle in log_text for name, needle in RESTART_MARKS.items()}
    standby = re.search(r"standby healthy on :\d+ in [0-9.]+s \(pid (\d+)\)", log_text)
    front_log = ""
    try:
        front_log = (root / "logs" / "front.log").read_text()
    except OSError:
        pass
    to_standby = front_log.rfind(f"preferred upstream now :{start['standby_port']}")
    switched = to_standby >= 0 and front_log.find(f"preferred upstream now :{primary}", to_standby) > to_standby
    (out / "front.log").write_text(front_log)
    holds = [ln for ln in edge_lines(edge_log, skip) if ln.get("fault") == "hold_stream"]
    hold = holds[0] if len(holds) == 1 else None
    (out / "turn-restart.json").write_text(
        json.dumps({"stream": holder, "in_flight_seen": seen, "cutover": cutover, "hold": holds}, indent=1)
    )
    problems = restart_problems(
        cutover,
        hold,
        released_after_cutover and rc_hold == 0,
        restarted.get("rc"),
        restart,
        marks,
        switched,
        holder,
        not stream_thread.is_alive(),
    )
    c.step(
        "restart-with-stream",
        not problems,
        f"cutover {cutover}; in_flight_primary {seen} (status call: {flight.get('in_flight_primary')}) before "
        f"restart; held stream {hold}; lb-restart exit {restart.get('lb_restart_exit')} in "
        f"{restart.get('seconds')} s; log marks {marks}; front switched to :{start['standby_port']} and back to "
        f":{primary}: {switched}; stream {holder.get('status')} complete {holder.get('complete')} "
        f"{holder.get('text', '')[:40]!r}; problems {problems or 'none'}",
        [
            str(hold_out),
            str(flight_out),
            str(restart_out),
            str(rel_out),
            str(out / "lb-restart.log"),
            str(out / "front.log"),
            str(out / "turn-restart.json"),
            str(edge_log),
        ],
    )
    must_see = {
        "draining old primary": cutover.get("old_pid") if cutover else None,
        "standby": int(standby.group(1)) if standby else None,
        "aux": status.get("aux_pid"),
        "front": status.get("front_pid"),
    }
    problems = process_scan_problems(rc_pm, procs_mid, must_see) if cutover else ["no cutover, no scan"]
    p = procs_mid.get("processes") or {}
    c.step(
        "process-env-scan-at-cutover",
        not problems,
        f"ps eww of {p.get('processes_scanned')} run processes {p.get('pids')} during the drain: environments "
        f"read {p.get('visible_pids')}, hits {p.get('hits')}; must read {must_see}: {problems or 'ok'}",
        [str(pm_out)] if pm_out else [],
    )

    # gate: only the two read-only GETs were forwarded to live
    rc_g, gate_status, gate_out = c.sb("status-gate", "status", "--run-id", run_id)
    gate = gate_status.get("gate", {})
    forwarded = [(f.get("method"), f.get("path")) for f in gate.get("forwarded", [])]
    c.step(
        "gate-read-only",
        bool(forwarded) and all(f in GATE_ALLOWED for f in forwarded),
        f"forwarded {gate.get('forwarded')}; refused {gate.get('refused')} {gate.get('refused_by')}",
        [str(gate_out)],
    )

    # 7. scan for leaked tokens: the sandbox root itself (before teardown), --out, and shared trees
    rc_s0, scan_root, s0_out = c.sb("scan-root", "scan", "--run-id", run_id, str(root))
    rc_s1, scan_out_dir, s1_out = c.sb("scan-out", "scan", "--run-id", run_id, str(out))
    tmpdir = os.environ.get("TMPDIR") or "/tmp"
    rc_s2, scan_new, s2_out = c.sb(
        "scan-newer",
        "scan",
        "--run-id",
        run_id,
        "--newer-than",
        str(marker),
        "--exclude",
        str(root),  # scanned whole just above
        str(HOME / ".agent-rails"),
        str(HOME / "Library" / "LaunchAgents"),
        tmpdir,
        str(HOME / ".agent-lb"),
        timeout=1500,
    )
    problems = (
        scan_problems("sandbox root", rc_s0, scan_root, keyed=True)
        + scan_problems("--out", rc_s1, scan_out_dir, keyed=True)
        + scan_problems("shared trees", rc_s2, scan_new, keyed=True)
    )
    if not scan_root.get("files_scanned"):
        problems.append("the sandbox root scan read no file")
    c.step(
        "scan",
        not problems,
        f"sandbox root (store and key at their own paths excepted): found {scan_root.get('found')} in "
        f"{scan_root.get('files_scanned')} files; --out: found {scan_out_dir.get('found')} in "
        f"{scan_out_dir.get('files_scanned')} files; newer than marker under ~/.agent-rails, ~/Library/LaunchAgents, "
        f"$TMPDIR, ~/.agent-lb: found {scan_new.get('found')} in {scan_new.get('files_scanned')} files; unreadable "
        f"{scan_root.get('unreadable')}+{scan_out_dir.get('unreadable')}+{scan_new.get('unreadable')} "
        f"{scan_new.get('unreadable_paths', [])[:5]}; secrets (tokens, key, ciphertexts) held by lb-sandbox "
        f"{scan_out_dir.get('secrets_loaded')}; problems {problems or 'none'}",
        [str(s0_out), str(s1_out), str(s2_out)],
    )

    # 8. stop
    stop_and_verify(c, run_id)

    # 9. live identity after
    after = live_identity()
    holders = sorted({h for h in (holder_before, live_restart_holder()) if h})
    restarts = live_restarts_since(sync_mark)
    (out / "live-after.json").write_text(json.dumps(after, indent=1))
    (out / "live-restarts.json").write_text(
        json.dumps({"sync_log": str(LIVE_SYNC_LOG), "offset": sync_mark, "logged": restarts, "lock_holders": holders})
    )
    verdict, detail = live_untouched(before, after, restarts, holders)
    evidence = [str(out / "live-before.json"), str(out / "live-after.json"), str(out / "live-restarts.json")]
    if verdict == "infra_error":
        # The contract's step results have no infra_error: the step is unverified, the run is infra_error.
        c.env_infra = detail
        c.unverified.append(f"Live agent-lb untouched: not provable this run; {detail}")
        c.steps.append({"name": "live-untouched", "result": "unverified", "detail": detail, "evidence": evidence})
        print(f"[{utc()}] INFRA live-untouched: {detail}", flush=True)
    else:
        c.step("live-untouched", verdict == "pass", detail, evidence)


def stop_and_verify(c: Check, run_id: str) -> None:
    rc, stop, stop_out = c.sb("stop", "stop", "--run-id", run_id, "--logs-to", str(c.out / "logs"))
    c.stopped = True
    leftover = leftover_pids(run_id)
    labels = sh("/bin/launchctl", "list")
    problems = stop_problems(rc, stop, leftover, labels, run_id)
    # The exported logs once more, after the root is gone: only the live token is left to look for.
    rc_x, exported, x_out = c.sb("scan-exported-logs", "scan", "--run-id", run_id, str(c.out / "logs"))
    problems += scan_problems("exported logs after stop", rc_x, exported, min_secrets=1)
    c.step(
        "stop-clean",
        not problems,
        f"stop exit {rc} clean {stop.get('clean')}: labels {stop.get('labels_loaded')}, listeners "
        f"{stop.get('listeners')}, processes {stop.get('processes')}, root exists {stop.get('root_exists')}; "
        f"logs {stop.get('logs')}; custody {stop.get('custody')}; independent ps leftover pids {leftover}; "
        f"exported logs rescanned for the live token: found {exported.get('found')} in "
        f"{exported.get('files_scanned')} files; problems {problems or 'none'}",
        [str(stop_out), str(x_out), str(c.out / "logs")],
    )


def leftover_pids(run_id: str) -> list[int]:
    """Pids whose command line names the run, this check excepted. Pids only: a command line may hold a token."""
    leftover = []
    for row in sh("/bin/ps", "-axww", "-o", "pid=,command=").splitlines():
        parts = row.strip().split(None, 1)
        if len(parts) == 2 and parts[0].isdigit() and int(parts[0]) != os.getpid() and run_id in parts[1]:
            leftover.append(int(parts[0]))
    return leftover


def run_verdict(steps: list[dict], infra: str | None, env_infra: str | None) -> str:
    """The run's result. A real failure is never hidden behind a concurrent live deploy (env_infra); with no
    failure, that deploy makes the run infra_error; pass needs every step pass with evidence."""
    if infra:
        return "infra_error"
    if any(s["result"] == "fail" for s in steps):
        return "fail"
    if env_infra:
        return "infra_error"
    if steps and all(s["result"] == "pass" and s["evidence"] for s in steps):
        return "pass"
    return "fail"


OUT_CLAIM = ".lb-sandbox-check.claim"


def claim_out(out: Path) -> str | None:
    """Give this run sole use of DIR, or say why not. Two runs sharing one DIR overwrite each other's numbered
    step files and verdict, so both results are garbage (2026-10-08: two verifiers both wrote run-v3r1; each run
    read the other's status and stop output and failed on it). DIR must be new or empty; the claim file is
    created with O_EXCL, so of two runs that both found it empty only one proceeds."""
    try:
        out.mkdir(parents=True, exist_ok=True)
        held = sorted(p.name for p in out.iterdir())
    except OSError as exc:
        return f"--out {out} unusable: {exc.__class__.__name__}"
    if held:
        return f"--out {out} is not empty ({len(held)} entries, e.g. {held[0]}); give each run its own dir"
    try:
        fd = os.open(out / OUT_CLAIM, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    except FileExistsError:
        return f"--out {out} was claimed by another lb-sandbox-check run; give each run its own"
    with os.fdopen(fd, "w") as f:
        f.write(f"{os.getpid()} {utc()}\n")
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--lb-sandbox", type=Path, default=HOME / ".agent-lb" / "bin" / "lb-sandbox")
    args = parser.parse_args()
    out = args.out.expanduser().resolve()
    refused = claim_out(out)
    if refused:  # another run owns DIR: write nothing there, its step files and verdict stay its own
        print(json.dumps({"result": "infra_error", "run_id": None, "summary": refused}, indent=1))
        return 2
    c = Check(out, args.lb_sandbox)
    c.run_id, c.started, c.stopped, c.infra = None, False, False, None
    started_at = utc()
    try:
        if not args.lb_sandbox.is_file():
            c.infra = f"installed lb-sandbox missing at {args.lb_sandbox}"
        elif sys.platform != "darwin" or shutil.which("launchctl") != "/bin/launchctl":
            c.infra = "needs Studio with /bin/launchctl"
        else:
            run_check(c, args)
    except Exception as exc:  # the verdict must still be written
        c.step("check-crashed", False, f"{exc.__class__.__name__}: {exc}", [])
    finally:
        if c.started and not c.stopped and c.run_id:
            stop_and_verify(c, c.run_id)
    steps = c.steps
    verdict = run_verdict(steps, c.infra, c.env_infra)
    failed = [s["name"] for s in steps if s["result"] != "pass"]
    result = {
        "schema": 1,
        "lane": "sys-lb-sandbox",
        "component_ids": ["claude-lb"],
        "run_id": c.run_id,
        "host": socket.gethostname(),
        "started_at": started_at,
        "ended_at": utc(),
        "result": verdict,
        "summary": (
            c.infra
            or (c.env_infra if verdict == "infra_error" else None)
            or (
                "lb-sandbox mirrored the live pool, served both vendors, failed over an injected 429 on each edge, "
                "restarted blue/green with a held stream in flight across the cutover, kept every token out of "
                "files and process environments, and tore down clean; live agent-lb untouched."
                if verdict == "pass"
                else f"failed steps: {', '.join(failed)}"
            )
        ),
        "steps": steps,
        "unverified": c.unverified,
        "lb_sandbox": str(args.lb_sandbox),
    }
    (out / "result.json").write_text(json.dumps(result, indent=1) + "\n")
    print(json.dumps({k: result[k] for k in ("result", "run_id", "summary")}, indent=1))
    return {"pass": 0, "fail": 1}.get(verdict, 2)


if __name__ == "__main__":
    sys.exit(main())
