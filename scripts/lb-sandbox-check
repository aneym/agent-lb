#!/usr/bin/env python3


from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from scripts.lb_sandbox_check_runtime import HOME, Check, utc
from scripts.lb_sandbox_check_flow import run_check, stop_and_verify


def run_verdict(steps: list[dict], infra: str | None, env_infra: str | None) -> str:

    if infra:
        return "infra_error"
    if any(s["result"] == "fail" for s in steps):
        return "fail"
    if env_infra:
        return "infra_error"
    if steps and all(s["result"] == "pass" and s["evidence"] for s in steps):
        return "pass"
    return "fail"


OUT_CLAIM = ".lb-sandbox-check.claim"


def claim_out(out: Path) -> str | None:

    try:
        out.mkdir(parents=True, exist_ok=True)
        held = sorted(p.name for p in out.iterdir())
    except OSError as exc:
        return f"--out {out} unusable: {exc.__class__.__name__}"
    if held:
        return f"--out {out} is not empty ({len(held)} entries, e.g. {held[0]}); give each run its own dir"
    try:
        fd = os.open(out / OUT_CLAIM, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    except FileExistsError:
        return f"--out {out} was claimed by another lb-sandbox-check run; give each run its own"
    with os.fdopen(fd, "w") as f:
        f.write(f"{os.getpid()} {utc()}\n")
    return None


def main() -> int:
    parser = argparse.ArgumentParser(description='lb-sandbox-check: the live check for scripts/lb-sandbox (Studio only).', formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--lb-sandbox", type=Path, default=HOME / ".agent-lb" / "bin" / "lb-sandbox")
    parser.add_argument(
        "--from-ref",
        metavar="REF",
        help="run the sandbox on this agent-lb git ref's code (lb-sandbox start --from-ref); default: live runtime",
    )
    args = parser.parse_args()
    out = args.out.expanduser().resolve()
    refused = claim_out(out)
    if refused:
        print(json.dumps({"result": "infra_error", "run_id": None, "summary": refused}, indent=1))
        return 2
    c = Check(out, args.lb_sandbox)
    c.run_id, c.started, c.stopped, c.infra = None, False, False, None
    started_at = utc()
    try:
        if not args.lb_sandbox.is_file():
            c.infra = f"installed lb-sandbox missing at {args.lb_sandbox}"
        elif sys.platform != "darwin" or shutil.which("launchctl") != "/bin/launchctl":
            c.infra = "needs Studio with /bin/launchctl"
        else:
            run_check(c, args)
    except Exception as exc:
        c.step("check-crashed", False, f"{exc.__class__.__name__}: {exc}", [])
    finally:
        if c.started and not c.stopped and c.run_id:
            stop_and_verify(c, c.run_id)
    steps = c.steps
    verdict = run_verdict(steps, c.infra, c.env_infra)
    failed = [s["name"] for s in steps if s["result"] != "pass"]
    result = {
        "schema": 1,
        "lane": "sys-lb-sandbox",
        "component_ids": ["claude-lb"],
        "run_id": c.run_id,
        "host": socket.gethostname(),
        "started_at": started_at,
        "ended_at": utc(),
        "result": verdict,
        "summary": (
            c.infra
            or (c.env_infra if verdict == "infra_error" else None)
            or (
                "lb-sandbox mirrored the live pool, served both vendors, failed over an injected 429 on each edge, "
                "restarted blue/green with a held stream in flight across the cutover, kept every token out of "
                "files and process environments, and tore down clean; live agent-lb untouched."
                if verdict == "pass"
                else f"failed steps: {', '.join(failed)}"
            )
        ),
        "steps": steps,
        "unverified": c.unverified,
        "lb_sandbox": str(args.lb_sandbox),
        "runtime_ref": args.from_ref,
    }
    (out / "result.json").write_text(json.dumps(result, indent=1) + "\n")
    print(json.dumps({k: result[k] for k in ("result", "run_id", "summary")}, indent=1))
    return {"pass": 0, "fail": 1}.get(verdict, 2)


if __name__ == "__main__":
    sys.exit(main())
