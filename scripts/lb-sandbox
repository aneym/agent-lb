#!/usr/bin/env python3
"""lb-sandbox: a throwaway agent-lb instance on Studio that mirrors the live account pool.

Drills and checks need an agent-lb with working accounts that is not the live
service. Everything that touches a credential runs inside this agent-lb code:
reading the live federation token, mirroring accounts, forwarding upstream
Authorization headers, injecting account faults and scanning for leaks. A caller
gets ports, account ids, 12-character hashes and counts, never a token.

    lb-sandbox start --run-id R --from-live [--port P] [--min-accounts N] [--transport http] [--json]
    lb-sandbox status --run-id R [--json]
    lb-sandbox client-env --run-id R --vendor claude|codex [--json]
    lb-sandbox fault --run-id R --edge anthropic|openai (--arm account_429|cut_after_bytes:N|hold_stream:S | --clear)
    lb-sandbox restart --run-id R --reason TEXT [--json]
    lb-sandbox scan --run-id R [--newer-than FILE] [--exclude PATH ...] [--processes] [PATH...] [--json]
    lb-sandbox stop --run-id R [--logs-to DIR] [--json]
    lb-sandbox gc [--older-than 3600] [--json]

Layout: root ~/.agent-lb/sandboxes/R/ holds a copy of the installed runtime
(app, config, scripts; the venv is a symlink), its own SQLite store and key,
logs and state. Two launchd jobs run it:
- com.agent-lb.drill.sbx-R: `lb-sandbox _serve <root>`, which reads the live
  federation token from the live plist, writes it into a pipe and execs
  `lb-sandbox _boot`, which reads it from the inherited pipe fd, loads the app
  settings with it and starts the app in the same process. The token is never
  in an exec environment (`ps eww`), the sandbox plist, a file, argv or a log.
- com.agent-lb.drill.sbx-R-aux: `lb-sandbox _aux <root>`: the peer gate (forwards
  only GET /api/federation/mirror and /status to the live LB, answers 403 to
  everything else), two edge proxies to the real providers that log only a hash
  of the Authorization value and inject armed faults, and the front as a child.

Every listener binds 127.0.0.1; ports come from 2470-2599 and are never 1455,
2455, 2457 or 2459. The sandbox can read the live pool and never write to it.

Custody parity with the live service (same UID): the root is mode 0700 under
~/.agent-lb/sandboxes (0700), the key file is created 0600 with O_EXCL and
unlinked at stop, and no token, store or key reaches --out or --logs-to: the
scans look for the raw tokens, the key and any ciphertext the key opens (an old
store snapshot included), and the log export scans every byte it copies. Every
path under a root is opened component by component without following a link,
and a file with a second hard link is refused, so a link planted in the root
never leads a read, write or unlink into live state.

Exit codes: 0 ok, 1 assertion false (scan found something, stop not clean),
2 refused (guard), 3 unhealthy (boot, mirror or restart failed).
"""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import errno
import hashlib
import json
import os
import plistlib
import pwd
import re
import shutil
import signal
import socket
import sqlite3
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

REAL_HOME = Path(pwd.getpwuid(os.getuid()).pw_dir)
LB_HOME = REAL_HOME / ".agent-lb"
SANDBOXES = LB_HOME / "sandboxes"
LIVE_RUNTIME = LB_HOME / "runtime" / "agent-lb"
LIVE_VENV = LIVE_RUNTIME / ".venv"
LIVE_PLIST = REAL_HOME / "Library" / "LaunchAgents" / "com.aneyman.agent-lb.plist"
LIVE_LABEL = "com.aneyman.agent-lb"
LIVE_FRONT_LABEL = "com.aneyman.agent-lb-front"
LIVE_FRONT_STATE = LB_HOME / "state" / "front.json"
LIVE_FRONT_PORT = 2455
LIVE_PRIMARY_PORT = 2457
LIVE_PEER_URL = "http://127.0.0.1:2455"
MANAGED_ROUTING = LB_HOME / "managed" / "coding-agents"

LABEL_PREFIX = "com.agent-lb.drill."
FORBIDDEN_PORTS = frozenset({1455, 2455, 2457, 2459})
MIN_PORT = 2470
PICK_RANGE = range(2470, 2600)
RUN_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,79}$")
TOKEN_ENV = "AGENT_LB_FEDERATION_TOKEN"
EDGES = {"anthropic": "https://api.anthropic.com", "openai": "https://chatgpt.com/backend-api"}
GATE_ALLOWED = frozenset({("GET", "/api/federation/mirror"), ("GET", "/api/federation/status")})
VENDOR_OF_PROVIDER = {"anthropic": "anthropic", "openai": "openai"}
USABLE_EXPIRY_S = 1800
DRAIN_S = 120
HOLD_MAX_S = 120
# The files that legitimately hold the sandbox's custody material (ciphertexts and their key).
CUSTODY_FILES = (
    "data/store.db",
    "data/store.db-wal",
    "data/store.db-shm",
    "data/store.db-journal",
    "data/encryption.key",
)
ENV_MARKER = "LB_SANDBOX_ROOT="  # in every sandbox process's exec env: proves ps showed the env at all

EXIT_OK, EXIT_ASSERT, EXIT_REFUSED, EXIT_UNHEALTHY = 0, 1, 2, 3

# Schedulers that would spend, refresh or write; the sandbox runs only the federation mirror.
DISABLED_SCHEDULERS = (
    "METRICS",
    "USAGE_REFRESH",
    "MODEL_REGISTRY",
    "ACCOUNT_PULSE",
    "RESET_CREDIT_AUTO_REDEEM",
    "RESET_CREDIT_EXPIRY_REDEEM",
    "ACCOUNTS_CACHE_WARMER",
    "STICKY_SESSION_CLEANUP",
    "QUOTA_PLANNER_SCHEDULER",
    "HTTP_RESPONSES_SESSION_BRIDGE",
    "AUTH_GUARDIAN",
)


class Refused(Exception):
    """A guard said no; nothing was touched."""


class Unhealthy(Exception):
    """Boot, mirror or restart failed."""


# ---------------------------------------------------------------- guards


def check_run_id(run_id: str) -> str:
    if not isinstance(run_id, str) or not RUN_ID_RE.match(run_id):
        raise Refused(f"run id {run_id!r} must match {RUN_ID_RE.pattern}")
    if run_id.endswith("-aux"):
        # Run R's aux label is sbx-R-aux; a run named R-aux would own that label too.
        raise Refused(f"run id {run_id!r} must not end in -aux")
    return run_id


def check_label(label: str) -> str:
    suffix = label.removeprefix(LABEL_PREFIX)
    if not label.startswith(LABEL_PREFIX) or not suffix or not suffix.replace("-", "").isalnum():
        raise Refused(f"label {label!r} is not a {LABEL_PREFIX}* drill label")
    return label


def check_ports(ports: list[int]) -> list[int]:
    for port in ports:
        if isinstance(port, bool) or not isinstance(port, int) or port < MIN_PORT or port > 2599:
            raise Refused(f"port {port!r} is outside {MIN_PORT}-2599")
        if port in FORBIDDEN_PORTS:
            raise Refused(f"port {port} belongs to the live agent-lb")
    if len(set(ports)) != len(ports):
        raise Refused("sandbox ports repeat")
    return ports


def check_root(root: Path, sandboxes: Path | None = None) -> Path:
    base = (sandboxes or SANDBOXES).resolve()
    resolved = Path(root).resolve()
    if resolved.parent != base:
        raise Refused(f"sandbox root {resolved} is not directly under {base}")
    check_run_id(resolved.name)
    return resolved


def check_launchctl() -> None:
    found = shutil.which("launchctl")
    if found != "/bin/launchctl":
        # A launchctl shim on PATH once drove the live agent-lb from a test (scripts/lb-restart).
        raise Refused(f"launchctl resolves to {found}, not /bin/launchctl")


def labels_for(run_id: str) -> tuple[str, str]:
    check_run_id(run_id)
    label = check_label(f"{LABEL_PREFIX}sbx-{run_id}")
    return label, check_label(f"{label}-aux")


def root_for(run_id: str) -> Path:
    return SANDBOXES / check_run_id(run_id)


# ---------------------------------------------------------------- small helpers


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------- confined file access
# Every read or write under a sandbox root goes through a directory descriptor opened component by
# component with O_NOFOLLOW, so a link planted anywhere below the root (logs/sub -> <root>/data, data ->
# the live data dir) is refused, never followed. Files must be regular with a single link: a hard link to
# a live file (plist, front-preferred-port, store, key) is refused, never written through.

DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


class Confinement(OSError):
    """A path under the sandbox root is a link, or a file shares its inode with another name."""


def open_root(root: Path) -> int:
    """A descriptor for the sandbox root itself; a root that is a link is refused."""
    parent = os.open(os.path.realpath(root.parent), os.O_RDONLY | os.O_DIRECTORY)
    try:
        return os.open(root.name, DIR_FLAGS, dir_fd=parent)
    finally:
        os.close(parent)


def open_dir(root: Path, rel: str | Path = "", create: bool = False) -> int:
    """A descriptor for directory rel under root, no link followed at any component."""
    fd = open_root(root)
    try:
        for part in Path(rel).parts:
            if part in (".", "..") or "/" in part:
                raise Confinement(f"unsafe path component {part!r}")
            if create:
                try:
                    os.mkdir(part, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
            child = os.open(part, DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def single_link(fd: int, what: object) -> int:
    """fd when it is a regular file with one link; otherwise closes it and raises Confinement."""
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        os.close(fd)
        raise Confinement(f"{what} is not a single-link regular file")
    return fd


def open_in_root(root: Path, rel: str | Path, flags: int, mode: int = 0o600, create_dirs: bool = False) -> int:
    """Open root/rel without following a link; O_TRUNC applies only after the single-link check."""
    rel = Path(rel)
    dir_fd = open_dir(root, rel.parent, create=create_dirs)
    try:
        fd = os.open(rel.name, (flags & ~os.O_TRUNC) | os.O_NOFOLLOW, mode, dir_fd=dir_fd)
    finally:
        os.close(dir_fd)
    single_link(fd, rel)
    if flags & os.O_TRUNC:
        os.ftruncate(fd, 0)
    return fd


def write_in_root(root: Path, rel: str | Path, data: bytes, mode: int = 0o600) -> None:
    """Write root/rel as a new inode (temp file, then rename in the same directory), never through a link."""
    rel = Path(rel)
    dir_fd = open_dir(root, rel.parent, create=True)
    tmp = f".{rel.name}.{os.getpid()}.{uuid.uuid4().hex[:8]}.tmp"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode, dir_fd=dir_fd)
        try:
            os.fchmod(fd, mode)
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view) :]
        finally:
            os.close(fd)
        os.replace(tmp, rel.name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise
    finally:
        os.close(dir_fd)


def append_in_root(root: Path, rel: str | Path):
    """root/rel opened for append (created if missing), refusing a link or a shared inode."""
    fd = open_in_root(root, rel, os.O_WRONLY | os.O_APPEND | os.O_CREAT, create_dirs=True)
    return os.fdopen(fd, "a")


def confined(action):
    """Run action(); a Confinement (a link or shared inode under the root) becomes a refusal."""
    try:
        return action()
    except OSError as exc:
        if isinstance(exc, Confinement) or exc.errno in (errno.ELOOP, errno.ENOTDIR):
            raise Refused(f"sandbox path is a link or shared file: {exc}") from None
        raise


def write_json(root: Path, rel: str | Path, data: object, mode: int = 0o600) -> None:
    write_in_root(root, rel, (json.dumps(data, indent=1, sort_keys=True) + "\n").encode(), mode)


def read_json(path: Path) -> dict:
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def http(port: int, path: str, timeout: float = 3.0) -> tuple[int, bytes]:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as exc:
        return exc.code, b""
    except Exception:
        return 0, b""


def port_free(port: int) -> bool:
    with socket.socket() as sock:
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def ports_in_use_by_sandboxes() -> set[int]:
    used: set[int] = set()
    if SANDBOXES.is_dir():
        for meta in SANDBOXES.glob("*/sandbox.json"):
            used.update(int(p) for p in read_json(meta).get("ports", {}).values() if isinstance(p, int))
    return used


def pick_ports(count: int, taken: set[int]) -> list[int]:
    picked: list[int] = []
    for port in PICK_RANGE:
        if port in FORBIDDEN_PORTS or port in taken or port in picked:
            continue
        if port_free(port):
            picked.append(port)
            if len(picked) == count:
                return picked
    raise Unhealthy("no free sandbox ports in 2470-2599")


def run(argv: list[str], timeout: float = 30) -> subprocess.CompletedProcess:
    # Output of these tools carries no credentials (launchctl, lsof, ps); still never relayed raw.
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)


def launchd_pid(label: str) -> int | None:
    out = run(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"]).stdout
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("pid = "):
            try:
                return int(line.split("=", 1)[1])
            except ValueError:
                return None
    return None


def label_loaded(label: str) -> bool:
    return run(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"]).returncode == 0


def listener_pids(port: int) -> list[int]:
    out = run(["/usr/sbin/lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"]).stdout.split()
    return sorted({int(pid) for pid in out if pid.isdigit()})


def listener_addresses(pids: list[int]) -> list[dict]:
    """Every TCP listener of the given pids with its bound address."""
    if not pids:
        return []
    out = run(["/usr/sbin/lsof", "-nP", "-a", "-p", ",".join(map(str, pids)), "-iTCP", "-sTCP:LISTEN"]).stdout
    found = []
    for line in out.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 9:
            found.append({"pid": int(parts[1]), "address": parts[8]})
    return found


def processes() -> list[tuple[int, int, str]]:
    out = run(["/bin/ps", "-axww", "-o", "pid=,ppid=,command="]).stdout
    rows = []
    for line in out.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            rows.append((int(parts[0]), int(parts[1]), parts[2]))
    return rows


def names_root(cmd: str, root: Path) -> bool:
    """True when a command line names this sandbox root itself or a path inside it (never a sibling run)."""
    text = str(root)
    return any(token == text or token.startswith(text + "/") for token in cmd.split())


def names_run(cmd: str, run_id: str) -> bool:
    return re.search(rf"(?<![a-z0-9-]){re.escape(run_id)}(?![a-z0-9-])", cmd) is not None


def own_lineage(rows: list[tuple[int, int, str]]) -> set[int]:
    parents = {pid: ppid for pid, ppid, _ in rows}
    lineage, pid = set(), os.getpid()
    while pid and pid not in lineage:
        lineage.add(pid)
        pid = parents.get(pid, 0)
    return lineage


def pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def emit(data: dict, code: int) -> int:
    print(json.dumps(data, indent=1, sort_keys=True), flush=True)
    return code


def load_meta(run_id: str) -> tuple[Path, dict]:
    root = root_for(run_id)
    meta = read_json(root / "sandbox.json")
    if not meta:
        raise Unhealthy(f"no sandbox {run_id} (missing {root / 'sandbox.json'})")
    return root, meta


# ---------------------------------------------------------------- secrets (agent-lb custody only)


def live_federation_token(plist: Path | None = None) -> str | None:
    """The live federation token, read into this process only. Never printed, written or passed in argv."""
    with (plist or LIVE_PLIST).open("rb") as fh:
        env = plistlib.load(fh).get("EnvironmentVariables", {})
    value = env.get(TOKEN_ENV)
    return str(value) if value else None


def _fernet(root: Path):
    from cryptography.fernet import Fernet

    key = read_key(root)
    if not key:
        raise Refused("sandbox store key missing")
    return Fernet(key.encode())


def check_data_custody(root: Path) -> None:
    """Refuse a data dir that is a link, or a store, journal or key that is a link or shares its inode.

    A hard link from the sandbox's data/ to the live store or key would let the sandbox open, migrate or
    unlink live custody files; a single link proves the file is the sandbox's own.
    """
    try:
        data_fd = open_dir(root, "data")
    except FileNotFoundError:
        return
    except OSError as exc:
        raise Refused(f"sandbox data dir is not a real directory under the root ({exc.__class__.__name__})") from None
    try:
        for name in [Path(rel).name for rel in CUSTODY_FILES] + ["federation-push.json"]:
            try:
                info = os.stat(name, dir_fd=data_fd, follow_symlinks=False)
            except FileNotFoundError:
                continue
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid():
                raise Refused(f"sandbox data/{name} is not a private single-link file")
        try:
            info = os.stat("conversation-archive", dir_fd=data_fd, follow_symlinks=False)
            if not stat.S_ISDIR(info.st_mode):
                raise Refused("sandbox data/conversation-archive is not a real directory")
        except FileNotFoundError:
            pass
    finally:
        os.close(data_fd)


def read_accounts(root: Path, *, with_tokens: bool = False, strict: bool = False) -> list[dict]:
    """Mirrored accounts from the sandbox store. Tokens stay in this process; callers get auth_hash12.

    strict (scan and stop): any store or decryption error raises, so a scan never runs with secrets missing.
    """
    db = root / "data" / "store.db"
    try:
        check_data_custody(root)
    except Refused:
        if strict:
            raise
        return []
    if not db.is_file() or db.is_symlink():
        if strict:
            raise Refused("sandbox store missing; its account tokens cannot be scanned for")
        return []
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=5)
    try:
        rows = con.execute(
            "SELECT id, provider, status, access_expires_at, access_token_encrypted, id_token_encrypted,"
            " reset_at, blocked_at, refresh_token_encrypted FROM accounts"
        ).fetchall()
    except sqlite3.OperationalError as exc:
        if "no such table" in str(exc):
            return []  # the store exists but the app has not migrated it: no token was ever written
        if strict:
            raise
        return []
    except sqlite3.Error:
        if strict:
            raise
        return []
    finally:
        con.close()
    fernet = _fernet(root) if rows else None
    now = time.time()
    accounts = []

    def decrypt(blob) -> str:
        try:
            return fernet.decrypt(bytes(blob)).decode() if fernet and blob else ""
        except Exception:
            if strict:
                raise
            return ""  # status reports a row this key cannot open without a hash

    for account_id, provider, status, expires_at, access_enc, id_enc, reset_at, blocked_at, refresh_enc in rows:
        token = decrypt(access_enc)
        expires_in = None
        if expires_at:
            try:
                stamp = dt.datetime.fromisoformat(str(expires_at)).replace(tzinfo=dt.timezone.utc)
                expires_in = int(stamp.timestamp() - now)
            except ValueError:
                expires_in = None
        cooling = status in ("rate_limited", "quota_exceeded") or bool(
            blocked_at and reset_at and float(reset_at) > now
        )
        entry = {
            "id": account_id,
            "vendor": VENDOR_OF_PROVIDER.get(str(provider), str(provider)),
            "status": status,
            "expires_in_s": expires_in,
            "auth_hash12": hashlib.sha256(f"Bearer {token}".encode()).hexdigest()[:12] if token else None,
            "in_cooldown": cooling,
            "cooldown_until": int(reset_at) if cooling and reset_at else None,
            "usable": status == "active" and expires_in is not None and expires_in > USABLE_EXPIRY_S,
        }
        if with_tokens:
            entry["_secrets"] = [secret for secret in (token, decrypt(id_enc), decrypt(refresh_enc)) if secret]
            # The stored ciphertexts too: a copy of the store (or a page of it) in an output dir is a leak.
            entry["_ciphertexts"] = [
                bytes(blob).decode("ascii", "replace") for blob in (access_enc, id_enc, refresh_enc) if blob
            ]
        accounts.append(entry)
    return sorted(accounts, key=lambda a: (a["vendor"], a["id"]))


def read_key(root: Path) -> str | None:
    """The sandbox store key, read without following a link at any component (None when never keyed).

    A key that is a link, sits in a linked data dir or shares its inode raises Confinement.
    """
    try:
        fd = open_in_root(root, "data/encryption.key", os.O_RDONLY)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, "rb") as fh:
        return fh.read().strip().decode("ascii", "replace") or None


def create_key(path: Path) -> None:
    """A fresh store key, 0600, created exclusively: never reuses or follows a file someone placed there."""
    from cryptography.fernet import Fernet

    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as fh:
        fh.write(Fernet.generate_key())


def load_secrets(root: Path | None) -> list[str]:
    """What no scanned file may hold: the live token, mirrored tokens, the store key and stored ciphertexts."""
    secrets = []
    token = live_federation_token()
    if not token:
        raise Refused("live federation token not found; a scan without it would be incomplete")
    secrets.append(token)
    if root is not None and root.is_dir():
        for account in read_accounts(root, with_tokens=True, strict=True):
            secrets.extend(s for s in account.pop("_secrets") if s)
            secrets.extend(s for s in account.pop("_ciphertexts") if s)
        key = load_key(root)
        if key:
            secrets.append(key)
    return secrets


def load_key(root: Path | None) -> str | None:
    """The store key for the ciphertext detector; a redirected key is a refusal, never a quiet skip."""
    if root is None or not root.is_dir():
        return None
    try:
        return read_key(root)
    except OSError as exc:
        raise Refused(f"sandbox store key is redirected or shared ({exc.__class__.__name__})") from None


def custody_paths(root: Path) -> list[Path]:
    """The exact files allowed to hold custody material; a copy anywhere else (a hard link included) is a hit."""
    return [root / rel for rel in CUSTODY_FILES]


def secret_patterns(secret: str) -> list[bytes]:
    """The secret raw and as it appears inside standard or URL-safe base64 at any byte alignment."""
    raw = secret.encode()
    patterns = {raw}
    for encode in (base64.b64encode, base64.urlsafe_b64encode):
        for shift, skip in ((0, 0), (1, 2), (2, 3)):
            encoded = encode(b"\0" * shift + raw).rstrip(b"=")
            # Keep only characters made entirely of secret bits.
            whole = ((shift + len(raw)) * 8) // 6
            # Kept at any length: a short secret's fragment may match by chance (a false alarm), never miss.
            if encoded[skip:whole]:
                patterns.add(encoded[skip:whole])
    return sorted(p for p in patterns if p)


# A Fernet token is url-safe base64 of 0x80 | timestamp(8) | IV(16) | AES-CBC blocks | HMAC(32). Its first
# 56 characters decode to 42 bytes: version, timestamp, IV and the first ciphertext block.
FERNET_FRAGMENT = re.compile(rb"(?=(gAAAAA[A-Za-z0-9_-]{50}))")
FERNET_FRAGMENT_CHARS = 56


def plausible_plaintext(block: bytes) -> bool:
    """True for a first block a token encrypts to: printable ASCII, or printable ASCII then PKCS7 padding.

    A wrong key gives 16 random bytes, printable by chance about once in 10^7 tries.
    """
    pad = block[-1]
    body = block[:-pad] if 1 <= pad <= 16 and block.endswith(bytes([pad]) * pad) else block
    return bool(body) and all(0x20 <= b < 0x7F for b in body)


class Detector:
    """What a scanned byte range may not hold.

    The secrets raw and inside base64 (secret_patterns), and, given the sandbox store key, any ciphertext
    that key opens: a Fernet token (even a fragment, such as one split across SQLite overflow pages) whose
    first block decrypts to token text. That catches a copy of the store taken before a mirror cycle
    re-encrypted every row, which matches no current ciphertext.
    """

    def __init__(self, secrets: list[str], keys: list[str] | None = None) -> None:
        self.patterns = sorted({p for s in secrets if s for p in secret_patterns(s)})
        self.decryptors = []
        for key in keys or []:
            if not key:
                continue
            from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

            raw = base64.urlsafe_b64decode(key.encode() if isinstance(key, str) else key)
            self.decryptors.append(Cipher(algorithms.AES(raw[16:]), modes.ECB()).decryptor())
        lengths = [len(p) for p in self.patterns] + ([FERNET_FRAGMENT_CHARS] if self.decryptors else [])
        self.overlap = max(lengths, default=1) - 1

    def __bool__(self) -> bool:
        return bool(self.patterns)

    def opens(self, fragment: bytes) -> bool:
        raw = base64.urlsafe_b64decode(fragment[:FERNET_FRAGMENT_CHARS])
        iv, first = raw[9:25], raw[25:41]
        return any(
            plausible_plaintext(bytes(a ^ b for a, b in zip(dec.update(first), iv, strict=True)))
            for dec in self.decryptors
        )

    def hit(self, buf: bytes) -> bool:
        if any(p in buf for p in self.patterns):
            return True
        if self.decryptors and b"gAAAAA" in buf:
            return any(self.opens(m.group(1)) for m in FERNET_FRAGMENT.finditer(buf))
        return False


def iter_files(
    paths: list[Path],
    newer_than: float | None,
    exclude: list[Path],
    unreadable: list[str],
    skip_exact: list[Path] | None = None,
):
    """Regular files under paths (symlinks never followed), modified after newer_than, outside exclude.

    skip_exact names single files to pass over, by exact path only: a hard link elsewhere is still read.

    A directory or file that exists but cannot be read is appended to unreadable; one that vanished
    while the walk ran is not (it holds nothing any more).
    """
    excluded = {os.path.realpath(e) for e in exclude}
    skipped = {os.path.join(os.path.realpath(p.parent), p.name) for p in (skip_exact or [])}

    def is_excluded(path: str) -> bool:
        return any(path == e or path.startswith(e + os.sep) for e in excluded)

    for top in paths:
        top = os.path.realpath(top)
        if is_excluded(top):
            continue
        try:
            info = os.stat(top)
        except FileNotFoundError:
            continue
        except OSError:  # isfile/isdir would hide a permission error as "not there"
            unreadable.append(top)
            continue
        if stat.S_ISREG(info.st_mode):
            if newer_than is None or info.st_mtime > newer_than:
                yield Path(top)
            continue
        stack = [top] if stat.S_ISDIR(info.st_mode) else []
        while stack:
            directory = stack.pop()
            try:
                entries = os.scandir(directory)
            except FileNotFoundError:
                continue
            except OSError:
                unreadable.append(directory)
                continue
            with entries:
                for entry in entries:
                    try:
                        if entry.is_symlink():
                            continue
                        if entry.is_dir(follow_symlinks=False):
                            if not is_excluded(entry.path):
                                stack.append(entry.path)
                        elif entry.path in skipped:
                            continue
                        elif entry.is_file(follow_symlinks=False) and (
                            newer_than is None or entry.stat(follow_symlinks=False).st_mtime > newer_than
                        ):
                            yield Path(entry.path)
                    except FileNotFoundError:
                        continue
                    except OSError:
                        unreadable.append(entry.path)


def scan_stream(read, detector: Detector, write=None, chunk: int = 4 << 20) -> tuple[bool, int]:
    """Feed read(n) blocks through the detector (and to write, when given). Returns (hit, bytes read)."""
    tail, total = b"", 0
    while True:
        block = read(chunk)
        if not block:
            return False, total
        total += len(block)
        buf = tail + block
        if detector.hit(buf):
            return True, total
        if write is not None:
            write(block)
        tail = buf[-detector.overlap :] if detector.overlap > 0 else b""


def scan_file(path: Path, detector: Detector, chunk: int = 4 << 20) -> bool:
    # O_NOFOLLOW: a file swapped for a symlink after the walk is refused, never followed.
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW), "rb") as fh:
        return scan_stream(fh.read, detector, chunk=chunk)[0]


def scan_paths(
    paths: list[Path],
    secrets: list[str],
    newer_than: float | None = None,
    exclude: list[Path] | None = None,
    skip_exact: list[Path] | None = None,
    keys: list[str] | None = None,
) -> dict:
    """complete is False when no secret was loaded or anything that exists could not be read.

    keys: store keys whose ciphertexts are a hit too (Detector).
    """
    detector = Detector(secrets, keys)
    hits: list[str] = []
    unreadable: list[str] = []
    files: list[str] = []
    total = 0
    if detector:
        for path in iter_files(paths, newer_than, exclude or [], unreadable, skip_exact):
            try:
                found = scan_file(path, detector)
                total += path.stat().st_size
            except FileNotFoundError:
                continue
            except OSError:
                unreadable.append(str(path))
                continue
            files.append(str(path))
            if found:
                hits.append(str(path))
    return {
        "found": bool(hits),
        "complete": bool(detector) and not unreadable,
        "files_scanned": len(files),
        "bytes_scanned": total,
        "unreadable": len(unreadable),
        "unreadable_paths": unreadable[:20],
        "hits": hits,
        "secrets_loaded": len(secrets),
        "_files": files,
    }


def ps_command(pid: int, with_env: bool) -> bytes:
    flags = ["-E"] if with_env else []
    return subprocess.run(
        ["/bin/ps", *flags, "-ww", "-o", "command=", "-p", str(pid)], capture_output=True, timeout=30, check=False
    ).stdout.rstrip(b"\n")


def env_shows_root(env_text: bytes, root: Path) -> bool:
    """True when the environment part of `ps -E` holds LB_SANDBOX_ROOT=<root> as a whole entry."""
    marker = re.escape(ENV_MARKER.encode() + str(root).encode())
    return re.search(rb"(?:^|\s)" + marker + rb"(?:\s|$)", env_text) is not None


PROCESS_SETTLE_S = 2.0


def env_part(argv_text: bytes, text: bytes, root: Path) -> bool:
    """True when `ps -E` output, past the argv `ps` printed alone, holds this root's marker entry."""
    return bool(argv_text.strip()) and text.startswith(argv_text) and env_shows_root(text[len(argv_text) :], root)


def scan_processes(root: Path, run_id: str, secrets: list[str]) -> dict:
    """Search the exec environment and argv (`ps -E`, as `ps eww` shows them) of every process of this run.

    Returns pids and counts only. Every process that names the run must show its environment: ps prints
    argv, then the environment, so the part after the argv (`ps` without -E) must hold this root's
    LB_SANDBOX_ROOT entry. A process whose environment ps did not show (visible_pids lacks it) makes the
    scan incomplete, whichever process it is, so no extra child can read clean unseen.
    """
    patterns = sorted({p for s in secrets if s for p in secret_patterns(s)})
    rows = processes()
    lineage = own_lineage(rows)
    pids = sorted(
        pid for pid, _, cmd in rows if (names_root(cmd, root) or names_run(cmd, run_id)) and pid not in lineage
    )
    hits, visible, invisible, unreadable, scanned = [], [], [], [], []
    for pid in pids:
        argv_text = ps_command(pid, with_env=False)
        text = ps_command(pid, with_env=True)
        if not text.strip() or not argv_text.strip():
            if pid_alive(pid):
                unreadable.append(pid)
            continue
        scanned.append(pid)
        if any(p in text for p in patterns):
            hits.append(pid)
        shown = env_part(argv_text, text, root)
        # macOS hides the environment of platform binaries (launchctl, ps): a short-lived one that names the
        # run gets a moment to exit; one that stays is unreadable and the scan is incomplete.
        deadline = time.monotonic() + PROCESS_SETTLE_S
        while not shown and pid_alive(pid) and time.monotonic() < deadline:
            time.sleep(0.1)
            argv_text, text = ps_command(pid, with_env=False), ps_command(pid, with_env=True)
            if any(p in text for p in patterns) and pid not in hits:
                hits.append(pid)
            shown = env_part(argv_text, text, root)
        if shown:
            visible.append(pid)
        elif pid_alive(pid):
            invisible.append(pid)
        elif pid not in hits:
            scanned.remove(pid)  # exited before ps could show its environment: nothing left to hold a secret
    return {
        "found": bool(hits),
        "complete": bool(patterns) and not unreadable and not invisible and bool(scanned),
        "processes_scanned": len(scanned),
        "pids": scanned,
        "visible_pids": visible,
        "invisible_pids": invisible,
        "unreadable_pids": unreadable,
        "hits": hits,
        "secrets_loaded": len(secrets),
    }


class LeakFound(OSError):
    """An exported file held a secret or a ciphertext the store key opens; the copy was removed."""


def custody_inodes(root: Path) -> set[tuple[int, int]]:
    """(device, inode) of the store and key at their own paths, read without following a link."""
    found = set()
    try:
        data_fd = open_dir(root, "data")
    except OSError:
        return found
    try:
        for rel in CUSTODY_FILES:
            try:
                info = os.stat(Path(rel).name, dir_fd=data_fd, follow_symlinks=False)
            except OSError:
                continue
            found.add((info.st_dev, info.st_ino))
    finally:
        os.close(data_fd)
    return found


def export_logs(root: Path, dest: Path, scanned_files: list[str], detector: Detector) -> dict:
    """Copy the regular files under root/logs that the teardown scan read, scanning every byte copied.

    The source is opened from a descriptor for the root, one component at a time with O_NOFOLLOW, so a
    directory swapped for a link after the scan (logs/d -> <root>/data) is refused, never followed. A
    source must be a single-link regular file that is not the store or key. Each block is checked by the
    detector before it is written; on a hit the partial copy is unlinked and LeakFound is raised.
    Returns files and bytes copied.
    """
    if not detector:
        raise OSError("no secret loaded; an unscanned export is refused")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW

    def directory(path: Path) -> int:
        # Destination directories are walked by descriptor too: no links, including link swaps.
        absolute = path.absolute()
        fd = os.open(absolute.anchor, flags)
        try:
            for part in absolute.parts[1:]:
                if part in (".", ".."):
                    raise OSError("unsafe export directory")
                try:
                    os.mkdir(part, mode=0o700, dir_fd=fd)
                except FileExistsError:
                    pass
                child = os.open(part, flags, dir_fd=fd)
                os.close(fd)
                fd = child
            return fd
        except BaseException:
            os.close(fd)
            raise

    custody = custody_inodes(root)
    copied, total = 0, 0
    base = (root / "logs").resolve()
    dest_fd = directory(dest)
    try:
        for name in scanned_files:
            try:
                rel = Path(name).relative_to(base)
            except ValueError:
                continue
            if not rel.parts or any(part in (".", "..") for part in rel.parts):
                raise OSError("unsafe export filename")
            src_dir = open_dir(root, Path("logs", *rel.parts[:-1]))
            try:
                src_fd = os.open(rel.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=src_dir)
            finally:
                os.close(src_dir)
            with os.fdopen(single_link(src_fd, f"log {rel}"), "rb") as src:
                info = os.fstat(src.fileno())
                if (info.st_dev, info.st_ino) in custody:
                    raise Confinement(f"log {rel} is the sandbox store or key")
                parent_fd = os.dup(dest_fd)
                try:
                    for part in rel.parts[:-1]:
                        try:
                            os.mkdir(part, mode=0o700, dir_fd=parent_fd)
                        except FileExistsError:
                            pass
                        child = os.open(part, flags, dir_fd=parent_fd)
                        os.close(parent_fd)
                        parent_fd = child
                    # Existing files may be hard links to live files: never truncate.
                    target_fd = os.open(
                        rel.name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent_fd
                    )
                    with os.fdopen(target_fd, "wb") as out:
                        leaked, size = scan_stream(src.read, detector, write=out.write)
                    if leaked:
                        os.unlink(rel.name, dir_fd=parent_fd)
                        raise LeakFound(f"log {rel} holds a secret; its copy was removed")
                finally:
                    os.close(parent_fd)
            copied += 1
            total += size
    finally:
        os.close(dest_fd)
    return {"files": copied, "bytes": total}


# ---------------------------------------------------------------- start


def sandbox_env(root: Path, ports: dict[str, int], run_id: str, transport: str) -> dict[str, str]:
    """The sandbox primary's environment. No secrets: _serve adds the federation token at exec time."""
    env = {
        "HOME": str(root / "home"),
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
        "PYTHONPATH": str(root / "runtime"),
        "LB_SANDBOX_ROOT": str(root),
        "AGENT_LB_DATA_DIR": str(root / "data"),
        "AGENT_LB_DATABASE_URL": f"sqlite+aiosqlite:///{root / 'data' / 'store.db'}",
        "AGENT_LB_DATABASE_SQLITE_PRE_MIGRATE_BACKUP_ENABLED": "false",
        "AGENT_LB_ENCRYPTION_KEY_FILE": str(root / "data" / "encryption.key"),
        "AGENT_LB_LOCAL_INSTANCE_ID": f"sbx-{run_id}",
        "AGENT_LB_FEDERATION_PEER_URL": f"http://127.0.0.1:{ports['gate']}",
        "AGENT_LB_FEDERATION_MIRROR_INTERVAL_SECONDS": "5",
        "AGENT_LB_FEDERATION_FORWARD_REQUEST_LOGS": "false",
        "AGENT_LB_FEDERATION_PUSH_PATH": str(root / "data" / "federation-push.json"),
        "AGENT_LB_UPSTREAM_BASE_URL": f"http://127.0.0.1:{ports['edge_openai']}",
        "AGENT_LB_ANTHROPIC_UPSTREAM_BASE_URL": f"http://127.0.0.1:{ports['edge_anthropic']}",
        "AGENT_LB_UPSTREAM_STREAM_TRANSPORT": transport,
        # Dashboard APIs (account export among them) answer 401 to everyone: trusted_header mode, no
        # password, and the only trusted proxy is TEST-NET-1 (192.0.2.1, RFC 5737), which no peer can be.
        # "disabled" would hand decrypted tokens to any local caller.
        "AGENT_LB_DASHBOARD_AUTH_MODE": "trusted_header",
        "AGENT_LB_FIREWALL_TRUST_PROXY_HEADERS": "true",
        "AGENT_LB_FIREWALL_TRUSTED_PROXY_CIDRS": "192.0.2.1/32",
        # uvicorn trusts loopback X-Forwarded-For by default, which would let a local caller claim to be
        # 192.0.2.1; with no forwarded-allow hosts the socket peer is always the client address.
        "FORWARDED_ALLOW_IPS": "",
        "AGENT_LB_PROXY_UNAUTHENTICATED_CLIENT_CIDRS": "127.0.0.1/32",
        "AGENT_LB_CONVERSATION_ARCHIVE_DIR": str(root / "data" / "conversation-archive"),
        "UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN": str(DRAIN_S),
    }
    for name in DISABLED_SCHEDULERS:
        env[f"AGENT_LB_{name}_ENABLED"] = "false"
    return env


def write_plists(root: Path, run_id: str, ports: dict[str, int], transport: str) -> tuple[Path, Path]:
    label, aux_label = labels_for(run_id)
    python = str(root / "runtime" / ".venv" / "bin" / "python")
    script = str(root / "bin" / "lb-sandbox")
    primary = {
        "Label": label,
        "ProgramArguments": [
            python,
            script,
            "_serve",
            str(root),
            "--host",
            "127.0.0.1",
            "--port",
            str(ports["primary"]),
        ],
        "WorkingDirectory": str(root / "runtime"),
        "EnvironmentVariables": sandbox_env(root, ports, run_id, transport),
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 2,
        "ExitTimeOut": DRAIN_S + 30,
        "StandardOutPath": str(root / "logs" / "primary.log"),
        "StandardErrorPath": str(root / "logs" / "primary.log"),
    }
    aux = {
        "Label": aux_label,
        "ProgramArguments": [python, script, "_aux", str(root)],
        "WorkingDirectory": str(root),
        "EnvironmentVariables": {
            "HOME": str(root / "home"),
            "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
            "LB_SANDBOX_ROOT": str(root),
        },
        "RunAtLoad": True,
        "KeepAlive": False,
        "ExitTimeOut": 20,
        "StandardOutPath": str(root / "logs" / "aux.log"),
        "StandardErrorPath": str(root / "logs" / "aux.log"),
    }
    paths = (root / "launchd" / f"{label}.plist", root / "launchd" / f"{aux_label}.plist")
    for path, body in zip(paths, (primary, aux), strict=True):
        write_in_root(root, path.relative_to(root), plistlib.dumps(body))
    return paths


def find_node() -> str:
    for candidate in (
        run(["volta", "which", "node"]).stdout.strip() if shutil.which("volta") else "",
        shutil.which("node") or "",
        "/opt/homebrew/bin/node",
    ):
        if candidate and Path(candidate).is_file() and os.access(candidate, os.X_OK):
            return str(Path(candidate).resolve())
    raise Unhealthy("node not found for the sandbox front")


def live_identity() -> dict:
    preferred = read_json(LIVE_FRONT_STATE).get("preferred")
    return {
        "primary_pid": launchd_pid(LIVE_LABEL),
        "front_pid": launchd_pid(LIVE_FRONT_LABEL),
        "front_port": LIVE_FRONT_PORT,
        "front_listener_pids": listener_pids(LIVE_FRONT_PORT),
        "primary_listener_pids": listener_pids(LIVE_PRIMARY_PORT),
        "preferred_port": preferred,
    }


def bootstrap(plist: Path, label: str, deadline_s: float = 20) -> None:
    check_label(label)
    domain = f"gui/{os.getuid()}"
    deadline = time.monotonic() + deadline_s
    while time.monotonic() < deadline:
        if run(["/bin/launchctl", "bootstrap", domain, str(plist)]).returncode == 0 or label_loaded(label):
            return
        time.sleep(0.5)
    raise Unhealthy(f"launchctl bootstrap {label} failed")


def label_names_root(label: str, root: Path) -> bool:
    """True when the loaded job's program or arguments name this sandbox root."""
    out = run(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"]).stdout
    return any(names_root(line.strip(), root) for line in out.splitlines())


def bootout(label: str, deadline_s: float = 30) -> bool:
    check_label(label)
    target = f"gui/{os.getuid()}/{label}"
    run(["/bin/launchctl", "bootout", target], timeout=deadline_s + 10)
    deadline = time.monotonic() + deadline_s
    while label_loaded(label):
        if time.monotonic() > deadline:
            return False
        time.sleep(0.5)
    return True


def usable_counts(accounts: list[dict]) -> dict[str, int]:
    counts = {"anthropic": 0, "openai": 0}
    for account in accounts:
        if account["usable"] and account["vendor"] in counts:
            counts[account["vendor"]] += 1
    return counts


def log_failure_classes(root: Path) -> dict:
    """Exception class names and app frames from the primary log; never message text."""
    log = root / "logs" / "primary.log"
    if not log.is_file():
        return {}
    text = log.read_text(errors="replace")[-200_000:]
    return {
        "exception_classes": sorted(set(re.findall(r"^([A-Za-z0-9_.]+(?:Error|Exception)):", text, re.MULTILINE))),
        "frames": re.findall(r'File "[^\n"]*/(app/[^\n"]+)", line ([0-9]+), in ([A-Za-z0-9_]+)', text)[-8:],
    }


def cmd_start(args) -> int:
    run_id = check_run_id(args.run_id)
    if not args.from_live:
        raise Refused("start needs --from-live (the only supported account source)")
    if args.transport != "http":
        raise Refused("only --transport http is supported (the edge must see and cut streams)")
    check_launchctl()
    root = root_for(run_id)
    if root.exists():
        raise Refused(f"sandbox root {root} already exists")
    label, aux_label = labels_for(run_id)
    if label_loaded(label) or label_loaded(aux_label):
        raise Refused(f"label {label} is already loaded")
    if not LIVE_PLIST.is_file() or not (LIVE_RUNTIME / "app").is_dir() or not (LIVE_VENV / "bin" / "python").exists():
        raise Unhealthy("live runtime, venv or plist missing")
    taken = ports_in_use_by_sandboxes()
    if args.port is not None:
        check_ports([args.port])
        if args.port in taken or not port_free(args.port):
            raise Refused(f"--port {args.port} is in use")
        taken.add(args.port)
    picked = pick_ports(6 if args.port is None else 5, taken)
    front = args.port if args.port is not None else picked.pop(0)
    names = ("primary", "standby", "gate", "edge_anthropic", "edge_openai")
    ports = {"front": front, **dict(zip(names, picked, strict=True))}
    check_ports(list(ports.values()))
    started = time.monotonic()
    out: dict = {"run_id": run_id, "root": str(root), "label": label, "aux_label": aux_label}

    stopping: list[int] = []

    def interrupted(signum, frame):
        if not stopping:
            stopping.append(signum)
            raise Unhealthy(f"interrupted by signal {signum}")

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, interrupted)
    created = False
    try:
        SANDBOXES.mkdir(mode=0o700, parents=True, exist_ok=True)
        if SANDBOXES.is_symlink() or not SANDBOXES.is_dir():
            raise Refused(f"{SANDBOXES} is not a real directory")
        os.chmod(SANDBOXES, 0o700)  # agent-lb's own directory; no other user may list sandbox roots
        try:
            root.mkdir(mode=0o700)
        except FileExistsError:
            # A concurrent start with the same run id won the race; its root is not ours to tear down.
            raise Refused(f"sandbox root {root} already exists") from None
        created = True
        os.chmod(root, 0o700)  # mkdir's mode is masked by umask; set it exactly
        for sub in ("data", "home", "logs", "state", "bin", "clients"):
            (root / sub).mkdir(mode=0o700)
        create_key(root / "data" / "encryption.key")
        meta = {
            "run_id": run_id,
            "label": label,
            "aux_label": aux_label,
            "ports": ports,
            "caller_pid": os.getppid(),
            "created_at": now_iso(),
            "created_epoch": time.time(),
            "transport": args.transport,
            "node": find_node(),
        }
        write_json(root, "sandbox.json", meta)
        runtime = root / "runtime"
        runtime.mkdir()
        for part in ("app", "config", "scripts"):
            if (LIVE_RUNTIME / part).is_dir():
                shutil.copytree(
                    LIVE_RUNTIME / part, runtime / part, ignore=shutil.ignore_patterns("__pycache__", "*.pyc")
                )
        (runtime / ".venv").symlink_to(LIVE_VENV)
        shutil.copy2(Path(__file__).resolve(), root / "bin" / "lb-sandbox")
        managed = root / "home" / ".agent-lb" / "managed" / "coding-agents"
        for name in ("routing-table.json", "decider.json"):
            if (MANAGED_ROUTING / name).is_file():
                managed.mkdir(parents=True, exist_ok=True)
                shutil.copy2(MANAGED_ROUTING / name, managed / name)
        primary_plist, aux_plist = write_plists(root, run_id, ports, args.transport)
        write_json(
            root,
            "lb-restart.json",
            {
                "root": str(root),
                "label": label,
                "plist": str(primary_plist),
                "runtime": str(runtime),
                "state_dir": str(root / "state"),
                "front_port": ports["front"],
                "primary_port": ports["primary"],
                "standby_port": ports["standby"],
            },
        )
        write_in_root(root, "state/front-preferred-port", f"{ports['primary']}\n".encode(), 0o644)
        out["live"] = live_identity()

        bootstrap(aux_plist, aux_label)
        deadline = time.monotonic() + 30
        while not read_json(root / "state" / "aux.json").get("ready"):
            if time.monotonic() > deadline:
                raise Unhealthy("aux (gate, edges, front) did not become ready in 30 s")
            time.sleep(0.25)
        bootstrap(primary_plist, label)
        deadline = time.monotonic() + 90
        while not (
            http(ports["primary"], "/health/ready")[0] == 200 and http(ports["front"], "/health/ready")[0] == 200
        ):
            if time.monotonic() > deadline:
                raise Unhealthy("sandbox primary or front not healthy in 90 s")
            time.sleep(0.5)
        out["boot_s"] = round(time.monotonic() - started, 1)
        deadline = time.monotonic() + 120
        while True:
            counts = usable_counts(read_accounts(root))
            if all(n >= args.min_accounts for n in counts.values()):
                break
            if time.monotonic() > deadline:
                raise Unhealthy(f"mirror gave {counts} usable accounts, need {args.min_accounts} per vendor in 120 s")
            time.sleep(1)
        out.update(
            {
                "front_port": ports["front"],
                "primary_port": ports["primary"],
                "standby_port": ports["standby"],
                "gate_port": ports["gate"],
                "edge_ports": {"anthropic": ports["edge_anthropic"], "openai": ports["edge_openai"]},
                "accounts_per_vendor": counts,
                "ready_s": round(time.monotonic() - started, 1),
            }
        )
        return emit(out, EXIT_OK)
    except Exception as exc:  # any failure tears the sandbox down before exit 3
        if isinstance(exc, Refused) and not created:
            raise
        out["error"] = f"{exc.__class__.__name__}: {exc}"
        if created and root.exists():
            out["failure"] = log_failure_classes(root)
            for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
                signal.signal(sig, signal.SIG_IGN)
            out["teardown"] = teardown(run_id, Path(args.logs_to) if args.logs_to else None)
        return emit(out, EXIT_UNHEALTHY)


# ---------------------------------------------------------------- _serve and _aux (run by launchd)


def serve_exec_args(root: Path, argv: list[str]) -> tuple[str, list[str], dict[str, str], str]:
    """Validate a _serve invocation; build (executable, argv, env) for the boot and return the token apart.

    The env and argv never carry the token: _serve hands it over through a pipe (cmd_serve). Writes nothing.
    """
    root = check_root(root)
    meta = read_json(root / "sandbox.json")
    if not meta:
        raise Refused(f"{root} has no sandbox.json")
    parser = argparse.ArgumentParser(prog="lb-sandbox _serve")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, required=True)
    opts, extra = parser.parse_known_args(argv)
    if extra:
        raise Refused(f"_serve takes only --host and --port, not {' '.join(extra)}")
    if opts.host != "127.0.0.1":
        raise Refused("the sandbox binds 127.0.0.1 only")
    expected_ports = {"front", "primary", "standby", "gate", "edge_anthropic", "edge_openai"}
    if not isinstance(meta.get("ports"), dict) or set(meta["ports"]) != expected_ports:
        raise Refused("sandbox metadata must contain exactly the six listener ports")
    check_ports(list(meta["ports"].values()))
    # Refuse redirected stores before reading any credential or starting SQLite.
    for relative in (
        "data",
        "data/store.db",
        "data/encryption.key",
        "data/federation-push.json",
        "data/conversation-archive",
    ):
        path = root / relative
        if path.is_symlink() or not path.resolve().is_relative_to(root):
            raise Refused(f"sandbox data path {relative} is redirected outside the root")
    # A hard link passes the checks above: the store, its journals and the key must each have one link.
    check_data_custody(root)
    try:
        key_fd = open_in_root(root, "data/encryption.key", os.O_RDONLY)
    except OSError as exc:
        raise Refused(f"sandbox store key is missing or redirected ({exc.__class__.__name__})") from None
    os.close(key_fd)
    allowed = {meta["ports"]["primary"], meta["ports"]["standby"]}
    check_ports([opts.port])
    if opts.port not in allowed:
        raise Refused(f"port {opts.port} is not this sandbox's primary or standby port")
    if os.environ.get("LB_SANDBOX_ROOT") != str(root):
        raise Refused("LB_SANDBOX_ROOT does not match the sandbox root")
    # The app sees only the environment rebuilt from sandbox.json: nothing inherited (a live database URL,
    # peer URL or key file in the caller's env) can reach it.
    env = sandbox_env(root, meta["ports"], root.name, meta.get("transport", "http"))
    env.update({k: os.environ[k] for k in ("USER", "LOGNAME", "TMPDIR", "LANG") if k in os.environ})
    token = live_federation_token()
    if not token:
        raise Unhealthy("live plist has no federation token")
    python = str(root / "runtime" / ".venv" / "bin" / "python")
    # --port last and literal: lb-restart recognises its standby by "--port <standby>" in the command line.
    args = [
        python,
        str(root / "bin" / "lb-sandbox"),
        "_boot",
        str(root),
        "--host",
        "127.0.0.1",
        "--port",
        str(opts.port),
    ]
    return python, args, env, token


def token_pipe(token: str) -> int:
    """A pipe holding the token and closed for writing; returns the inheritable read end."""
    read_fd, write_fd = os.pipe()
    try:
        data = token.encode()
        while data:  # a token is far under the pipe buffer, so this never blocks
            data = data[os.write(write_fd, data) :]
    finally:
        os.close(write_fd)
    os.set_inheritable(read_fd, True)
    return read_fd


def cmd_serve(root: str, argv: list[str]) -> int:
    root_path = check_root(Path(root))
    python, args, env, token = serve_exec_args(root_path, argv)
    read_fd = token_pipe(token)
    del token
    os.chdir(root_path / "runtime")
    os.execve(python, [*args[:4], "--token-fd", str(read_fd), *args[4:]], env)
    return EXIT_UNHEALTHY  # not reached


def read_token_fd(fd: int) -> str:
    """Read the token from the inherited pipe and close it. Refuses anything but a pipe."""
    try:
        if not stat.S_ISFIFO(os.fstat(fd).st_mode):
            raise Refused(f"--token-fd {fd} is not a pipe")
        chunks = []
        while chunk := os.read(fd, 65536):
            chunks.append(chunk)
    finally:
        os.close(fd)
    token = b"".join(chunks).decode().strip()
    if not token:
        raise Unhealthy("the token pipe was empty")
    return token


def boot_app(root: Path, argv: list[str]) -> None:
    """_boot: take the token from the pipe, load the app settings with it, drop it from the env, run the app.

    The token is set in os.environ only after exec, so `ps eww` (the exec-time environment) never shows it,
    and it is removed again once the settings hold it, so no child the app spawns inherits it. Same process,
    no second exec.
    """
    # _serve confined the root and its data paths before it read the token; _boot runs only the copy of
    # lb-sandbox inside that root, so the sandboxes directory is the one this file sits in.
    here = Path(__file__).resolve()
    if here != (Path(root) / "bin" / "lb-sandbox").resolve():
        raise Refused("_boot runs only the lb-sandbox copy inside its own root")
    root = check_root(root, sandboxes=here.parent.parent.parent)
    parser = argparse.ArgumentParser(prog="lb-sandbox _boot")
    parser.add_argument("--token-fd", type=int, required=True)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, required=True)
    opts = parser.parse_args(argv)
    if TOKEN_ENV in os.environ:
        raise Refused("the federation token is in the exec environment; refusing to start")
    if os.environ.get("LB_SANDBOX_ROOT") != str(root):
        raise Refused("LB_SANDBOX_ROOT does not match the sandbox root")
    meta = read_json(root / "sandbox.json")
    if opts.host != "127.0.0.1" or opts.port not in {meta.get("ports", {}).get(k) for k in ("primary", "standby")}:
        raise Refused("_boot serves only this sandbox's primary or standby port on 127.0.0.1")
    check_ports([opts.port])
    token = read_token_fd(opts.token_fd)
    if str(root / "runtime") not in sys.path:
        sys.path.insert(0, str(root / "runtime"))
    os.environ["PORT"] = str(opts.port)  # what app.cli sets before its settings load; their defaults read it
    os.environ[TOKEN_ENV] = token
    try:
        from app.core.config.settings import get_settings

        loaded = get_settings().federation_token == token  # cached for the life of the process
    finally:
        os.environ.pop(TOKEN_ENV, None)
        del token
    if not loaded:
        raise Unhealthy("the app settings did not take the federation token")
    from app.cli import main as run_app

    run_app(["--host", opts.host, "--port", str(opts.port)])


def rate_limit_response(edge: str) -> tuple[int, dict[str, str], bytes]:
    reset = int(time.time()) + 600
    if edge == "anthropic":
        body = {"type": "error", "error": {"type": "rate_limit_error", "message": "lb-sandbox injected account_429"}}
        headers = {
            "retry-after": "600",
            "anthropic-ratelimit-unified-status": "rejected",
            "anthropic-ratelimit-unified-reset": str(reset),
            "request-id": f"req_lbsandbox_{uuid.uuid4().hex[:16]}",
        }
    else:
        body = {
            "error": {
                "type": "rate_limit_exceeded",
                "code": "rate_limit_exceeded",
                "message": "lb-sandbox injected account_429",
                "resets_in_seconds": 600,
                "resets_at": reset,
            }
        }
        headers = {"retry-after": "600"}
    headers["content-type"] = "application/json"
    return 429, headers, json.dumps(body).encode()


HOP_BY_HOP = frozenset(
    {
        "connection",
        "keep-alive",
        "proxy-authenticate",
        "proxy-authorization",
        "proxy-connection",
        "te",
        "trailer",
        "trailers",
        "transfer-encoding",
        "upgrade",
        "host",
        "content-length",
    }
)


def auth_hash12(headers) -> str:
    value = headers.get("Authorization") or headers.get("x-api-key") or ""
    return hashlib.sha256(value.encode()).hexdigest()[:12] if value else ""


class FaultState:
    """One edge's armed fault, re-read from <root>/state/fault-<edge>.json on every request."""

    def __init__(self, path: Path) -> None:
        self.path = path
        self.mtime = None
        self.nonce = None
        self.fault: str | None = None
        self.n: int | None = None
        self.failed: set[str] = set()
        self.consumed = False

    def refresh(self) -> None:
        try:
            mtime = self.path.stat().st_mtime_ns
        except OSError:
            mtime = None
        if mtime == self.mtime:
            return
        self.mtime = mtime
        data = read_json(self.path) if mtime is not None else {}
        if data.get("nonce") != self.nonce:
            self.nonce = data.get("nonce")
            self.fault = data.get("fault") if data.get("armed") else None
            self.n = data.get("n")
            self.failed = set()
            self.consumed = False

    def take_429(self, auth_hash: str) -> bool:
        """account_429: the first request after arming fails its hash; that hash keeps failing until cleared."""
        if self.fault != "account_429":
            return False
        if not self.failed:
            self.failed.add(auth_hash)
            return True
        return auth_hash in self.failed

    def take_cut(self) -> int | None:
        if self.fault != "cut_after_bytes" or self.consumed or not isinstance(self.n, int):
            return None
        self.consumed = True
        return self.n

    def take_hold(self) -> tuple[int, object] | None:
        """hold_stream:S: the next streamed request gets a held stream; returns (bound, the arming nonce)."""
        if self.fault != "hold_stream" or self.consumed or not isinstance(self.n, int):
            return None
        self.consumed = True
        return min(self.n, HOLD_MAX_S), self.nonce

    def released(self, nonce: object) -> bool:
        """True once the fault that armed a hold was cleared or replaced (a new nonce)."""
        self.refresh()
        return self.nonce != nonce


def sse(event: str, data: dict) -> bytes:
    return f"event: {event}\ndata: {json.dumps(data)}\n\n".encode()


async def serve_held_stream(request, fault: FaultState, bound: int, nonce, model: str) -> tuple[object, dict]:
    """A provider-shaped Anthropic stream served by the edge itself (no upstream call, no spend).

    It sends the opening events and a first delta, then holds the response open until the fault that armed
    it is cleared (the check's "cutover done" signal) or the bound passes, then finishes the message.
    Returns the response and the log fields: released_by "clear" or "timeout", held_s.
    """
    import asyncio

    from aiohttp import web

    response = web.StreamResponse(
        status=200,
        headers={
            "content-type": "text/event-stream",
            "cache-control": "no-cache",
            "request-id": f"req_lbsandbox_{uuid.uuid4().hex[:16]}",
        },
    )
    await response.prepare(request)
    message = {
        "id": f"msg_lbsandbox_{uuid.uuid4().hex[:16]}",
        "type": "message",
        "role": "assistant",
        "model": model,
        "content": [],
        "stop_reason": None,
        "stop_sequence": None,
        "usage": {"input_tokens": 1, "output_tokens": 1},
    }
    sent = 0
    for chunk in (
        sse("message_start", {"type": "message_start", "message": message}),
        sse(
            "content_block_start",
            {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}},
        ),
        sse(
            "content_block_delta",
            {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "1, 2, 3"}},
        ),
    ):
        await response.write(chunk)
        sent += len(chunk)
    started = time.monotonic()
    released_by, last_ping = "timeout", started
    while time.monotonic() - started < bound:
        if fault.released(nonce):
            released_by = "clear"
            break
        if time.monotonic() - last_ping >= 2:
            ping = sse("ping", {"type": "ping"})
            await response.write(ping)
            sent += len(ping)
            last_ping = time.monotonic()
        await asyncio.sleep(0.1)
    held = round(time.monotonic() - started, 1)
    for chunk in (
        sse(
            "content_block_delta",
            {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": ", 4, 5"}},
        ),
        sse("content_block_stop", {"type": "content_block_stop", "index": 0}),
        sse(
            "message_delta",
            {
                "type": "message_delta",
                "delta": {"stop_reason": "end_turn", "stop_sequence": None},
                "usage": {"output_tokens": 5},
            },
        ),
        sse("message_stop", {"type": "message_stop"}),
    ):
        await response.write(chunk)
        sent += len(chunk)
    await response.write_eof()
    return response, {"status": 200, "bytes": sent, "released_by": released_by, "held_s": held}


def make_edge_handler(edge: str, base: str, fault: FaultState, session, counters: dict, log):
    """The edge proxy for one vendor: forwards to base, applies the armed fault, logs one entry per request.

    log(entry) receives the JSON line for <root>/logs/edge.jsonl (auth as a 12-char hash, never a value).
    """
    import asyncio

    import aiohttp
    from aiohttp import web

    async def handle(request: web.Request) -> web.StreamResponse:
        started = time.monotonic()
        body = await request.read()
        auth = auth_hash12(request.headers)
        counters["edge_requests"][edge] += 1
        fault.refresh()
        record = {"ts": now_iso(), "edge": edge, "method": request.method, "path": request.path}
        record["auth_hash12"] = auth
        if fault.take_429(auth):
            counters["faults_applied"][edge] += 1
            status, headers, payload = rate_limit_response(edge)
            log({**record, "status": status, "bytes": len(payload), "fault": "account_429"})
            return web.Response(status=status, body=payload, headers=headers)
        armed_hold = fault.fault == "hold_stream" and not fault.consumed  # parse the body only when armed
        if armed_hold and edge == "anthropic" and request.method == "POST" and request.path == "/v1/messages":
            try:
                parsed = json.loads(body or b"{}")
            except ValueError:
                parsed = {}
            hold = fault.take_hold() if isinstance(parsed, dict) and parsed.get("stream") is True else None
            if hold is not None:
                counters["faults_applied"][edge] += 1
                try:
                    response, fields = await serve_held_stream(
                        request, fault, hold[0], hold[1], str(parsed.get("model", ""))
                    )
                except (ConnectionResetError, asyncio.CancelledError):
                    log(
                        {
                            **record,
                            "status": 200,
                            "fault": "hold_stream",
                            "downstream_closed": True,
                            "ms": int((time.monotonic() - started) * 1000),
                        }
                    )
                    raise
                log({**record, **fields, "fault": "hold_stream", "ms": int((time.monotonic() - started) * 1000)})
                return response
        headers = {k: v for k, v in request.headers.items() if k.lower() not in HOP_BY_HOP}
        applied, status, sent, error, downstream_closed = None, 0, 0, None, False
        response: web.StreamResponse | None = None

        def drop_downstream() -> None:
            # close() flushes what is already queued, then closes without the terminating chunk,
            # so the sandbox sees an incomplete chunked body (abort() would discard queued bytes).
            if request.transport is not None:
                request.transport.close()

        try:
            async with session.request(
                request.method,
                f"{base}{request.path_qs}",
                headers=headers,
                data=body or None,
                allow_redirects=False,
            ) as upstream:
                status = upstream.status
                out_headers = {k: v for k, v in upstream.headers.items() if k.lower() not in HOP_BY_HOP}
                response = web.StreamResponse(status=status, headers=out_headers)
                await response.prepare(request)
                streamed = "text/event-stream" in upstream.headers.get("content-type", "")
                cut_at = fault.take_cut() if streamed and status == 200 else None
                if cut_at is not None:
                    applied = f"cut_after_bytes:{cut_at}"
                    counters["faults_applied"][edge] += 1
                try:
                    async for chunk in upstream.content.iter_any():
                        if cut_at is not None and sent + len(chunk) >= cut_at:
                            part = chunk[: max(0, cut_at - sent)]
                            if part:
                                await response.write(part)
                                sent += len(part)
                            drop_downstream()  # a TCP close mid-body
                            break
                        await response.write(chunk)
                        sent += len(chunk)
                    else:
                        await response.write_eof()
                except ConnectionResetError:
                    # The sandbox stops reading once it has the terminal event; not an upstream error.
                    downstream_closed = True
        except (aiohttp.ClientError, asyncio.TimeoutError) as exc:
            error = exc.__class__.__name__
            if response is not None and response.prepared:
                # Upstream broke after headers: never finish the HTTP framing, so the
                # truncation reaches the sandbox as a truncation, not a clean end.
                drop_downstream()
        ms = int((time.monotonic() - started) * 1000)
        entry = {**record, "status": status, "bytes": sent, "fault": applied, "ms": ms}
        if applied:
            entry["cut"] = True
        if downstream_closed:
            entry["downstream_closed"] = True
        if error:
            entry["error"] = error
        log(entry)
        if response is None:
            return web.json_response({"error": {"type": "lb_sandbox_edge", "message": error}}, status=502)
        return response

    return handle


def cmd_aux(root_arg: str) -> int:  # noqa: C901 - one event loop with three listeners and a child
    import asyncio
    import ssl

    import aiohttp
    from aiohttp import web

    root = check_root(Path(root_arg))
    if os.environ.get("LB_SANDBOX_ROOT") != str(root):
        raise Refused("LB_SANDBOX_ROOT does not match the sandbox root")
    meta = read_json(root / "sandbox.json")
    ports = meta["ports"]
    check_ports(list(ports.values()))
    state_file = root / "state" / "aux.json"
    edge_log = root / "logs" / "edge.jsonl"
    gate_log = root / "logs" / "gate.jsonl"
    counters = {
        "gate_forwarded": {},
        "gate_refused": 0,
        "gate_refused_by": {},
        "edge_requests": {"anthropic": 0, "openai": 0},
        "faults_applied": {"anthropic": 0, "openai": 0},
    }
    faults = {edge: FaultState(root / "state" / f"fault-{edge}.json") for edge in EDGES}
    front_proc: dict[str, subprocess.Popen | None] = {"proc": None}
    ready = {"value": False}

    def append(path: Path, record: dict) -> None:
        with append_in_root(root, path.relative_to(root)) as fh:
            fh.write(json.dumps(record, sort_keys=True) + "\n")

    def save_state() -> None:
        proc = front_proc["proc"]
        write_json(
            root,
            state_file.relative_to(root),
            {
                "pid": os.getpid(),
                "front_pid": proc.pid if proc else None,
                "front_alive": bool(proc and proc.poll() is None),
                "ready": ready["value"],
                "updated_at": now_iso(),
                "gate": {
                    "forwarded": [
                        {"method": k.split(" ", 1)[0], "path": k.split(" ", 1)[1], "count": v}
                        for k, v in sorted(counters["gate_forwarded"].items())
                    ],
                    "refused": counters["gate_refused"],
                    "refused_by": counters["gate_refused_by"],
                },
                "edge": {
                    "requests": counters["edge_requests"],
                    "faults_applied": counters["faults_applied"],
                    "log": str(edge_log),
                },
            },
        )

    try:
        import certifi

        ssl_context = ssl.create_default_context(cafile=certifi.where())
    except ImportError:
        ssl_context = ssl.create_default_context()

    async def main() -> None:
        connector = aiohttp.TCPConnector(ssl=ssl_context, limit=0)
        session = aiohttp.ClientSession(
            connector=connector,
            auto_decompress=False,
            trust_env=False,
            skip_auto_headers=("User-Agent", "Accept-Encoding"),
            timeout=aiohttp.ClientTimeout(total=None, sock_connect=15, sock_read=900),
        )

        async def gate(request: web.Request) -> web.StreamResponse:
            key = (request.method, request.path)
            name = f"{request.method} {request.path}"
            if key not in GATE_ALLOWED or request.query_string:
                counters["gate_refused"] += 1
                counters["gate_refused_by"][name] = counters["gate_refused_by"].get(name, 0) + 1
                append(gate_log, {"ts": now_iso(), "method": request.method, "path": request.path, "status": 403})
                save_state()
                return web.json_response({"detail": "lb-sandbox peer gate: read-only mirror only"}, status=403)
            headers = {k: v for k, v in request.headers.items() if k.lower() in ("authorization", "accept")}
            async with session.get(f"{LIVE_PEER_URL}{request.path}", headers=headers) as upstream:
                body = await upstream.read()
                status = upstream.status
                content_type = upstream.headers.get("content-type", "application/json")
            counters["gate_forwarded"][name] = counters["gate_forwarded"].get(name, 0) + 1
            append(gate_log, {"ts": now_iso(), "method": request.method, "path": request.path, "status": status})
            save_state()
            return web.Response(status=status, body=body, headers={"content-type": content_type})

        def edge_handler(edge: str):
            def log(entry: dict) -> None:
                append(edge_log, entry)
                save_state()

            return make_edge_handler(edge, EDGES[edge], faults[edge], session, counters, log)

        runners = []
        gate_app = web.Application(client_max_size=1 << 20)
        gate_app.router.add_route("*", "/{tail:.*}", gate)
        apps = [(gate_app, ports["gate"])]
        for edge in EDGES:
            app = web.Application(client_max_size=256 << 20)
            app.router.add_route("*", "/{tail:.*}", edge_handler(edge))
            apps.append((app, ports[f"edge_{edge}"]))
        for app, port in apps:
            runner = web.AppRunner(app, auto_decompress=False, access_log=None, handle_signals=False)
            await runner.setup()
            await web.TCPSite(runner, "127.0.0.1", port).start()
            runners.append(runner)

        front_env = {
            "HOME": str(root / "home"),
            "PATH": "/usr/bin:/bin",
            "AGENT_LB_FRONT_HOST": "127.0.0.1",
            "AGENT_LB_FRONT_LISTEN_PORT": str(ports["front"]),
            "AGENT_LB_FRONT_UPSTREAM_PORTS": f"{ports['primary']},{ports['standby']}",
            "AGENT_LB_FRONT_PREFERRED_FILE": str(root / "state" / "front-preferred-port"),
            "AGENT_LB_FRONT_STATE_FILE": str(root / "state" / "front.json"),
            "LB_SANDBOX_ROOT": str(root),
        }
        front_log = append_in_root(root, "logs/front.log")
        front_proc["proc"] = subprocess.Popen(
            # The trailing root is ignored by the front; it puts the run's root in the command line for stop.
            [meta["node"], str(root / "runtime" / "scripts" / "agent-lb-front.mjs"), str(root)],
            env=front_env,
            stdout=front_log,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            cwd=str(root),
        )
        deadline = time.monotonic() + 15
        while not listener_pids(ports["front"]):
            if time.monotonic() > deadline or front_proc["proc"].poll() is not None:
                raise Unhealthy("sandbox front did not listen")
            await asyncio.sleep(0.2)
        ready["value"] = True
        save_state()

        stop = asyncio.Event()
        loop = asyncio.get_running_loop()
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            loop.add_signal_handler(sig, stop.set)
        while not stop.is_set():
            if front_proc["proc"].poll() is not None:
                break
            save_state()
            try:
                await asyncio.wait_for(stop.wait(), timeout=1.0)
            except asyncio.TimeoutError:
                pass
        ready["value"] = False
        for runner in runners:
            await runner.cleanup()
        await session.close()

    try:
        asyncio.run(main())
    finally:
        proc = front_proc["proc"]
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(10)
            except subprocess.TimeoutExpired:
                proc.kill()
        save_state()
    return EXIT_OK


# ---------------------------------------------------------------- status, client-env, fault, restart, scan


def cmd_status(args) -> int:
    root, meta = load_meta(args.run_id)
    ports = meta["ports"]
    code, body = http(ports["primary"], "/internal/drain/status", timeout=2)
    in_flight = None
    if code == 200:
        try:
            in_flight = int(json.loads(body)["checks"]["in_flight"])
        except (ValueError, KeyError, TypeError):
            in_flight = None
    aux = read_json(root / "state" / "aux.json")
    accounts = read_accounts(root)
    for account in accounts:
        account.pop("usable", None)
    healthy = (
        http(ports["primary"], "/health/ready")[0] == 200
        and http(ports["front"], "/health/ready")[0] == 200
        and bool(aux.get("ready"))
    )
    out = {
        "run_id": meta["run_id"],
        "healthy": healthy,
        "in_flight_primary": in_flight,
        "preferred_port": read_json(root / "state" / "front.json").get("preferred"),
        "primary_pid": launchd_pid(meta["label"]),
        "aux_pid": aux.get("pid"),
        "front_pid": aux.get("front_pid"),
        "accounts": accounts,
        "accounts_per_vendor": usable_counts(read_accounts(root)),
        "gate": aux.get("gate", {"forwarded": [], "refused": 0}),
        "edge": {k: v for k, v in aux.get("edge", {}).items() if k != "log"},
        "edge_log": str(root / "logs" / "edge.jsonl"),
        "ports": ports,
    }
    return emit(out, EXIT_OK if healthy else EXIT_UNHEALTHY)


CODEX_PLACEHOLDER = "lb-sandbox-placeholder-not-a-credential"


def cmd_client_env(args) -> int:
    root, meta = load_meta(args.run_id)
    front = meta["ports"]["front"]
    if args.vendor == "claude":
        os.close(confined(lambda: open_dir(root, "clients/claude", create=True)))
        env = {
            "CLAUDE_LB_LOCAL_URL": f"http://127.0.0.1:{front}",
            "CLAUDE_LB_BASE_URL": f"http://127.0.0.1:{front}",
            "CLAUDE_LB_LAUNCHD_LABEL": meta["label"],
        }
    else:
        home = root / "clients" / "codex"
        config = (
            "\n".join(
                [
                    'model_provider = "agent-lb"',
                    "",
                    "[model_providers.agent-lb]",
                    'name = "OpenAI"',
                    f'base_url = "http://127.0.0.1:{front}/backend-api/codex"',
                    'wire_api = "responses"',
                    "supports_websockets = false",
                    "requires_openai_auth = true",
                    "",
                ]
            )
        ).encode()
        # New inodes by rename, no link followed: a planted link or hard link never truncates a live file.
        confined(lambda: write_in_root(root, "clients/codex/config.toml", config))
        confined(
            lambda: write_json(
                root, "clients/codex/auth.json", {"OPENAI_API_KEY": CODEX_PLACEHOLDER, "auth_mode": "apikey"}
            )
        )
        env = {"CODEX_SOURCE_HOME": str(home)}
    return emit({"run_id": meta["run_id"], "vendor": args.vendor, "env": env}, EXIT_OK)


def parse_fault(spec: str) -> tuple[str, int | None]:
    if spec == "account_429":
        return "account_429", None
    match = re.fullmatch(r"cut_after_bytes:([0-9]{1,9})", spec)
    if match:
        return "cut_after_bytes", int(match.group(1))
    match = re.fullmatch(r"hold_stream:([0-9]{1,3})", spec)
    if match and 1 <= int(match.group(1)) <= HOLD_MAX_S:
        return "hold_stream", int(match.group(1))
    raise Refused(f"unknown fault {spec!r}; use account_429, cut_after_bytes:N or hold_stream:S (S 1-{HOLD_MAX_S})")


def cmd_fault(args) -> int:
    root, _ = load_meta(args.run_id)
    path = f"state/fault-{args.edge}.json"
    if args.clear:
        confined(lambda: write_json(root, path, {"armed": False, "nonce": uuid.uuid4().hex, "at": now_iso()}))
        return emit({"armed": False, "edge": args.edge, "fault": None}, EXIT_OK)
    fault, n = parse_fault(args.arm)
    if fault == "hold_stream" and args.edge != "anthropic":
        raise Refused("hold_stream is served by the anthropic edge only")
    confined(
        lambda: write_json(
            root, path, {"armed": True, "fault": fault, "n": n, "nonce": uuid.uuid4().hex, "at": now_iso()}
        )
    )
    return emit({"armed": True, "edge": args.edge, "fault": args.arm}, EXIT_OK)


def cmd_restart(args) -> int:
    check_launchctl()
    root, _ = load_meta(args.run_id)
    lb_restart = Path(__file__).resolve().parent / "lb-restart"
    if not lb_restart.is_file():
        raise Unhealthy(f"{lb_restart} missing")
    log_path = root / "logs" / "lb-restart.log"
    argv = [
        sys.executable,
        str(lb_restart),
        "--sandbox",
        str(root / "lb-restart.json"),
        "--force",
        "--reason",
        args.reason,
    ]
    started = time.monotonic()
    # Opened by descriptor from the root: a planted link or hard link (to the live plist, say) is refused.
    with confined(lambda: append_in_root(root, "logs/lb-restart.log")) as log:
        log.write(f"==== {now_iso()} lb-sandbox restart: {' '.join(argv[1:])}\n")
        log.flush()
        # lb-restart and the reaper it spawns carry the run's marker, so `scan --processes` can see their env.
        env = {**os.environ, "LB_SANDBOX_ROOT": str(root)}
        proc = subprocess.Popen(
            argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, cwd=str(root), env=env
        )
        assert proc.stdout is not None
        for line in proc.stdout:
            log.write(line)
            log.flush()
            sys.stderr.write(line)
        code = proc.wait()
    out = {"lb_restart_exit": code, "log": str(log_path), "seconds": round(time.monotonic() - started, 1)}
    return emit(out, EXIT_OK if code == 0 else EXIT_UNHEALTHY)


def cmd_scan(args) -> int:
    root = root_for(args.run_id)
    if not args.paths and not args.processes:
        raise Refused("scan needs paths, --processes or both")
    secrets = load_secrets(root if root.is_dir() else None)
    key = load_key(root)
    newer = Path(args.newer_than).stat().st_mtime if args.newer_than else None
    result = (
        scan_paths(
            [Path(p) for p in args.paths],
            secrets,
            newer_than=newer,
            exclude=[Path(p) for p in args.exclude],
            skip_exact=custody_paths(root),  # the store and its key, at their own paths only
            keys=[key] if key else None,  # any ciphertext this key opens, an old snapshot's included
        )
        if args.paths
        else {"found": False, "complete": True, "files_scanned": 0, "hits": []}
    )
    result.pop("_files", None)
    if args.processes:
        procs = scan_processes(root, args.run_id, secrets)
        result["processes"] = procs
        result["found"] = result["found"] or procs["found"]
        result["complete"] = result["complete"] and procs["complete"]
    result["secrets_loaded"] = len(secrets)
    result["ciphertext_keys"] = 1 if key else 0
    result["run_id"] = args.run_id
    return emit(result, EXIT_OK if result["complete"] and not result["found"] else EXIT_ASSERT)


# ---------------------------------------------------------------- stop and gc


def stop_pid(pid: int, bound: float = 15) -> None:
    for sig, wait in ((signal.SIGTERM, bound), (signal.SIGKILL, 5)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + wait
        while pid_alive(pid) and time.monotonic() < deadline:
            try:
                os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                pass
            time.sleep(0.2)
        if not pid_alive(pid):
            return


def unlink_key(root: Path) -> dict:
    """Unlink data/encryption.key through a descriptor for a real data dir under a real root.

    A data dir (or root) swapped for a link to the live data dir is refused: unlinking through it would
    delete the live key. Unlinking the name inside a real data dir removes only that name.
    """
    if not root.exists() and not root.is_symlink():
        return {"key_unlinked": None}
    try:
        data_fd = open_dir(root, "data")
    except FileNotFoundError:
        return {"key_unlinked": "absent"}
    except OSError as exc:
        return {"key_unlinked": False, "key_error": f"root or data dir is a link ({exc.__class__.__name__})"}
    try:
        os.unlink("encryption.key", dir_fd=data_fd)
        return {"key_unlinked": True}
    except FileNotFoundError:
        return {"key_unlinked": "absent"}
    except OSError as exc:
        return {"key_unlinked": False, "key_error": exc.__class__.__name__}
    finally:
        os.close(data_fd)


def command_ref(cmd: str) -> str:
    """A leftover process by hash only: its command line may hold anything, a token included."""
    return hashlib.sha256(cmd.encode(errors="replace")).hexdigest()[:12]


def teardown(run_id: str, logs_to: Path | None) -> dict:
    """Stop everything the sandbox started, keep scanned logs if asked, delete the root, then verify."""
    root = root_for(run_id)
    meta = read_json(root / "sandbox.json") if not root.is_symlink() else {}
    label, aux_label = labels_for(run_id)
    ports = [int(p) for p in meta.get("ports", {}).values() if isinstance(p, int)]
    secrets: list[str] = []
    keys: list[str] = []
    load_error = None
    try:
        secrets = load_secrets(root if root.is_dir() and not root.is_symlink() else None)
        key = load_key(root) if not root.is_symlink() else None
        keys = [key] if key else []
    except Exception as exc:  # a broken or redirected store must not block teardown
        secrets, keys = [], []
        load_error = exc.__class__.__name__
    booted = {}
    for name in (label, aux_label):
        if not label_loaded(name):
            booted[name] = "not loaded"
        elif label_names_root(name, root):
            booted[name] = bootout(name)
        else:
            booted[name] = "refused: the loaded job does not run this sandbox root"
    pidfile = root / "state" / "lb-standby.pid"
    rows = processes()
    lineage = own_lineage(rows)
    if pidfile.is_file():
        try:
            pid = int(pidfile.read_text().strip())
        except ValueError:
            pid = 0
        if pid and any(p == pid and names_root(cmd, root) for p, _, cmd in rows):
            stop_pid(pid)
    # Every process of the run: those naming its root and those naming its run id (a unique stamp), never
    # this stop or its callers.
    for pid, _, cmd in processes():
        if (names_root(cmd, root) or names_run(cmd, run_id)) and pid not in lineage:
            stop_pid(pid, bound=5)
    logs: dict = {"copied": False}
    if root.is_dir() and not root.is_symlink():
        # The whole root, not just logs/: a token in state/, home/ or a copied store is a leak too.
        scanned = scan_paths([root], secrets, skip_exact=custody_paths(root), keys=keys)
        logs["scan_found"] = scanned["found"]
        logs["scan_complete"] = scanned["complete"]
        logs["files_scanned"] = scanned["files_scanned"]
        logs["scan_scope"] = "root"
        logs["ciphertext_keys"] = len(keys)
        logs["hits"] = [os.path.relpath(hit, root.resolve()) for hit in scanned["hits"]]
        if logs_to is not None and (root / "logs").is_dir():
            if scanned["found"] is False and scanned["complete"] and not load_error:
                log_files = [f for f in scanned["_files"] if Path(f).is_relative_to((root / "logs").resolve())]
                try:  # the copy is best effort; teardown below always runs
                    # Every exported byte is scanned again as it is copied: the files may have changed since.
                    exported = export_logs(root, logs_to, log_files, Detector(secrets, keys))
                    logs.update(
                        {
                            "files_copied": exported["files"],
                            "bytes_copied": exported["bytes"],
                            "export_scanned": True,
                            "copied": True,
                            "to": str(logs_to),
                        }
                    )
                except LeakFound:
                    logs["copy_error"] = "LeakFound"
                    logs["export_found"] = True
                except OSError as exc:
                    logs["copy_error"] = exc.__class__.__name__
            else:
                logs["refused"] = (
                    "token, key or ciphertext found in the sandbox root"
                    if scanned["found"]
                    else "secrets could not all be loaded or a file could not be read"
                )
    if load_error:
        logs["secret_load_error"] = load_error
    custody = unlink_key(root)
    if root.is_symlink():
        root.unlink()  # the link only; its target is not this sandbox's to delete
    elif root.exists():
        check_root(root)
        shutil.rmtree(root)
    time.sleep(0.5)
    rows = processes()
    lineage = own_lineage(rows)
    leftover = [
        {"pid": pid, "command_sha12": command_ref(cmd)}
        for pid, _, cmd in rows
        if (names_run(cmd, run_id) or names_root(cmd, root)) and pid not in lineage
    ]
    result = {
        "labels_loaded": [name for name in (label, aux_label) if label_loaded(name)],
        "listeners": [{"port": port, "pids": pids} for port in ports if (pids := listener_pids(port))],
        "processes": leftover,
        "root_exists": root.exists() or root.is_symlink(),
        "bootout": booted,
        "logs": logs,
        "custody": custody,
    }
    result["clean"] = not (
        result["labels_loaded"] or result["listeners"] or result["processes"] or result["root_exists"]
    )
    return result


def cmd_stop(args) -> int:
    check_launchctl()
    run_id = check_run_id(args.run_id)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, signal.SIG_IGN)
    result = teardown(run_id, Path(args.logs_to) if args.logs_to else None)
    result["run_id"] = run_id
    safe_logs = result.get("logs", {})
    safe = (
        safe_logs.get("scan_found") is False
        and safe_logs.get("scan_complete") is True
        and not safe_logs.get("secret_load_error")
        and not safe_logs.get("copy_error")
        and not safe_logs.get("export_found")
        and result.get("custody", {}).get("key_unlinked") is not False
    )
    return emit(result, EXIT_OK if result["clean"] and safe else EXIT_ASSERT)


def cmd_gc(args) -> int:
    check_launchctl()
    stopped, kept = [], []
    now = time.time()
    if SANDBOXES.is_dir():
        for meta_path in sorted(SANDBOXES.glob("*/sandbox.json")):
            meta = read_json(meta_path)
            run_id = meta_path.parent.name
            age = now - float(meta.get("created_epoch") or meta_path.stat().st_mtime)
            if age > args.older_than and not pid_alive(meta.get("caller_pid")):
                result = teardown(run_id, None)
                stopped.append(run_id) if result["clean"] else kept.append({"run_id": run_id, "teardown": result})
    return emit({"stopped": stopped, "not_clean": kept}, EXIT_OK if not kept else EXIT_ASSERT)


# ---------------------------------------------------------------- main


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="lb-sandbox", description=__doc__, formatter_class=argparse.RawTextHelpFormatter
    )
    sub = parser.add_subparsers(dest="command", required=True)

    def command(name: str, help_text: str) -> argparse.ArgumentParser:
        p = sub.add_parser(name, help=help_text)
        p.add_argument("--json", action="store_true", help="print one JSON object (always on)")
        return p

    p = command("start", "create, boot and mirror a sandbox")
    p.add_argument("--run-id", required=True)
    p.add_argument("--from-live", action="store_true")
    p.add_argument("--port", type=int)
    p.add_argument("--min-accounts", type=int, default=2)
    p.add_argument("--transport", default="http")
    p.add_argument("--logs-to", help="on failure, copy scanned logs here before teardown")
    p = command("status", "health, accounts, gate and edge counters")
    p.add_argument("--run-id", required=True)
    p = command("client-env", "env for a client pointed only at the sandbox")
    p.add_argument("--run-id", required=True)
    p.add_argument("--vendor", choices=("claude", "codex"), required=True)
    p = command("fault", "arm or clear one edge fault")
    p.add_argument("--run-id", required=True)
    p.add_argument("--edge", choices=tuple(EDGES), required=True)
    group = p.add_mutually_exclusive_group(required=True)
    group.add_argument("--arm")
    group.add_argument("--clear", action="store_true")
    p = command("restart", "blue/green restart of the sandbox through lb-restart --sandbox")
    p.add_argument("--run-id", required=True)
    p.add_argument("--reason", required=True)
    p = command("scan", "search files for the live federation token and mirrored tokens")
    p.add_argument("--run-id", required=True)
    p.add_argument("--newer-than", help="only files modified after this file")
    p.add_argument("--exclude", action="append", default=[], help="skip this path (repeatable)")
    p.add_argument("--processes", action="store_true", help="also scan the exec env of every process of the run")
    p.add_argument("paths", nargs="*")
    p = command("stop", "tear the sandbox down and verify")
    p.add_argument("--run-id", required=True)
    p.add_argument("--logs-to")
    p = command("gc", "stop abandoned sandboxes")
    p.add_argument("--older-than", type=float, default=3600)
    return parser


COMMANDS = {
    "start": cmd_start,
    "status": cmd_status,
    "client-env": cmd_client_env,
    "fault": cmd_fault,
    "restart": cmd_restart,
    "scan": cmd_scan,
    "stop": cmd_stop,
    "gc": cmd_gc,
}


# The marker this process was exec'd with (read at import, before main sets it).
EXEC_ENV_MARKER = os.environ.get("LB_SANDBOX_ROOT")


def run_marker(args) -> str | None:
    """LB_SANDBOX_ROOT for a command of one run (None for gc, or a run id the command will refuse)."""
    run_id = getattr(args, "run_id", None)
    try:
        return str(root_for(run_id)) if run_id else None
    except Refused:
        return None


def in_live_venv() -> bool:
    try:
        return Path(sys.prefix).resolve() == LIVE_VENV.resolve()
    except OSError:
        return False


def main(argv: list[str]) -> int:
    if argv[:1] == ["_serve"] and len(argv) >= 2:
        try:
            return cmd_serve(argv[1], argv[2:])
        except Refused as exc:
            print(f"lb-sandbox _serve refused: {exc}", file=sys.stderr)
            return EXIT_REFUSED
    if argv[:1] == ["_boot"] and len(argv) >= 2:
        try:
            boot_app(Path(argv[1]), argv[2:])
            return EXIT_OK
        except Refused as exc:
            print(f"lb-sandbox _boot refused: {exc}", file=sys.stderr)
            return EXIT_REFUSED
    if argv[:1] == ["_aux"] and len(argv) == 2:
        try:
            return cmd_aux(argv[1])
        except Refused as exc:
            print(f"lb-sandbox _aux refused: {exc}", file=sys.stderr)
            return EXIT_REFUSED
    args = build_parser().parse_args(argv)
    marker = run_marker(args)
    if marker is not None:
        # A command of run R names R in its argv, so `scan --processes` claims it: its exec environment must
        # carry the run's marker or the scan cannot tell a shown environment from a hidden one.
        os.environ["LB_SANDBOX_ROOT"] = marker
    if not os.environ.get("LB_SANDBOX_NO_REEXEC"):
        python = LIVE_VENV / "bin" / "python"
        reexec = (not in_live_venv() and python.exists()) or (marker is not None and marker != EXEC_ENV_MARKER)
        if reexec:
            # status, scan and stop decrypt the sandbox store; the agent-lb venv has the crypto they need.
            target = str(python) if python.exists() and not in_live_venv() else sys.executable
            os.execv(target, [target, str(Path(__file__).resolve()), *argv])
    try:
        return COMMANDS[args.command](args)
    except Refused as exc:
        return emit({"refused": str(exc)}, EXIT_REFUSED)
    except Unhealthy as exc:
        return emit({"error": str(exc)}, EXIT_UNHEALTHY)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
