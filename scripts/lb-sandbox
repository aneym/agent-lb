#!/usr/bin/env python3
"""lb-sandbox: a throwaway agent-lb instance on Studio that mirrors the live account pool.

Drills and checks need an agent-lb with working accounts that is not the live
service. Everything that touches a credential runs inside this agent-lb code:
reading the live federation token, mirroring accounts, forwarding upstream
Authorization headers, injecting account faults and scanning for leaks. A caller
gets ports, account ids, 12-character hashes and counts, never a token.

    lb-sandbox start --run-id R --from-live [--port P] [--min-accounts N] [--transport http] [--json]
    lb-sandbox status --run-id R [--json]
    lb-sandbox client-env --run-id R --vendor claude|codex [--json]
    lb-sandbox fault --run-id R --edge anthropic|openai (--arm account_429|cut_after_bytes:N|hold_stream:S | --clear)
    lb-sandbox restart --run-id R --reason TEXT [--json]
    lb-sandbox scan --run-id R [--newer-than FILE] [--exclude PATH ...] [--processes] [PATH...] [--json]
    lb-sandbox stop --run-id R [--logs-to DIR] [--json]
    lb-sandbox gc [--older-than 3600] [--json]

Layout: root ~/.agent-lb/sandboxes/R/ is its own volume (an encrypted sparse
image under ~/.agent-lb/sandboxes/.images, mounted at the root, its passphrase
never stored) and holds a copy of the installed runtime (app, config, scripts;
the venv is a symlink), its own SQLite store and key, logs and state. Two
launchd jobs run it:
- com.agent-lb.drill.sbx-R: `<venv python> -I <installed lb-sandbox> _serve <root>` (nothing under the root
  runs before confinement: the script is the installed file and -I ignores PYTHONPATH), which reads the live
  federation token from the live plist, writes it into a pipe and execs
  `lb-sandbox _boot`, which reads it from the inherited pipe fd, loads the app
  settings with it and starts the app in the same process. The token is never
  in an exec environment (`ps eww`), the sandbox plist, a file, argv or a log.
- com.agent-lb.drill.sbx-R-aux: `lb-sandbox _aux <root>`: the peer gate (forwards
  only GET /api/federation/mirror and /status to the live LB, answers 403 to
  everything else), two edge proxies to the real providers that log only a hash
  of the Authorization value and inject armed faults, and the front as a child.

Every listener binds 127.0.0.1; ports come from 2470-2599 and are never 1455,
2455, 2457 or 2459. The sandbox can read the live pool and never write to it.

Custody parity with the live service (same UID): the root is mode 0700 under
~/.agent-lb/sandboxes (0700), the key file is created 0600 with O_EXCL and
unlinked at stop, and no token, store or key reaches --out or --logs-to: the
scans look for the raw tokens, the key and any ciphertext the key opens (an old
store snapshot included), and the log export scans every byte it copies. Every
path lb-sandbox opens under a root is opened component by component without
following a link, and a file with a second hard link is refused. The app, the
front and the aux open paths by name, so two kernel rules cover them: the root
is its own volume (no hard link reaches a live file) and they run under a
Seatbelt profile that denies writes outside the root and reads of live custody
(a planted symlink is denied, not followed). A link planted in the root never
leads a read, write or unlink into live state.

stop and gc touch only a sandbox whose sandbox.json is stamped with the run id,
and signal only processes naming the root or the run's launchd label.

Exit codes: 0 ok, 1 assertion false (scan found something, stop not clean),
2 refused (guard), 3 unhealthy (boot, mirror or restart failed).
"""

from __future__ import annotations

import argparse
import base64
import binascii
import datetime as dt
import errno
import hashlib
import json
import os
import plistlib
import pwd
import re
import shutil
import signal
import socket
import sqlite3
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

REAL_HOME = Path(pwd.getpwuid(os.getuid()).pw_dir)
LB_HOME = REAL_HOME / ".agent-lb"
SANDBOXES = LB_HOME / "sandboxes"
VOLUME_SIZE = "2g"  # sparse: grows only as the copied runtime, store and logs need
LIVE_RUNTIME = LB_HOME / "runtime" / "agent-lb"
LIVE_VENV = LIVE_RUNTIME / ".venv"
LIVE_PLIST = REAL_HOME / "Library" / "LaunchAgents" / "com.aneyman.agent-lb.plist"
LIVE_LABEL = "com.aneyman.agent-lb"
LIVE_FRONT_LABEL = "com.aneyman.agent-lb-front"
LIVE_FRONT_STATE = LB_HOME / "state" / "front.json"
LIVE_FRONT_PORT = 2455
LIVE_PRIMARY_PORT = 2457
LIVE_PEER_URL = "http://127.0.0.1:2455"
LIVE_KEY_DIR_LEGACY = REAL_HOME / ".codex-lb"
MANAGED_ROUTING = LB_HOME / "managed" / "coding-agents"

LABEL_PREFIX = "com.agent-lb.drill."
FORBIDDEN_PORTS = frozenset({1455, 2455, 2457, 2459})
MIN_PORT = 2470
PICK_RANGE = range(2470, 2600)
RUN_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,79}$")
TOKEN_ENV = "AGENT_LB_FEDERATION_TOKEN"
EDGES = {"anthropic": "https://api.anthropic.com", "openai": "https://chatgpt.com/backend-api"}
GATE_ALLOWED = frozenset({("GET", "/api/federation/mirror"), ("GET", "/api/federation/status")})
VENDOR_OF_PROVIDER = {"anthropic": "anthropic", "openai": "openai"}
USABLE_EXPIRY_S = 1800
DRAIN_S = 120
HOLD_MAX_S = 120
# The files that legitimately hold the sandbox's custody material (ciphertexts and their key).
CUSTODY_FILES = (
    "data/store.db",
    "data/store.db-wal",
    "data/store.db-shm",
    "data/store.db-journal",
    "data/encryption.key",
)
ENV_MARKER = "LB_SANDBOX_ROOT="  # in every sandbox process's exec env: proves ps showed the env at all

EXIT_OK, EXIT_ASSERT, EXIT_REFUSED, EXIT_UNHEALTHY = 0, 1, 2, 3

# Schedulers that would spend, refresh or write; the sandbox runs only the federation mirror.
DISABLED_SCHEDULERS = (
    "METRICS",
    "USAGE_REFRESH",
    "MODEL_REGISTRY",
    "ACCOUNT_PULSE",
    "RESET_CREDIT_AUTO_REDEEM",
    "RESET_CREDIT_EXPIRY_REDEEM",
    "ACCOUNTS_CACHE_WARMER",
    "STICKY_SESSION_CLEANUP",
    "QUOTA_PLANNER_SCHEDULER",
    "HTTP_RESPONSES_SESSION_BRIDGE",
    "AUTH_GUARDIAN",
)


class Refused(Exception):
    """A guard said no; nothing was touched."""


class Unhealthy(Exception):
    """Boot, mirror or restart failed."""


# ---------------------------------------------------------------- guards


# Names of live agent-lb directories: a sandboxes dir swapped for a link to ~/.agent-lb would make a run of one
# of these names a live directory. Any name that exists in the live agent-lb home is refused as well.
RESERVED_RUN_IDS = frozenset(
    {"state", "data", "bin", "runtime", "logs", "sandboxes", "managed", "backups", "shims", "tls", "team", "seats"}
)


def check_run_id(run_id: str) -> str:
    if not isinstance(run_id, str) or not RUN_ID_RE.match(run_id):
        raise Refused(f"run id {run_id!r} must match {RUN_ID_RE.pattern}")
    if run_id.endswith("-aux"):
        # Run R's aux label is sbx-R-aux; a run named R-aux would own that label too.
        raise Refused(f"run id {run_id!r} must not end in -aux")
    if run_id in RESERVED_RUN_IDS or os.path.lexists(LB_HOME / run_id):
        raise Refused(f"run id {run_id!r} names a live agent-lb directory")
    return run_id


def check_label(label: str) -> str:
    suffix = label.removeprefix(LABEL_PREFIX)
    if not label.startswith(LABEL_PREFIX) or not suffix or not suffix.replace("-", "").isalnum():
        raise Refused(f"label {label!r} is not a {LABEL_PREFIX}* drill label")
    return label


def check_ports(ports: list[int]) -> list[int]:
    for port in ports:
        if isinstance(port, bool) or not isinstance(port, int) or port < MIN_PORT or port > 2599:
            raise Refused(f"port {port!r} is outside {MIN_PORT}-2599")
        if port in FORBIDDEN_PORTS:
            raise Refused(f"port {port} belongs to the live agent-lb")
    if len(set(ports)) != len(ports):
        raise Refused("sandbox ports repeat")
    return ports


def _lexical(path: Path) -> Path:
    """path with . and .. folded by text alone: nothing on disk is followed."""
    return Path(os.path.normpath(str(path)))


def _refuse_linked_dirs(what: str, path: Path) -> os.stat_result:
    """Every component of absolute path, lstat'd from the top down, is a real directory. Returns the last one's
    stat. Raises Refused on a link, a non-directory or a missing component."""
    if not path.is_absolute():
        raise Refused(f"{what} {path} is not absolute")
    info = None
    for i in range(1, len(path.parts) + 1):
        prefix = Path(*path.parts[:i])
        try:
            info = prefix.lstat()
        except OSError as exc:
            raise Refused(f"{what} {path}: {prefix} is missing ({exc.__class__.__name__})") from None
        if not stat.S_ISDIR(info.st_mode):
            raise Refused(f"{what} {path}: {prefix} is a link or not a directory")
    assert info is not None
    return info


def check_root(root: Path, sandboxes: Path | None = None) -> Path:
    """root, by its text, directly under the sandboxes dir, which is a real private directory with no link at
    any component; root itself, when it exists, is a real directory. Never resolved: resolving accepted a
    sandboxes dir swapped for a link to ~/.agent-lb and named live state as a root."""
    base = Path(os.path.normpath(os.path.abspath(sandboxes or SANDBOXES)))
    path = Path(os.path.normpath(os.path.abspath(root)))
    if path.parent != base:
        raise Refused(f"sandbox root {path} is not directly under {base}")
    check_run_id(path.name)
    try:
        sb = sandboxes_fd(base)
    except FileNotFoundError:
        return path  # nothing at the sandboxes path, so nothing to follow or delete
    except OSError as exc:
        raise Refused(f"sandboxes dir {base} is a link or not private ({exc})") from None
    try:
        info = os.stat(path.name, dir_fd=sb, follow_symlinks=False)
    except FileNotFoundError:
        return path
    if not stat.S_ISDIR(info.st_mode):
        raise Refused(f"sandbox root {path} is a link or not a directory")
    return path


def interpreter_for(root: Path) -> Path:
    """The interpreter every sandbox job runs: the installed runtime's venv python (<home>/.agent-lb/runtime/
    agent-lb/.venv/bin/python), never <root>/runtime/.venv/bin/python, which anything in the root could swap
    for a shim. lb-restart --sandbox requires this exact name in the plist (sandbox_python_for)."""
    return _lexical(Path(root)).parent.parent / "runtime" / "agent-lb" / ".venv" / "bin" / "python"


# What an executable binary starts with: Mach-O (thin 64/32-bit, fat) on macOS, ELF elsewhere (unit tests only).
NATIVE_MAGIC = (
    (b"\xcf\xfa\xed\xfe", b"\xce\xfa\xed\xfe", b"\xca\xfe\xba\xbe", b"\xca\xfe\xba\xbf")
    if sys.platform == "darwin"
    else (b"\x7fELF",)
)
BASE_INTERPRETER_NAME = re.compile(r"^python(3(\.[0-9]+)?)?$")


def _trusted_file(what: str, path: Path, info: os.stat_result) -> None:
    """A file or dir only this user or root can change: owned by one of them, no group or other write."""
    if info.st_uid not in (os.getuid(), 0) or info.st_mode & 0o022:
        raise Refused(f"{what} {path} is one another user could write")


def venv_base_dir(python: Path) -> Path:
    """The resolved `home` directory the venv's own pyvenv.cfg names. Raises Refused.

    pyvenv.cfg is read without following a link and must be a single-link regular file only this user or root
    can write; the home directory must be one only this user or root can write."""
    cfg = python.parent.parent / "pyvenv.cfg"
    try:
        fd = os.open(cfg, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        raise Refused(f"interpreter {python} has no venv config {cfg}") from None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise Refused(f"venv config {cfg} is not a single-link regular file")
        _trusted_file("venv config", cfg, info)
        text = os.read(fd, 1 << 16).decode(errors="replace")
    finally:
        os.close(fd)
    home = ""
    for line in text.splitlines():
        key, sep, value = line.partition("=")
        if sep and key.strip().lower() == "home":
            home = value.strip()
    if not home.startswith("/"):
        raise Refused(f"venv config {cfg} names no absolute home")
    base = Path(os.path.realpath(home))
    try:
        _trusted_file("venv home", base, os.stat(base))
    except OSError:
        raise Refused(f"venv home {home} is missing") from None
    return base


def check_interpreter(python: Path, root: Path) -> None:
    """What python runs is the venv's own base interpreter, by identity: no link from the top to its bin dir, and
    the file it leads to sits in the directory the venv's pyvenv.cfg names, is called python, python3 or
    python3.N, is a native executable (Mach-O; a script or shell shim is refused), is owned by this user or root
    with no group or other write, and is outside every sandbox root. Checked just before each exec. Raises Refused."""
    python = _lexical(python)
    sandboxes = _lexical(Path(root)).parent
    if python != interpreter_for(root) or sandboxes in python.parents:
        raise Refused(f"interpreter {python} is not the installed runtime's venv python")
    _refuse_linked_dirs("interpreter", python.parent)
    base = venv_base_dir(python)
    try:
        target = Path(os.path.realpath(python))
        fd = os.open(target, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        raise Refused(f"interpreter {python} is missing") from None
    try:
        info = os.fstat(fd)
        head = os.read(fd, 4) if stat.S_ISREG(info.st_mode) else b""
    finally:
        os.close(fd)
    if target == sandboxes or sandboxes in target.parents:
        raise Refused(f"interpreter {python} leads into a sandbox root")
    if target.parent != base or not BASE_INTERPRETER_NAME.match(target.name):
        raise Refused(f"interpreter {python} does not lead to the base interpreter its venv config names")
    if not stat.S_ISREG(info.st_mode) or not info.st_mode & stat.S_IXUSR or head not in NATIVE_MAGIC:
        raise Refused(f"interpreter {python} does not lead to a native executable (a script or shim?)")
    _trusted_file("interpreter", target, info)


def bootstrap_script() -> Path:
    """The lb-sandbox every sandbox job runs: this installed file, outside every root. Never a copy inside a root:
    the confined app can write there, and launchd (KeepAlive) or lb-restart's standby would run it unconfined."""
    return Path(__file__).resolve()


def check_bootstrap(script: Path, root: Path) -> None:
    """script is a real path outside the sandboxes dir: no link on the way, a single-link regular file owned by
    this user or root that group and other cannot write. Raises Refused."""
    script = _lexical(script)
    sandboxes = _lexical(Path(root)).parent
    if script == sandboxes or sandboxes in script.parents:
        raise Refused(f"bootstrap {script} is inside the sandboxes dir")
    _refuse_linked_dirs("bootstrap", script.parent)
    try:
        info = os.lstat(script)
    except OSError:
        raise Refused(f"bootstrap {script} is missing") from None
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise Refused(f"bootstrap {script} is not a single-link regular file")
    _trusted_file("bootstrap", script, info)


def check_launchctl() -> None:
    found = shutil.which("launchctl")
    if found != "/bin/launchctl":
        # A launchctl shim on PATH once drove the live agent-lb from a test (scripts/lb-restart).
        raise Refused(f"launchctl resolves to {found}, not /bin/launchctl")


def labels_for(run_id: str) -> tuple[str, str]:
    check_run_id(run_id)
    label = check_label(f"{LABEL_PREFIX}sbx-{run_id}")
    return label, check_label(f"{label}-aux")


def root_for(run_id: str) -> Path:
    return SANDBOXES / check_run_id(run_id)


# ---------------------------------------------------------------- small helpers


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------- confined file access
# Every read or write under a sandbox root goes through a directory descriptor opened component by
# component with O_NOFOLLOW, so a link planted anywhere below the root (logs/sub -> <root>/data, data ->
# the live data dir) is refused, never followed. Files must be regular with a single link: a hard link to
# a live file (plist, front-preferred-port, store, key) is refused, never written through.

DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


class Confinement(OSError):
    """A path under the sandbox root is a link, or a file shares its inode with another name."""


# The sandboxes directory, held by descriptor for the life of the process: every open, mount, unmount and delete
# of a root goes through it by name, so a sandboxes dir renamed aside and replaced by a link to ~/.agent-lb (or
# any other directory) after the checks never redirects them. {path text: (descriptor, (device, inode))}
_PINNED: dict[str, tuple[int, tuple[int, int]]] = {}


def _open_dir_no_links(text: str) -> int:
    """A descriptor for directory text with no link at any component (refused with ELOOP or ENOTDIR)."""
    nofollow_any = getattr(os, "O_NOFOLLOW_ANY", 0)
    if nofollow_any:
        return os.open(text, os.O_RDONLY | os.O_DIRECTORY | nofollow_any)
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in Path(text).parts[1:]:
            child = os.open(part, DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def sandboxes_fd(base: Path | None = None, create: bool = False) -> int:
    """The pinned descriptor for the sandboxes dir (owned by this module; never close it).

    The path has no link at any component and the directory is this user's own with no group or other write.
    create makes it (mode 0700) when missing and sets it to 0700.
    """
    text = os.path.normpath(os.path.abspath(base or SANDBOXES))
    if text in _PINNED:
        return _PINNED[text][0]
    if create:
        os.makedirs(text, mode=0o700, exist_ok=True)
    fd = _open_dir_no_links(text)
    info = os.fstat(fd)
    if info.st_uid != os.getuid() or info.st_mode & 0o022:
        os.close(fd)
        raise Confinement(f"sandboxes dir {text} is not this user's own private directory")
    if create:
        os.fchmod(fd, 0o700)  # agent-lb's own directory; no other user may list sandbox roots
    _PINNED[text] = (fd, (info.st_dev, info.st_ino))
    return fd


def sandboxes_id(base: Path | None = None) -> tuple[int, int]:
    """(device, inode) of the pinned sandboxes dir: start records it, stop refuses a different one."""
    sandboxes_fd(base)
    return _PINNED[os.path.normpath(os.path.abspath(base or SANDBOXES))][1]


def fd_path(fd: int) -> str:
    """The current path of an open directory, from the kernel (never by resolving a name)."""
    if sys.platform == "darwin":
        import fcntl

        return os.fsdecode(fcntl.fcntl(fd, fcntl.F_GETPATH, bytes(1024)).split(b"\0", 1)[0])
    return os.readlink(f"/proc/self/fd/{fd}")


def root_entry(root: Path) -> str | None:
    """What sits at root's name in the pinned sandboxes dir: "dir", "link", "other" or None (nothing)."""
    root = Path(root)
    try:
        info = os.stat(root.name, dir_fd=sandboxes_fd(root.parent), follow_symlinks=False)
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(info.st_mode):
        return "link"
    return "dir" if stat.S_ISDIR(info.st_mode) else "other"


def open_root(root: Path) -> int:
    """A descriptor for the sandbox root itself, by name in the pinned sandboxes dir; a root that is a link is
    refused."""
    root = Path(root)
    return os.open(root.name, DIR_FLAGS, dir_fd=sandboxes_fd(root.parent))


def open_dir(root: Path, rel: str | Path = "", create: bool = False) -> int:
    """A descriptor for directory rel under root, no link followed at any component."""
    fd = open_root(root)
    try:
        for part in Path(rel).parts:
            if part in (".", "..") or "/" in part:
                raise Confinement(f"unsafe path component {part!r}")
            if create:
                try:
                    os.mkdir(part, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
            child = os.open(part, DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def single_link(fd: int, what: object, reading: bool = False) -> int:
    """fd when it is a regular file with one link; otherwise closes it and raises Confinement.

    reading: a file the front or aux replaced atomically between the open and this check has no name left
    (st_nlink 0); for a read that is their own write, not a planted link. A second name is always refused."""
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink > 1 or (info.st_nlink == 0 and not reading):
        os.close(fd)
        raise Confinement(f"{what} is not a single-link regular file")
    return fd


def open_in_root(root: Path, rel: str | Path, flags: int, mode: int = 0o600, create_dirs: bool = False) -> int:
    """Open root/rel without following a link; O_TRUNC applies only after the single-link check."""
    rel = Path(rel)
    dir_fd = open_dir(root, rel.parent, create=create_dirs)
    try:
        # O_NONBLOCK: a FIFO planted in the root fails the single-link check instead of blocking the open.
        fd = os.open(rel.name, (flags & ~os.O_TRUNC) | os.O_NOFOLLOW | os.O_NONBLOCK, mode, dir_fd=dir_fd)
    finally:
        os.close(dir_fd)
    single_link(fd, rel, reading=flags & os.O_ACCMODE == os.O_RDONLY)
    if flags & os.O_TRUNC:
        os.ftruncate(fd, 0)
    return fd


def write_in_root(root: Path, rel: str | Path, data: bytes, mode: int = 0o600) -> None:
    """Write root/rel as a new inode (temp file, then rename in the same directory), never through a link."""
    rel = Path(rel)
    dir_fd = open_dir(root, rel.parent, create=True)
    tmp = f".{rel.name}.{os.getpid()}.{uuid.uuid4().hex[:8]}.tmp"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode, dir_fd=dir_fd)
        try:
            os.fchmod(fd, mode)
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view) :]
        finally:
            os.close(fd)
        os.replace(tmp, rel.name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise
    finally:
        os.close(dir_fd)


def append_in_root(root: Path, rel: str | Path):
    """root/rel opened for append (created if missing), refusing a link or a shared inode."""
    fd = open_in_root(root, rel, os.O_WRONLY | os.O_APPEND | os.O_CREAT, create_dirs=True)
    return os.fdopen(fd, "a")


def confined(action):
    """Run action(); a Confinement (a link or shared inode under the root) becomes a refusal."""
    try:
        return action()
    except OSError as exc:
        if isinstance(exc, Confinement) or exc.errno in (errno.ELOOP, errno.ENOTDIR):
            raise Refused(f"sandbox path is a link or shared file: {exc}") from None
        raise


def write_json(root: Path, rel: str | Path, data: object, mode: int = 0o600) -> None:
    write_in_root(root, rel, (json.dumps(data, indent=1, sort_keys=True) + "\n").encode(), mode)


def read_json(path: Path) -> dict:
    """A JSON object from a path outside any sandbox root (live state the caller reads on purpose)."""
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def read_root_json(root: Path, rel: str | Path) -> dict:
    """A JSON object from root/rel, opened without following a link at any component; {} when absent or not ours.

    sandbox.json swapped for a link to live state/front.json, or a hard link to it, reads as no metadata.
    """
    try:
        fd = open_in_root(root, rel, os.O_RDONLY)
    except OSError:
        return {}
    try:
        with os.fdopen(fd, "rb") as fh:
            data = json.loads(fh.read(1 << 20) or b"null")
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def read_root_text(root: Path, rel: str | Path, limit: int) -> str:
    """The last limit bytes of root/rel as text, read without following a link; "" when absent or not ours."""
    try:
        fd = open_in_root(root, rel, os.O_RDONLY)
    except OSError:
        return ""
    with os.fdopen(fd, "rb") as fh:
        size = os.fstat(fh.fileno()).st_size
        fh.seek(max(0, size - limit))
        return fh.read(limit).decode(errors="replace")


# ---------------------------------------------------------------- kernel confinement
# The descriptor helpers above cover lb-sandbox's own opens. The app, the front and the aux open paths by name,
# and their code is not ours to change, so two kernel rules cover every process that works in a root:
# - The root is its own volume (an encrypted sparse image mounted at the root). A hard link cannot cross
#   volumes, so no name under the root can share an inode with a live file.
# - Every process that works in a root runs under a Seatbelt profile (sandbox_init, inherited by children):
#   no write anywhere under the home directory except the root, and no read of live custody. Seatbelt
#   checks the resolved path, so a link planted in the root that leads to live state is denied, not followed.
# Without either, a link swapped in after a check (data -> ~/.agent-lb, state/front.json.tmp -> live
# front.json) would carry a write into the live service.


def seatbelt_profile(root: Path, reads: bool) -> str:
    """The SBPL profile for one root. reads=False confines writes only (start's copy needs the live runtime)."""

    def q(path: Path | str, resolve: bool = True) -> str:
        text = os.path.realpath(path) if resolve else str(path)
        if '"' in text or "\\" in text:
            raise Refused(f"path {text!r} cannot go in a sandbox profile")
        return f'"{text}"'

    rules = [
        "(version 1)",
        "(allow default)",
        f"(deny file-write* (subpath {q(REAL_HOME)}))",
    ]
    if reads:
        runtime = Path(os.path.realpath(LIVE_RUNTIME))
        try:
            envs = sorted(name for name in os.listdir(runtime) if name.startswith(".env"))
        except OSError:
            envs = []
        private = " ".join([f"(subpath {q(runtime / '.codex-lb')})"] + [f"(literal {q(runtime / n)})" for n in envs])
        custody = f"(subpath {q(LB_HOME)}) (subpath {q(LIVE_KEY_DIR_LEGACY)}) (literal {q(LIVE_PLIST)})"
        rules += [
            # Live custody: the agent-lb home (store key, state, logs), the legacy store dir and the live plist.
            f"(deny file-read-data {custody})",
            # The installed runtime is code (the venv and an editable install point into it), minus its env files.
            f"(allow file-read-data (subpath {q(runtime)}))",
            f"(deny file-read-data {private})",
        ]
    # The root's own name is never resolved: a root that is a link is refused by confine, not followed here. Its
    # parent must be its own real path (a linked sandboxes dir would put live state inside the profile), and the
    # profile names the pinned sandboxes dir's real path from the kernel: a sandboxes path swapped for a link
    # after the pin cannot widen the profile to live state.
    if os.path.realpath(Path(root).parent) != str(_lexical(Path(root).parent)):
        raise Refused(f"sandbox root {root} sits under a linked directory")
    own = Path(fd_path(sandboxes_fd(Path(root).parent))) / Path(root).name
    if reads:
        # The sandboxes directory itself (a listing of run ids, no file in it): confined opens start from a
        # descriptor for it (open_root).
        rules.append(f"(allow file-read-data (literal {q(own.parent, resolve=False)}))")
    # file-read-data named, not file-read*: a wildcard allow does not undo the deny of a named operation above.
    rules.append(f"(allow file-read* file-read-data file-write* (subpath {q(own, resolve=False)}))")
    return "".join(rules)


def _libsystem():
    import ctypes

    lib = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
    lib.sandbox_init.argtypes = [ctypes.c_char_p, ctypes.c_uint64, ctypes.POINTER(ctypes.c_char_p)]
    lib.sandbox_init.restype = ctypes.c_int
    lib.sandbox_check.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
    lib.sandbox_check.restype = ctypes.c_int
    return lib


def confine(root: Path, reads: bool = True) -> None:
    """Put this process (and every child it starts) under the root's Seatbelt profile. Irreversible; fails closed."""
    import ctypes

    if root_entry(root) != "dir":
        raise Refused(f"sandbox root {root} is not a real directory")
    profile = seatbelt_profile(root, reads)
    error = ctypes.c_char_p()
    if _libsystem().sandbox_init(profile.encode(), 0, ctypes.byref(error)) != 0:
        raise Refused(f"cannot confine to {root}: {(error.value or b'').decode(errors='replace')}")


def is_confined(pid: int | None) -> bool | None:
    """True when pid runs under a Seatbelt profile (None when it cannot be asked)."""
    if not pid or sys.platform != "darwin":
        return None
    try:
        return _libsystem().sandbox_check(int(pid), None, 0) == 1
    except OSError:
        return None


def run_confined(root: Path, action, reads: bool, timeout_s: int = 120):
    """action() in a forked child confined to root; its JSON-able result, or its Refused/Unhealthy re-raised.

    lb-sandbox runs only on macOS (launchd, hdiutil, Seatbelt); elsewhere no sandbox can exist and action runs
    in place, which only unit tests reach.
    """
    if sys.platform != "darwin":
        return action()
    read_fd, write_fd = os.pipe()
    pid = os.fork()
    if pid == 0:  # child: never returns
        code = 1
        try:
            os.close(read_fd)
            for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
                signal.signal(sig, signal.SIG_DFL)
            signal.alarm(timeout_s)
            confine(root, reads)
            out = {"ok": action()}
            code = 0
        except BaseException as exc:  # noqa: BLE001 - reported to the parent by class and message
            out = {"error": exc.__class__.__name__, "message": str(exc)}
        try:
            data = json.dumps(out).encode()
            while data:
                data = data[os.write(write_fd, data) :]
        finally:
            os._exit(code)
    os.close(write_fd)
    chunks = []
    with os.fdopen(read_fd, "rb") as fh:
        while chunk := fh.read(65536):
            chunks.append(chunk)
    os.waitpid(pid, 0)
    try:
        out = json.loads(b"".join(chunks) or b"{}")
    except ValueError:
        out = {}
    if "ok" in out:
        return out["ok"]
    kind = {"Refused": Refused, "Unhealthy": Unhealthy}.get(out.get("error"), Unhealthy)
    raise kind(f"confined step failed: {out.get('error', 'no result')}: {out.get('message', '')}")


def image_for(run_id: str) -> Path:
    """The run's volume image. Named by a hash: no command line (hdiutil's helpers) carries the run id."""
    return SANDBOXES / ".images" / f"{hashlib.sha256(check_run_id(run_id).encode()).hexdigest()[:24]}.sparseimage"


def on_own_volume(root: Path) -> bool:
    """True when root, opened by name in the pinned sandboxes dir with no link followed, is the top of a volume
    other than the sandboxes dir's."""
    try:
        sb = sandboxes_fd(Path(root).parent)
        fd = os.open(Path(root).name, DIR_FLAGS, dir_fd=sb)
    except OSError:
        return False
    try:
        return os.fstat(fd).st_dev != os.fstat(sb).st_dev
    finally:
        os.close(fd)


def check_own_volume(root: Path) -> None:
    if not on_own_volume(root):
        raise Refused(f"sandbox root {root} is not its own volume; refusing to work in it")


def _statfs_from(fd: int) -> str | None:
    """The device a directory descriptor's volume is mounted from (f_mntfromname, macOS), or None."""
    if sys.platform != "darwin":
        return None
    import ctypes

    class StatFS(ctypes.Structure):  # struct statfs with 64-bit inodes (the arm64 and modern x86_64 layout)
        _fields_ = [
            ("f_bsize", ctypes.c_uint32),
            ("f_iosize", ctypes.c_int32),
            ("f_blocks", ctypes.c_uint64),
            ("f_bfree", ctypes.c_uint64),
            ("f_bavail", ctypes.c_uint64),
            ("f_files", ctypes.c_uint64),
            ("f_ffree", ctypes.c_uint64),
            ("f_fsid", ctypes.c_int32 * 2),
            ("f_owner", ctypes.c_uint32),
            ("f_type", ctypes.c_uint32),
            ("f_flags", ctypes.c_uint32),
            ("f_fssubtype", ctypes.c_uint32),
            ("f_fstypename", ctypes.c_char * 16),
            ("f_mntonname", ctypes.c_char * 1024),
            ("f_mntfromname", ctypes.c_char * 1024),
            ("f_flags_ext", ctypes.c_uint32),
            ("f_reserved", ctypes.c_uint32 * 7),
        ]

    lib = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
    info = StatFS()
    if lib.fstatfs(fd, ctypes.byref(info)) != 0:
        return None
    device = info.f_mntfromname.decode(errors="replace")
    return device if re.fullmatch(r"/dev/disk[0-9]+(s[0-9]+)*", device) else None


def volume_device(root: Path) -> str | None:
    """The device of the volume mounted at root (opened by descriptor from the pinned sandboxes dir), or None
    when root is not its own volume. Detaching by this device never follows a name: a sandboxes path swapped
    for a link cannot point the unmount at another directory."""
    try:
        sb = sandboxes_fd(Path(root).parent)
        fd = os.open(Path(root).name, DIR_FLAGS, dir_fd=sb)
    except OSError:
        return None
    try:
        if os.fstat(fd).st_dev == os.fstat(sb).st_dev:
            return None
        return _statfs_from(fd)
    finally:
        os.close(fd)


def images_dir_fd() -> int:
    """A descriptor for <sandboxes>/.images, opened by name in the pinned sandboxes dir, created 0700, never a
    link, this user's own."""
    sb = sandboxes_fd()
    try:
        os.mkdir(".images", 0o700, dir_fd=sb)
    except FileExistsError:
        pass
    fd = os.open(".images", DIR_FLAGS, dir_fd=sb)
    if os.fstat(fd).st_uid != os.getuid():
        os.close(fd)
        raise Confinement("the images dir is not this user's own")
    os.fchmod(fd, 0o700)
    return fd


def image_exists(run_id: str) -> bool:
    """Whether the run's image is still there; True when the images dir cannot be reached safely (never "gone"
    unseen)."""
    try:
        fd = images_dir_fd()
    except FileNotFoundError:
        return False
    except OSError:
        return True
    try:
        os.stat(image_for(run_id).name, dir_fd=fd, follow_symlinks=False)
        return True
    except FileNotFoundError:
        return False
    finally:
        os.close(fd)


# What hdiutil writes first in an encrypted image: anything else at an image's name is not one this code made.
IMAGE_MAGIC = b"encrcdsa"


def _is_image(fd: int) -> bool:
    """True when fd is this user's single-link regular file that starts as an encrypted image does."""
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid():
        return False
    return os.pread(fd, len(IMAGE_MAGIC), 0) == IMAGE_MAGIC


def remove_image(run_id: str) -> bool:
    """Unlink the run's image inside the real images dir; True when it is gone.

    The entry is renamed to a private name first, then unlinked only when that removes nothing but a name (a
    symlink, or a file with another hard link) or the inode there is checked as an image. A live file renamed
    over the image's name (bin/lb-restart, say), its only name now, is never unlinked: it goes back under that
    name and the image counts as not removed."""
    name = image_for(run_id).name
    try:
        fd = images_dir_fd()
    except FileNotFoundError:
        return True
    except OSError:
        return False
    aside = f".{name}.{os.getpid()}.{uuid.uuid4().hex[:8]}.rm"
    try:
        try:
            os.rename(name, aside, src_dir_fd=fd, dst_dir_fd=fd)
        except FileNotFoundError:
            return True
        entry = os.stat(aside, dir_fd=fd, follow_symlinks=False)
        if stat.S_ISLNK(entry.st_mode) or (stat.S_ISREG(entry.st_mode) and entry.st_nlink > 1):
            os.unlink(aside, dir_fd=fd)  # only this name goes; the link's target or the file's other name stays
            return True
        image = -1
        if stat.S_ISREG(entry.st_mode):
            try:
                image = os.open(aside, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
            except OSError:
                image = -1  # swapped since the stat, or unreadable: not checked as an image, so not removed
        try:
            if image >= 0 and _is_image(image):
                info = os.fstat(image)
                if _same_entry(fd, aside, (info.st_dev, info.st_ino)):
                    os.unlink(aside, dir_fd=fd)
                    return True
        finally:
            if image >= 0:
                os.close(image)
        # Not ours: put it back under the image's name (left in place if that name was taken meanwhile), so the
        # image still counts as present and the teardown is not clean.
        try:
            os.stat(name, dir_fd=fd, follow_symlinks=False)
        except FileNotFoundError:
            os.rename(aside, name, src_dir_fd=fd, dst_dir_fd=fd)
        return False
    except OSError:
        return False
    finally:
        os.close(fd)
    return True


def _in_dir(fd: int):
    """A preexec_fn that moves the child into directory fd before exec, with umask 077: the bare names the tool
    gets resolve from that directory's inode, never through a path that could be swapped, and what it creates is
    private from the start (the image is never chmod'ed after the fact)."""

    def enter() -> None:
        os.umask(0o077)
        os.fchdir(fd)

    return enter


def _image_identity(images_fd: int, name: str, made_after: float) -> tuple[int, int]:
    """(device, inode) of the image hdiutil just made at name in the images dir, opened with no link followed.

    Nothing is changed on it. It must be this user's single-link regular file, private (hdiutil created it under
    umask 077), born no earlier than the create began, and start as an encrypted image does. A live file renamed
    over the name after the create (bin/lb-restart, state/front.json) fails these and is refused untouched."""
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=images_fd)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid():
            raise Confinement(f"image {name} is not this user's single-link regular file")
        if stat.S_IMODE(info.st_mode) & 0o077:
            raise Confinement(f"image {name} is not private; not the image hdiutil made")
        born = getattr(info, "st_birthtime", info.st_mtime)
        if born < made_after - 1 or os.pread(fd, len(IMAGE_MAGIC), 0) != IMAGE_MAGIC:
            raise Confinement(f"image {name} is not the encrypted image this create made")
        return info.st_dev, info.st_ino
    finally:
        os.close(fd)


def _same_entry(dir_fd: int, name: str, ident: tuple[int, int]) -> bool:
    try:
        info = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
    except OSError:
        return False
    return stat.S_ISREG(info.st_mode) and (info.st_dev, info.st_ino) == ident


def _detach_attached(plist_out: bytes) -> None:
    """Unmount, by device, whatever one hdiutil attach -plist reported."""
    try:
        entities = plistlib.loads(plist_out).get("system-entities", [])
    except Exception:
        entities = []
    for device in sorted({e["dev-entry"] for e in entities if isinstance(e.get("dev-entry"), str)}, key=len):
        subprocess.run(["/usr/bin/hdiutil", "detach", "-quiet", "-force", device], capture_output=True, timeout=60)


def attach_volume(root: Path, run_id: str) -> None:
    """Create the run's encrypted sparse image and mount it at root (an empty directory start just made).

    The passphrase is random, lives only in this process and goes to hdiutil on stdin, so the image on disk is
    ciphertext: neither the scan of ~/.agent-lb nor a copy of the image finds the store, key or tokens in it.

    hdiutil runs inside the images dir held by descriptor, under umask 077, and gets the image by its bare name.
    The image is opened with no link followed and must be the private encrypted image this create made
    (_image_identity); nothing is ever chmod'ed. Its identity is checked again right
    before attach and after it, and the mount must land on root as reached from the pinned sandboxes dir. An
    image swapped for a link (to a live helper, say) is refused, never chmod'ed or attached through.
    """
    import secrets as secrets_module

    name = image_for(run_id).name
    if not remove_image(run_id):
        raise Unhealthy(f"stale image {name} could not be removed")
    images = images_dir_fd()
    try:
        passphrase = secrets_module.token_hex(32).encode()
        made_after = time.time()
        create = subprocess.run(
            ["/usr/bin/hdiutil", "create", "-quiet", "-size", VOLUME_SIZE, "-type", "SPARSE", "-fs", "APFS"]
            + ["-volname", "lb-sandbox", "-encryption", "AES-256", "-stdinpass", name],
            input=passphrase,
            capture_output=True,
            timeout=180,
            check=False,
            preexec_fn=_in_dir(images),
        )
        if create.returncode != 0:
            raise Unhealthy(f"hdiutil create failed (exit {create.returncode})")
        try:
            ident = _image_identity(images, name, made_after)
        except OSError as exc:
            raise Refused(f"the new image was swapped before attach ({exc.__class__.__name__}); not attached") from None
        mountpoint = os.path.join(fd_path(sandboxes_fd(Path(root).parent)), Path(root).name)
        if not _same_entry(images, name, ident):
            raise Refused("the new image was swapped before attach; not attached")
        attach = subprocess.run(
            ["/usr/bin/hdiutil", "attach", "-plist", "-nobrowse", "-noautoopen", "-owners", "on", "-stdinpass"]
            + ["-mountpoint", mountpoint, name],
            input=passphrase,
            capture_output=True,
            timeout=120,
            check=False,
            preexec_fn=_in_dir(images),
        )
        del passphrase
        if attach.returncode == 0 and not (_same_entry(images, name, ident) and on_own_volume(root)):
            _detach_attached(attach.stdout)  # mounted, but not our image or not at our root
            raise Unhealthy("the sandbox volume did not mount our image at the root")
    finally:
        os.close(images)
    if attach.returncode != 0 or not on_own_volume(root):
        raise Unhealthy(f"the sandbox volume did not mount at {root} (hdiutil exit {attach.returncode})")
    fd = open_root(root)
    try:
        os.fchmod(fd, 0o700)
    finally:
        os.close(fd)
    write_in_root(root, ".metadata_never_index", b"")  # Spotlight never reads the store


def detach_volume(root: Path) -> dict:
    """Unmount the run's volume from root (plain, then forced), by the device mounted on root's descriptor.
    Returns what happened, never raises."""
    if not on_own_volume(root):
        return {"volume": "not mounted"}
    for extra in ([], [], ["-force"]):
        device = volume_device(root)
        if device is None:
            return {"volume": "still mounted"} if on_own_volume(root) else {"volume": "detached"}
        subprocess.run(
            ["/usr/bin/hdiutil", "detach", "-quiet", *extra, device], capture_output=True, timeout=60, check=False
        )
        if not on_own_volume(root):
            return {"volume": "detached"}
        time.sleep(1)
    return {"volume": "still mounted"}


def http(port: int, path: str, timeout: float = 3.0) -> tuple[int, bytes]:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as exc:
        return exc.code, b""
    except Exception:
        return 0, b""


def port_free(port: int) -> bool:
    with socket.socket() as sock:
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def sandbox_roots() -> list[Path]:
    """Every directory directly under SANDBOXES whose name is a run id (links and .images never count)."""
    try:
        with os.scandir(sandboxes_fd()) as listing:
            entries = sorted(((e.name, e.is_dir(follow_symlinks=False)) for e in listing), key=lambda e: e[0])
    except OSError:
        return []
    return [SANDBOXES / name for name, is_dir in entries if RUN_ID_RE.match(name) and is_dir]


def ports_in_use_by_sandboxes() -> set[int]:
    used: set[int] = set()
    for root in sandbox_roots():
        ports = read_root_json(root, "sandbox.json").get("ports", {})
        used.update(int(p) for p in (ports.values() if isinstance(ports, dict) else []) if isinstance(p, int))
    return used


def pick_ports(count: int, taken: set[int]) -> list[int]:
    picked: list[int] = []
    for port in PICK_RANGE:
        if port in FORBIDDEN_PORTS or port in taken or port in picked:
            continue
        if port_free(port):
            picked.append(port)
            if len(picked) == count:
                return picked
    raise Unhealthy("no free sandbox ports in 2470-2599")


def run(argv: list[str], timeout: float = 30) -> subprocess.CompletedProcess:
    # Output of these tools carries no credentials (launchctl, lsof, ps); still never relayed raw.
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)


def launchd_pid(label: str) -> int | None:
    out = run(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"]).stdout
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("pid = "):
            try:
                return int(line.split("=", 1)[1])
            except ValueError:
                return None
    return None


def label_loaded(label: str) -> bool:
    return run(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"]).returncode == 0


def listener_pids(port: int) -> list[int]:
    out = run(["/usr/sbin/lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"]).stdout.split()
    return sorted({int(pid) for pid in out if pid.isdigit()})


def listener_addresses(pids: list[int]) -> list[dict]:
    """Every TCP listener of the given pids with its bound address."""
    if not pids:
        return []
    out = run(["/usr/sbin/lsof", "-nP", "-a", "-p", ",".join(map(str, pids)), "-iTCP", "-sTCP:LISTEN"]).stdout
    found = []
    for line in out.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 9:
            found.append({"pid": int(parts[1]), "address": parts[8]})
    return found


def processes() -> list[tuple[int, int, str]]:
    out = run(["/bin/ps", "-axww", "-o", "pid=,ppid=,command="]).stdout
    rows = []
    for line in out.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            rows.append((int(parts[0]), int(parts[1]), parts[2]))
    return rows


def names_root(cmd: str, root: Path) -> bool:
    """True when a command line names this sandbox root itself or a path inside it (never a sibling run)."""
    text = str(root)
    return any(token == text or token.startswith(text + "/") for token in cmd.split())


def names_label(cmd: str, run_id: str) -> bool:
    """True when a command line holds this run's launchd label (or gui/<uid>/<label>) as a whole token."""
    labels = set(labels_for(run_id))
    return any(token.rsplit("/", 1)[-1] in labels for token in cmd.split() if token.startswith(("gui/", LABEL_PREFIX)))


def names_run(cmd: str, run_id: str) -> bool:
    """True when a command line is a command of this run: its label, or `--run-id R` as an argument pair.

    Never a bare word: run id `aneyman` or `runtime` must not claim the live agent-lb, whose command line holds
    both as path segments. Used to find processes to inspect or report, never to choose what to kill.
    """
    return names_label(cmd, run_id) or run_argument(cmd, run_id)


def run_argument(cmd: str, run_id: str) -> bool:
    """True when a command line passes this run id as `--run-id R` or `--run-id=R`."""
    tokens = cmd.split()
    return any(
        token == f"--run-id={run_id}" or (token == "--run-id" and tokens[i + 1 : i + 2] == [run_id])
        for i, token in enumerate(tokens)
    )


def owned_process(cmd: str, root: Path, run_id: str) -> bool:
    """What stop may signal: a process naming this sandbox root (or a path in it) or this run's launchd label."""
    return names_root(cmd, root) or names_label(cmd, run_id)


def own_lineage(rows: list[tuple[int, int, str]]) -> set[int]:
    parents = {pid: ppid for pid, ppid, _ in rows}
    lineage, pid = set(), os.getpid()
    while pid and pid not in lineage:
        lineage.add(pid)
        pid = parents.get(pid, 0)
    return lineage


def pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def emit(data: dict, code: int) -> int:
    print(json.dumps(data, indent=1, sort_keys=True), flush=True)
    return code


def stamped_meta(root: Path, run_id: str) -> dict:
    """sandbox.json when it is this run's own (a real single-link file stamped with run_id and its label), else {}."""
    meta = read_root_json(root, "sandbox.json")
    if meta.get("run_id") != run_id:
        return {}
    if "label" in meta and meta["label"] != labels_for(run_id)[0]:
        return {}
    return meta


def load_meta(run_id: str) -> tuple[Path, dict]:
    root = check_root(root_for(run_id))
    meta = stamped_meta(root, run_id)
    if not meta:
        raise Unhealthy(f"no sandbox {run_id} (no sandbox.json stamped with this run id under {root})")
    return root, meta


# ---------------------------------------------------------------- secrets (agent-lb custody only)


def live_federation_token(plist: Path | None = None) -> str | None:
    """The live federation token, read into this process only. Never printed, written or passed in argv."""
    with (plist or LIVE_PLIST).open("rb") as fh:
        env = plistlib.load(fh).get("EnvironmentVariables", {})
    value = env.get(TOKEN_ENV)
    return str(value) if value else None


def _fernet(root: Path):
    from cryptography.fernet import Fernet

    key = read_key(root)
    if not key:
        raise Refused("sandbox store key missing")
    return Fernet(key.encode())


def open_data_dir(root: Path, expect: tuple[int, int] | list[int] | None = None) -> int:
    """A descriptor for <root>/data, opened by name in the root descriptor with no link followed.

    It must be a real directory of this user on the root's own device (a volume mounted over data/ is refused)
    and, given expect, the very (device, inode) a caller recorded earlier: a data dir renamed aside and replaced
    after that check is refused. Every later open of the store, its journals and the key goes relative to this
    descriptor, never by name through the root again. Raises FileNotFoundError when there is no data dir and
    Refused otherwise.
    """
    root_fd = open_root(root)
    try:
        try:
            fd = os.open("data", DIR_FLAGS, dir_fd=root_fd)
        except FileNotFoundError:
            raise
        except OSError as exc:
            raise Refused(f"sandbox data dir is not a real directory ({exc.__class__.__name__})") from None
        info, top = os.fstat(fd), os.fstat(root_fd)
    finally:
        os.close(root_fd)
    if info.st_dev != top.st_dev or info.st_uid != os.getuid():
        os.close(fd)
        raise Refused("sandbox data dir is not this user's own on the root's volume")
    if expect is not None and (info.st_dev, info.st_ino) != tuple(expect):
        os.close(fd)
        raise Refused("sandbox data dir changed since it was checked")
    return fd


def check_data_custody_fd(data_fd: int) -> None:
    """Refuse a store, journal or key in the data dir at data_fd that is a link or shares its inode, or an
    archive dir that is not a real directory.

    A hard link from the sandbox's data/ to the live store or key would let the sandbox open, migrate or
    unlink live custody files; a single link proves the file is the sandbox's own.
    """
    for name in [Path(rel).name for rel in CUSTODY_FILES] + ["federation-push.json"]:
        try:
            info = os.stat(name, dir_fd=data_fd, follow_symlinks=False)
        except FileNotFoundError:
            continue
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid():
            raise Refused(f"sandbox data/{name} is not a private single-link file")
    try:
        info = os.stat("conversation-archive", dir_fd=data_fd, follow_symlinks=False)
        if not stat.S_ISDIR(info.st_mode):
            raise Refused("sandbox data/conversation-archive is not a real directory")
    except FileNotFoundError:
        pass


def check_data_custody(root: Path) -> None:
    """Refuse a data dir that is a link, or a store, journal or key that is a link or shares its inode."""
    try:
        data_fd = open_data_dir(root)
    except FileNotFoundError:
        return
    except OSError as exc:
        raise Refused(f"sandbox data dir is not a real directory under the root ({exc.__class__.__name__})") from None
    try:
        check_data_custody_fd(data_fd)
    finally:
        os.close(data_fd)


def store_rows(root: Path) -> list[list]:
    """The account rows of the root's store, bytes as {"b64": ...} so they cross a pipe as JSON ([] unmigrated).

    The process works inside the data dir descriptor for the whole read and SQLite gets the bare name: the store
    is never reached by a name through the root, so a data dir swapped after the checks cannot lead it into live
    custody. Runs in a child confined to the root (read_accounts), where a live path is denied as well.
    """
    data_fd = open_data_dir(root)
    here = os.open(".", os.O_RDONLY | os.O_DIRECTORY)
    try:
        check_data_custody_fd(data_fd)
        os.fchdir(data_fd)
        con = sqlite3.connect("file:store.db?mode=ro", uri=True, timeout=5)
        try:
            rows = con.execute(
                "SELECT id, provider, status, access_expires_at, access_token_encrypted, id_token_encrypted,"
                " reset_at, blocked_at, refresh_token_encrypted FROM accounts"
            ).fetchall()
        except sqlite3.OperationalError as exc:
            if "no such table" in str(exc):
                return []  # the store exists but the app has not migrated it: no token was ever written
            raise
        finally:
            con.close()
    finally:
        os.fchdir(here)
        os.close(here)
        os.close(data_fd)
    return [
        [{"b64": base64.b64encode(bytes(v)).decode()} if isinstance(v, (bytes, memoryview)) else v for v in row]
        for row in rows
    ]


def read_accounts(root: Path, *, with_tokens: bool = False, strict: bool = False) -> list[dict]:
    """Mirrored accounts from the sandbox store. Tokens stay in this process; callers get auth_hash12.

    strict (scan and stop): any store or decryption error raises, so a scan never runs with secrets missing.
    """
    try:
        check_data_custody(root)
        data_fd = open_data_dir(root)
    except FileNotFoundError:
        data_fd = None
    except (Refused, OSError):
        if strict:
            raise Refused("sandbox data dir is linked, shared or not the root's; its tokens cannot be read") from None
        return []
    has_store = False
    if data_fd is not None:
        try:
            has_store = stat.S_ISREG(os.stat("store.db", dir_fd=data_fd, follow_symlinks=False).st_mode)
        except OSError:
            pass
        finally:
            os.close(data_fd)
    if not has_store:
        if strict:
            raise Refused("sandbox store missing; its account tokens cannot be scanned for")
        return []
    try:
        # The read works inside the data dir descriptor (store_rows), in a child confined to the root as well.
        rows = run_confined(root, lambda: store_rows(root), reads=True, timeout_s=60)
    except (Refused, Unhealthy, sqlite3.Error):
        if strict:
            raise
        return []
    rows = [tuple(base64.b64decode(v["b64"]) if isinstance(v, dict) else v for v in row) for row in rows]
    fernet = _fernet(root) if rows else None
    now = time.time()
    accounts = []

    def decrypt(blob) -> str:
        try:
            return fernet.decrypt(bytes(blob)).decode() if fernet and blob else ""
        except Exception:
            if strict:
                raise
            return ""  # status reports a row this key cannot open without a hash

    for account_id, provider, status, expires_at, access_enc, id_enc, reset_at, blocked_at, refresh_enc in rows:
        token = decrypt(access_enc)
        expires_in = None
        if expires_at:
            try:
                stamp = dt.datetime.fromisoformat(str(expires_at)).replace(tzinfo=dt.timezone.utc)
                expires_in = int(stamp.timestamp() - now)
            except ValueError:
                expires_in = None
        cooling = status in ("rate_limited", "quota_exceeded") or bool(
            blocked_at and reset_at and float(reset_at) > now
        )
        entry = {
            "id": account_id,
            "vendor": VENDOR_OF_PROVIDER.get(str(provider), str(provider)),
            "status": status,
            "expires_in_s": expires_in,
            "auth_hash12": hashlib.sha256(f"Bearer {token}".encode()).hexdigest()[:12] if token else None,
            "in_cooldown": cooling,
            "cooldown_until": int(reset_at) if cooling and reset_at else None,
            "usable": status == "active" and expires_in is not None and expires_in > USABLE_EXPIRY_S,
        }
        if with_tokens:
            entry["_secrets"] = [secret for secret in (token, decrypt(id_enc), decrypt(refresh_enc)) if secret]
            # The stored ciphertexts too: a copy of the store (or a page of it) in an output dir is a leak.
            entry["_ciphertexts"] = [
                bytes(blob).decode("ascii", "replace") for blob in (access_enc, id_enc, refresh_enc) if blob
            ]
        accounts.append(entry)
    return sorted(accounts, key=lambda a: (a["vendor"], a["id"]))


def read_key(root: Path) -> str | None:
    """The sandbox store key, read without following a link at any component (None when never keyed).

    A key that is a link, sits in a linked data dir or shares its inode raises Confinement.
    """
    try:
        fd = open_in_root(root, "data/encryption.key", os.O_RDONLY)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, "rb") as fh:
        return fh.read().strip().decode("ascii", "replace") or None


def create_key(path: Path) -> None:
    """A fresh store key, 0600, created exclusively: never reuses or follows a file someone placed there."""
    from cryptography.fernet import Fernet

    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as fh:
        fh.write(Fernet.generate_key())


def load_secrets(root: Path | None) -> list[str]:
    """What no scanned file may hold: the live token, mirrored tokens, the store key and stored ciphertexts."""
    secrets = []
    token = live_federation_token()
    if not token:
        raise Refused("live federation token not found; a scan without it would be incomplete")
    secrets.append(token)
    if root is not None and entry_of(root) == "dir":
        for account in read_accounts(root, with_tokens=True, strict=True):
            secrets.extend(s for s in account.pop("_secrets") if s)
            secrets.extend(s for s in account.pop("_ciphertexts") if s)
        key = load_key(root)
        if key:
            secrets.append(key)
    return secrets


def load_key(root: Path | None) -> str | None:
    """The store key for the ciphertext detector; a redirected key is a refusal, never a quiet skip."""
    if root is None or entry_of(root) != "dir":
        return None
    try:
        return read_key(root)
    except OSError as exc:
        raise Refused(f"sandbox store key is redirected or shared ({exc.__class__.__name__})") from None


def custody_paths(root: Path) -> list[Path]:
    """The exact files allowed to hold custody material; a copy anywhere else (a hard link included) is a hit."""
    return [root / rel for rel in CUSTODY_FILES]


def secret_patterns(secret: str) -> list[bytes]:
    """The secret raw and as it appears inside standard or URL-safe base64 at any byte alignment."""
    raw = secret.encode()
    patterns = {raw}
    for encode in (base64.b64encode, base64.urlsafe_b64encode):
        for shift, skip in ((0, 0), (1, 2), (2, 3)):
            encoded = encode(b"\0" * shift + raw).rstrip(b"=")
            # Keep only characters made entirely of secret bits.
            whole = ((shift + len(raw)) * 8) // 6
            # Kept at any length: a short secret's fragment may match by chance (a false alarm), never miss.
            if encoded[skip:whole]:
                patterns.add(encoded[skip:whole])
    return sorted(p for p in patterns if p)


# A Fernet token is url-safe base64 of 0x80 | timestamp(8) | IV(16) | AES-CBC blocks | HMAC(32). Its first
# 56 characters decode to 42 bytes: version, timestamp, IV and the first ciphertext block.
FERNET_FRAGMENT = re.compile(rb"(?=(gAAAAA[A-Za-z0-9_-]{50}))")
FERNET_FRAGMENT_CHARS = 56
# A store snapshot base64-encoded once more (standard or URL-safe alphabet, one line or wrapped) holds each
# Fernet token as base64 of base64. 56 fragment characters take at least 75 encoded characters; a run that short
# or longer is decoded at each of the four alignments and the decoded bytes are searched like a raw file.
B64_RUN = re.compile(rb"[A-Za-z0-9+/_\-\r\n]{75,}")
# Window the scan keeps across a chunk boundary for that search: an encoded fragment spans at most 78
# characters, and line breaks (CRLF every 64 or 76 characters) add at most a few more.
B64_FRAGMENT_SPAN = 96
B64_STANDARD = bytes.maketrans(b"-_", b"+/")


def base64_decodings(buf: bytes):
    """The bytes each long base64 run in buf decodes to, at each of the four alignments, either alphabet."""
    for match in B64_RUN.finditer(buf):
        text = match.group(0).translate(B64_STANDARD, b"\r\n")
        for offset in range(4):
            piece = text[offset:]
            piece = piece[: len(piece) - len(piece) % 4]
            if len(piece) >= 4:
                yield binascii.a2b_base64(piece)


def plausible_plaintext(block: bytes) -> bool:
    """True for a first block a token encrypts to: printable ASCII, or printable ASCII then PKCS7 padding.

    A wrong key gives 16 random bytes, printable by chance about once in 10^7 tries.
    """
    pad = block[-1]
    body = block[:-pad] if 1 <= pad <= 16 and block.endswith(bytes([pad]) * pad) else block
    return bool(body) and all(0x20 <= b < 0x7F for b in body)


class Detector:
    """What a scanned byte range may not hold.

    The secrets raw and inside base64 (secret_patterns), and, given the sandbox store key, any ciphertext
    that key opens: a Fernet token (even a fragment, such as one split across SQLite overflow pages) whose
    first block decrypts to token text, raw or inside standard or URL-safe base64 (base64_decodings). That
    catches a copy of the store taken before a mirror cycle re-encrypted every row, which matches no current
    ciphertext, and the same copy base64-encoded.
    """

    def __init__(self, secrets: list[str], keys: list[str] | None = None) -> None:
        self.patterns = sorted({p for s in secrets if s for p in secret_patterns(s)})
        self.decryptors = []
        for key in keys or []:
            if not key:
                continue
            from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

            raw = base64.urlsafe_b64decode(key.encode() if isinstance(key, str) else key)
            self.decryptors.append(Cipher(algorithms.AES(raw[16:]), modes.ECB()).decryptor())
        lengths = [len(p) for p in self.patterns] + ([B64_FRAGMENT_SPAN] if self.decryptors else [])
        self.overlap = max(lengths, default=1) - 1

    def __bool__(self) -> bool:
        return bool(self.patterns)

    def opens(self, fragment: bytes) -> bool:
        raw = base64.urlsafe_b64decode(fragment[:FERNET_FRAGMENT_CHARS])
        iv, first = raw[9:25], raw[25:41]
        return any(
            plausible_plaintext(bytes(a ^ b for a, b in zip(dec.update(first), iv, strict=True)))
            for dec in self.decryptors
        )

    def keyed(self, buf: bytes) -> bool:
        return b"gAAAAA" in buf and any(self.opens(m.group(1)) for m in FERNET_FRAGMENT.finditer(buf))

    def hit(self, buf: bytes) -> bool:
        if any(p in buf for p in self.patterns):
            return True
        if not self.decryptors:
            return False
        # Raw, then inside base64: a snapshot encoded for transport is still the snapshot.
        return self.keyed(buf) or any(self.keyed(decoded) for decoded in base64_decodings(buf))


def scan_stream(read, detector: Detector, write=None, chunk: int = 4 << 20) -> tuple[bool, int]:
    """Feed read(n) blocks through the detector (and to write, when given). Returns (hit, bytes read)."""
    tail, total = b"", 0
    while True:
        block = read(chunk)
        if not block:
            return False, total
        total += len(block)
        buf = tail + block
        if detector.hit(buf):
            return True, total
        if write is not None:
            write(block)
        tail = buf[-detector.overlap :] if detector.overlap > 0 else b""


NOFOLLOW_ANY = getattr(os, "O_NOFOLLOW_ANY", 0)  # macOS: refuse a link at any component of the path
READ_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
# A multi-link file whose inode changed within this long before the live inode set's last refresh forces another
# (filesystem timestamps can trail the wall clock by a tick).
ALIAS_CTIME_SLACK_NS = 2_000_000_000
# A whole path with no link anywhere (O_NOFOLLOW_ANY; macOS refuses it combined with O_NOFOLLOW, EINVAL).
PATH_FLAGS = os.O_RDONLY | os.O_NONBLOCK | (NOFOLLOW_ANY or os.O_NOFOLLOW)
# The event log fseventsd keeps at the top of every mounted volume: owned by root, unreadable to the run and
# unwritable by it, so it can hold no token the run wrote. Skipped only there (the top of this run's root, or of
# any other volume the walk enters, such as a concurrent run's root), only root-owned, only on that volume; a
# directory of that name the run could have made is scanned like any other.
VOLUME_EVENT_LOG = ".fseventsd"


def volume_top(dir_fd: int) -> bool:
    """True when the directory at dir_fd is the top of a mounted volume (its .. is on another device)."""
    try:
        return os.fstat(dir_fd).st_dev != os.stat("..", dir_fd=dir_fd).st_dev
    except OSError:
        return False


def _under(path: str, base: str) -> bool:
    return path == base or path.startswith(base + os.sep)


def root_text(root: Path) -> str:
    """The root as the walker spells it: the pinned sandboxes dir's real path from the kernel, then the root's own
    name, never followed. With no sandboxes dir to pin (the root is gone), its parent resolved."""
    try:
        parent = fd_path(sandboxes_fd(Path(root).parent))
    except OSError:
        parent = os.path.realpath(Path(root).parent)
    return os.path.join(parent, Path(root).name)


def live_trees() -> list[str]:
    """The live agent-lb custody and state trees, as path text: the agent-lb home and the legacy store dir."""
    return [os.path.abspath(LB_HOME), os.path.abspath(LIVE_KEY_DIR_LEGACY)]


class LiveInodes:
    """(device, inode) of every regular file in the live agent-lb trees (the sandboxes dir and the runtime's venvs,
    which are code, excepted) and of the live plist. A file elsewhere with one of these inodes is a live file
    reached by another name.

    Every file is kept, not only those with a second name now: a hard link made later to a live file that has one
    name today (state/front.json) is still its inode. refresh() first walks the trees once; after that it
    re-lists only directories whose mtime changed since it last listed them (a new entry, a live file written
    by rename, changes it), so the set is current as of the moment the latest refresh began (started_ns)."""

    def __init__(self) -> None:
        self.ids: set[tuple[int, int]] = set()
        self.dirs: dict[str, tuple[int, int, int]] = {}  # path -> (device, inode, mtime_ns when last listed)
        self.started_ns: int | None = None
        self.skip = {os.path.abspath(SANDBOXES)}

    def _list(self, path: str) -> list[tuple[str, os.stat_result]]:
        """Add the regular files directly in path; return its subdirectories not yet known."""
        new = []
        try:
            with os.scandir(path) as listing:
                entries = [entry.path for entry in listing]
        except OSError:
            return new
        for child in entries:
            try:
                info = os.stat(child, follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISREG(info.st_mode):
                self.ids.add((info.st_dev, info.st_ino))
            elif stat.S_ISDIR(info.st_mode) and os.path.basename(child) != ".venv" and child not in self.skip:
                if child not in self.dirs:
                    new.append((child, info))
        return new

    def _add_tree(self, path: str, info: os.stat_result) -> None:
        stack = [(path, info)]
        while stack:
            here, seen = stack.pop()
            # The mtime is the one read before the listing: an entry added during it shows at the next refresh.
            self.dirs[here] = (seen.st_dev, seen.st_ino, seen.st_mtime_ns)
            stack.extend(self._list(here))

    def refresh(self) -> None:
        self.started_ns = time.time_ns()
        try:
            info = os.stat(LIVE_PLIST, follow_symlinks=False)
            if stat.S_ISREG(info.st_mode):
                self.ids.add((info.st_dev, info.st_ino))
        except OSError:
            pass
        for path, (dev, ino, mtime_ns) in list(self.dirs.items()):
            try:
                info = os.stat(path, follow_symlinks=False)
            except OSError:
                del self.dirs[path]
                continue
            if not stat.S_ISDIR(info.st_mode):
                del self.dirs[path]
            elif (info.st_dev, info.st_ino) != (dev, ino):
                del self.dirs[path]
                self._add_tree(path, info)  # a directory replaced at this path: all of it is new
            elif info.st_mtime_ns != mtime_ns:
                self.dirs[path] = (dev, ino, info.st_mtime_ns)
                for sub, sub_info in self._list(path):
                    self._add_tree(sub, sub_info)
        for top in live_trees():
            if top in self.dirs:
                continue
            try:
                info = os.stat(top, follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISDIR(info.st_mode):
                self._add_tree(top, info)


def system_links_resolved(text: str) -> str:
    """text with only root-owned links resolved (/var -> private/var, /tmp -> private/tmp: TMPDIR sits behind
    them). A link this user could have made, at any component, is refused with ELOOP, never followed: a scan path
    out/linked-parent/front.json with linked-parent -> ~/.agent-lb/state would otherwise name the live file."""
    parts = list(Path(os.path.abspath(text)).parts[1:])
    done = "/"
    hops = 0
    while parts:
        part = parts.pop(0)
        candidate = os.path.join(done, part)
        try:
            info = os.lstat(candidate)
        except (FileNotFoundError, NotADirectoryError):
            return os.path.join(candidate, *parts)  # the open that follows fails the same way
        if not stat.S_ISLNK(info.st_mode):
            done = candidate
            continue
        hops += 1
        if info.st_uid != 0 or hops > 32:
            raise Confinement(errno.ELOOP, f"{candidate} is a link this user could have made; not followed")
        target = os.readlink(candidate)
        rest = Path(os.path.normpath(os.path.join(done, target))).parts[1:]
        parts = [*rest, *parts]
        done = "/"
    return done


def _open_top(top: Path, root: Path | None) -> tuple[int, str]:
    """(descriptor, path text) for a scan top, never following a link this user could have made.

    Inside the sandbox root the path is opened from a root descriptor one component at a time, no link
    followed. Elsewhere only root-owned links in the top's parent are resolved (TMPDIR sits behind /var ->
    /private/var; system_links_resolved), the parent is opened with no link at any component since, and the
    top is opened in it with O_NOFOLLOW: a top that is a link (to the live key, say), or under a parent that is
    a user's link (to live state/), is refused with ELOOP and the scan is incomplete, never read through.
    """
    text = os.path.abspath(top)
    parent, name = os.path.split(text)
    resolved = os.path.join(system_links_resolved(parent), name) if name else system_links_resolved(text)
    if root is not None:
        base = root_text(root)
        for candidate in (text, resolved):
            if _under(candidate, base):
                rel = Path(os.path.relpath(candidate, base))
                if rel == Path("."):
                    return open_root(root), base
                dir_fd = open_dir(root, rel.parent)
                try:
                    return os.open(rel.name, READ_FLAGS, dir_fd=dir_fd), candidate
                finally:
                    os.close(dir_fd)
    if not name:
        return os.open(resolved, os.O_RDONLY | os.O_DIRECTORY), resolved
    parent_fd = os.open(os.path.dirname(resolved), os.O_RDONLY | os.O_DIRECTORY | (NOFOLLOW_ANY or os.O_NOFOLLOW))
    try:
        return os.open(name, READ_FLAGS, dir_fd=parent_fd), resolved
    finally:
        os.close(parent_fd)


def walk_files(
    paths: list[Path],
    newer_than: float | None,
    exclude: list[Path],
    unreadable: list[str],
    skip_exact: list[Path] | None = None,
    root: Path | None = None,
):
    """(path text, open descriptor) for each regular file under paths, modified after newer_than, outside exclude.

    The walk holds a descriptor for every directory and opens each entry relative to it with O_NOFOLLOW, so a
    parent swapped for a link between the listing and the open is never followed; a file is read only when the
    descriptor is the inode the listing named. Symlinks are never followed, a top that is a link included. A file
    with a second hard link under the sandbox root or in a live agent-lb tree, or anywhere with the inode of a
    live agent-lb file (LiveInodes: an output dir holding a hard link to live state/front.json), is not read
    and counts as unreadable (the scan is incomplete). Other multi-link files (git objects of a local clone in
    TMPDIR) are read: they cannot be a live file.
    skip_exact names single files to pass over, by exact path only. The caller closes each descriptor.

    A path that exists but cannot be read is appended to unreadable; one that vanished while the walk ran is
    not (it holds nothing any more).
    """
    excluded = {os.path.realpath(e) for e in exclude}
    skipped = {os.path.join(os.path.realpath(p.parent), p.name) for p in (skip_exact or [])}
    base = root_text(root) if root is not None else None
    trees = live_trees()
    # Built on the first multi-link file outside them, and refreshed for a multi-link file it does not hold whose
    # inode changed (st_ctime: a new hard link sets it) since the last refresh began: that inode may be a live
    # file made after the refresh. Any other inode it does not hold was no live file then, and has had no new
    # name since.
    live = LiveInodes()

    def is_excluded(path: str) -> bool:
        return any(_under(path, e) for e in excluded)

    def checked_file(fd: int, path: str, expect: tuple[int, int] | None):
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or (expect is not None and (info.st_dev, info.st_ino) != expect):
            unreadable.append(path)  # swapped since the listing, or not a regular file
            return None
        if info.st_nlink != 1:
            if (base is not None and _under(path, base)) or any(_under(path, t) for t in trees):
                unreadable.append(path)  # a second name in the root or a live tree: possibly a live file
                return None
            ident = (info.st_dev, info.st_ino)
            if live.started_ns is None or (
                ident not in live.ids and info.st_ctime_ns >= live.started_ns - ALIAS_CTIME_SLACK_NS
            ):
                live.refresh()
            if ident in live.ids:
                unreadable.append(path)  # a live agent-lb file reached by another name: never read
                return None
        if newer_than is not None and info.st_mtime <= newer_than:
            return None
        return fd

    def volume_event_log(name: str, listed: os.stat_result, dir_fd: int) -> bool:
        return (
            name == VOLUME_EVENT_LOG
            and stat.S_ISDIR(listed.st_mode)
            and listed.st_uid == 0
            and os.getuid() != 0
            and listed.st_dev == os.fstat(dir_fd).st_dev
        )

    def walk(dir_fd: int, path: str):
        try:
            with os.scandir(dir_fd) as listing:
                # In name order: a walk is the same walk every time.
                entries = sorted((e.name, e.is_symlink(), e.is_dir(follow_symlinks=False)) for e in listing)
        except FileNotFoundError:
            return
        except OSError:
            unreadable.append(path)
            return
        for name, is_link, is_dir in entries:
            child = os.path.join(path, name)
            if is_link or is_excluded(child):
                continue
            try:
                if is_dir:
                    listed = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
                    if volume_event_log(name, listed, dir_fd) and (path == base or volume_top(dir_fd)):
                        continue
                    fd = os.open(name, DIR_FLAGS | os.O_NONBLOCK, dir_fd=dir_fd)
                    try:
                        opened = os.fstat(fd)
                        if (opened.st_dev, opened.st_ino) != (listed.st_dev, listed.st_ino):
                            unreadable.append(child)  # swapped between the stat and the open
                            continue
                        yield from walk(fd, child)
                    finally:
                        os.close(fd)
                    continue
                if child in skipped:
                    continue
                info = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
                if not stat.S_ISREG(info.st_mode):
                    continue
                if newer_than is not None and info.st_mtime <= newer_than:
                    continue
                fd = os.open(name, READ_FLAGS, dir_fd=dir_fd)
            except FileNotFoundError:
                continue
            except OSError:
                unreadable.append(child)
                continue
            if checked_file(fd, child, (info.st_dev, info.st_ino)) is None:
                os.close(fd)
                continue
            yield child, fd

    for top in paths:
        if is_excluded(os.path.realpath(top)) or is_excluded(os.path.abspath(top)):
            continue
        try:
            fd, text = _open_top(Path(top), root)
        except FileNotFoundError:
            continue
        except OSError:
            unreadable.append(os.path.abspath(top))
            continue
        try:
            info = os.fstat(fd)
            if stat.S_ISDIR(info.st_mode):
                yield from walk(fd, text)
            elif stat.S_ISREG(info.st_mode) and text not in skipped and checked_file(fd, text, None) is not None:
                yield text, os.dup(fd)
        finally:
            os.close(fd)


def scan_fd(fd: int, detector: Detector, chunk: int = 4 << 20) -> tuple[bool, int]:
    """Scan an open file; closes it. Returns (hit, bytes read)."""
    with os.fdopen(fd, "rb") as fh:
        return scan_stream(fh.read, detector, chunk=chunk)


def scan_file(path: Path, detector: Detector, chunk: int = 4 << 20) -> bool:
    # No link at any component (O_NOFOLLOW_ANY on macOS), so a file or parent swapped for a link is refused.
    return scan_fd(os.open(path, PATH_FLAGS), detector, chunk)[0]


def scan_paths(
    paths: list[Path],
    secrets: list[str],
    newer_than: float | None = None,
    exclude: list[Path] | None = None,
    skip_exact: list[Path] | None = None,
    keys: list[str] | None = None,
    root: Path | None = None,
) -> dict:
    """complete is False when no secret was loaded or anything that exists could not be read.

    keys: store keys whose ciphertexts are a hit too (Detector). root: the sandbox root, inside which the walk
    follows no link from a root descriptor and refuses a file with a second hard link (walk_files).
    """
    detector = Detector(secrets, keys)
    hits: list[str] = []
    unreadable: list[str] = []
    files: list[str] = []
    total = 0
    if detector:
        for path, fd in walk_files(paths, newer_than, exclude or [], unreadable, skip_exact, root):
            try:
                found, size = scan_fd(fd, detector)
            except OSError:
                unreadable.append(path)
                continue
            total += size
            files.append(path)
            if found:
                hits.append(path)
    return {
        "found": bool(hits),
        "complete": bool(detector) and not unreadable,
        "files_scanned": len(files),
        "bytes_scanned": total,
        "unreadable": len(unreadable),
        "unreadable_paths": unreadable[:20],
        "hits": hits,
        "secrets_loaded": len(secrets),
        "_files": files,
    }


def ps_command(pid: int, with_env: bool) -> bytes:
    flags = ["-E"] if with_env else []
    return subprocess.run(
        ["/bin/ps", *flags, "-ww", "-o", "command=", "-p", str(pid)], capture_output=True, timeout=30, check=False
    ).stdout.rstrip(b"\n")


def env_shows_root(env_text: bytes, root: Path) -> bool:
    """True when the environment part of `ps -E` holds LB_SANDBOX_ROOT=<root> as a whole entry."""
    marker = re.escape(ENV_MARKER.encode() + str(root).encode())
    return re.search(rb"(?:^|\s)" + marker + rb"(?:\s|$)", env_text) is not None


PROCESS_SETTLE_S = 2.0


def run_processes(rows: list[tuple[int, int, str]], root: Path, run_id: str) -> tuple[list[int], list[int]]:
    """(named, descendants): processes whose command line names this root or passes this run id, and every
    process below one of them, whatever its argv says. The scanner's own lineage is never either."""
    lineage = own_lineage(rows)
    named = {pid for pid, _, cmd in rows if (names_root(cmd, root) or run_argument(cmd, run_id)) and pid not in lineage}
    children: dict[int, list[int]] = {}
    for pid, ppid, _ in rows:
        if pid != ppid:
            children.setdefault(ppid, []).append(pid)
    below: set[int] = set()
    stack = sorted(named)
    while stack:
        for child in children.get(stack.pop(), []):
            if child not in named and child not in below and child not in lineage:
                below.add(child)
                stack.append(child)
    return sorted(named), sorted(below)


def executable_path(pid: int) -> str | None:
    """The file the kernel runs for pid (proc_pidpath), never the argv the process chose for itself."""
    try:
        import ctypes

        libproc = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
        buf = ctypes.create_string_buffer(4096)
        size = libproc.proc_pidpath(ctypes.c_int(pid), buf, ctypes.c_uint32(len(buf)))
    except (OSError, AttributeError):
        return None
    return buf.value.decode(errors="replace") if size > 0 else None


# Platform tools lb-sandbox and lb-restart run as children with the caller's own environment (no env= argument):
# macOS never shows a platform binary's environment, and a long lsof or a `launchctl kickstart -k` waiting out a
# drain outlives the settle wait. Set aside only below a run process whose environment was read, and only when the
# kernel names the binary (proc_pidpath), never by argv.
INHERITING_TOOLS = frozenset({"/bin/launchctl", "/bin/ps", "/usr/sbin/lsof"})


def zombie(pid: int) -> bool:
    """True for an exited process its parent has not reaped: no memory, no environment left to hold a secret."""
    out = subprocess.run(["/bin/ps", "-o", "stat=", "-p", str(pid)], capture_output=True, timeout=30, check=False)
    return out.stdout.strip().startswith(b"Z")


def env_rest(argv_text: bytes, text: bytes) -> bytes | None:
    """The environment part of `ps -E` output (past the argv `ps` printed alone), None when they disagree."""
    if not argv_text.strip() or not text.startswith(argv_text):
        return None
    return text[len(argv_text) :]


def scan_processes(root: Path, run_id: str, secrets: list[str]) -> dict:
    """Search the exec environment and argv (`ps -E`, as `ps eww` shows them) of every process of this run.

    Returns pids and counts only. The run's processes are those whose command line names the root or passes
    the run id, and every descendant of one of them (run_processes): a child whose argv names neither still
    inherits, or is handed, the environment its parent had. ps prints argv, then the environment. A named
    process's environment counts as shown only when the part after the argv (`ps` without -E) holds this root's
    LB_SANDBOX_ROOT entry; a descendant's, when that part is not empty (a child may be given an environment
    without the marker). A process whose environment ps did not show (visible_pids lacks it) makes the scan
    incomplete, whichever process it is, so no extra child can read clean unseen.

    A command that names only the run's launchd label (`launchctl kickstart -k gui/<uid>/<label>`, which
    lb-restart leaves waiting out the drain) is not selected by name. Below a run process, a hidden child is set
    aside (tool_pids) only when the kernel says it runs one of INHERITING_TOOLS and its parent's environment
    was read: those are platform binaries whose environment macOS never shows, and lb-sandbox and lb-restart
    hand them their own, which is scanned. Any other hidden descendant leaves the scan incomplete.
    """
    patterns = sorted({p for s in secrets if s for p in secret_patterns(s)})
    rows = processes()
    named, below = run_processes(rows, root, run_id)
    parent_of = {pid: ppid for pid, ppid, _ in rows}
    pids = sorted({*named, *below})

    def shown_for(pid: int, argv_text: bytes, text: bytes) -> bool:
        rest = env_rest(argv_text, text)
        if rest is None:
            return False
        if pid in below:
            return bool(rest.strip())
        return env_shows_root(rest, root)

    hits, visible, invisible, unreadable, scanned, inherited = [], [], [], [], [], []
    for pid in pids:
        argv_text = ps_command(pid, with_env=False)
        text = ps_command(pid, with_env=True)
        if not text.strip() or not argv_text.strip():
            if pid_alive(pid) and not zombie(pid):
                unreadable.append(pid)
            continue
        scanned.append(pid)
        if any(p in text for p in patterns):
            hits.append(pid)
        shown = shown_for(pid, argv_text, text)
        # macOS hides the environment of platform binaries (launchctl, ps): a short-lived one that names the
        # run gets a moment to exit; one that stays is unreadable and the scan is incomplete.
        deadline = time.monotonic() + PROCESS_SETTLE_S
        while not shown and pid_alive(pid) and time.monotonic() < deadline:
            time.sleep(0.1)
            argv_text, text = ps_command(pid, with_env=False), ps_command(pid, with_env=True)
            if any(p in text for p in patterns) and pid not in hits:
                hits.append(pid)
            shown = shown_for(pid, argv_text, text)
        if shown:
            visible.append(pid)
        elif pid_alive(pid) and not zombie(pid):
            invisible.append(pid)
        elif pid not in hits:
            scanned.remove(pid)  # exited before ps could show its environment: nothing left to hold a secret
    for pid in list(invisible):
        if pid in below and parent_of.get(pid) in visible and executable_path(pid) in INHERITING_TOOLS:
            invisible.remove(pid)
            scanned.remove(pid)
            inherited.append(pid)
    return {
        "found": bool(hits),
        "complete": bool(patterns) and not unreadable and not invisible and bool(scanned),
        "processes_scanned": len(scanned),
        "pids": scanned,
        "descendant_pids": [pid for pid in below if pid in scanned],
        "visible_pids": visible,
        "invisible_pids": invisible,
        "unreadable_pids": unreadable,
        "tool_pids": inherited,
        "hits": hits,
        "secrets_loaded": len(secrets),
    }


class LeakFound(OSError):
    """An exported file held a secret or a ciphertext the store key opens; the copy was removed."""


def custody_inodes(root: Path) -> set[tuple[int, int]]:
    """(device, inode) of the store and key at their own paths, read without following a link."""
    found = set()
    try:
        data_fd = open_dir(root, "data")
    except OSError:
        return found
    try:
        for rel in CUSTODY_FILES:
            try:
                info = os.stat(Path(rel).name, dir_fd=data_fd, follow_symlinks=False)
            except OSError:
                continue
            found.add((info.st_dev, info.st_ino))
    finally:
        os.close(data_fd)
    return found


def export_logs(root: Path, dest: Path, scanned_files: list[str], detector: Detector) -> dict:
    """Copy the regular files under root/logs that the teardown scan read, scanning every byte copied.

    The source is opened from a descriptor for the root, one component at a time with O_NOFOLLOW, so a
    directory swapped for a link after the scan (logs/d -> <root>/data) is refused, never followed. A
    source must be a single-link regular file that is not the store or key. Each block is checked by the
    detector before it is written; on a hit the partial copy is unlinked and LeakFound is raised.
    Returns files and bytes copied.
    """
    if not detector:
        raise OSError("no secret loaded; an unscanned export is refused")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW

    def directory(path: Path) -> int:
        # Destination directories are walked by descriptor too: no links, including link swaps.
        absolute = path.absolute()
        fd = os.open(absolute.anchor, flags)
        try:
            for part in absolute.parts[1:]:
                if part in (".", ".."):
                    raise OSError("unsafe export directory")
                try:
                    os.mkdir(part, mode=0o700, dir_fd=fd)
                except FileExistsError:
                    pass
                child = os.open(part, flags, dir_fd=fd)
                os.close(fd)
                fd = child
            return fd
        except BaseException:
            os.close(fd)
            raise

    custody = custody_inodes(root)
    copied, total = 0, 0
    base = Path(root_text(root)) / "logs"
    dest_fd = directory(dest)
    try:
        for name in scanned_files:
            try:
                rel = Path(name).relative_to(base)
            except ValueError:
                continue
            if not rel.parts or any(part in (".", "..") for part in rel.parts):
                raise OSError("unsafe export filename")
            src_dir = open_dir(root, Path("logs", *rel.parts[:-1]))
            try:
                src_fd = os.open(rel.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=src_dir)
            finally:
                os.close(src_dir)
            with os.fdopen(single_link(src_fd, f"log {rel}"), "rb") as src:
                info = os.fstat(src.fileno())
                if (info.st_dev, info.st_ino) in custody:
                    raise Confinement(f"log {rel} is the sandbox store or key")
                parent_fd = os.dup(dest_fd)
                try:
                    for part in rel.parts[:-1]:
                        try:
                            os.mkdir(part, mode=0o700, dir_fd=parent_fd)
                        except FileExistsError:
                            pass
                        child = os.open(part, flags, dir_fd=parent_fd)
                        os.close(parent_fd)
                        parent_fd = child
                    # Existing files may be hard links to live files: never truncate.
                    target_fd = os.open(
                        rel.name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent_fd
                    )
                    with os.fdopen(target_fd, "wb") as out:
                        leaked, size = scan_stream(src.read, detector, write=out.write)
                    if leaked:
                        os.unlink(rel.name, dir_fd=parent_fd)
                        raise LeakFound(f"log {rel} holds a secret; its copy was removed")
                finally:
                    os.close(parent_fd)
            copied += 1
            total += size
    finally:
        os.close(dest_fd)
    return {"files": copied, "bytes": total}


# ---------------------------------------------------------------- start


def sandbox_env(root: Path, ports: dict[str, int], run_id: str, transport: str) -> dict[str, str]:
    """The sandbox primary's environment. No secrets: _serve adds the federation token at exec time."""
    env = {
        "HOME": str(root / "home"),
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
        "PYTHONPATH": str(root / "runtime"),
        "LB_SANDBOX_ROOT": str(root),
        "AGENT_LB_DATA_DIR": str(root / "data"),
        "AGENT_LB_DATABASE_URL": f"sqlite+aiosqlite:///{root / 'data' / 'store.db'}",
        "AGENT_LB_DATABASE_SQLITE_PRE_MIGRATE_BACKUP_ENABLED": "false",
        "AGENT_LB_ENCRYPTION_KEY_FILE": str(root / "data" / "encryption.key"),
        "AGENT_LB_LOCAL_INSTANCE_ID": f"sbx-{run_id}",
        "AGENT_LB_FEDERATION_PEER_URL": f"http://127.0.0.1:{ports['gate']}",
        "AGENT_LB_FEDERATION_MIRROR_INTERVAL_SECONDS": "5",
        "AGENT_LB_FEDERATION_FORWARD_REQUEST_LOGS": "false",
        "AGENT_LB_FEDERATION_PUSH_PATH": str(root / "data" / "federation-push.json"),
        "AGENT_LB_UPSTREAM_BASE_URL": f"http://127.0.0.1:{ports['edge_openai']}",
        "AGENT_LB_ANTHROPIC_UPSTREAM_BASE_URL": f"http://127.0.0.1:{ports['edge_anthropic']}",
        "AGENT_LB_UPSTREAM_STREAM_TRANSPORT": transport,
        # Dashboard APIs (account export among them) answer 401 to everyone: trusted_header mode, no
        # password, and the only trusted proxy is TEST-NET-1 (192.0.2.1, RFC 5737), which no peer can be.
        # "disabled" would hand decrypted tokens to any local caller.
        "AGENT_LB_DASHBOARD_AUTH_MODE": "trusted_header",
        "AGENT_LB_FIREWALL_TRUST_PROXY_HEADERS": "true",
        "AGENT_LB_FIREWALL_TRUSTED_PROXY_CIDRS": "192.0.2.1/32",
        # uvicorn trusts loopback X-Forwarded-For by default, which would let a local caller claim to be
        # 192.0.2.1; with no forwarded-allow hosts the socket peer is always the client address.
        "FORWARDED_ALLOW_IPS": "",
        "AGENT_LB_PROXY_UNAUTHENTICATED_CLIENT_CIDRS": "127.0.0.1/32",
        "AGENT_LB_CONVERSATION_ARCHIVE_DIR": str(root / "data" / "conversation-archive"),
        "UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN": str(DRAIN_S),
    }
    for name in DISABLED_SCHEDULERS:
        env[f"AGENT_LB_{name}_ENABLED"] = "false"
    return env


def plist_bodies(
    root: Path, run_id: str, ports: dict[str, int], transport: str, script: Path | None = None
) -> tuple[dict, dict]:
    """The primary's and the aux's launchd jobs. Both run `<venv python> -I <installed lb-sandbox>`: nothing under
    the root runs before confinement. -I (isolated): no PYTHON* variable (PYTHONPATH names <root>/runtime, where a
    sitecustomize.py could be planted), no user site and no script or working directory on sys.path."""
    label, aux_label = labels_for(run_id)
    python = str(interpreter_for(root))
    script = str(script or bootstrap_script())
    primary = {
        "Label": label,
        "ProgramArguments": [
            python,
            "-I",
            script,
            "_serve",
            str(root),
            "--host",
            "127.0.0.1",
            "--port",
            str(ports["primary"]),
        ],
        "WorkingDirectory": str(root / "runtime"),
        "EnvironmentVariables": sandbox_env(root, ports, run_id, transport),
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 2,
        "ExitTimeOut": DRAIN_S + 30,
    }
    aux = {
        "Label": aux_label,
        "ProgramArguments": [python, "-I", script, "_aux", str(root)],
        "WorkingDirectory": str(root),
        "EnvironmentVariables": {
            "HOME": str(root / "home"),
            "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
            "LB_SANDBOX_ROOT": str(root),
        },
        "RunAtLoad": True,
        "KeepAlive": False,
        "ExitTimeOut": 20,
    }
    # No StandardOutPath: launchd opens it by name and follows a planted link. _serve and _aux open their own
    # logs from a root descriptor instead (log_to_root).
    return primary, aux


def write_plists(
    root: Path, run_id: str, ports: dict[str, int], transport: str, script: Path | None = None
) -> tuple[Path, Path]:
    """The two jobs as plist files under the root: what lb-restart --sandbox reads (and checks) for its standby.
    launchd never loads these files (bootstrap_job): the confined jobs can write anywhere in the root."""
    paths = plist_paths(root, run_id)
    for path, body in zip(paths, plist_bodies(root, run_id, ports, transport, script), strict=True):
        write_in_root(root, path.relative_to(root), plistlib.dumps(body))
    return paths


def find_node() -> str:
    for candidate in (
        run(["volta", "which", "node"]).stdout.strip() if shutil.which("volta") else "",
        shutil.which("node") or "",
        "/opt/homebrew/bin/node",
    ):
        if candidate and Path(candidate).is_file() and os.access(candidate, os.X_OK):
            return str(Path(candidate).resolve())
    raise Unhealthy("node not found for the sandbox front")


def live_identity() -> dict:
    preferred = read_json(LIVE_FRONT_STATE).get("preferred")
    return {
        "primary_pid": launchd_pid(LIVE_LABEL),
        "front_pid": launchd_pid(LIVE_FRONT_LABEL),
        "front_port": LIVE_FRONT_PORT,
        "front_listener_pids": listener_pids(LIVE_FRONT_PORT),
        "primary_listener_pids": listener_pids(LIVE_PRIMARY_PORT),
        "preferred_port": preferred,
    }


def bootstrap(plist: Path, label: str, deadline_s: float = 20) -> None:
    check_label(label)
    domain = f"gui/{os.getuid()}"
    deadline = time.monotonic() + deadline_s
    while time.monotonic() < deadline:
        if run(["/bin/launchctl", "bootstrap", domain, str(plist)]).returncode == 0 or label_loaded(label):
            return
        time.sleep(0.5)
    raise Unhealthy(f"launchctl bootstrap {label} failed")


def bootstrap_job(root: Path, body: dict) -> None:
    """Load one sandbox job into launchd from bytes this process made, never from a plist file under the root.

    Every process confined to a root can write anywhere in it, so a plist there is only as trusted as the jobs
    already running: an aux (or its front) started first could rewrite the primary's plist to an unconfined
    payload just before its bootstrap. The job goes to launchd through a private file (O_EXCL, 0600) in
    <sandboxes>/.launchd, which no confined process can write (their profile allows writes in their own root
    only), and the file is unlinked once launchd holds the job."""
    label = check_label(str(body.get("Label", "")))
    sb = sandboxes_fd(Path(root).parent)
    try:
        os.mkdir(".launchd", 0o700, dir_fd=sb)
    except FileExistsError:
        pass
    dir_fd = os.open(".launchd", DIR_FLAGS, dir_fd=sb)
    try:
        if os.fstat(dir_fd).st_uid != os.getuid():
            raise Refused("the sandboxes .launchd dir is not this user's own")
        os.fchmod(dir_fd, 0o700)
        name = f"{label}.plist"
        try:
            os.unlink(name, dir_fd=dir_fd)  # a stale copy from a start that died: the name only
        except FileNotFoundError:
            pass
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dir_fd)
        with os.fdopen(fd, "wb") as fh:
            fh.write(plistlib.dumps(body))
        try:
            bootstrap(Path(fd_path(dir_fd)) / name, label)
        finally:
            try:
                os.unlink(name, dir_fd=dir_fd)
            except FileNotFoundError:
                pass
    finally:
        os.close(dir_fd)


def label_names_root(label: str, root: Path) -> bool:
    """True when the loaded job's program or arguments name this sandbox root."""
    out = run(["/bin/launchctl", "print", f"gui/{os.getuid()}/{label}"]).stdout
    return any(names_root(line.strip(), root) for line in out.splitlines())


def bootout(label: str, deadline_s: float = 30) -> bool:
    check_label(label)
    target = f"gui/{os.getuid()}/{label}"
    run(["/bin/launchctl", "bootout", target], timeout=deadline_s + 10)
    deadline = time.monotonic() + deadline_s
    while label_loaded(label):
        if time.monotonic() > deadline:
            return False
        time.sleep(0.5)
    return True


def usable_counts(accounts: list[dict]) -> dict[str, int]:
    counts = {"anthropic": 0, "openai": 0}
    for account in accounts:
        if account["usable"] and account["vendor"] in counts:
            counts[account["vendor"]] += 1
    return counts


def log_failure_classes(root: Path) -> dict:
    """Exception class names and app frames from the primary log; never message text."""
    text = read_root_text(root, "logs/primary.log", 200_000)
    if not text:
        return {}
    return {
        "exception_classes": sorted(set(re.findall(r"^([A-Za-z0-9_.]+(?:Error|Exception)):", text, re.MULTILINE))),
        "frames": re.findall(r'File "[^\n"]*/(app/[^\n"]+)", line ([0-9]+), in ([A-Za-z0-9_]+)', text)[-8:],
    }


def plist_paths(root: Path, run_id: str) -> tuple[Path, Path]:
    label, aux_label = labels_for(run_id)
    return root / "launchd" / f"{label}.plist", root / "launchd" / f"{aux_label}.plist"


def populate_root(root: Path, run_id: str, ports: dict[str, int], meta: dict, transport: str, source: str) -> None:
    """Fill a new root: key, metadata, runtime copy, plists, restart config, front preference.

    start runs this in a child confined to the root (write-only profile): a link planted in the root while it
    runs (runtime/app -> live state, say) leads the copy to a denied write, never a live file. No lb-sandbox
    copy goes into the root: the plists run source, the installed file outside it (bootstrap_script).
    """
    for sub in ("data", "home", "logs", "state", "clients", "runtime"):
        os.mkdir(root / sub, 0o700)
    create_key(root / "data" / "encryption.key")
    write_json(root, "sandbox.json", meta)
    runtime = root / "runtime"
    for part in ("app", "config", "scripts"):
        if (LIVE_RUNTIME / part).is_dir():
            shutil.copytree(LIVE_RUNTIME / part, runtime / part, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
    os.symlink(LIVE_VENV, runtime / ".venv")
    managed = Path("home/.agent-lb/managed/coding-agents")
    for name in ("routing-table.json", "decider.json"):
        if (MANAGED_ROUTING / name).is_file():
            write_in_root(root, managed / name, (MANAGED_ROUTING / name).read_bytes())
    primary_plist, _ = write_plists(root, run_id, ports, transport, Path(source))
    write_json(
        root,
        "lb-restart.json",
        {
            "root": str(root),
            "label": meta["label"],
            "plist": str(primary_plist),
            "runtime": str(runtime),
            "state_dir": str(root / "state"),
            "front_port": ports["front"],
            "primary_port": ports["primary"],
            "standby_port": ports["standby"],
        },
    )
    write_in_root(root, "state/front-preferred-port", f"{ports['primary']}\n".encode(), 0o644)


def cmd_start(args) -> int:
    run_id = check_run_id(args.run_id)
    if not args.from_live:
        raise Refused("start needs --from-live (the only supported account source)")
    if args.transport != "http":
        raise Refused("only --transport http is supported (the edge must see and cut streams)")
    check_launchctl()
    root = root_for(run_id)
    try:
        if root_entry(root) is not None:
            raise Refused(f"sandbox root {root} already exists")
    except FileNotFoundError:
        pass  # no sandboxes dir yet: start makes it
    except OSError as exc:
        raise Refused(f"sandboxes dir is a link or not private ({exc})") from None
    label, aux_label = labels_for(run_id)
    if label_loaded(label) or label_loaded(aux_label):
        raise Refused(f"label {label} is already loaded")
    if not LIVE_PLIST.is_file() or not (LIVE_RUNTIME / "app").is_dir() or not (LIVE_VENV / "bin" / "python").exists():
        raise Unhealthy("live runtime, venv or plist missing")
    taken = ports_in_use_by_sandboxes()
    if args.port is not None:
        check_ports([args.port])
        if args.port in taken or not port_free(args.port):
            raise Refused(f"--port {args.port} is in use")
        taken.add(args.port)
    picked = pick_ports(6 if args.port is None else 5, taken)
    front = args.port if args.port is not None else picked.pop(0)
    names = ("primary", "standby", "gate", "edge_anthropic", "edge_openai")
    ports = {"front": front, **dict(zip(names, picked, strict=True))}
    check_ports(list(ports.values()))
    started = time.monotonic()
    out: dict = {"run_id": run_id, "root": str(root), "label": label, "aux_label": aux_label}

    stopping: list[int] = []

    def interrupted(signum, frame):
        if not stopping:
            stopping.append(signum)
            raise Unhealthy(f"interrupted by signal {signum}")

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, interrupted)
    created = False
    try:
        # The sandboxes dir, held by descriptor from here to the end of this process (cleanup included): every
        # mkdir, mount, open and delete of the root goes by name inside it, never through the path again.
        try:
            sb = sandboxes_fd(create=True)
        except OSError as exc:
            raise Refused(f"{SANDBOXES} is not a real private directory ({exc})") from None
        try:
            os.mkdir(root.name, 0o700, dir_fd=sb)
        except FileExistsError:
            # A concurrent start with the same run id won the race; its root is not ours to tear down.
            raise Refused(f"sandbox root {root} already exists") from None
        created = True
        root_fd = open_root(root)
        try:
            os.fchmod(root_fd, 0o700)  # mkdir's mode is masked by umask; set it exactly
            made = os.fstat(root_fd)
        finally:
            os.close(root_fd)
        ROOT_IDS[run_id] = (made.st_dev, made.st_ino)  # the mountpoint itself, before the volume covers it
        attach_volume(root, run_id)  # the root is its own volume from here on: no hard link reaches live files
        meta = {
            "run_id": run_id,
            "label": label,
            "aux_label": aux_label,
            "ports": ports,
            "caller_pid": os.getppid(),
            "created_at": now_iso(),
            "created_epoch": time.time(),
            "transport": args.transport,
            "node": find_node(),
            "volume": image_for(run_id).name,
            # The sandboxes dir this root was made in: stop removes the root only through that very directory.
            "sandboxes_id": list(sandboxes_id()),
            # The mountpoint directory start made: stop removes only that directory, never another put at its name.
            "root_id": list(ROOT_IDS[run_id]),
        }
        source = str(bootstrap_script())
        check_bootstrap(Path(source), root)
        check_interpreter(interpreter_for(root), root)
        run_confined(
            root, lambda: populate_root(root, run_id, ports, meta, args.transport, source), reads=False, timeout_s=300
        )
        # The jobs launchd runs are made here, in this unconfined process, from the same inputs populate_root
        # used; the plist files it wrote under the root are never loaded (bootstrap_job).
        primary_job, aux_job = plist_bodies(root, run_id, ports, args.transport, Path(source))
        out["live"] = live_identity()

        bootstrap_job(root, aux_job)
        deadline = time.monotonic() + 30
        while not read_root_json(root, "state/aux.json").get("ready"):
            if time.monotonic() > deadline:
                raise Unhealthy("aux (gate, edges, front) did not become ready in 30 s")
            time.sleep(0.25)
        bootstrap_job(root, primary_job)
        deadline = time.monotonic() + 90
        while not (
            http(ports["primary"], "/health/ready")[0] == 200 and http(ports["front"], "/health/ready")[0] == 200
        ):
            if time.monotonic() > deadline:
                raise Unhealthy("sandbox primary or front not healthy in 90 s")
            time.sleep(0.5)
        out["boot_s"] = round(time.monotonic() - started, 1)
        deadline = time.monotonic() + 120
        while True:
            counts = usable_counts(read_accounts(root))
            if all(n >= args.min_accounts for n in counts.values()):
                break
            if time.monotonic() > deadline:
                raise Unhealthy(f"mirror gave {counts} usable accounts, need {args.min_accounts} per vendor in 120 s")
            time.sleep(1)
        out.update(
            {
                "front_port": ports["front"],
                "primary_port": ports["primary"],
                "standby_port": ports["standby"],
                "gate_port": ports["gate"],
                "edge_ports": {"anthropic": ports["edge_anthropic"], "openai": ports["edge_openai"]},
                "accounts_per_vendor": counts,
                "ready_s": round(time.monotonic() - started, 1),
            }
        )
        return emit(out, EXIT_OK)
    except Exception as exc:  # any failure tears the sandbox down before exit 3
        if isinstance(exc, Refused) and not created:
            raise
        out["error"] = f"{exc.__class__.__name__}: {exc}"
        if created and entry_of(root) is not None:
            out["failure"] = log_failure_classes(root)
            for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
                signal.signal(sig, signal.SIG_IGN)
            out["teardown"] = teardown(run_id, Path(args.logs_to) if args.logs_to else None, created=True)
        return emit(out, EXIT_UNHEALTHY)


# ---------------------------------------------------------------- _serve and _aux (run by launchd)


def serve_exec_args(root: Path, argv: list[str]) -> tuple[str, list[str], dict[str, str], str]:
    """Validate a _serve invocation; build (executable, argv, env) for the boot and return the token apart.

    The env and argv never carry the token: _serve hands it over through a pipe (cmd_serve). Writes nothing.
    """
    root = check_root(root)
    meta = read_root_json(root, "sandbox.json")
    if not meta or meta.get("run_id") != root.name:
        raise Refused(f"{root} has no sandbox.json stamped with its run id")
    parser = argparse.ArgumentParser(prog="lb-sandbox _serve")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, required=True)
    opts, extra = parser.parse_known_args(argv)
    if extra:
        raise Refused(f"_serve takes only --host and --port, not {' '.join(extra)}")
    if opts.host != "127.0.0.1":
        raise Refused("the sandbox binds 127.0.0.1 only")
    expected_ports = {"front", "primary", "standby", "gate", "edge_anthropic", "edge_openai"}
    if not isinstance(meta.get("ports"), dict) or set(meta["ports"]) != expected_ports:
        raise Refused("sandbox metadata must contain exactly the six listener ports")
    check_ports(list(meta["ports"].values()))
    # Refuse redirected stores before reading any credential or starting SQLite.
    for relative in (
        "data",
        "data/store.db",
        "data/encryption.key",
        "data/federation-push.json",
        "data/conversation-archive",
    ):
        path = root / relative
        if path.is_symlink() or not path.resolve().is_relative_to(root):
            raise Refused(f"sandbox data path {relative} is redirected outside the root")
    # A hard link passes the checks above: the store, its journals and the key must each have one link.
    check_data_custody(root)
    try:
        key_fd = open_in_root(root, "data/encryption.key", os.O_RDONLY)
    except OSError as exc:
        raise Refused(f"sandbox store key is missing or redirected ({exc.__class__.__name__})") from None
    os.close(key_fd)
    # The data dir just checked, by identity: _boot opens it again by descriptor and refuses any other one, so a
    # data dir renamed aside and replaced between this check and the app's start never reaches the app.
    try:
        data_fd = open_data_dir(root)
    except OSError as exc:
        raise Refused(f"sandbox data dir is missing or redirected ({exc.__class__.__name__})") from None
    data = os.fstat(data_fd)
    os.close(data_fd)
    allowed = {meta["ports"]["primary"], meta["ports"]["standby"]}
    check_ports([opts.port])
    if opts.port not in allowed:
        raise Refused(f"port {opts.port} is not this sandbox's primary or standby port")
    if os.environ.get("LB_SANDBOX_ROOT") != str(root):
        raise Refused("LB_SANDBOX_ROOT does not match the sandbox root")
    # The app sees only the environment rebuilt from sandbox.json: nothing inherited (a live database URL,
    # peer URL or key file in the caller's env) can reach it.
    env = sandbox_env(root, meta["ports"], root.name, meta.get("transport", "http"))
    env.update({k: os.environ[k] for k in ("USER", "LOGNAME", "TMPDIR", "LANG") if k in os.environ})
    token = live_federation_token()
    if not token:
        raise Unhealthy("live plist has no federation token")
    python = str(interpreter_for(root))
    check_interpreter(Path(python), root)  # what execve runs, checked just before it
    script = bootstrap_script()  # this file, outside the root: nothing under the root runs before _boot confines
    check_bootstrap(script, root)
    # --port last and literal: lb-restart recognises its standby by "--port <standby>" in the command line.
    # -I: no PYTHON* variable, user site or script dir reaches the interpreter before _boot confines it.
    args = [
        python,
        "-I",
        str(script),
        "_boot",
        str(root),
        "--data-id",
        f"{data.st_dev}:{data.st_ino}",
        "--host",
        "127.0.0.1",
        "--port",
        str(opts.port),
    ]
    return python, args, env, token


def token_pipe(token: str) -> int:
    """A pipe holding the token and closed for writing; returns the inheritable read end."""
    read_fd, write_fd = os.pipe()
    try:
        data = token.encode()
        while data:  # a token is far under the pipe buffer, so this never blocks
            data = data[os.write(write_fd, data) :]
    finally:
        os.close(write_fd)
    os.set_inheritable(read_fd, True)
    return read_fd


def log_to_root(root: Path, rel: str) -> None:
    """Under launchd (stdout is /dev/null: the plist names no log) send stdout and stderr to root/rel.

    The log is opened from a root descriptor, never by name, so a link planted at the log path is refused
    (launchd's StandardOutPath would have followed it). A process whose stdout is already a file (the standby
    lb-restart starts, logging to its own file) keeps it.
    """
    try:
        out, null = os.fstat(1), os.stat(os.devnull)
        if (out.st_dev, out.st_ino) != (null.st_dev, null.st_ino):
            return
    except OSError:
        pass  # no stdout at all: log to the root
    fd = confined(lambda: open_in_root(root, rel, os.O_WRONLY | os.O_APPEND | os.O_CREAT, create_dirs=True))
    sys.stdout.flush()
    sys.stderr.flush()
    os.dup2(fd, 1)
    os.dup2(fd, 2)
    os.close(fd)


def cmd_serve(root: str, argv: list[str]) -> int:
    root_path = check_root(Path(root))
    log_to_root(root_path, "logs/primary.log")
    check_own_volume(root_path)  # no hard link can reach a live file from a root on its own volume
    python, args, env, token = serve_exec_args(root_path, argv)
    read_fd = token_pipe(token)
    del token
    os.chdir(root_path / "runtime")
    os.execve(python, [*args[:5], "--token-fd", str(read_fd), *args[5:]], env)
    return EXIT_UNHEALTHY  # not reached


def read_token_fd(fd: int) -> str:
    """Read the token from the inherited pipe and close it. Refuses anything but a pipe."""
    try:
        if not stat.S_ISFIFO(os.fstat(fd).st_mode):
            raise Refused(f"--token-fd {fd} is not a pipe")
        chunks = []
        while chunk := os.read(fd, 65536):
            chunks.append(chunk)
    finally:
        os.close(fd)
    token = b"".join(chunks).decode().strip()
    if not token:
        raise Unhealthy("the token pipe was empty")
    return token


# The app's store, journals, key, push state and archive as names relative to its working directory, which
# enter_data_dir makes the data dir _serve checked, held by inode. The app's code opens them by name and is not
# ours to change; relative names resolve from that inode, never through the root or the sandboxes path again.
RELATIVE_DATA_ENV = {
    "AGENT_LB_DATA_DIR": ".",
    "AGENT_LB_DATABASE_URL": "sqlite+aiosqlite:///store.db",
    "AGENT_LB_ENCRYPTION_KEY_FILE": "encryption.key",
    "AGENT_LB_FEDERATION_PUSH_PATH": "federation-push.json",
    "AGENT_LB_CONVERSATION_ARCHIVE_DIR": "conversation-archive",
}


def enter_data_dir(root: Path, data_id: str) -> None:
    """Open <root>/data by descriptor from the pinned root, refuse it unless it is the (device, inode) _serve
    checked and its custody files are single-link, move this process into it and point the app's data
    settings at names relative to it."""
    match = re.fullmatch(r"([0-9]+):([0-9]+)", data_id or "")
    if not match:
        raise Refused("--data-id must be <device>:<inode>")
    try:
        data_fd = open_data_dir(root, expect=(int(match.group(1)), int(match.group(2))))
    except FileNotFoundError:
        raise Refused("sandbox data dir is missing") from None
    except OSError as exc:
        raise Refused(f"sandbox data dir is a link or not the root's ({exc.__class__.__name__})") from None
    try:
        check_data_custody_fd(data_fd)
        os.fchdir(data_fd)
    finally:
        os.close(data_fd)
    os.environ.update(RELATIVE_DATA_ENV)


def boot_app(root: Path, argv: list[str]) -> None:
    """_boot: take the token from the pipe, load the app settings with it, drop it from the env, run the app.

    The token is set in os.environ only after exec, so `ps eww` (the exec-time environment) never shows it,
    and it is removed again once the settings hold it, so no child the app spawns inherits it. Same process,
    no second exec.
    """
    # _serve checked the root and its data paths before it read the token. _boot never runs from inside a
    # sandboxes dir: a copy there is one the confined app could have rewritten.
    sandboxes = _lexical(Path(root)).parent
    check_bootstrap(bootstrap_script(), Path(root))
    root = check_root(root, sandboxes=sandboxes)
    # The app opens its store, key and logs by name and its code is not ours to change: it runs on the root's
    # own volume (no hard link to a live file) under the root's Seatbelt profile (no write outside the root
    # and no read of live custody, whatever link is planted). Both before anything under the root is opened.
    check_own_volume(root)
    confine(root, reads=True)
    parser = argparse.ArgumentParser(prog="lb-sandbox _boot")
    parser.add_argument("--token-fd", type=int, required=True)
    parser.add_argument("--data-id", required=True)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, required=True)
    opts = parser.parse_args(argv)
    if TOKEN_ENV in os.environ:
        raise Refused("the federation token is in the exec environment; refusing to start")
    if os.environ.get("LB_SANDBOX_ROOT") != str(root):
        raise Refused("LB_SANDBOX_ROOT does not match the sandbox root")
    meta = read_root_json(root, "sandbox.json")
    if opts.host != "127.0.0.1" or opts.port not in {meta.get("ports", {}).get(k) for k in ("primary", "standby")}:
        raise Refused("_boot serves only this sandbox's primary or standby port on 127.0.0.1")
    check_ports([opts.port])
    enter_data_dir(root, opts.data_id)
    token = read_token_fd(opts.token_fd)
    if str(root / "runtime") not in sys.path:
        sys.path.insert(0, str(root / "runtime"))
    os.environ["PORT"] = str(opts.port)  # what app.cli sets before its settings load; their defaults read it
    os.environ[TOKEN_ENV] = token
    try:
        from app.core.config.settings import get_settings

        loaded = get_settings().federation_token == token  # cached for the life of the process
    finally:
        os.environ.pop(TOKEN_ENV, None)
        del token
    if not loaded:
        raise Unhealthy("the app settings did not take the federation token")
    from app.cli import main as run_app

    run_app(["--host", opts.host, "--port", str(opts.port)])


def rate_limit_response(edge: str) -> tuple[int, dict[str, str], bytes]:
    reset = int(time.time()) + 600
    if edge == "anthropic":
        body = {"type": "error", "error": {"type": "rate_limit_error", "message": "lb-sandbox injected account_429"}}
        headers = {
            "retry-after": "600",
            "anthropic-ratelimit-unified-status": "rejected",
            "anthropic-ratelimit-unified-reset": str(reset),
            "request-id": f"req_lbsandbox_{uuid.uuid4().hex[:16]}",
        }
    else:
        body = {
            "error": {
                "type": "rate_limit_exceeded",
                "code": "rate_limit_exceeded",
                "message": "lb-sandbox injected account_429",
                "resets_in_seconds": 600,
                "resets_at": reset,
            }
        }
        headers = {"retry-after": "600"}
    headers["content-type"] = "application/json"
    return 429, headers, json.dumps(body).encode()


HOP_BY_HOP = frozenset(
    {
        "connection",
        "keep-alive",
        "proxy-authenticate",
        "proxy-authorization",
        "proxy-connection",
        "te",
        "trailer",
        "trailers",
        "transfer-encoding",
        "upgrade",
        "host",
        "content-length",
    }
)


def auth_hash12(headers) -> str:
    value = headers.get("Authorization") or headers.get("x-api-key") or ""
    return hashlib.sha256(value.encode()).hexdigest()[:12] if value else ""


class FaultState:
    """One edge's armed fault, re-read from <root>/state/fault-<edge>.json on every request."""

    def __init__(self, root: Path, rel: str) -> None:
        self.root, self.rel = root, rel
        self.path = root / rel
        self.seen = None
        self.nonce = None
        self.fault: str | None = None
        self.n: int | None = None
        self.failed: set[str] = set()
        self.consumed = False

    def refresh(self) -> None:
        # `fault` writes a new inode by rename each time, so the inode tells two writes apart even when their
        # timestamps would not.
        try:
            info = os.stat(self.path, follow_symlinks=False)
            seen = (info.st_dev, info.st_ino, info.st_mtime_ns, info.st_size)
        except OSError:
            seen = None
        if seen == self.seen:
            return
        self.seen = seen
        data = read_root_json(self.root, self.rel) if seen is not None else {}
        if data.get("nonce") != self.nonce:
            self.nonce = data.get("nonce")
            self.fault = data.get("fault") if data.get("armed") else None
            self.n = data.get("n")
            self.failed = set()
            self.consumed = False

    def take_429(self, auth_hash: str) -> bool:
        """account_429: the first request after arming fails its hash; that hash keeps failing until cleared."""
        if self.fault != "account_429":
            return False
        if not self.failed:
            self.failed.add(auth_hash)
            return True
        return auth_hash in self.failed

    def take_cut(self) -> int | None:
        if self.fault != "cut_after_bytes" or self.consumed or not isinstance(self.n, int):
            return None
        self.consumed = True
        return self.n

    def take_hold(self) -> tuple[int, object] | None:
        """hold_stream:S: the next streamed request gets a held stream; returns (bound, the arming nonce)."""
        if self.fault != "hold_stream" or self.consumed or not isinstance(self.n, int):
            return None
        self.consumed = True
        return min(self.n, HOLD_MAX_S), self.nonce

    def released(self, nonce: object) -> bool:
        """True once the fault that armed a hold was cleared or replaced (a new nonce)."""
        self.refresh()
        return self.nonce != nonce


# The most request body the edge decodes to read its stream flag (agent-lb gzips bodies of 16 KB and up).
MAX_DECODED_BODY = 64 << 20
# The upstream paths that always answer with a stream: the Codex backend's responses endpoint.
STREAMED_PATHS = ("/codex/responses",)


def request_json(body: bytes, headers) -> dict:
    """The request body as a JSON object, decoded from gzip when the sandbox sent it compressed; {} otherwise.

    agent-lb gzips large model-call bodies on their way upstream (app/core/clients/upstream_body.py), so a
    real Claude Code turn reaches the edge as gzip: reading it as plain JSON missed its stream flag."""
    encoding = (headers.get("Content-Encoding") or "").strip().lower()
    if encoding == "gzip" and body[:2] == b"\x1f\x8b":  # a server layer that inflated it already leaves plain JSON
        import zlib

        try:
            inflater = zlib.decompressobj(16 + zlib.MAX_WBITS)
            body = inflater.decompress(body, MAX_DECODED_BODY)
            if inflater.unconsumed_tail:
                return {}  # larger than the bound: not read
        except zlib.error:
            return {}
    elif encoding not in ("", "identity", "gzip"):
        return {}
    try:
        parsed = json.loads(body or b"{}")
    except ValueError:
        return {}
    return parsed if isinstance(parsed, dict) else {}


def wants_stream(method: str, path: str, parsed: dict) -> bool:
    """True when the request asks for a streamed answer: stream:true in its body, or a path that always streams."""
    return method == "POST" and (parsed.get("stream") is True or path.endswith(STREAMED_PATHS))


def sse(event: str, data: dict) -> bytes:
    return f"event: {event}\ndata: {json.dumps(data)}\n\n".encode()


async def serve_held_stream(request, fault: FaultState, bound: int, nonce, model: str) -> tuple[object, dict]:
    """A provider-shaped Anthropic stream served by the edge itself (no upstream call, no spend).

    It sends the opening events and a first delta, then holds the response open until the fault that armed
    it is cleared (the check's "cutover done" signal) or the bound passes, then finishes the message.
    Returns the response and the log fields: released_by "clear" or "timeout", held_s.
    """
    import asyncio

    from aiohttp import web

    response = web.StreamResponse(
        status=200,
        headers={
            "content-type": "text/event-stream",
            "cache-control": "no-cache",
            "request-id": f"req_lbsandbox_{uuid.uuid4().hex[:16]}",
        },
    )
    await response.prepare(request)
    message = {
        "id": f"msg_lbsandbox_{uuid.uuid4().hex[:16]}",
        "type": "message",
        "role": "assistant",
        "model": model,
        "content": [],
        "stop_reason": None,
        "stop_sequence": None,
        "usage": {"input_tokens": 1, "output_tokens": 1},
    }
    sent = 0
    for chunk in (
        sse("message_start", {"type": "message_start", "message": message}),
        sse(
            "content_block_start",
            {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}},
        ),
        sse(
            "content_block_delta",
            {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "1, 2, 3"}},
        ),
    ):
        await response.write(chunk)
        sent += len(chunk)
    started = time.monotonic()
    released_by, last_ping = "timeout", started
    while time.monotonic() - started < bound:
        if fault.released(nonce):
            released_by = "clear"
            break
        if time.monotonic() - last_ping >= 2:
            ping = sse("ping", {"type": "ping"})
            await response.write(ping)
            sent += len(ping)
            last_ping = time.monotonic()
        await asyncio.sleep(0.1)
    held = round(time.monotonic() - started, 1)
    for chunk in (
        sse(
            "content_block_delta",
            {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": ", 4, 5"}},
        ),
        sse("content_block_stop", {"type": "content_block_stop", "index": 0}),
        sse(
            "message_delta",
            {
                "type": "message_delta",
                "delta": {"stop_reason": "end_turn", "stop_sequence": None},
                "usage": {"output_tokens": 5},
            },
        ),
        sse("message_stop", {"type": "message_stop"}),
    ):
        await response.write(chunk)
        sent += len(chunk)
    await response.write_eof()
    return response, {"status": 200, "bytes": sent, "released_by": released_by, "held_s": held}


def make_edge_handler(edge: str, base: str, fault: FaultState, session, counters: dict, log):
    """The edge proxy for one vendor: forwards to base, applies the armed fault, logs one entry per request.

    log(entry) receives the JSON line for <root>/logs/edge.jsonl (auth as a 12-char hash, never a value).
    """
    import asyncio

    import aiohttp
    from aiohttp import web

    async def handle(request: web.Request) -> web.StreamResponse:
        started = time.monotonic()
        body = await request.read()
        auth = auth_hash12(request.headers)
        counters["edge_requests"][edge] += 1
        fault.refresh()
        record = {"ts": now_iso(), "edge": edge, "method": request.method, "path": request.path}
        record["auth_hash12"] = auth
        if fault.take_429(auth):
            counters["faults_applied"][edge] += 1
            status, headers, payload = rate_limit_response(edge)
            log({**record, "status": status, "bytes": len(payload), "fault": "account_429"})
            return web.Response(status=status, body=payload, headers=headers)
        # The body is decoded only when a stream fault is armed. Whether a request streams is read from the
        # request (stream:true, or a path that always streams), never from the upstream content-type.
        armed = fault.fault in ("hold_stream", "cut_after_bytes") and not fault.consumed
        parsed = request_json(body, request.headers) if armed else {}
        streamed = armed and wants_stream(request.method, request.path, parsed)
        armed_hold = fault.fault == "hold_stream" and not fault.consumed
        if armed_hold and edge == "anthropic" and request.method == "POST" and request.path == "/v1/messages":
            hold = fault.take_hold() if parsed.get("stream") is True else None
            if hold is not None:
                counters["faults_applied"][edge] += 1
                try:
                    response, fields = await serve_held_stream(
                        request, fault, hold[0], hold[1], str(parsed.get("model", ""))
                    )
                except (ConnectionResetError, asyncio.CancelledError):
                    log(
                        {
                            **record,
                            "status": 200,
                            "fault": "hold_stream",
                            "downstream_closed": True,
                            "ms": int((time.monotonic() - started) * 1000),
                        }
                    )
                    raise
                log({**record, **fields, "fault": "hold_stream", "ms": int((time.monotonic() - started) * 1000)})
                return response
        headers = {k: v for k, v in request.headers.items() if k.lower() not in HOP_BY_HOP}
        applied, status, sent, error, downstream_closed = None, 0, 0, None, False
        response: web.StreamResponse | None = None

        def drop_downstream() -> None:
            # close() flushes what is already queued, then closes without the terminating chunk,
            # so the sandbox sees an incomplete chunked body (abort() would discard queued bytes).
            if request.transport is not None:
                request.transport.close()

        try:
            async with session.request(
                request.method,
                f"{base}{request.path_qs}",
                headers=headers,
                data=body or None,
                allow_redirects=False,
            ) as upstream:
                status = upstream.status
                out_headers = {k: v for k, v in upstream.headers.items() if k.lower() not in HOP_BY_HOP}
                response = web.StreamResponse(status=status, headers=out_headers)
                await response.prepare(request)
                cut_at = fault.take_cut() if streamed and status == 200 else None
                if cut_at is not None:
                    applied = f"cut_after_bytes:{cut_at}"
                    counters["faults_applied"][edge] += 1
                try:
                    async for chunk in upstream.content.iter_any():
                        if cut_at is not None and sent + len(chunk) >= cut_at:
                            part = chunk[: max(0, cut_at - sent)]
                            if part:
                                await response.write(part)
                                sent += len(part)
                            drop_downstream()  # a TCP close mid-body
                            break
                        await response.write(chunk)
                        sent += len(chunk)
                    else:
                        await response.write_eof()
                except ConnectionResetError:
                    # The sandbox stops reading once it has the terminal event; not an upstream error.
                    downstream_closed = True
        except (aiohttp.ClientError, asyncio.TimeoutError) as exc:
            error = exc.__class__.__name__
            if response is not None and response.prepared:
                # Upstream broke after headers: never finish the HTTP framing, so the
                # truncation reaches the sandbox as a truncation, not a clean end.
                drop_downstream()
        ms = int((time.monotonic() - started) * 1000)
        entry = {**record, "status": status, "bytes": sent, "fault": applied, "ms": ms}
        if applied:
            entry["cut"] = True
        if downstream_closed:
            entry["downstream_closed"] = True
        if error:
            entry["error"] = error
        log(entry)
        if response is None:
            return web.json_response({"error": {"type": "lb_sandbox_edge", "message": error}}, status=502)
        return response

    return handle


def cmd_aux(root_arg: str) -> int:  # noqa: C901 - one event loop with three listeners and a child
    import asyncio
    import ssl

    import aiohttp
    from aiohttp import web

    root = check_root(Path(root_arg))
    log_to_root(root, "logs/aux.log")
    if os.environ.get("LB_SANDBOX_ROOT") != str(root):
        raise Refused("LB_SANDBOX_ROOT does not match the sandbox root")
    # The front (a child, inherits this) writes state/front.json through a .tmp by name: same two rules as _boot.
    check_own_volume(root)
    confine(root, reads=True)
    meta = read_root_json(root, "sandbox.json")
    if meta.get("run_id") != root.name or not isinstance(meta.get("ports"), dict):
        raise Refused(f"{root} has no sandbox.json stamped with its run id")
    ports = meta["ports"]
    check_ports(list(ports.values()))
    state_file = root / "state" / "aux.json"
    edge_log = root / "logs" / "edge.jsonl"
    gate_log = root / "logs" / "gate.jsonl"
    counters = {
        "gate_forwarded": {},
        "gate_refused": 0,
        "gate_refused_by": {},
        "edge_requests": {"anthropic": 0, "openai": 0},
        "faults_applied": {"anthropic": 0, "openai": 0},
    }
    faults = {edge: FaultState(root, f"state/fault-{edge}.json") for edge in EDGES}
    front_proc: dict[str, subprocess.Popen | None] = {"proc": None}
    ready = {"value": False}

    def append(path: Path, record: dict) -> None:
        with append_in_root(root, path.relative_to(root)) as fh:
            fh.write(json.dumps(record, sort_keys=True) + "\n")

    def save_state() -> None:
        proc = front_proc["proc"]
        write_json(
            root,
            state_file.relative_to(root),
            {
                "pid": os.getpid(),
                "front_pid": proc.pid if proc else None,
                "front_alive": bool(proc and proc.poll() is None),
                "ready": ready["value"],
                "updated_at": now_iso(),
                "gate": {
                    "forwarded": [
                        {"method": k.split(" ", 1)[0], "path": k.split(" ", 1)[1], "count": v}
                        for k, v in sorted(counters["gate_forwarded"].items())
                    ],
                    "refused": counters["gate_refused"],
                    "refused_by": counters["gate_refused_by"],
                },
                "edge": {
                    "requests": counters["edge_requests"],
                    "faults_applied": counters["faults_applied"],
                    "log": str(edge_log),
                },
            },
        )

    try:
        import certifi

        ssl_context = ssl.create_default_context(cafile=certifi.where())
    except ImportError:
        ssl_context = ssl.create_default_context()

    async def main() -> None:
        connector = aiohttp.TCPConnector(ssl=ssl_context, limit=0)
        session = aiohttp.ClientSession(
            connector=connector,
            auto_decompress=False,
            trust_env=False,
            skip_auto_headers=("User-Agent", "Accept-Encoding"),
            timeout=aiohttp.ClientTimeout(total=None, sock_connect=15, sock_read=900),
        )

        async def gate(request: web.Request) -> web.StreamResponse:
            key = (request.method, request.path)
            name = f"{request.method} {request.path}"
            if key not in GATE_ALLOWED or request.query_string:
                counters["gate_refused"] += 1
                counters["gate_refused_by"][name] = counters["gate_refused_by"].get(name, 0) + 1
                append(gate_log, {"ts": now_iso(), "method": request.method, "path": request.path, "status": 403})
                save_state()
                return web.json_response({"detail": "lb-sandbox peer gate: read-only mirror only"}, status=403)
            headers = {k: v for k, v in request.headers.items() if k.lower() in ("authorization", "accept")}
            async with session.get(f"{LIVE_PEER_URL}{request.path}", headers=headers) as upstream:
                body = await upstream.read()
                status = upstream.status
                content_type = upstream.headers.get("content-type", "application/json")
            counters["gate_forwarded"][name] = counters["gate_forwarded"].get(name, 0) + 1
            append(gate_log, {"ts": now_iso(), "method": request.method, "path": request.path, "status": status})
            save_state()
            return web.Response(status=status, body=body, headers={"content-type": content_type})

        def edge_handler(edge: str):
            def log(entry: dict) -> None:
                append(edge_log, entry)
                save_state()

            return make_edge_handler(edge, EDGES[edge], faults[edge], session, counters, log)

        runners = []
        gate_app = web.Application(client_max_size=1 << 20)
        gate_app.router.add_route("*", "/{tail:.*}", gate)
        apps = [(gate_app, ports["gate"])]
        for edge in EDGES:
            app = web.Application(client_max_size=256 << 20)
            app.router.add_route("*", "/{tail:.*}", edge_handler(edge))
            apps.append((app, ports[f"edge_{edge}"]))
        for app, port in apps:
            runner = web.AppRunner(app, auto_decompress=False, access_log=None, handle_signals=False)
            await runner.setup()
            await web.TCPSite(runner, "127.0.0.1", port).start()
            runners.append(runner)

        front_env = {
            "HOME": str(root / "home"),
            "PATH": "/usr/bin:/bin",
            "AGENT_LB_FRONT_HOST": "127.0.0.1",
            "AGENT_LB_FRONT_LISTEN_PORT": str(ports["front"]),
            "AGENT_LB_FRONT_UPSTREAM_PORTS": f"{ports['primary']},{ports['standby']}",
            "AGENT_LB_FRONT_PREFERRED_FILE": str(root / "state" / "front-preferred-port"),
            "AGENT_LB_FRONT_STATE_FILE": str(root / "state" / "front.json"),
            "LB_SANDBOX_ROOT": str(root),
        }
        front_log = append_in_root(root, "logs/front.log")
        front_proc["proc"] = subprocess.Popen(
            # The trailing root is ignored by the front; it puts the run's root in the command line for stop.
            [meta["node"], str(root / "runtime" / "scripts" / "agent-lb-front.mjs"), str(root)],
            env=front_env,
            stdout=front_log,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            cwd=str(root),
        )
        deadline = time.monotonic() + 15
        while not listener_pids(ports["front"]):
            if time.monotonic() > deadline or front_proc["proc"].poll() is not None:
                raise Unhealthy("sandbox front did not listen")
            await asyncio.sleep(0.2)
        ready["value"] = True
        save_state()

        stop = asyncio.Event()
        loop = asyncio.get_running_loop()
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            loop.add_signal_handler(sig, stop.set)
        while not stop.is_set():
            if front_proc["proc"].poll() is not None:
                break
            save_state()
            try:
                await asyncio.wait_for(stop.wait(), timeout=1.0)
            except asyncio.TimeoutError:
                pass
        ready["value"] = False
        for runner in runners:
            await runner.cleanup()
        await session.close()

    try:
        asyncio.run(main())
    finally:
        proc = front_proc["proc"]
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(10)
            except subprocess.TimeoutExpired:
                proc.kill()
        save_state()
    return EXIT_OK


# ---------------------------------------------------------------- status, client-env, fault, restart, scan


def cmd_status(args) -> int:
    root, meta = load_meta(args.run_id)
    ports = meta["ports"]
    code, body = http(ports["primary"], "/internal/drain/status", timeout=2)
    in_flight = None
    if code == 200:
        try:
            in_flight = int(json.loads(body)["checks"]["in_flight"])
        except (ValueError, KeyError, TypeError):
            in_flight = None
    aux = read_root_json(root, "state/aux.json")
    accounts = read_accounts(root)
    for account in accounts:
        account.pop("usable", None)
    primary_pid = launchd_pid(meta["label"])
    healthy = (
        http(ports["primary"], "/health/ready")[0] == 200
        and http(ports["front"], "/health/ready")[0] == 200
        and bool(aux.get("ready"))
    )
    out = {
        "run_id": meta["run_id"],
        "healthy": healthy,
        "in_flight_primary": in_flight,
        "preferred_port": read_root_json(root, "state/front.json").get("preferred"),
        "primary_pid": primary_pid,
        "aux_pid": aux.get("pid"),
        "front_pid": aux.get("front_pid"),
        # The two kernel rules the app and the front run under (see "kernel confinement").
        "own_volume": on_own_volume(root),
        "confined": {
            "primary": is_confined(primary_pid),
            "aux": is_confined(aux.get("pid")),
            "front": is_confined(aux.get("front_pid")),
        },
        "accounts": accounts,
        "accounts_per_vendor": usable_counts(read_accounts(root)),
        "gate": aux.get("gate", {"forwarded": [], "refused": 0}),
        "edge": {k: v for k, v in aux.get("edge", {}).items() if k != "log"},
        "edge_log": str(root / "logs" / "edge.jsonl"),
        # The sandbox app's own SQLite store, which holds its request logs (AGENT_LB_DATABASE_URL in sandbox_env).
        "request_log_store": str(root / "data" / "store.db"),
        "ports": ports,
    }
    return emit(out, EXIT_OK if healthy else EXIT_UNHEALTHY)


CODEX_PLACEHOLDER = "lb-sandbox-placeholder-not-a-credential"


def cmd_client_env(args) -> int:
    root, meta = load_meta(args.run_id)
    front = meta["ports"]["front"]
    if args.vendor == "claude":
        os.close(confined(lambda: open_dir(root, "clients/claude", create=True)))
        env = {
            "CLAUDE_LB_LOCAL_URL": f"http://127.0.0.1:{front}",
            "CLAUDE_LB_BASE_URL": f"http://127.0.0.1:{front}",
            "CLAUDE_LB_LAUNCHD_LABEL": meta["label"],
        }
    else:
        home = root / "clients" / "codex"
        config = (
            "\n".join(
                [
                    'model_provider = "agent-lb"',
                    "",
                    "[model_providers.agent-lb]",
                    'name = "OpenAI"',
                    f'base_url = "http://127.0.0.1:{front}/backend-api/codex"',
                    'wire_api = "responses"',
                    "supports_websockets = false",
                    "requires_openai_auth = true",
                    "",
                ]
            )
        ).encode()
        # New inodes by rename, no link followed: a planted link or hard link never truncates a live file.
        confined(lambda: write_in_root(root, "clients/codex/config.toml", config))
        confined(
            lambda: write_json(
                root, "clients/codex/auth.json", {"OPENAI_API_KEY": CODEX_PLACEHOLDER, "auth_mode": "apikey"}
            )
        )
        env = {"CODEX_SOURCE_HOME": str(home)}
    return emit({"run_id": meta["run_id"], "vendor": args.vendor, "env": env}, EXIT_OK)


def parse_fault(spec: str) -> tuple[str, int | None]:
    if spec == "account_429":
        return "account_429", None
    match = re.fullmatch(r"cut_after_bytes:([0-9]{1,9})", spec)
    if match:
        return "cut_after_bytes", int(match.group(1))
    match = re.fullmatch(r"hold_stream:([0-9]{1,3})", spec)
    if match and 1 <= int(match.group(1)) <= HOLD_MAX_S:
        return "hold_stream", int(match.group(1))
    raise Refused(f"unknown fault {spec!r}; use account_429, cut_after_bytes:N or hold_stream:S (S 1-{HOLD_MAX_S})")


def cmd_fault(args) -> int:
    root, _ = load_meta(args.run_id)
    path = f"state/fault-{args.edge}.json"
    if args.clear:
        confined(lambda: write_json(root, path, {"armed": False, "nonce": uuid.uuid4().hex, "at": now_iso()}))
        return emit({"armed": False, "edge": args.edge, "fault": None}, EXIT_OK)
    fault, n = parse_fault(args.arm)
    if fault == "hold_stream" and args.edge != "anthropic":
        raise Refused("hold_stream is served by the anthropic edge only")
    confined(
        lambda: write_json(
            root, path, {"armed": True, "fault": fault, "n": n, "nonce": uuid.uuid4().hex, "at": now_iso()}
        )
    )
    return emit({"armed": True, "edge": args.edge, "fault": args.arm}, EXIT_OK)


def cmd_restart(args) -> int:
    check_launchctl()
    root, _ = load_meta(args.run_id)
    # Nothing is written (not even the restart log) unless the root is a real directory under a link-free
    # sandboxes dir (load_meta) and is its own volume, so no name in it can reach a live file.
    check_own_volume(root)
    lb_restart = Path(__file__).resolve().parent / "lb-restart"
    if not lb_restart.is_file():
        raise Unhealthy(f"{lb_restart} missing")
    log_path = root / "logs" / "lb-restart.log"
    # Isolated, with no PYTHON* or DYLD_* variable passed on: nothing planted on a path in the caller's
    # environment (PYTHONPATH=<root>/runtime) loads into lb-restart, which can signal and kickstart.
    argv = isolated_python(
        sys.executable, lb_restart, ["--sandbox", str(root / "lb-restart.json"), "--force", "--reason", args.reason]
    )
    started = time.monotonic()
    # Opened by descriptor from the root: a planted link or hard link (to the live plist, say) is refused.
    with confined(lambda: append_in_root(root, "logs/lb-restart.log")) as log:
        log.write(f"==== {now_iso()} lb-sandbox restart: {' '.join(argv[1:])}\n")
        log.flush()
        # lb-restart and the reaper it spawns carry the run's marker, so `scan --processes` can see their env.
        env = {**isolated_env(dict(os.environ)), "LB_SANDBOX_ROOT": str(root)}
        proc = subprocess.Popen(
            argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, cwd=str(root), env=env
        )
        assert proc.stdout is not None
        for line in proc.stdout:
            log.write(line)
            log.flush()
            sys.stderr.write(line)
        code = proc.wait()
    out = {"lb_restart_exit": code, "log": str(log_path), "seconds": round(time.monotonic() - started, 1)}
    return emit(out, EXIT_OK if code == 0 else EXIT_UNHEALTHY)


def cmd_scan(args) -> int:
    root = root_for(args.run_id)
    if not args.paths and not args.processes:
        raise Refused("scan needs paths, --processes or both")
    secrets = load_secrets(root if entry_of(root) == "dir" else None)
    key = load_key(root)
    newer = Path(args.newer_than).stat().st_mtime if args.newer_than else None
    result = (
        scan_paths(
            [Path(p) for p in args.paths],
            secrets,
            newer_than=newer,
            exclude=[Path(p) for p in args.exclude],
            skip_exact=custody_paths(root),  # the store and its key, at their own paths only
            keys=[key] if key else None,  # any ciphertext this key opens, an old snapshot's included
            root=root,  # inside the root: no link followed from a root descriptor, no second hard link read
        )
        if args.paths
        else {"found": False, "complete": True, "files_scanned": 0, "hits": []}
    )
    result.pop("_files", None)
    if args.processes:
        procs = scan_processes(root, args.run_id, secrets)
        result["processes"] = procs
        result["found"] = result["found"] or procs["found"]
        result["complete"] = result["complete"] and procs["complete"]
    result["secrets_loaded"] = len(secrets)
    result["ciphertext_keys"] = 1 if key else 0
    result["run_id"] = args.run_id
    return emit(result, EXIT_OK if result["complete"] and not result["found"] else EXIT_ASSERT)


# ---------------------------------------------------------------- stop and gc


def stop_pid(pid: int, bound: float = 15) -> None:
    for sig, wait in ((signal.SIGTERM, bound), (signal.SIGKILL, 5)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + wait
        while pid_alive(pid) and time.monotonic() < deadline:
            try:
                os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                pass
            time.sleep(0.2)
        if not pid_alive(pid):
            return


def unlink_key(root: Path) -> dict:
    """Unlink data/encryption.key through a descriptor for a real data dir under a real root.

    A data dir (or root) swapped for a link to the live data dir is refused: unlinking through it would
    delete the live key. Unlinking the name inside a real data dir removes only that name.
    """
    if entry_of(root) is None:
        return {"key_unlinked": None}
    try:
        data_fd = open_dir(root, "data")
    except FileNotFoundError:
        return {"key_unlinked": "absent"}
    except OSError as exc:
        return {"key_unlinked": False, "key_error": f"root or data dir is a link ({exc.__class__.__name__})"}
    try:
        os.unlink("encryption.key", dir_fd=data_fd)
        return {"key_unlinked": True}
    except FileNotFoundError:
        return {"key_unlinked": "absent"}
    except OSError as exc:
        return {"key_unlinked": False, "key_error": exc.__class__.__name__}
    finally:
        os.close(data_fd)


def entry_of(root: Path) -> str | None:
    """root_entry, with "unknown" when the sandboxes dir cannot be pinned (a link, not private): never None then,
    so a root that cannot be seen is never reported gone."""
    try:
        return root_entry(root)
    except FileNotFoundError:
        return None
    except OSError:
        return "unknown"


def has_dir(root: Path, rel: str) -> bool:
    """True when root/rel is a real directory, reached from the pinned root with no link followed."""
    try:
        os.close(open_dir(root, rel))
    except OSError:
        return False
    return True


# (device, inode) of each root this process made, taken at mkdir before its volume covers it: start's failure
# path has no sandbox.json to read it from.
ROOT_IDS: dict[str, tuple[int, int]] = {}


def root_id_of(meta: dict, run_id: str) -> tuple[int, int] | None:
    """The root directory's recorded (device, inode): this process's own record, else sandbox.json's."""
    if run_id in ROOT_IDS:
        return ROOT_IDS[run_id]
    value = meta.get("root_id")
    if isinstance(value, list) and len(value) == 2 and all(type(v) is int for v in value):
        return value[0], value[1]
    return None


def _empty_dir(dir_fd: int) -> None:
    """Remove everything inside the directory at dir_fd, by name inside descriptors only: a subdirectory is
    entered only when the descriptor is the inode the listing named, on the same device, never through a link;
    a link or a second hard link loses only its name here."""
    device = os.fstat(dir_fd).st_dev
    with os.scandir(dir_fd) as listing:
        names = sorted(entry.name for entry in listing)
    for name in names:
        info = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        if not stat.S_ISDIR(info.st_mode):
            os.unlink(name, dir_fd=dir_fd)
            continue
        child = os.open(name, DIR_FLAGS, dir_fd=dir_fd)
        try:
            opened = os.fstat(child)
            if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino) or opened.st_dev != device:
                raise Confinement(f"{name} was swapped or is another volume; not entered")
            _empty_dir(child)
        finally:
            os.close(child)
        os.rmdir(name, dir_fd=dir_fd)  # only an empty directory: one swapped in since is left alone


def remove_root(root: Path, expect: tuple[int, int] | None, was_volume: bool) -> bool:
    """Delete the (unmounted) root by name inside the pinned sandboxes dir, never through a path: a sandboxes
    dir renamed aside and replaced by a link to ~/.agent-lb after the checks leaves the delete in the directory
    this run was made in. True when gone.

    Only the directory start made is removed: it must be the recorded (device, inode) (expect; None removes
    nothing), so live state moved into the root's name after the detach is refused untouched. A root that was
    its own volume until the detach is the bare mountpoint, empty by construction, so it is only rmdir'ed: even
    a forged record cannot make this delete anything inside a directory. A root that never was a volume is
    emptied through the descriptor checked against the record, then rmdir'ed. A link, a non-directory or a
    root still mounted is refused."""
    sb = sandboxes_fd(root.parent)
    try:
        fd = os.open(root.name, DIR_FLAGS, dir_fd=sb)
    except FileNotFoundError:
        return True
    except OSError:
        return False
    try:
        info = os.fstat(fd)
        if expect is None or (info.st_dev, info.st_ino) != tuple(expect) or info.st_dev != os.fstat(sb).st_dev:
            return False
        if not was_volume:
            _empty_dir(fd)
    except OSError:
        return False
    finally:
        os.close(fd)
    try:
        os.rmdir(root.name, dir_fd=sb)
    except FileNotFoundError:
        return True
    except OSError:
        return False
    return True


def command_ref(cmd: str) -> str:
    """A leftover process by hash only: its command line may hold anything, a token included."""
    return hashlib.sha256(cmd.encode(errors="replace")).hexdigest()[:12]


def teardown(run_id: str, logs_to: Path | None, created: bool = False) -> dict:
    """Stop everything the sandbox started, keep scanned logs if asked, delete the root and its volume, verify.

    Nothing is signalled, scanned or deleted unless the root holds this run's own stamped sandbox.json (a real
    single-link file whose run_id is this run's), or this process created the root (start's failure path). A
    typo, a stale id or a hostile one (`aneyman`, `runtime`) stops nothing. Processes are matched by the root
    path or the run's launchd label, never by a bare word.

    The sandboxes dir must be link-free from the top and agent-lb's own (sandboxes_fd), else nothing is done:
    with ~/.agent-lb/sandboxes a link to ~/.agent-lb, run id `state` named the live state dir. It is pinned by a
    descriptor for the rest of the process and the root is read, unmounted and removed by name inside it, so a
    swap during teardown cannot turn any of it toward live state. A root whose sandbox.json records another
    sandboxes dir than the pinned one is refused.
    """
    root = root_for(run_id)
    # The sandboxes dir is pinned here (or was at create, in start's failure path) and held to the end: every
    # read, delete and unmount below goes by name inside that descriptor.
    entry = entry_of(root)
    pin_error = "the sandboxes dir is a link or not private" if entry == "unknown" else None
    real_root = entry == "dir"
    meta = stamped_meta(root, run_id) if real_root else {}
    if meta and isinstance(meta.get("sandboxes_id"), list) and list(meta["sandboxes_id"]) != list(sandboxes_id()):
        meta, pin_error = {}, "the sandboxes dir is not the one this run was made in"
    owned = (bool(meta) or created) and not pin_error
    label, aux_label = labels_for(run_id)
    meta_ports = meta.get("ports") if isinstance(meta.get("ports"), dict) else {}
    ports = [int(p) for p in meta_ports.values() if isinstance(p, int) and not isinstance(p, bool)]
    secrets: list[str] = []
    keys: list[str] = []
    load_error = None
    if owned:
        try:
            secrets = load_secrets(root if real_root else None)
            key = load_key(root) if real_root else None
            keys = [key] if key else []
        except Exception as exc:  # a broken or redirected store must not block teardown
            secrets, keys = [], []
            load_error = exc.__class__.__name__
    booted = {}
    for name in (label, aux_label):
        if not label_loaded(name):
            booted[name] = "not loaded"
        elif label_names_root(name, root):
            booted[name] = bootout(name)
        else:
            booted[name] = "refused: the loaded job does not run this sandbox root"
    refused = None
    if owned:
        rows = processes()
        lineage = own_lineage(rows)
        standby = read_root_text(root, "state/lb-standby.pid", 64).strip() if real_root else ""
        pid = int(standby) if standby.isdigit() else 0
        if pid and any(p == pid and names_root(cmd, root) for p, _, cmd in rows):
            stop_pid(pid)
        # Every process of the run: those naming its root or its launchd label, never this stop or its callers.
        for pid, _, cmd in processes():
            if owned_process(cmd, root, run_id) and pid not in lineage:
                stop_pid(pid, bound=5)
    elif pin_error:
        refused = f"{pin_error}: nothing was signalled, scanned or deleted"
    elif entry is not None:
        refused = "no sandbox.json stamped with this run id: nothing was signalled, scanned or deleted"
    logs: dict = {"copied": False}
    if owned and real_root:
        # The whole root, not just logs/: a token in state/, home/ or a copied store is a leak too.
        scanned = scan_paths([root], secrets, skip_exact=custody_paths(root), keys=keys, root=root)
        logs["scan_found"] = scanned["found"]
        logs["scan_complete"] = scanned["complete"]
        logs["files_scanned"] = scanned["files_scanned"]
        logs["scan_scope"] = "root"
        logs["ciphertext_keys"] = len(keys)
        logs["hits"] = [os.path.relpath(hit, root_text(root)) for hit in scanned["hits"]]
        logs["unreadable"] = [os.path.relpath(p, root_text(root)) for p in scanned["unreadable_paths"]]
        if logs_to is not None and has_dir(root, "logs"):
            if scanned["found"] is False and scanned["complete"] and not load_error:
                logs_base = os.path.join(root_text(root), "logs")
                log_files = [f for f in scanned["_files"] if f.startswith(logs_base + os.sep)]
                try:  # the copy is best effort; teardown below always runs
                    # Every exported byte is scanned again as it is copied: the files may have changed since.
                    exported = export_logs(root, logs_to, log_files, Detector(secrets, keys))
                    logs.update(
                        {
                            "files_copied": exported["files"],
                            "bytes_copied": exported["bytes"],
                            "export_scanned": True,
                            "copied": True,
                            "to": str(logs_to),
                        }
                    )
                except LeakFound:
                    logs["copy_error"] = "LeakFound"
                    logs["export_found"] = True
                except OSError as exc:
                    logs["copy_error"] = exc.__class__.__name__
            else:
                logs["refused"] = (
                    "token, key or ciphertext found in the sandbox root"
                    if scanned["found"]
                    else "secrets could not all be loaded or a file could not be read"
                )
    if load_error:
        logs["secret_load_error"] = load_error
    custody: dict = {"key_unlinked": None}
    volume: dict = {}
    if owned:
        custody = unlink_key(root)
        entry = entry_of(root)
        if entry == "link":
            os.unlink(root.name, dir_fd=sandboxes_fd(root.parent))  # the link only; never its target
        elif entry == "dir":
            was_volume = on_own_volume(root)
            volume = detach_volume(root)
            if volume.get("volume") != "still mounted":
                volume["root_removed"] = remove_root(root, root_id_of(meta, run_id), was_volume)
        if not on_own_volume(root):
            volume["image_removed"] = remove_image(run_id)
    time.sleep(0.5)
    rows = processes()
    lineage = own_lineage(rows)
    leftover = [
        {"pid": pid, "command_sha12": command_ref(cmd)}
        for pid, _, cmd in rows
        if (owned_process(cmd, root, run_id) or names_run(cmd, run_id)) and pid not in lineage
    ]
    result = {
        "labels_loaded": [name for name in (label, aux_label) if label_loaded(name)],
        "listeners": [{"port": port, "pids": pids} for port in ports if (pids := listener_pids(port))],
        "processes": leftover,
        "root_exists": entry_of(root) is not None,
        "volume_mounted": on_own_volume(root),
        "image_exists": image_exists(run_id),
        "bootout": booted,
        "logs": logs,
        "custody": custody,
        "volume": volume,
    }
    if refused:
        result["refused"] = refused
    result["clean"] = not (
        result["labels_loaded"]
        or result["listeners"]
        or result["processes"]
        or result["root_exists"]
        or result["volume_mounted"]
        or result["image_exists"]
    )
    return result


def cmd_stop(args) -> int:
    check_launchctl()
    run_id = check_run_id(args.run_id)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, signal.SIG_IGN)
    result = teardown(run_id, Path(args.logs_to) if args.logs_to else None)
    result["run_id"] = run_id
    if result.get("refused"):
        return emit(result, EXIT_REFUSED)
    safe_logs = result.get("logs", {})
    safe = (
        safe_logs.get("scan_found") is False
        and safe_logs.get("scan_complete") is True
        and not safe_logs.get("secret_load_error")
        and not safe_logs.get("copy_error")
        and not safe_logs.get("export_found")
        and result.get("custody", {}).get("key_unlinked") is not False
    )
    return emit(result, EXIT_OK if result["clean"] and safe else EXIT_ASSERT)


def cmd_gc(args) -> int:
    check_launchctl()
    stopped, kept, skipped = [], [], []
    now = time.time()
    for root in sandbox_roots():
        run_id = root.name
        meta = stamped_meta(root, run_id)
        created = meta.get("created_epoch")
        if not meta or isinstance(created, bool) or not isinstance(created, (int, float)):
            # Not a sandbox this code can prove it started: never stopped by gc.
            skipped.append({"run_id": run_id, "reason": "no sandbox.json stamped with this run id"})
            continue
        if now - float(created) > args.older_than and not pid_alive(meta.get("caller_pid")):
            result = teardown(run_id, None)
            stopped.append(run_id) if result["clean"] else kept.append({"run_id": run_id, "teardown": result})
    return emit({"stopped": stopped, "not_clean": kept, "skipped": skipped}, EXIT_OK if not kept else EXIT_ASSERT)


# ---------------------------------------------------------------- main


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="lb-sandbox", description=__doc__, formatter_class=argparse.RawTextHelpFormatter
    )
    sub = parser.add_subparsers(dest="command", required=True)

    def command(name: str, help_text: str) -> argparse.ArgumentParser:
        p = sub.add_parser(name, help=help_text)
        p.add_argument("--json", action="store_true", help="print one JSON object (always on)")
        return p

    p = command("start", "create, boot and mirror a sandbox")
    p.add_argument("--run-id", required=True)
    p.add_argument("--from-live", action="store_true")
    p.add_argument("--port", type=int)
    p.add_argument("--min-accounts", type=int, default=2)
    p.add_argument("--transport", default="http")
    p.add_argument("--logs-to", help="on failure, copy scanned logs here before teardown")
    p = command("status", "health, accounts, gate and edge counters")
    p.add_argument("--run-id", required=True)
    p = command("client-env", "env for a client pointed only at the sandbox")
    p.add_argument("--run-id", required=True)
    p.add_argument("--vendor", choices=("claude", "codex"), required=True)
    p = command("fault", "arm or clear one edge fault")
    p.add_argument("--run-id", required=True)
    p.add_argument("--edge", choices=tuple(EDGES), required=True)
    group = p.add_mutually_exclusive_group(required=True)
    group.add_argument("--arm")
    group.add_argument("--clear", action="store_true")
    p = command("restart", "blue/green restart of the sandbox through lb-restart --sandbox")
    p.add_argument("--run-id", required=True)
    p.add_argument("--reason", required=True)
    p = command("scan", "search files for the live federation token and mirrored tokens")
    p.add_argument("--run-id", required=True)
    p.add_argument("--newer-than", help="only files modified after this file")
    p.add_argument("--exclude", action="append", default=[], help="skip this path (repeatable)")
    p.add_argument("--processes", action="store_true", help="also scan the exec env of every process of the run")
    p.add_argument("paths", nargs="*")
    p = command("stop", "tear the sandbox down and verify")
    p.add_argument("--run-id", required=True)
    p.add_argument("--logs-to")
    p = command("gc", "stop abandoned sandboxes")
    p.add_argument("--older-than", type=float, default=3600)
    return parser


COMMANDS = {
    "start": cmd_start,
    "status": cmd_status,
    "client-env": cmd_client_env,
    "fault": cmd_fault,
    "restart": cmd_restart,
    "scan": cmd_scan,
    "stop": cmd_stop,
    "gc": cmd_gc,
}


# The marker this process was exec'd with (read at import, before main sets it).
EXEC_ENV_MARKER = os.environ.get("LB_SANDBOX_ROOT")


def run_marker(args) -> str | None:
    """LB_SANDBOX_ROOT for a command of one run (None for gc, or a run id the command will refuse)."""
    run_id = getattr(args, "run_id", None)
    try:
        return str(root_for(run_id)) if run_id else None
    except Refused:
        return None


def in_live_venv() -> bool:
    try:
        return Path(sys.prefix).resolve() == LIVE_VENV.resolve()
    except OSError:
        return False


def isolated_env(env: dict[str, str]) -> dict[str, str]:
    """env without what loads code into a Python child before its first line runs: every PYTHON* variable
    (PYTHONPATH naming <root>/runtime, where a sitecustomize.py can be planted) and every DYLD_* variable."""
    return {k: v for k, v in env.items() if not k.startswith(("PYTHON", "DYLD_"))}


def isolated_python(python: str, script: Path, argv: list[str]) -> list[str]:
    """The argv that runs script under python isolated (-I: no PYTHON* variable, user site or script dir)."""
    return [python, "-I", str(script), *argv]


def main(argv: list[str]) -> int:
    if argv[:1] == ["_serve"] and len(argv) >= 2:
        try:
            return cmd_serve(argv[1], argv[2:])
        except Refused as exc:
            print(f"lb-sandbox _serve refused: {exc}", file=sys.stderr)
            return EXIT_REFUSED
    if argv[:1] == ["_boot"] and len(argv) >= 2:
        try:
            boot_app(Path(argv[1]), argv[2:])
            return EXIT_OK
        except Refused as exc:
            print(f"lb-sandbox _boot refused: {exc}", file=sys.stderr)
            return EXIT_REFUSED
    if argv[:1] == ["_aux"] and len(argv) == 2:
        try:
            return cmd_aux(argv[1])
        except Refused as exc:
            print(f"lb-sandbox _aux refused: {exc}", file=sys.stderr)
            return EXIT_REFUSED
    args = build_parser().parse_args(argv)
    marker = run_marker(args)
    if marker is not None:
        # A command of run R names R in its argv, so `scan --processes` claims it: its exec environment must
        # carry the run's marker or the scan cannot tell a shown environment from a hidden one.
        os.environ["LB_SANDBOX_ROOT"] = marker
    if not os.environ.get("LB_SANDBOX_NO_REEXEC"):
        python = LIVE_VENV / "bin" / "python"
        reexec = (not in_live_venv() and python.exists()) or (marker is not None and marker != EXEC_ENV_MARKER)
        if reexec:
            # status, scan and stop decrypt the sandbox store; the agent-lb venv has the crypto they need. Always
            # isolated, whatever this process was started with: `python -I lb-sandbox stop` with PYTHONPATH naming
            # a root's runtime/ must not run a sitecustomize.py planted there in the re-exec'd process.
            target = str(python) if python.exists() and not in_live_venv() else sys.executable
            os.execve(target, isolated_python(target, Path(__file__).resolve(), argv), isolated_env(dict(os.environ)))
    try:
        return COMMANDS[args.command](args)
    except Refused as exc:
        return emit({"refused": str(exc)}, EXIT_REFUSED)
    except Unhealthy as exc:
        return emit({"error": str(exc)}, EXIT_UNHEALTHY)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
