#!/usr/bin/env python3
from __future__ import annotations

import sys
from pathlib import Path

source = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(source if (source / "app").is_dir() else Path.home() / ".agent-lb/runtime/agent-lb"))
import argparse
import shutil
import signal
import subprocess
import time

from scripts.restart_budget import EXCHANGE_SETTLE_S, minimum_exit_timeout, parse_reaper_args, regenerate_plist
from scripts.restart_context import RestartContext, SandboxRefused
from scripts.restart_process import (
    check_loaded_sandbox_job,
    established,
    exit_timeout,
    front_routes_to,
    front_understands_preference,
    graceful_seconds,
    healthy,
    in_flight,
    kickstart_primary,
    launchd_pid,
    listener_pid,
    pid_alive,
    plist_env,
    reap,
    restart_primary,
    signal_group,
    spawn_reaper,
    start_standby,
    stop_leftover_standby,
    stop_pid_gracefully,
    wait_for_oauth_flows,
    wait_until,
)
from scripts.restart_state import Files, Lock, apply_sandbox, read_state, remove_state, say, set_preferred, sync_log


def main(context: RestartContext) -> int:
    if any((arg.startswith("--reap") for arg in sys.argv[1:])):
        try:
            pid, deadline, config = parse_reaper_args(sys.argv[1:])
            if config is not None:
                apply_sandbox(context, config)
            return reap(context, pid, deadline)
        except (SandboxRefused, ValueError) as exc:
            print(f"lb-restart --reap refused: {exc}", file=sys.stderr)
            return 2
    p = argparse.ArgumentParser(
        description="Controlled, zero-gap restart of the live agent-lb service (blue/green).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--reason", required=True, help="Why; goes into sync.log.")
    p.add_argument("--from", dest="src", type=Path, help="Source root (a worktree) for --files.")
    p.add_argument("--files", nargs="+", default=[], help="Runtime-relative paths to copy from --from.")
    p.add_argument("--backup", type=Path, help="Backup dir to restore from if the new code fails its health gate.")
    p.add_argument("--reload-plist", action="store_true", help="bootout/bootstrap the primary so plist edits apply.")
    p.add_argument(
        "--check", action="store_true", help="Only boot and health-gate a standby on the code on disk, then stop it."
    )
    p.add_argument("--skip-exchange-wait", action="store_true", help="Skip OAuth/exchange waits.")
    p.add_argument("--skip-exit-timeout-gate", action="store_true", help="Skip ExitTimeOut gate.")
    p.add_argument(
        "--oauth-wait", type=float, default=600, help="Seconds to wait in total for sign-ins in progress (default 600)."
    )
    p.add_argument("--lock-wait", type=float, default=900, help="Seconds to wait for another restart (default 900).")
    p.add_argument(
        "--boot-timeout", type=float, default=90, help="Seconds for an instance to pass health (default 90)."
    )
    p.add_argument(
        "--sandbox",
        type=Path,
        metavar="CONFIG",
        help="Restart the lb-sandbox instance described by CONFIG (JSON) instead of the live service.",
    )
    args = p.parse_args()
    if args.sandbox is not None:
        combined = [
            flag
            for flag, value in (
                ("--from", args.src),
                ("--files", args.files),
                ("--backup", args.backup),
                ("--reload-plist", args.reload_plist),
            )
            if value
        ]
        if combined:
            p.error(f"--sandbox cannot be combined with {', '.join(combined)}")
        try:
            apply_sandbox(context, args.sandbox)
        except SandboxRefused as exc:
            p.error(f"--sandbox refused: {exc}")
        say(
            context,
            f"sandbox {context.LABEL}: front :{context.FRONT_PORT} is an lb-sandbox child, not a launchd job; no front hot-swap",
        )
    if args.files and (not args.src):
        p.error("--files needs --from")
    if not context.RUNTIME.is_dir() or not context.PLIST.is_file():
        p.error(f"runtime {context.RUNTIME} or plist {context.PLIST} missing")
    if shutil.which("launchctl") != "/bin/launchctl":
        p.error(f"launchctl resolves to {shutil.which('launchctl')}, not /bin/launchctl; refusing to touch the live LB")
    try:
        with Lock(context, args.reason, args.lock_wait):
            try:
                return run(context, args)
            except BaseException as exc:
                if isinstance(exc, (SystemExit, SandboxRefused)):
                    raise
                standby = listener_pid(context, context.STANDBY_PORT)
                say(
                    context,
                    f"crashed: {exc!r}; primary pid {launchd_pid(context, context.LABEL)}, standby pid {standby}",
                )
                sync_log(
                    context,
                    f"lb-restart CRASHED reason={args.reason!r} error={exc!r}; front prefers {(read_state(context, context.PREFERRED_FILE) or ('?', 0))[0].strip()}; standby pid {standby}. The front falls back to whichever instance is up; the next lb-restart retires a leftover standby.",
                )
                raise
    except SandboxRefused as exc:
        say(context, f"--sandbox refused: {exc}")
        return 2


def run(context: RestartContext, args) -> int:
    drain = graceful_seconds(context)
    required = minimum_exit_timeout(plist_env(context))
    if exit_timeout(context) < required and (not args.skip_exit_timeout_gate):
        say(context, f"ExitTimeOut < {required}; regenerating via install-service")
        try:
            if context.SANDBOX_ROOT is not None:
                raise RuntimeError("regenerate sandbox plist")
            regenerate_plist(context.PLIST)
            args.reload_plist = True
            say(context, "plist repaired; reload")
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
            say(context, f"ExitTimeOut regeneration failed: {exc}")
            return 3
    primary_bound = max(drain, exit_timeout(context)) + 15
    files = Files(context, label="lb-restart")
    stats: dict[str, object] = {"reason": args.reason}
    say(context, f"reason: {args.reason}; drain bound {drain}s")
    oauth_waited = 0.0

    def hold_for_oauth(port: int) -> None:
        nonlocal oauth_waited
        if args.skip_exchange_wait or args.check or (oauth_waited > 0 and oauth_waited >= args.oauth_wait):
            return
        oauth_waited += wait_for_oauth_flows(context, port, max(0.0, args.oauth_wait - oauth_waited))
        stats["oauth_wait_s"] = round(oauth_waited, 1)

    if not front_understands_preference(context):
        say(context, "the running front does not support blue/green (old build or not running); refusing")
        if context.FRONT_LABEL:
            say(
                context,
                f"install the front from scripts/agent-lb-front.mjs and kickstart {context.FRONT_LABEL} in a quiet moment first",
            )
        return 3
    if context.SANDBOX_ROOT is not None:
        check_loaded_sandbox_job(context)
    stop_leftover_standby(context, drain, hold_for_oauth, args.skip_exchange_wait)
    set_preferred(context, context.PRIMARY_PORT)
    old_pid = launchd_pid(context, context.LABEL)
    if not healthy(context, context.PRIMARY_PORT):
        say(context, "primary is not healthy before the restart; continuing (the standby will carry traffic)")
    else:
        hold_for_oauth(context.PRIMARY_PORT)
    if args.files:
        files.deploy(args.src, args.files)
    elif args.backup:
        files.use_backup(args.backup)
    t = time.monotonic()
    standby = start_standby(context, drain)
    if not wait_until(
        context, lambda: healthy(context, context.STANDBY_PORT) or standby.poll() is not None, args.boot_timeout
    ):
        pass
    stats["standby_boot_s"] = round(time.monotonic() - t, 1)
    if standby.poll() is not None or not healthy(context, context.STANDBY_PORT):
        say(context, f"standby failed its health gate (exit={standby.poll()}); see {context.STANDBY_LOG}")
        if standby.poll() is None:
            stop_pid_gracefully(context, standby.pid, context.STANDBY_PORT, 10, args.skip_exchange_wait)
        rolled = files.rollback()
        remove_state(context, context.STANDBY_PIDFILE)
        sync_log(
            context,
            f"lb-restart FAILED reason={args.reason!r} standby health gate failed after {stats['standby_boot_s']}s; primary untouched (pid {old_pid}); rollback={('yes ' + str(files.restored_from) if rolled else 'none')}",
        )
        return 1
    say(context, f"standby healthy on :{context.STANDBY_PORT} in {stats['standby_boot_s']}s (pid {standby.pid})")
    if args.check:
        secs, forced = stop_pid_gracefully(
            context, standby.pid, context.STANDBY_PORT, drain + 15, args.skip_exchange_wait
        )
        remove_state(context, context.STANDBY_PIDFILE)
        say(
            context, f"--check: code on disk boots and passes health; standby stopped in {secs:.1f}s; primary untouched"
        )
        return 0
    if healthy(context, context.PRIMARY_PORT):
        hold_for_oauth(context.PRIMARY_PORT)
    set_preferred(context, context.STANDBY_PORT)
    if not front_routes_to(context, context.STANDBY_PORT):
        say(context, "front did not pick up the standby preference; aborting before touching the primary")
        stop_pid_gracefully(context, standby.pid, context.STANDBY_PORT, drain + 15, args.skip_exchange_wait)
        set_preferred(context, context.PRIMARY_PORT)
        return 4
    time.sleep(0.5)
    if healthy(context, context.PRIMARY_PORT):
        hold_for_oauth(context.PRIMARY_PORT)
    stats["primary_in_flight_at_cutover"] = in_flight(context, context.PRIMARY_PORT)
    stats["primary_conns_at_cutover"] = established(context, context.PRIMARY_PORT)
    say(
        context,
        f"front -> :{context.STANDBY_PORT}; primary pid {old_pid} had {stats['primary_in_flight_at_cutover']} in flight, {stats['primary_conns_at_cutover']} connection(s); draining it (bound {primary_bound}s)",
    )
    t = time.monotonic()
    if not args.skip_exchange_wait:
        wait_for_oauth_flows(context, context.PRIMARY_PORT, EXCHANGE_SETTLE_S, exchanges=True)
    restart_primary(context, args.reload_plist, old_pid, primary_bound)

    def old_gone() -> bool:
        return not pid_alive(context, old_pid)

    last = [0.0]

    def old_gone_logged() -> bool:
        if time.monotonic() - last[0] >= 10:
            last[0] = time.monotonic()
            say(context, f"  primary draining, {established(context, context.PRIMARY_PORT)} connection(s) open")
        return old_gone()

    wait_until(context, old_gone_logged, primary_bound, 0.25)
    stats["primary_drain_s"] = round(time.monotonic() - t, 1)
    say(context, f"old primary exited after {stats['primary_drain_s']}s")
    t = time.monotonic()
    primary_ok = wait_until(
        context,
        lambda: launchd_pid(context, context.LABEL) not in (None, old_pid) and healthy(context, context.PRIMARY_PORT),
        args.boot_timeout,
        0.25,
    )
    stats["primary_boot_s"] = round(time.monotonic() - t, 1)
    if not primary_ok:
        say(context, "new primary failed its health gate; rolling back files and restarting the primary on them")
        rolled = files.rollback()
        if rolled:
            kickstart_primary(context, wait=True)
            primary_ok = wait_until(context, lambda: healthy(context, context.PRIMARY_PORT), args.boot_timeout, 0.5)
        if not primary_ok:
            sync_log(
                context,
                f"lb-restart FAILED reason={args.reason!r} primary unhealthy after restart; standby pid {standby.pid} still serving on :{context.STANDBY_PORT}; rollback={('yes' if rolled else 'none')}",
            )
            say(
                context,
                f"primary still down; standby pid {standby.pid} keeps serving on :{context.STANDBY_PORT}. Fix by hand.",
            )
            return 2
    say(
        context,
        f"new primary healthy on :{context.PRIMARY_PORT} (pid {launchd_pid(context, context.LABEL)}) {stats['primary_boot_s']}s after exit",
    )
    hold_for_oauth(context.STANDBY_PORT)
    set_preferred(context, context.PRIMARY_PORT)
    front_routes_to(context, context.PRIMARY_PORT)
    time.sleep(0.5)
    hold_for_oauth(context.STANDBY_PORT)
    stats["standby_in_flight_at_cutover"] = in_flight(context, context.STANDBY_PORT)
    if not args.skip_exchange_wait:
        wait_for_oauth_flows(context, context.STANDBY_PORT, EXCHANGE_SETTLE_S, exchanges=True)
    signal_group(context, standby.pid, signal.SIGTERM)
    spawn_reaper(context, standby.pid, drain)
    wait_until(context, lambda: listener_pid(context, context.STANDBY_PORT) is None, 10)
    remove_state(context, context.STANDBY_PIDFILE)
    stats["total_s"] = round(time.monotonic() - context.T0, 1)
    say(
        context,
        f"standby pid {standby.pid} stopped listening and drains its {stats['standby_in_flight_at_cutover']} in-flight request(s) in the background (log {context.STANDBY_LOG}); done in {stats['total_s']}s",
    )
    rollback_note = f" rolled_back_from={files.restored_from}" if files.restored_from else ""
    backup_note = f" backup={files.backup_dir}" if files.backup_dir else ""
    sync_log(
        context,
        "lb-restart ok "
        + " ".join((f"{k}={v!r}" if isinstance(v, str) else f"{k}={v}" for k, v in stats.items()))
        + f" old_pid={old_pid} new_pid={launchd_pid(context, context.LABEL)}{backup_note}{rollback_note}",
    )
    return 0 if not files.restored_from else 1


if __name__ == "__main__":
    sys.exit(main(RestartContext(Path(__file__).resolve())))
