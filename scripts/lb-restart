#!/usr/bin/env python3
"""Controlled, zero-gap restart of the live agent-lb service (blue/green).

Every Claude Code and Codex session on this machine sends its model traffic
through agent-lb, so a restart is a production event. This is the only
supported way to restart it or deploy files into the runtime:

    lb-restart --reason "why"                                  # restart onto what is on disk
    lb-restart --reason "why" --from <worktree> --files a b    # copy files in, then restart
    lb-restart --reason "why" --backup <dir>                   # files already copied; roll back from <dir> on failure
    lb-restart --reason "why" --reload-plist                   # also re-read the launchd plist
    lb-restart --reason "why" --check                          # boot + health-gate the code on disk, touch nothing
    lb-restart --reason "why" --force                          # do not wait for sign-ins in progress
    lb-restart --reason "why" --sandbox <config.json>          # the same restart on an lb-sandbox instance

What it does, in order:

1. Takes a machine-wide lock (one restart at a time; others wait, up to --lock-wait).
   OAuth sign-ins live only in the memory of the process that started them, so
   before each move of the front, and again after it before that instance is
   stopped, it waits (up to --oauth-wait in total) while the instance it moves
   away from has a sign-in in progress or still holds the callback port (1455).
   --force skips the wait. A sign-in can still be lost, and the browser then shows
   "start the sign-in again", when:
   - it starts in the moment between the last check and a front move or SIGTERM
     (closing that fully would need a stop-the-world handoff);
   - the primary is unhealthy (the watchdog path): a broken primary is replaced
     at once and its sign-ins are not waited for;
   - --force is given or --oauth-wait is used up.
2. Optionally backs up and copies --files from --from into the runtime.
3. Boots a standby instance of the new code on the standby port (2459) and
   health-gates it. If the gate fails, the files are rolled back and the live
   primary was never touched: no client sees anything.
4. Points the TCP front (2455) at the standby for new connections, then
   SIGTERMs the primary (launchd job on 2457). The primary stops accepting,
   closes idle keep-alive sockets (clients reconnect to the standby) and lets
   in-flight streams finish (uvicorn graceful shutdown), then launchd restarts it.
5. Health-gates the new primary, points the front back at it, and drains and
   stops the standby the same way.
6. Appends one line with durations and in-flight counts to runtime/sync.log.

New connections are served by some healthy instance throughout; the only
client-visible cost is a keep-alive socket closed while idle, which clients
reopen. Streams longer than the drain bound (UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN
in the plist) are cut.
"""

from __future__ import annotations

import argparse
import datetime as dt
import errno
import fcntl
import json
import os
import plistlib
import re
import shutil
import signal
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path.home()
LB_HOME = HOME / ".agent-lb"
RUNTIME = LB_HOME / "runtime" / "agent-lb"
BACKUPS = LB_HOME / "runtime" / "backups"
SYNC_LOG = LB_HOME / "runtime" / "sync.log"
STATE_DIR = LB_HOME / "state"
LOCK_FILE = LB_HOME / "runtime" / "lb-restart.lock"
PREFERRED_FILE = STATE_DIR / "front-preferred-port"
FRONT_STATE = STATE_DIR / "front.json"
STANDBY_PIDFILE = STATE_DIR / "lb-standby.pid"
STANDBY_LOG = LB_HOME / "agent-lb-standby.log"
WATCHDOG_PAUSE = LB_HOME / "watchdog.pause"
LABEL = "com.aneyman.agent-lb"
FRONT_LABEL = "com.aneyman.agent-lb-front"
PLIST = HOME / "Library" / "LaunchAgents" / f"{LABEL}.plist"
FRONT_PORT = 2455
PRIMARY_PORT = 2457
STANDBY_PORT = 2459
UID = os.getuid()

# --sandbox <config.json> rebinds every constant above to an lb-sandbox instance
# (scripts/lb-sandbox), so drills and checks run this exact code without the live
# label, ports or state. The guard refuses before anything is touched.
SANDBOX_LABEL_PREFIX = "com.agent-lb.drill."
SANDBOX_FORBIDDEN_PORTS = frozenset({1455, 2455, 2457, 2459})
SANDBOX_MIN_PORT = 2470
SANDBOX_KEYS = ("root", "label", "plist", "runtime", "state_dir", "front_port", "primary_port", "standby_port")
SANDBOX_CONFIG: Path | None = None
SANDBOX_ROOT: Path | None = None  # set by --sandbox; processes outside it are never signalled
# What apply_sandbox restores when a refusal comes after the constants were rebound.
LIVE_BINDINGS: dict[str, object] = {
    name: globals()[name]
    for name in (
        "SANDBOX_ROOT",
        "RUNTIME",
        "BACKUPS",
        "SYNC_LOG",
        "STATE_DIR",
        "LOCK_FILE",
        "PREFERRED_FILE",
        "FRONT_STATE",
        "STANDBY_PIDFILE",
        "STANDBY_LOG",
        "WATCHDOG_PAUSE",
        "LABEL",
        "FRONT_LABEL",
        "PLIST",
        "FRONT_PORT",
        "PRIMARY_PORT",
        "STANDBY_PORT",
    )
}


class SandboxRefused(Exception):
    pass


def _real_home() -> Path:
    import pwd

    return Path(pwd.getpwuid(os.getuid()).pw_dir)


def _inside(path: Path, parent: Path) -> bool:
    return path == parent or parent in path.parents


def _lexical(path: Path) -> Path:
    """path with . and .. folded by text alone: nothing on disk is followed."""
    return Path(os.path.normpath(str(path)))


def _refuse_links_on(name: str, path: Path, leaf: str) -> None:
    """Every existing component of absolute path must be a real directory, checked with lstat from / down and
    before anything is resolved: a symlink anywhere (an ancestor, the root, the leaf) is refused, not followed.
    The leaf may be missing, else a real directory (leaf="dir") or a single-link regular file (leaf="file")."""
    parts = path.parts
    for i in range(1, len(parts) + 1):
        prefix = Path(*parts[:i])
        try:
            info = prefix.lstat()
        except FileNotFoundError:
            return
        if i < len(parts) or leaf == "dir":
            if not stat.S_ISDIR(info.st_mode):
                raise SandboxRefused(f"{name} {path}: {prefix} is a link or not a directory")
        elif not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise SandboxRefused(f"{name} {path} is not a single-link regular file (a link to live state?)")


def sandbox_bindings(config: dict, home: Path | None = None) -> dict[str, object]:
    """Validate an lb-sandbox config and return the module constants it rebinds. Raises SandboxRefused.

    Paths are kept as written (lexically normalised), never resolved: resolving would turn an in-root symlink
    (lb-restart.lock -> lb-restart.json) into its target and the link would then pass as a plain file."""
    missing = [key for key in SANDBOX_KEYS if key not in config]
    if missing:
        raise SandboxRefused(f"sandbox config lacks {', '.join(missing)}")
    sandboxes = _lexical((home or _real_home()) / ".agent-lb" / "sandboxes")
    root = Path(str(config["root"])).expanduser()
    if not root.is_absolute():
        raise SandboxRefused("sandbox root must be absolute")
    root = _lexical(root)
    if root.parent != sandboxes or root.name in ("", ".", ".."):
        raise SandboxRefused(f"sandbox root {root} is not directly under {sandboxes}")
    # From / down: a sandboxes dir (or root) swapped for a link to ~/.agent-lb is refused here and, after this
    # check, cannot redirect anything because every file operation goes through the pinned root descriptor.
    _refuse_links_on("root", root, "dir")
    label = str(config["label"])
    suffix = label.removeprefix(SANDBOX_LABEL_PREFIX)
    if not label.startswith(SANDBOX_LABEL_PREFIX) or not suffix or not suffix.replace("-", "").isalnum():
        raise SandboxRefused(f"label {label!r} is not a {SANDBOX_LABEL_PREFIX}* drill label")
    ports = []
    for key in ("front_port", "primary_port", "standby_port"):
        value = config[key]
        if isinstance(value, bool) or not isinstance(value, int):
            raise SandboxRefused(f"{key} must be an integer")
        if value < SANDBOX_MIN_PORT or value > 2599 or value in SANDBOX_FORBIDDEN_PORTS:
            raise SandboxRefused(f"{key} {value} is a live or unsafe port")
        ports.append(value)
    if len(set(ports)) != len(ports):
        raise SandboxRefused("sandbox ports repeat")
    paths = {}
    for key in ("plist", "runtime", "state_dir"):
        path = Path(str(config[key])).expanduser()
        path = _lexical(path if path.is_absolute() else root / path)
        if root not in path.parents:
            raise SandboxRefused(f"{key} {path} is outside the sandbox root")
        paths[key] = path
    state_dir = paths["state_dir"]
    derived = {
        "BACKUPS": root / "backups",
        "SYNC_LOG": root / "logs" / "sync.log",
        "LOCK_FILE": root / "lb-restart.lock",
        "PREFERRED_FILE": state_dir / "front-preferred-port",
        "PREFERRED_TMP": state_dir / "front-preferred-port.tmp",
        "FRONT_STATE": state_dir / "front.json",
        "STANDBY_PIDFILE": state_dir / "lb-standby.pid",
        "STANDBY_LOG": root / "logs" / "agent-lb-standby.log",
        "WATCHDOG_PAUSE": root / "watchdog.pause",
    }
    for name, path in (("RUNTIME", paths["runtime"]), ("STATE_DIR", state_dir), ("BACKUPS", derived["BACKUPS"])):
        _refuse_links_on(name, path, "dir")
    # The store the standby opens: a data dir, DB or key planted as a link would boot it against live.
    _refuse_links_on("data", root / "data", "dir")
    for leaf in ("store.db", "encryption.key"):
        _refuse_links_on("data", root / "data" / leaf, "file")
    for name, path in derived.items():
        if name != "BACKUPS":
            # A hard link passes a path rule: an in-root lock linked to the live front-preferred-port would be
            # truncated and overwritten by lock acquisition. Only a missing or single-link regular file is ours.
            _refuse_links_on(name, path, "file")
    _refuse_links_on("plist", paths["plist"], "file")
    return {
        "SANDBOX_ROOT": root,
        "RUNTIME": paths["runtime"],
        "STATE_DIR": state_dir,
        **derived,
        "LABEL": label,
        "FRONT_LABEL": None,
        "PLIST": paths["plist"],
        "FRONT_PORT": ports[0],
        "PRIMARY_PORT": ports[1],
        "STANDBY_PORT": ports[2],
    }


SANDBOX_PORT_URL = re.compile(r"^http://127\.0\.0\.1:([0-9]{4})$")
SANDBOX_LEADING_PORT = re.compile(r"^([0-9]{1,5})\b")
# The keys lb-sandbox writes into the primary plist. Any other key (Program above all, which launchd runs in
# place of ProgramArguments[0]) could start something other than the bootstrap.
SANDBOX_PLIST_KEYS = frozenset(
    {
        "Label",
        "ProgramArguments",
        "WorkingDirectory",
        "EnvironmentVariables",
        "RunAtLoad",
        "KeepAlive",
        "ThrottleInterval",
        "ExitTimeOut",
        "StandardOutPath",
        "StandardErrorPath",
    }
)


def check_sandbox_bootstrap(root: Path) -> None:
    """The plist's program, <root>/bin/lb-sandbox, must be a real single-link file in a real <root>/bin.

    Checked from the pinned root descriptor, so a swapped ancestor cannot show it someone else's bin."""
    try:
        bin_fd = _sandbox_dir_fd(root / "bin", create=False)
    except (OSError, SandboxRefused) as exc:
        raise SandboxRefused(f"sandbox bootstrap dir {root / 'bin'} is missing or a link") from exc
    try:
        info = os.stat("lb-sandbox", dir_fd=bin_fd, follow_symlinks=False)
    except OSError as exc:
        raise SandboxRefused(f"sandbox bootstrap {root / 'bin' / 'lb-sandbox'} is missing") from exc
    finally:
        os.close(bin_fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise SandboxRefused("sandbox bootstrap is a link, not lb-sandbox's own copy inside the root")


def check_sandbox_plist(data: object, root: Path, label: str, primary_port: int) -> None:
    """The sandbox plist must run `lb-sandbox _serve <root>` on its primary port with an env inside the root.

    The standby runs the plist's ProgramArguments with its env, so an in-root plist that ran the app
    directly with a live DB URL or key path would boot against the live store. Raises SandboxRefused.
    """
    if not isinstance(data, dict):
        raise SandboxRefused("sandbox plist is not a dictionary")
    extra = sorted(str(key) for key in set(data) - SANDBOX_PLIST_KEYS)
    if extra:
        raise SandboxRefused(f"sandbox plist has keys lb-sandbox never writes: {', '.join(extra)}")
    want = [
        str(root / "runtime" / ".venv" / "bin" / "python"),
        str(root / "bin" / "lb-sandbox"),
        "_serve",
        str(root),
        "--host",
        "127.0.0.1",
        "--port",
        str(primary_port),
    ]
    if data.get("Label") != label or data.get("ProgramArguments") != want:
        raise SandboxRefused("sandbox plist does not run `lb-sandbox _serve <root>` on the primary port")
    env = data.get("EnvironmentVariables")
    if not isinstance(env, dict):
        raise SandboxRefused("sandbox plist has no environment")
    if "AGENT_LB_FEDERATION_TOKEN" in env:
        raise SandboxRefused("sandbox plist carries the federation token")
    fixed = {
        "LB_SANDBOX_ROOT": str(root),
        "AGENT_LB_DATA_DIR": str(root / "data"),
        "AGENT_LB_DATABASE_URL": f"sqlite+aiosqlite:///{root / 'data' / 'store.db'}",
        "AGENT_LB_ENCRYPTION_KEY_FILE": str(root / "data" / "encryption.key"),
    }
    for key, value in fixed.items():
        if env.get(key) != value:
            raise SandboxRefused(f"sandbox plist {key} is not the sandbox's own")
    for store in (root / "data", root / "data" / "store.db", root / "data" / "encryption.key"):
        if not _inside(store.resolve(), root):
            raise SandboxRefused(f"sandbox store {store} resolves outside the sandbox root (a link?)")
    workdir = data.get("WorkingDirectory")
    if workdir is not None and not _inside(Path(str(workdir)).resolve(), root):
        raise SandboxRefused("sandbox plist working directory is outside the sandbox root")
    for key in ("StandardOutPath", "StandardErrorPath"):
        if key in data and not _inside(Path(str(data[key])).resolve(), root):
            raise SandboxRefused(f"sandbox plist {key} is outside the sandbox root")
    cwd = Path(str(workdir)) if workdir is not None else root / "runtime"
    for key, value in env.items():
        text = str(value)
        if key == "PATH" or key in fixed:
            continue
        if "://" in text:
            match = SANDBOX_PORT_URL.match(text)
            port = int(match.group(1)) if match else 0
            if port < SANDBOX_MIN_PORT or port > 2599 or port in SANDBOX_FORBIDDEN_PORTS:
                raise SandboxRefused(f"sandbox plist {key} points outside the sandbox's ports")
            continue
        for part in text.split(":"):
            # A live port without a scheme (127.0.0.1:2457, 2455) is as live as a URL to it.
            port = SANDBOX_LEADING_PORT.match(part)
            if port and int(port.group(1)) in SANDBOX_FORBIDDEN_PORTS:
                raise SandboxRefused(f"sandbox plist {key} names a live port")
            if part.startswith("~"):
                raise SandboxRefused(f"sandbox plist {key} names a home-relative path")
            # A relative path resolves against the working directory, so ../../.. climbs out of the root.
            if part.startswith("/") or "/" in part or part in (".", ".."):
                if not _inside((cwd / part).resolve(), root):
                    raise SandboxRefused(f"sandbox plist {key} names a path outside the sandbox root")


def apply_sandbox(config_path: Path) -> None:
    """Rebind the module constants to the sandbox in config_path. Raises SandboxRefused, touching nothing."""
    global SANDBOX_CONFIG
    try:
        config = json.loads(Path(config_path).read_text())
    except (OSError, ValueError) as exc:
        raise SandboxRefused(f"cannot read sandbox config {config_path}: {exc.__class__.__name__}") from exc
    if not isinstance(config, dict):
        raise SandboxRefused("sandbox config is not a JSON object")
    bindings = sandbox_bindings(config)
    globals().update(bindings)
    try:
        # Pin the root now (O_NOFOLLOW from / down) and read the plist through that descriptor: a link planted
        # since the guard ran, at the plist or at any ancestor, is refused instead of followed.
        pin_sandbox_root()
        with os.fdopen(sandbox_open(bindings["PLIST"], os.O_RDONLY), "rb") as fh:
            plist = plistlib.load(fh)
        check_sandbox_plist(plist, bindings["SANDBOX_ROOT"], bindings["LABEL"], bindings["PRIMARY_PORT"])
        check_sandbox_bootstrap(bindings["SANDBOX_ROOT"])
    except BaseException as exc:
        globals().update(LIVE_BINDINGS)
        unpin_sandbox_root()
        if isinstance(exc, (OSError, ValueError, plistlib.InvalidFileException)):
            raise SandboxRefused(f"cannot read sandbox plist: {exc.__class__.__name__}") from exc
        raise
    SANDBOX_CONFIG = Path(config_path).resolve()


# ---------------------------------------------------------------- sandbox file access
# With --sandbox every file lb-restart writes is opened from a descriptor for the root, one component at a
# time with O_NOFOLLOW, and must be a single-link regular file: a link or hard link planted after the guard
# ran is refused (exit 2), never written through. Without --sandbox these helpers keep the old calls.


SANDBOX_ROOT_FD: int | None = None
SANDBOX_ROOT_PINNED: tuple[Path, int, int] | None = None  # (root path, st_dev, st_ino) the descriptor holds


def _open_dir_nofollow(path: Path) -> int:
    """Open absolute path from / down, one component at a time with O_NOFOLLOW: a link anywhere is refused."""
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    fd = os.open(path.anchor, os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.parts[1:]:
            child = os.open(part, flags, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def _check_owned_dir(fd: int, what: str, path: Path, private: bool) -> os.stat_result:
    """fd is a directory this user owns; private: no group or other bits at all (lb-sandbox makes roots 0700),
    else no group or other write. Raises SandboxRefused."""
    info = os.fstat(fd)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise SandboxRefused(f"{what} {path} is not a directory owned by uid {os.getuid()}")
    if info.st_mode & (0o077 if private else 0o022):
        raise SandboxRefused(f"{what} {path} has mode {stat.S_IMODE(info.st_mode):o}; lb-sandbox makes it 0700")
    return info


def pin_sandbox_root() -> int:
    """The descriptor for SANDBOX_ROOT, opened once (from / down, no links) and held for the whole run.

    The root must be one lb-sandbox made: owned by this user, mode 0700, in a sandboxes dir this user owns."""
    global SANDBOX_ROOT_FD, SANDBOX_ROOT_PINNED
    assert SANDBOX_ROOT is not None
    if SANDBOX_ROOT_FD is not None and SANDBOX_ROOT_PINNED is not None and SANDBOX_ROOT_PINNED[0] == SANDBOX_ROOT:
        return SANDBOX_ROOT_FD
    unpin_sandbox_root()
    try:
        parent = _open_dir_nofollow(SANDBOX_ROOT.parent)
    except OSError as exc:
        raise SandboxRefused(
            f"sandboxes dir {SANDBOX_ROOT.parent} or an ancestor is a link or missing ({exc})"
        ) from exc
    try:
        _check_owned_dir(parent, "sandboxes dir", SANDBOX_ROOT.parent, private=False)
        try:
            fd = os.open(SANDBOX_ROOT.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        except OSError as exc:
            raise SandboxRefused(f"sandbox root {SANDBOX_ROOT} is a link or missing ({exc})") from exc
    finally:
        os.close(parent)
    try:
        info = _check_owned_dir(fd, "sandbox root", SANDBOX_ROOT, private=True)
    except BaseException:
        os.close(fd)
        raise
    SANDBOX_ROOT_FD, SANDBOX_ROOT_PINNED = fd, (SANDBOX_ROOT, info.st_dev, info.st_ino)
    return fd


def unpin_sandbox_root() -> None:
    global SANDBOX_ROOT_FD, SANDBOX_ROOT_PINNED
    if SANDBOX_ROOT_FD is not None:
        os.close(SANDBOX_ROOT_FD)
    SANDBOX_ROOT_FD, SANDBOX_ROOT_PINNED = None, None


def verify_sandbox_ancestry() -> None:
    """Before anything that must go by path (exec of the standby): the root path still names the pinned root."""
    fd = pin_sandbox_root()
    try:
        again = _open_dir_nofollow(SANDBOX_ROOT)
    except OSError as exc:
        raise SandboxRefused(f"sandbox root {SANDBOX_ROOT} or an ancestor became a link ({exc})") from exc
    try:
        now, pinned = os.fstat(again), os.fstat(fd)
    finally:
        os.close(again)
    if (now.st_dev, now.st_ino) != (pinned.st_dev, pinned.st_ino):
        raise SandboxRefused(f"sandbox root {SANDBOX_ROOT} no longer names the directory this run pinned")


def _sandbox_dir_fd(directory: Path, create: bool = True) -> int:
    """A descriptor for directory, walked from the pinned root with O_NOFOLLOW (missing dirs made 0700).

    Every call first checks the root path still names the pinned root, so a sandboxes dir or root swapped
    mid-run is refused at the next state operation instead of the run carrying on in the moved directory."""
    assert SANDBOX_ROOT is not None
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    try:
        rel = directory.relative_to(SANDBOX_ROOT)
    except ValueError as exc:
        raise SandboxRefused(f"{directory} is outside the sandbox root") from exc
    if ".." in rel.parts:
        raise SandboxRefused(f"{directory} climbs out of the sandbox root")
    verify_sandbox_ancestry()
    fd = os.dup(pin_sandbox_root())
    try:
        for part in rel.parts:
            if create:
                try:
                    os.mkdir(part, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
            child = os.open(part, flags, dir_fd=fd)
            os.close(fd)
            fd = child
            if os.fstat(fd).st_uid != os.getuid():
                raise SandboxRefused(f"{directory}: {part} is not owned by uid {os.getuid()}")
        return fd
    except BaseException:
        os.close(fd)
        raise


def _open_in(dir_fd: int, path: Path, flags: int, mode: int = 0o600) -> int:
    """openat(dir_fd, path.name) with O_NOFOLLOW; the file must be a single-link regular file. O_TRUNC is applied
    only after that check, so a hard link to live state is refused before a byte of it is lost."""
    try:
        fd = os.open(path.name, (flags & ~os.O_TRUNC) | os.O_NOFOLLOW, mode, dir_fd=dir_fd)
    except OSError as exc:
        raise SandboxRefused(f"{path} is a link or unreachable inside the sandbox root ({exc})") from exc
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        os.close(fd)
        raise SandboxRefused(f"{path} is not a single-link regular file; refusing to write through it")
    if flags & os.O_TRUNC:
        os.ftruncate(fd, 0)
    return fd


def _state_dir_fd(directory: Path, create: bool = True) -> int:
    try:
        return _sandbox_dir_fd(directory, create=create)
    except SandboxRefused:
        raise
    except OSError as exc:
        raise SandboxRefused(f"{directory} is a link or unreachable inside the sandbox root ({exc})") from exc


def _same_dir_still(dir_fd: int, directory: Path) -> None:
    """After a rename or unlink through dir_fd: the path still names that directory. A state dir swapped for a
    link (or for another directory) while the operation ran is refused, so the run stops instead of going on."""
    again = _state_dir_fd(directory, create=False)
    try:
        now, held = os.fstat(again), os.fstat(dir_fd)
    finally:
        os.close(again)
    if (now.st_dev, now.st_ino) != (held.st_dev, held.st_ino):
        raise SandboxRefused(f"{directory} was swapped during the operation; refusing to continue")


def sandbox_open(path: Path, flags: int, mode: int = 0o600) -> int:
    """Open a file under the sandbox root without following a link; O_TRUNC only after the link check."""
    dir_fd = _state_dir_fd(path.parent)
    try:
        return _open_in(dir_fd, path, flags, mode)
    finally:
        os.close(dir_fd)


def read_state(path: Path) -> tuple[str, float] | None:
    """(text, mtime) of a state file, None when it is missing or unreadable. With --sandbox, through the root fd."""
    if SANDBOX_ROOT is None:
        try:
            return path.read_text(), path.stat().st_mtime
        except OSError:
            return None
    try:
        dir_fd = _sandbox_dir_fd(path.parent, create=False)
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise SandboxRefused(f"{path.parent} is a link or unreachable inside the sandbox root ({exc})") from exc
    try:
        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise SandboxRefused(f"{path} is a link inside the sandbox root ({exc})") from exc
    finally:
        os.close(dir_fd)
    with os.fdopen(fd, "rb") as fh:
        info = os.fstat(fh.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise SandboxRefused(f"{path} is not a single-link regular file")
        return fh.read().decode(errors="replace"), info.st_mtime


def remove_state(path: Path) -> None:
    """unlink(missing_ok=True); with --sandbox, by name in the directory reached from the pinned root."""
    if SANDBOX_ROOT is None:
        path.unlink(missing_ok=True)
        return
    dir_fd = _state_dir_fd(path.parent)
    try:
        try:
            info = os.stat(path.name, dir_fd=dir_fd, follow_symlinks=False)
        except FileNotFoundError:
            return
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            # Unlinking our name would not touch the target, but a planted link means the state is not ours.
            raise SandboxRefused(f"{path} is not a single-link regular file; refusing to remove it")
        try:
            os.unlink(path.name, dir_fd=dir_fd)
        except FileNotFoundError:
            pass
        _same_dir_still(dir_fd, path.parent)
    finally:
        os.close(dir_fd)


def ensure_dir(path: Path) -> None:
    """mkdir -p; with --sandbox the helpers above make missing dirs under the pinned root themselves."""
    if SANDBOX_ROOT is None:
        path.mkdir(parents=True, exist_ok=True)


def open_append(path: Path):
    if SANDBOX_ROOT is None:
        return path.open("a")
    return os.fdopen(sandbox_open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT), "a")


def write_state(path: Path, text: str) -> None:
    if SANDBOX_ROOT is None:
        path.write_text(text)
        return
    with os.fdopen(sandbox_open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC), "w") as fh:
        fh.write(text)


def read_plist() -> dict:
    if SANDBOX_ROOT is None:
        with PLIST.open("rb") as fh:
            return plistlib.load(fh)
    with os.fdopen(sandbox_open(PLIST, os.O_RDONLY), "rb") as fh:
        data = plistlib.load(fh)
    check_sandbox_plist(data, SANDBOX_ROOT, LABEL, PRIMARY_PORT)  # again at use: the file may have changed
    check_sandbox_bootstrap(SANDBOX_ROOT)
    return data


T0 = time.monotonic()


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def say(msg: str) -> None:
    print(f"[lb-restart +{time.monotonic() - T0:6.1f}s] {msg}", flush=True)


def sync_log(line: str) -> None:
    with open_append(SYNC_LOG) as fh:
        fh.write(f"{now_iso()} {line}\n")


def http_get(port: int, path: str, timeout: float = 3.0) -> tuple[int, bytes]:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as exc:
        return exc.code, b""
    except Exception:
        return 0, b""


def healthy(port: int) -> bool:
    """Ready to serve: DB reachable and the proxy router answers."""
    code, body = http_get(port, "/health/ready")
    if code != 200:
        return False
    try:
        if json.loads(body).get("checks", {}).get("database") != "ok":
            return False
    except ValueError:
        return False
    code, _ = http_get(port, "/v1/models", timeout=5.0)
    return code == 200


def in_flight(port: int) -> int | None:
    code, body = http_get(port, "/internal/drain/status", timeout=2.0)
    if code != 200:
        return None
    try:
        return int(json.loads(body)["checks"]["in_flight"])
    except (ValueError, KeyError, TypeError):
        return None


OAUTH_POLL_S = 2.0


def oauth_pending(port: int) -> tuple[int, list[float]] | None:
    """(count, ages in seconds) of sign-ins in progress on port; None if it cannot say."""
    code, body = http_get(port, "/internal/oauth/pending", timeout=2.0)
    if code != 200:
        return None
    try:
        data = json.loads(body)
        return int(data["pending"]), [float(age) for age in data.get("ages_seconds", [])]
    except (ValueError, KeyError, TypeError):
        return None


def wait_for_oauth_flows(port: int, bound: float) -> float:
    """Hold the swap while port has a sign-in in progress, up to bound seconds. Returns seconds waited."""
    start = time.monotonic()
    announced: int | None = None
    while True:
        waited = time.monotonic() - start
        status = oauth_pending(port)
        if status is None or status[0] == 0:
            if announced:
                sync_log(f"lb-restart oauth flow(s) on :{port} finished after {waited:.0f}s; continuing")
            return waited
        count, ages = status
        if count != announced:
            announced = count
            msg = f"lb-restart waiting on {count} oauth flow(s) on :{port} (ages {ages}s, bound {bound:.0f}s)"
            say(msg)
            sync_log(msg)
        if waited >= bound:
            msg = f"lb-restart proceeding with {count} oauth flow(s) still pending on :{port} after {waited:.0f}s"
            say(msg)
            sync_log(msg)
            return waited
        time.sleep(OAUTH_POLL_S)


def established(port: int) -> int:
    """Server-side sockets on port (the front's piped connections)."""
    out = subprocess.run(
        ["lsof", "-nP", f"-iTCP:{port}", "-sTCP:ESTABLISHED"],
        capture_output=True,
        text=True,
    ).stdout
    return sum(1 for line in out.splitlines()[1:] if f":{port}->" in line)


def launchd_pid(label: str) -> int | None:
    out = subprocess.run(["launchctl", "print", f"gui/{UID}/{label}"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("pid = "):
            return int(line.split("=", 1)[1])
    return None


def pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError as exc:
        return exc.errno == errno.EPERM


def listener_pid(port: int) -> int | None:
    out = subprocess.run(
        ["lsof", "-nP", f"-iTCP@127.0.0.1:{port}", "-sTCP:LISTEN", "-t"], capture_output=True, text=True
    ).stdout.split()
    return int(out[0]) if out else None


def wait_until(pred, timeout: float, interval: float = 0.25) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if pred():
            return True
        time.sleep(interval)
    return pred()


def set_preferred(port: int) -> None:
    tmp = PREFERRED_FILE.with_suffix(".tmp")
    if SANDBOX_ROOT is None:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        tmp.write_text(f"{port}\n")
        os.replace(tmp, PREFERRED_FILE)
        return
    # One descriptor for the state dir, reached from the pinned root: the temp file is written and renamed by
    # name inside it, so a state dir swapped for a link to live state between the write and the rename cannot
    # carry the rename to the live preference. The swap itself is then refused (exit 2).
    if tmp.parent != PREFERRED_FILE.parent:
        raise SandboxRefused("preference temp file is not beside the preference file")
    dir_fd = _state_dir_fd(PREFERRED_FILE.parent)
    try:
        with os.fdopen(_open_in(dir_fd, tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644), "w") as fh:
            fh.write(f"{port}\n")
        os.replace(tmp.name, PREFERRED_FILE.name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        _same_dir_still(dir_fd, PREFERRED_FILE.parent)
    finally:
        os.close(dir_fd)


def owned_by_sandbox(pid: int) -> bool:
    """Without --sandbox, always True. With it, True only for a process whose command line names the root."""
    if SANDBOX_ROOT is None:
        return True
    cmd = subprocess.run(["ps", "-ww", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
    root = str(SANDBOX_ROOT)
    return any(token == root or token.startswith(root + os.sep) for token in cmd.split())


def front_understands_preference() -> bool:
    """True when the running front is the blue/green build (writes front.json)."""
    # launchd runs the front through a volta shim, so compare against the
    # process that actually holds the public port.
    pid = listener_pid(FRONT_PORT)
    got = read_state(FRONT_STATE)
    if got is None:
        return False
    try:
        state = json.loads(got[0])
    except ValueError:
        return False
    fresh = time.time() - got[1] < 5
    return bool(pid and state.get("pid") == pid and fresh and STANDBY_PORT in state.get("upstreams", []))


def front_routes_to(port: int, timeout: float = 5.0) -> bool:
    def ok() -> bool:
        got = read_state(FRONT_STATE)
        try:
            return got is not None and json.loads(got[0]).get("preferred") == port
        except (ValueError, AttributeError):
            return False

    return wait_until(ok, timeout)


# ---------------------------------------------------------------- lock


class Lock:
    def __init__(self, reason: str, wait: float) -> None:
        self.reason = reason
        self.wait = wait
        self.fh = None

    def __enter__(self) -> "Lock":
        ensure_dir(LOCK_FILE.parent)
        if SANDBOX_ROOT is None:
            self.fh = LOCK_FILE.open("a+")
        else:
            # Never truncate a lock that is a link or hard link to live state (front-preferred-port, say).
            self.fh = os.fdopen(sandbox_open(LOCK_FILE, os.O_RDWR | os.O_APPEND | os.O_CREAT), "a+")
        deadline = time.monotonic() + self.wait
        announced = False
        while True:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if not announced:
                    self.fh.seek(0)
                    say(f"another restart holds the lock ({self.fh.read().strip() or 'unknown'}); waiting")
                    announced = True
                if time.monotonic() >= deadline:
                    say(f"lock not free after {self.wait:.0f}s; retry later")
                    sys.exit(75)
                time.sleep(1)
        self.fh.seek(0)
        self.fh.truncate()
        self.fh.write(f"pid={os.getpid()} since={now_iso()} reason={self.reason}\n")
        self.fh.flush()
        return self

    def __exit__(self, *exc) -> None:
        assert self.fh is not None
        self.fh.seek(0)
        self.fh.truncate()
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


# ---------------------------------------------------------------- files


class Files:
    """Backup-and-copy of runtime files, with rollback."""

    def __init__(self, label: str) -> None:
        self.backup_dir: Path | None = None
        self.created: list[Path] = []
        self.restored_from: Path | None = None
        self.label = label

    def deploy(self, src_root: Path, rel_paths: list[str]) -> None:
        stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        self.backup_dir = BACKUPS / f"{self.label}-{stamp}"
        for rel in rel_paths:
            src = (src_root / rel).resolve()
            dst = RUNTIME / rel
            if not src.is_file():
                raise SystemExit(f"--files: {src} is not a file")
            if dst.exists():
                bak = self.backup_dir / rel
                bak.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(dst, bak)
            else:
                self.created.append(dst)
        (self.backup_dir).mkdir(parents=True, exist_ok=True)
        (self.backup_dir / "MANIFEST.json").write_text(
            json.dumps({"from": str(src_root), "files": rel_paths, "created": [str(p) for p in self.created]}, indent=1)
        )
        for rel in rel_paths:
            dst = RUNTIME / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(src_root / rel, dst)
            shutil.copymode(src_root / rel, dst)
            if (src_root / rel).read_bytes() != dst.read_bytes():
                raise SystemExit(f"copy verify failed for {rel}")
        say(f"deployed {len(rel_paths)} file(s); backup {self.backup_dir}")

    def use_backup(self, backup: Path) -> None:
        # Deploy scripts here keep either <dir>/<runtime-relative path> or <dir>/runtime/<path>.
        self.backup_dir = backup / "runtime" if (backup / "runtime").is_dir() else backup

    def rollback(self) -> bool:
        if self.backup_dir is None or not self.backup_dir.is_dir():
            return False
        restored = 0
        for bak in self.backup_dir.rglob("*"):
            if not bak.is_file() or bak.name == "MANIFEST.json":
                continue
            rel = bak.relative_to(self.backup_dir)
            dst = RUNTIME / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(bak, dst)
            restored += 1
        for path in self.created:
            path.unlink(missing_ok=True)
        say(f"rolled back {restored} file(s) from {self.backup_dir}, removed {len(self.created)} new file(s)")
        self.restored_from = self.backup_dir
        return True


# ---------------------------------------------------------------- standby


def plist_env() -> dict[str, str]:
    data = read_plist()
    return {str(k): str(v) for k, v in data.get("EnvironmentVariables", {}).items()}


def plist_program() -> list[str]:
    return list(read_plist()["ProgramArguments"])


def start_standby(drain_seconds: int) -> subprocess.Popen:
    env = {k: os.environ[k] for k in ("HOME", "USER", "LOGNAME", "TMPDIR", "LANG") if k in os.environ}
    env.update(plist_env())
    env["AGENT_LB_METRICS_ENABLED"] = "false"  # the primary owns :9090
    env["UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN"] = str(drain_seconds)
    args = [a for a in plist_program()]
    try:
        i = args.index("--port")
        args[i + 1] = str(STANDBY_PORT)
    except ValueError:
        args += ["--port", str(STANDBY_PORT)]
    ensure_dir(STANDBY_LOG.parent)
    log = open_append(STANDBY_LOG)
    log.write(f"\n==== {now_iso()} standby start ====\n")
    log.flush()
    if SANDBOX_ROOT is None:
        proc = subprocess.Popen(
            args,
            cwd=RUNTIME,
            env=env,
            stdout=log,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    else:
        # exec goes by path, so check the path still names the pinned root just before it, and start the
        # standby in the pinned runtime dir (fchdir), not in whatever the runtime path names now.
        verify_sandbox_ancestry()
        try:
            runtime_fd = _sandbox_dir_fd(RUNTIME, create=False)
        except OSError as exc:
            raise SandboxRefused(f"{RUNTIME} is a link or missing inside the sandbox root") from exc
        try:
            proc = subprocess.Popen(
                args,
                env=env,
                stdout=log,
                stderr=subprocess.STDOUT,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
                pass_fds=(runtime_fd,),
                preexec_fn=lambda: os.fchdir(runtime_fd),
            )
        finally:
            os.close(runtime_fd)
    ensure_dir(STATE_DIR)
    write_state(STANDBY_PIDFILE, f"{proc.pid}\n")
    return proc


def stop_pid_gracefully(pid: int, port: int, bound: float) -> tuple[float, bool]:
    """SIGTERM, wait up to bound for exit, SIGKILL after. Returns (seconds, forced)."""
    start = time.monotonic()
    try:
        # The standby runs under bash -> exec, so the pid is uvicorn itself; signal
        # the whole session in case a wrapper stayed in between.
        os.killpg(os.getpgid(pid), signal.SIGTERM)
    except OSError:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            return 0.0, False
    last = 0.0
    while pid_alive(pid) and time.monotonic() - start < bound:
        if time.monotonic() - last >= 10:
            last = time.monotonic()
            say(f"  :{port} draining, {established(port)} connection(s) open")
        time.sleep(0.25)
        try:
            os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            pass
    forced = False
    if pid_alive(pid):
        forced = True
        try:
            os.killpg(os.getpgid(pid), signal.SIGKILL)
        except OSError:
            pass
    return time.monotonic() - start, forced


def stop_leftover_standby(drain_seconds: int, hold_for_oauth=lambda port: None) -> None:
    pid = listener_pid(STANDBY_PORT)
    if pid is None:
        remove_state(STANDBY_PIDFILE)
        return
    say(f"found a standby still on :{STANDBY_PORT} (pid {pid}) from an earlier run")
    if not owned_by_sandbox(pid):
        raise SystemExit(f"pid {pid} on :{STANDBY_PORT} is not this sandbox's standby; refusing to signal it")
    if not healthy(PRIMARY_PORT):
        raise SystemExit("primary unhealthy and a standby is serving; fix by hand before restarting")
    hold_for_oauth(STANDBY_PORT)
    set_preferred(PRIMARY_PORT)
    front_routes_to(PRIMARY_PORT)
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    spawn_reaper(pid, drain_seconds)
    wait_until(lambda: listener_pid(STANDBY_PORT) is None, 15)
    say("leftover standby stopped listening; it drains in the background")
    remove_state(STANDBY_PIDFILE)


# A standby that got SIGTERM must exit within its drain bound. On 2026-09-25 two
# stopped standbys hung in lifespan shutdown for 10+ minutes, still running
# their schedulers and holding ~250 upstream sockets each. launchd bounds the
# primary with ExitTimeOut; this reaper is the same bound for the standby.
REAP_MARGIN_S = 90  # app drain (shutdown_drain_timeout_seconds 30) plus slack


def is_standby(pid: int) -> bool:
    out = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
    return "agent-lb" in out and f"--port {STANDBY_PORT}" in out and owned_by_sandbox(pid)


def spawn_reaper(pid: int, drain_seconds: int) -> None:
    argv = [sys.executable, str(Path(__file__).resolve()), "--reap", str(pid), str(drain_seconds + REAP_MARGIN_S)]
    if SANDBOX_CONFIG is not None:
        argv += ["--sandbox", str(SANDBOX_CONFIG)]
    subprocess.Popen(
        argv,
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def reap(pid: int, deadline_s: float) -> int:
    """Wait for a stopped standby to exit; past the deadline dump its stacks and SIGKILL it."""
    end = time.monotonic() + deadline_s
    while time.monotonic() < end:
        if not pid_alive(pid) or not is_standby(pid):
            return 0
        time.sleep(2)
    if not pid_alive(pid) or not is_standby(pid):
        return 0
    try:
        os.kill(pid, signal.SIGUSR2)  # app.core.forensics: all-thread stack dump
        time.sleep(2)
    except OSError:
        pass
    for kill in (lambda: os.killpg(os.getpgid(pid), signal.SIGKILL), lambda: os.kill(pid, signal.SIGKILL)):
        try:
            kill()
        except OSError:
            pass
    sync_log(
        f"lb-restart reaper: standby pid {pid} still alive {int(deadline_s)}s after SIGTERM; "
        "stack dump requested (SIGUSR2, forensics log), then SIGKILL"
    )
    return 1


# ---------------------------------------------------------------- primary


def job_loaded(label: str) -> bool:
    return subprocess.run(["launchctl", "print", f"gui/{UID}/{label}"], capture_output=True).returncode == 0


def restart_primary(reload_plist: bool, old_pid: int | None, bound: float) -> None:
    if not reload_plist:
        subprocess.Popen(["launchctl", "kickstart", "-k", f"gui/{UID}/{LABEL}"])
        return
    # Pause the watchdog so it does not re-bootstrap mid-swap. bootout returns
    # while the old process is still draining and bootstrap fails with EIO
    # until the job is fully gone, so wait for both before bootstrapping.
    WATCHDOG_PAUSE.touch()
    try:
        subprocess.run(["launchctl", "bootout", f"gui/{UID}/{LABEL}"], timeout=bound, check=False)
        wait_until(lambda: not pid_alive(old_pid) and not job_loaded(LABEL), bound, 0.25)
        deadline = time.monotonic() + 30
        while True:
            rc = subprocess.run(["launchctl", "bootstrap", f"gui/{UID}", str(PLIST)], capture_output=True).returncode
            if rc == 0 or job_loaded(LABEL):
                break
            if time.monotonic() > deadline:
                raise RuntimeError(f"launchctl bootstrap kept failing (rc={rc})")
            time.sleep(0.5)
    finally:
        WATCHDOG_PAUSE.unlink(missing_ok=True)


def graceful_seconds() -> int:
    env = plist_env()
    return int(env.get("UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN", "75"))


def exit_timeout() -> int:
    return int(read_plist().get("ExitTimeOut", 20))


# ---------------------------------------------------------------- main


def parse_reaper_args(argv: list[str]) -> tuple[int, float, Path | None]:
    """The reaper's argv is exactly what spawn_reaper writes: --reap PID SECONDS [--sandbox CONFIG].

    Anything else (--sandbox=CONFIG, an abbreviation, extra or missing words) is refused before a signal is
    sent: an unparsed --sandbox would leave the live constants bound and the reaper would kill the live standby.
    Raises SandboxRefused."""
    if len(argv) not in (3, 5) or argv[0] != "--reap":
        raise SandboxRefused(f"reaper takes --reap PID SECONDS [--sandbox CONFIG], got {len(argv)} word(s)")
    if not argv[1].isascii() or not argv[1].isdigit() or int(argv[1]) <= 1:
        raise SandboxRefused("reaper pid must be a positive integer above 1")
    try:
        deadline = float(argv[2])
    except ValueError as exc:
        raise SandboxRefused("reaper seconds must be a number") from exc
    if not 0 <= deadline <= 86400:
        raise SandboxRefused("reaper seconds out of range")
    config = None
    if len(argv) == 5:
        if argv[3] != "--sandbox" or not argv[4]:
            raise SandboxRefused(f"reaper option {argv[3]!r} is not --sandbox CONFIG")
        config = Path(argv[4])
    return int(argv[1]), deadline, config


def main() -> int:
    if any(arg.startswith("--reap") for arg in sys.argv[1:]):
        try:
            pid, deadline, config = parse_reaper_args(sys.argv[1:])
            if config is not None:
                apply_sandbox(config)
            return reap(pid, deadline)
        except SandboxRefused as exc:
            # Also at the reaper's own log write: a root swapped or removed while it waited.
            print(f"lb-restart --reap refused: {exc}", file=sys.stderr)
            return 2
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--reason", required=True, help="Why; goes into sync.log.")
    p.add_argument("--from", dest="src", type=Path, help="Source root (a worktree) for --files.")
    p.add_argument("--files", nargs="+", default=[], help="Runtime-relative paths to copy from --from.")
    p.add_argument("--backup", type=Path, help="Backup dir to restore from if the new code fails its health gate.")
    p.add_argument("--reload-plist", action="store_true", help="bootout/bootstrap the primary so plist edits apply.")
    p.add_argument(
        "--check", action="store_true", help="Only boot and health-gate a standby on the code on disk, then stop it."
    )
    p.add_argument("--force", action="store_true", help="Swap without waiting for OAuth sign-ins in progress.")
    p.add_argument(
        "--oauth-wait", type=float, default=600, help="Seconds to wait in total for sign-ins in progress (default 600)."
    )
    p.add_argument("--lock-wait", type=float, default=900, help="Seconds to wait for another restart (default 900).")
    p.add_argument(
        "--boot-timeout", type=float, default=90, help="Seconds for an instance to pass health (default 90)."
    )
    p.add_argument(
        "--sandbox",
        type=Path,
        metavar="CONFIG",
        help="Restart the lb-sandbox instance described by CONFIG (JSON) instead of the live service.",
    )
    args = p.parse_args()
    if args.sandbox is not None:
        combined = [
            flag
            for flag, value in (
                ("--from", args.src),
                ("--files", args.files),
                ("--backup", args.backup),
                ("--reload-plist", args.reload_plist),
            )
            if value
        ]
        if combined:
            p.error(f"--sandbox cannot be combined with {', '.join(combined)}")
        try:
            apply_sandbox(args.sandbox)
        except SandboxRefused as exc:
            p.error(f"--sandbox refused: {exc}")
        say(f"sandbox {LABEL}: front :{FRONT_PORT} is an lb-sandbox child, not a launchd job; no front hot-swap")
    if args.files and not args.src:
        p.error("--files needs --from")
    if not RUNTIME.is_dir() or not PLIST.is_file():
        p.error(f"runtime {RUNTIME} or plist {PLIST} missing")

    if shutil.which("launchctl") != "/bin/launchctl":
        # A test harness with a launchctl shim on PATH once ran this against the
        # live agent-lb: the standby took traffic and the fake kickstart left it there.
        p.error(f"launchctl resolves to {shutil.which('launchctl')}, not /bin/launchctl; refusing to touch the live LB")

    try:
        with Lock(args.reason, args.lock_wait):
            try:
                return run(args)
            except BaseException as exc:
                if isinstance(exc, (SystemExit, SandboxRefused)):
                    raise
                standby = listener_pid(STANDBY_PORT)
                say(f"crashed: {exc!r}; primary pid {launchd_pid(LABEL)}, standby pid {standby}")
                sync_log(
                    f"lb-restart CRASHED reason={args.reason!r} error={exc!r}; front prefers "
                    f"{(read_state(PREFERRED_FILE) or ('?', 0))[0].strip()}; standby pid {standby}. "
                    "The front falls back to whichever instance is up; the next lb-restart retires a leftover standby."
                )
                raise
    except SandboxRefused as exc:
        # A link or hard link under the root (lock, pidfile, logs, plist): nothing was written through it.
        say(f"--sandbox refused: {exc}")
        return 2


def run(args) -> int:
    drain = graceful_seconds()
    primary_bound = max(drain, exit_timeout()) + 15
    files = Files(label="lb-restart")
    stats: dict[str, object] = {"reason": args.reason}
    say(f"reason: {args.reason}; drain bound {drain}s")
    oauth_waited = 0.0

    def hold_for_oauth(port: int) -> None:
        nonlocal oauth_waited
        if args.force or args.check or (oauth_waited > 0 and oauth_waited >= args.oauth_wait):
            return  # skipped, or the bound is spent and already logged
        oauth_waited += wait_for_oauth_flows(port, max(0.0, args.oauth_wait - oauth_waited))
        stats["oauth_wait_s"] = round(oauth_waited, 1)

    if not front_understands_preference():
        say("the running front does not support blue/green (old build or not running); refusing")
        if FRONT_LABEL:
            say(
                f"install the front from scripts/agent-lb-front.mjs and kickstart {FRONT_LABEL} in a quiet moment first"
            )
        return 3

    stop_leftover_standby(drain, hold_for_oauth)
    set_preferred(PRIMARY_PORT)
    old_pid = launchd_pid(LABEL)
    if not healthy(PRIMARY_PORT):
        say("primary is not healthy before the restart; continuing (the standby will carry traffic)")
    else:
        hold_for_oauth(PRIMARY_PORT)

    if args.files:
        files.deploy(args.src, args.files)
    elif args.backup:
        files.use_backup(args.backup)

    # 1. standby on the new code
    t = time.monotonic()
    standby = start_standby(drain)
    if not wait_until(lambda: healthy(STANDBY_PORT) or standby.poll() is not None, args.boot_timeout):
        pass
    stats["standby_boot_s"] = round(time.monotonic() - t, 1)
    if standby.poll() is not None or not healthy(STANDBY_PORT):
        say(f"standby failed its health gate (exit={standby.poll()}); see {STANDBY_LOG}")
        if standby.poll() is None:
            stop_pid_gracefully(standby.pid, STANDBY_PORT, 10)
        rolled = files.rollback()
        remove_state(STANDBY_PIDFILE)
        sync_log(
            f"lb-restart FAILED reason={args.reason!r} standby health gate failed after {stats['standby_boot_s']}s; "
            f"primary untouched (pid {old_pid}); rollback={'yes ' + str(files.restored_from) if rolled else 'none'}"
        )
        return 1
    say(f"standby healthy on :{STANDBY_PORT} in {stats['standby_boot_s']}s (pid {standby.pid})")
    if args.check:
        secs, forced = stop_pid_gracefully(standby.pid, STANDBY_PORT, drain + 15)
        remove_state(STANDBY_PIDFILE)
        say(f"--check: code on disk boots and passes health; standby stopped in {secs:.1f}s; primary untouched")
        return 0

    # 2. front -> standby, then drain and restart the primary
    if healthy(PRIMARY_PORT):  # an unhealthy primary (watchdog restart) is not kept for sign-ins
        hold_for_oauth(PRIMARY_PORT)  # a sign-in may have started while the standby booted
    set_preferred(STANDBY_PORT)
    if not front_routes_to(STANDBY_PORT):
        say("front did not pick up the standby preference; aborting before touching the primary")
        stop_pid_gracefully(standby.pid, STANDBY_PORT, drain + 15)
        set_preferred(PRIMARY_PORT)
        return 4
    time.sleep(0.5)
    if healthy(PRIMARY_PORT):
        hold_for_oauth(PRIMARY_PORT)  # one that started between the check and the move
    stats["primary_in_flight_at_cutover"] = in_flight(PRIMARY_PORT)
    stats["primary_conns_at_cutover"] = established(PRIMARY_PORT)
    say(
        f"front -> :{STANDBY_PORT}; primary pid {old_pid} had {stats['primary_in_flight_at_cutover']} in flight, "
        f"{stats['primary_conns_at_cutover']} connection(s); draining it (bound {primary_bound}s)"
    )
    t = time.monotonic()
    restart_primary(args.reload_plist, old_pid, primary_bound)

    def old_gone() -> bool:
        return not pid_alive(old_pid)

    last = [0.0]

    def old_gone_logged() -> bool:
        if time.monotonic() - last[0] >= 10:
            last[0] = time.monotonic()
            say(f"  primary draining, {established(PRIMARY_PORT)} connection(s) open")
        return old_gone()

    wait_until(old_gone_logged, primary_bound, 0.25)
    stats["primary_drain_s"] = round(time.monotonic() - t, 1)
    say(f"old primary exited after {stats['primary_drain_s']}s")

    t = time.monotonic()
    primary_ok = wait_until(
        lambda: (launchd_pid(LABEL) not in (None, old_pid)) and healthy(PRIMARY_PORT), args.boot_timeout, 0.25
    )
    stats["primary_boot_s"] = round(time.monotonic() - t, 1)
    if not primary_ok:
        say("new primary failed its health gate; rolling back files and restarting the primary on them")
        rolled = files.rollback()
        if rolled:
            subprocess.run(["launchctl", "kickstart", "-k", f"gui/{UID}/{LABEL}"], check=False)
            primary_ok = wait_until(lambda: healthy(PRIMARY_PORT), args.boot_timeout, 0.5)
        if not primary_ok:
            sync_log(
                f"lb-restart FAILED reason={args.reason!r} primary unhealthy after restart; standby pid {standby.pid} "
                f"still serving on :{STANDBY_PORT}; rollback={'yes' if rolled else 'none'}"
            )
            say(f"primary still down; standby pid {standby.pid} keeps serving on :{STANDBY_PORT}. Fix by hand.")
            return 2
    say(f"new primary healthy on :{PRIMARY_PORT} (pid {launchd_pid(LABEL)}) {stats['primary_boot_s']}s after exit")

    # 3. front -> primary, drain and stop the standby
    hold_for_oauth(STANDBY_PORT)
    set_preferred(PRIMARY_PORT)
    front_routes_to(PRIMARY_PORT)
    time.sleep(0.5)
    hold_for_oauth(STANDBY_PORT)  # one that started between the check and the move
    stats["standby_in_flight_at_cutover"] = in_flight(STANDBY_PORT)
    # SIGTERM closes the standby's listener at once, so the port is free for
    # the next restart; the process finishes its in-flight streams on its own
    # (uvicorn graceful bound) and exits; a detached reaper kills it if it hangs.
    try:
        os.killpg(standby.pid, signal.SIGTERM)
    except OSError:
        pass
    spawn_reaper(standby.pid, drain)
    wait_until(lambda: listener_pid(STANDBY_PORT) is None, 10)
    remove_state(STANDBY_PIDFILE)
    stats["total_s"] = round(time.monotonic() - T0, 1)
    say(
        f"standby pid {standby.pid} stopped listening and drains its {stats['standby_in_flight_at_cutover']} "
        f"in-flight request(s) in the background (log {STANDBY_LOG}); done in {stats['total_s']}s"
    )
    rollback_note = f" rolled_back_from={files.restored_from}" if files.restored_from else ""
    backup_note = f" backup={files.backup_dir}" if files.backup_dir else ""
    sync_log(
        "lb-restart ok "
        + " ".join(f"{k}={v!r}" if isinstance(v, str) else f"{k}={v}" for k, v in stats.items())
        + f" old_pid={old_pid} new_pid={launchd_pid(LABEL)}{backup_note}{rollback_note}"
    )
    return 0 if not files.restored_from else 1


if __name__ == "__main__":
    sys.exit(main())
