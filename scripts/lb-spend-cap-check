#!/usr/bin/env python3


from __future__ import annotations

import argparse
import datetime as dt
import http.client
import json
import math
import os
import shutil
import signal
import sqlite3
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path

from lb_spend_cap_sandbox import Check, InfraError, SEED_ACCOUNT, copy_tree, export_app, free_port, guard_port, listener_addresses, listener_pids, sandbox_env, scrub_dotenv
from lb_spend_cap_upstream import CACHE_READ_TOKENS, CAP_MICRODOLLARS, INPUT_TOKENS, OUTPUT_TOKENS, FakeAnthropic, sse_body

PRICED_MODEL = "claude-sonnet-4-5-20250929"
PRICE_KEY = "claude-sonnet-4-5"
UNPRICED_MODEL = "claude-unpriced-sandbox-0"


REFUSED_UNDER_CAP = [UNPRICED_MODEL, "claude-sonnet-4-99", "claude-opus-5-99", "gpt-5.99", "gpt-5.1-unpriced", "gpt-5*", "gpt-5.5*", "files-create", "files-finalize", ""]
def http_call(port: int, method: str, path: str, body: dict | None = None, headers: dict | None = None):
    conn = http.client.HTTPConnection("127.0.0.1", port, timeout=60)
    try:
        hdrs = {"Content-Type": "application/json"}
        hdrs.update(headers or {})
        conn.request(method, path, body=json.dumps(body) if body is not None else None, headers=hdrs)
        resp = conn.getresponse()
        return resp.status, resp.read()
    finally:
        conn.close()


def send_message(port: int, key: str | None, model: str):
    headers = {"anthropic-version": "2023-06-01", "user-agent": "lb-spend-cap-check"}
    if key is not None:
        headers["Authorization"] = f"Bearer {key}"
    payload = {"model": model, "max_tokens": 16, "stream": True, "messages": [{"role": "user", "content": "hi"}]}
    return http_call(port, "POST", "/v1/messages", payload, headers)


def main() -> int:
    parser = argparse.ArgumentParser(description='Sandbox-port check that API key cost_usd caps bite on Claude traffic (bops S16 spend floor).', formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", type=Path, default=Path(os.environ.get("HARDEN_OUT_DIR", "")) or None)
    parser.add_argument("--repo", type=Path, default=Path("/Volumes/StudioExt/repos/agent-lb"))
    parser.add_argument("--ref", default="origin/main")
    parser.add_argument("--app-root", type=Path, help="use this source tree instead of exporting --ref")
    parser.add_argument("--python", type=Path, default=Path.home() / ".agent-lb/runtime/agent-lb/.venv/bin/python")
    parser.add_argument("--keep-sandbox", action="store_true")
    args = parser.parse_args()
    if args.out is None or str(args.out) in ("", "."):
        stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        args.out = Path.home() / f".agent-lb/sandboxes/lb-spend-cap-{stamp}-{uuid.uuid4().hex[:6]}"
    out: Path = args.out.expanduser().resolve()
    out.mkdir(parents=True, exist_ok=True)
    check = Check(out)
    check.unverified.append(
        "Live agent-lb deploy is not exercised: this check boots the landed ref on a private sandbox port only."
    )
    check.unverified.append(
        "Receipts carry no separate actual-cost field; request-log cost_usd was already list price, so no field "
        "was added (spec fixed interface: add one only if none exists)."
    )

    sandbox = out / "sandbox"
    if sandbox.exists():
        return check.write(infra_error=f"sandbox dir already exists: {sandbox}")
    live_before = listener_pids(2455)
    server_proc: subprocess.Popen | None = None
    fake: FakeAnthropic | None = None
    app_port = upstream_port = 0
    infra: str | None = None
    created_sandbox = False
    try:
        sandbox.mkdir()
        created_sandbox = True
        app_root = sandbox / "app"
        if args.app_root:
            sha = copy_tree(args.app_root.expanduser().resolve(), app_root)
        else:
            sha = export_app(args.repo, args.ref, app_root)
        scrub_dotenv(app_root)
        data = sandbox / "data"
        (data / "home").mkdir(parents=True)
        (data / "routing-table.json").write_text(json.dumps({"classes": {}, "aliases": {}, "retired": []}))
        (data / "decider.json").write_text("{}")
        upstream_port = free_port(set())
        app_port = free_port({upstream_port})
        guard_port(upstream_port)
        guard_port(app_port)

        fake = FakeAnthropic(upstream_port)
        threading.Thread(target=fake.serve_forever, daemon=True).start()

        env = sandbox_env(app_root, data, upstream_port)
        probe = subprocess.run(
            [str(args.python), "-c", "import app; print(app.__file__)"],
            cwd=app_root,
            env=env,
            capture_output=True,
            text=True,
            timeout=60,
        )
        imported_from = probe.stdout.strip()
        if not imported_from.startswith(str(app_root)):
            raise InfraError(f"app imports from {imported_from or probe.stderr[-300:]}, not {app_root}")

        log = open(out / "sandbox-app.log", "wb")
        server_proc = subprocess.Popen(
            [
                str(args.python),
                "-m",
                "uvicorn",
                "app.main:app",
                "--app-dir",
                str(app_root),
                "--host",
                "127.0.0.1",
                "--port",
                str(app_port),
            ],
            cwd=app_root,
            env=env,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        deadline = time.monotonic() + 120
        ready = False
        while time.monotonic() < deadline and server_proc.poll() is None:
            try:
                status, _ = http_call(app_port, "GET", "/health/ready")
                if status == 200:
                    ready = True
                    break
            except OSError:
                pass
            time.sleep(0.5)
        if not ready:
            raise InfraError("sandbox agent-lb did not become ready in 120 s (see sandbox-app.log)")
        addresses = listener_addresses(server_proc.pid)
        boot_ok = bool(addresses) and all(a.startswith("127.0.0.1:") for a in addresses)
        check.step(
            "sandbox-boot",
            boot_ok,
            f"agent-lb {sha} imported from {imported_from} on 127.0.0.1:{app_port} (pid {server_proc.pid}); "
            f"fake Anthropic upstream on 127.0.0.1:{upstream_port}; listeners {addresses}; "
            f"live :2455 listener pids {live_before}",
            [str(out / "sandbox-app.log"), f"ref {sha}", f"port {app_port}"],
        )

        seed = subprocess.run(
            [str(args.python), "-c", SEED_ACCOUNT], cwd=app_root, env=env, capture_output=True, text=True, timeout=60
        )
        if seed.returncode != 0:
            raise InfraError(f"account seed failed: {seed.stderr[-400:]}")

        sys.path.insert(0, str(app_root))
        from app.core.anthropic.pricing import DEFAULT_PRICING_MODELS  # noqa: E402 - sandbox ref's own table

        price = DEFAULT_PRICING_MODELS[PRICE_KEY]
        usd = (
            INPUT_TOKENS * price.input_per_1m
            + CACHE_READ_TOKENS * price.cache_read_input_per_1m
            + OUTPUT_TOKENS * price.output_per_1m
        ) / 1_000_000
        per_request = round(usd * 1_000_000)
        expected_trip = math.ceil(CAP_MICRODOLLARS / per_request) + 1

        def create_key(name: str, limits: list[dict]) -> tuple[str, str]:
            status, body = http_call(app_port, "POST", "/api/api-keys/", {"name": name, "limits": limits})
            if status != 200:
                raise RuntimeError(f"create key {name}: HTTP {status}")
            doc = json.loads(body)
            return doc["id"], doc["key"]

        cap = [{"limitType": "cost_usd", "limitWindow": "daily", "maxValue": CAP_MICRODOLLARS}]
        capped_id, capped_key = create_key("sandbox-cost-capped", cap)
        statuses: list[int] = []
        refusal = ""
        calls_before = len(fake.calls)
        for _ in range(expected_trip + 2):
            status, body = send_message(app_port, capped_key, PRICED_MODEL)
            statuses.append(status)
            if status != 200:
                refusal = body.decode(errors="replace")[:400]
                break
        served = len(fake.calls) - calls_before
        _, keys_body = http_call(app_port, "GET", "/api/api-keys/")
        key_doc = next(k for k in json.loads(keys_body) if k["id"] == capped_id)
        current = next(lim["currentValue"] for lim in key_doc["limits"] if lim["limitType"] == "cost_usd")
        (out / "capped-claude.json").write_text(
            json.dumps(
                {
                    "model": PRICED_MODEL,
                    "price_table_entry": PRICE_KEY,
                    "tokens": {"input": INPUT_TOKENS, "cache_read": CACHE_READ_TOKENS, "output": OUTPUT_TOKENS},
                    "per_request_microdollars": per_request,
                    "cap_microdollars": CAP_MICRODOLLARS,
                    "expected_trip_request": expected_trip,
                    "statuses": statuses,
                    "upstream_calls": served,
                    "limit_current_value": current,
                    "refusal": refusal,
                },
                indent=2,
            )
        )
        trip_ok = (
            statuses == [200] * (expected_trip - 1) + [429]
            and served == expected_trip - 1
            and current == per_request * (expected_trip - 1)
            and "cost_usd daily limit exceeded" in refusal
        )
        check.step(
            "capped-claude-trips",
            trip_ok,
            f"{PRICED_MODEL} at {per_request} microdollars per request (price table {PRICE_KEY}: "
            f"{INPUT_TOKENS} in, {CACHE_READ_TOKENS} cache read, {OUTPUT_TOKENS} out) under a "
            f"{CAP_MICRODOLLARS} microdollar daily cap: expected trip at request {expected_trip}; "
            f"statuses {statuses}; upstream calls {served}; limit current {current}",
            [str(out / "capped-claude.json")],
        )

        _, unpriced_key = create_key("sandbox-cost-capped-unpriced", cap)
        refusals = []
        for model in REFUSED_UNDER_CAP:
            calls_before = len(fake.calls)
            status, body = send_message(app_port, unpriced_key, model)
            text = body.decode(errors="replace")
            try:
                error = json.loads(body).get("error", {})
            except ValueError:
                error = {}
            upstream_calls = len(fake.calls) - calls_before
            refusals.append(
                {
                    "model": model,
                    "status": status,
                    "body": text[:600],
                    "upstream_calls": upstream_calls,
                    "ok": status == 403
                    and error.get("type") == "permission_error"
                    and error.get("code") == "model_unpriced_under_cost_cap"
                    and repr(model) in error.get("message", "")
                    and "cost_usd daily cap" in error.get("message", "")
                    and upstream_calls == 0,
                }
            )
        (out / "unpriced-refused.json").write_text(json.dumps(refusals, indent=2))
        check.step(
            "unpriced-refused",
            all(r["ok"] for r in refusals),
            "; ".join(f"{r['model']!r}: HTTP {r['status']}, upstream calls {r['upstream_calls']}" for r in refusals),
            [str(out / "unpriced-refused.json")],
        )

        file_results = []
        calls_before = len(fake.calls)
        for path, payload in (
            ("/backend-api/files", {"file_name": "sandbox.txt", "file_size": 1, "use_case": "mcp"}),
            ("/backend-api/files/sandbox-file/uploaded", {}),
        ):
            status, body = http_call(app_port, "POST", path, payload, {"Authorization": f"Bearer {capped_key}"})
            file_results.append({"path": path, "status": status, "body": body.decode(errors="replace")[:600]})
        file_calls = len(fake.calls) - calls_before
        (out / "file-routes.json").write_text(json.dumps(file_results, indent=2))
        check.step(
            "file-routes-exempt-only-on-file-routes",
            all(r["status"] == 200 for r in file_results) and file_calls == 2,
            f"Exhausted cost-capped key: file registration/finalize statuses {[r['status'] for r in file_results]}, "
            f"upstream calls {file_calls}; sentinel model names were refused above on /v1/messages",
            [str(out / "file-routes.json"), str(out / "unpriced-refused.json")],
        )

        _, uncapped_key = create_key("sandbox-uncapped", [])
        cases = [(uncapped_key, PRICED_MODEL)] * (expected_trip + 2) + [
            (uncapped_key, UNPRICED_MODEL),
            (None, PRICED_MODEL),
            (None, UNPRICED_MODEL),
        ]
        results = []
        calls_before = len(fake.calls)
        for key, model in cases:
            status, body = send_message(app_port, key, model)
            same = body == sse_body(model)
            results.append({"key": "uncapped" if key else "keyless", "model": model, "status": status, "same": same})
        uncapped_calls = len(fake.calls) - calls_before
        (out / "uncapped-unchanged.json").write_text(
            json.dumps({"requests": results, "upstream_calls": uncapped_calls}, indent=2)
        )
        check.step(
            "uncapped-unchanged",
            all(r["status"] == 200 and r["same"] for r in results) and uncapped_calls == len(cases),
            f"{len(cases)} uncapped and keyless requests (priced and unpriced models): "
            f"{sum(r['status'] == 200 for r in results)} HTTP 200, "
            f"{sum(r['same'] for r in results)} byte-identical to upstream; upstream calls {uncapped_calls}",
            [str(out / "uncapped-unchanged.json")],
        )

        db = sqlite3.connect(f"file:{data / 'store.db'}?mode=ro", uri=True)
        try:
            rows = db.execute(
                "SELECT r.cost_usd FROM request_logs r JOIN api_keys k ON k.id = r.api_key_id "
                "WHERE k.id = ? AND r.status = 'success'",
                (capped_id,),
            ).fetchall()
        finally:
            db.close()
        receipt_costs = [round(float(r[0]) * 1_000_000) for r in rows if r[0] is not None]
        (out / "receipts.json").write_text(
            json.dumps({"api_key_id": capped_id, "cost_usd": [r[0] for r in rows], "microdollars": receipt_costs})
        )
        check.step(
            "receipt-agrees-with-cap",
            len(receipt_costs) == expected_trip - 1 and all(c == per_request for c in receipt_costs),
            f"request-log cost_usd for the capped key's served requests, in microdollars: {receipt_costs} "
            f"(list price {per_request} each, same figure the cap metered)",
            [str(out / "receipts.json"), f"api_key {capped_id}"],
        )
    except InfraError as exc:
        infra = str(exc)
    except Exception as exc:  # noqa: BLE001 - every failure must land in result.json
        infra = f"{type(exc).__name__}: {exc}"
    finally:
        if server_proc is not None and server_proc.poll() is None:
            os.killpg(server_proc.pid, signal.SIGTERM)
            try:
                server_proc.wait(timeout=30)
            except subprocess.TimeoutExpired:
                os.killpg(server_proc.pid, signal.SIGKILL)
                server_proc.wait(timeout=10)
        if fake is not None:
            fake.shutdown()
            fake.server_close()
        removed = False
        if created_sandbox and not args.keep_sandbox:
            target = sandbox.resolve()
            if target.parent == out and target.name == "sandbox":
                shutil.rmtree(target, ignore_errors=True)
                removed = not target.exists()
            else:
                infra = infra or f"refused to delete unexpected path {target}"

    if infra is not None:
        return check.write(infra_error=f"{infra} (sandbox removed: {removed})")
    leftovers = {port: listener_pids(port) for port in (app_port, upstream_port)}
    live_after = listener_pids(2455)
    check.step(
        "cleanup-and-live-untouched",
        all(not pids for pids in leftovers.values())
        and server_proc is not None
        and server_proc.returncode is not None
        and (removed or args.keep_sandbox)
        and bool(live_before)
        and bool(live_after)
        and live_before == live_after,
        f"sandbox listeners after stop {leftovers}; app exit {server_proc.returncode if server_proc else None}; "
        f"sandbox dir removed {removed}; live :2455 listener pids before {live_before} after {live_after}",
        [str(out / "result.json"), f"ports {app_port},{upstream_port}"],
    )
    return check.write()


if __name__ == "__main__":
    sys.exit(main())
