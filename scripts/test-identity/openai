args = parser.parse_args()
value = {'status': 'unavailable', 'service': 'openai', 'identity_ref': None, 'env': {}, 'cleanup_cmd': None, 'backend': 'seed', 'reason': 'No disposable OpenAI test account with an enforced proof spend cap and outbound containment is available. Operator subscription credentials are forbidden.'}
if args.release:
    value["release"] = args.release
print(json.dumps(value))
raise SystemExit(3)
