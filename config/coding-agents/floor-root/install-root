#!/usr/bin/env python3
import argparse
import os
import pwd
import re
import stat
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
HELPER = "/usr/local/sbin/agent-floors"
SUDOERS = "/etc/sudoers.d/agent-floors"
DARWIN = sys.platform == "darwin"
PYTHON = "/Library/Developer/CommandLineTools/usr/bin/python3" if DARWIN else "/usr/bin/python3"
GROUP = 0


def trusted(path):
    pending = [part for part in os.path.abspath(path).split("/") if part]
    current, hops = "/", 0
    info = os.lstat(current)
    if info.st_uid != 0 or info.st_mode & 0o022:
        sys.exit(f"install-root: {current} is not root-owned and closed to other writers")
    while pending:
        part = pending.pop(0)
        if part == ".":
            continue
        if part == "..":
            current = os.path.dirname(current)
            continue
        step = os.path.join(current, part)
        if not os.path.lexists(step):
            return
        info = os.lstat(step)
        if stat.S_ISLNK(info.st_mode):
            hops += 1
            if info.st_uid != 0 or hops > 40:
                current = step
                sys.exit(f"install-root: {current} is not root-owned and closed to other writers")
            target = os.readlink(step)
            current = "/" if target.startswith("/") else current
            pending = [piece for piece in target.split("/") if piece] + pending
            continue
        current = step
        if info.st_uid != 0 or info.st_mode & 0o022:
            sys.exit(f"install-root: {current} is not root-owned and closed to other writers")


def place(path, text, mode):
    os.makedirs(os.path.dirname(path), 0o755, exist_ok=True)
    tmp = f"{path}.tmp-{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "w") as handle:
        handle.write(text)
    os.chown(tmp, 0, GROUP)
    os.chmod(tmp, mode)
    return tmp


def main():
    parser = argparse.ArgumentParser(description="One-time root install of the agent-floors sync helper.")
    parser.add_argument("--user", required=True)
    args = parser.parse_args()
    if os.geteuid() != 0:
        sys.exit("install-root: run as root")
    if not re.fullmatch(r"[a-z_][a-z0-9_.-]{0,31}", args.user):
        sys.exit("install-root: bad user name")
    pwd.getpwnam(args.user)
    python = os.path.realpath(PYTHON)
    for path in (python, HELPER, SUDOERS, "/usr/local/lib/agent-floors", "/var/lib/agent-floors"):
        trusted(os.path.dirname(path))
    info = os.stat(python)
    if info.st_uid != 0 or info.st_mode & 0o022:
        sys.exit(f"install-root: {python} is not root-owned")
    with open(os.path.join(HERE, "agent-floors")) as handle:
        body = handle.read().split("\n", 1)[1]
    os.umask(0o022)
    for path, mode in (
        ("/var/lib/agent-floors", 0o700),
        ("/usr/local/lib/agent-floors", 0o755),
        ("/etc/agent-floors", 0o755),
    ):
        os.makedirs(path, mode, exist_ok=True)
        os.chown(path, 0, GROUP)
        os.chmod(path, mode)
    helper = place(HELPER, f"#!{python} -IS\n{body}", 0o755)
    rules = f"Defaults!{HELPER} env_reset\n{args.user} ALL=(root) NOPASSWD: {HELPER} sync\n"
    sudoers = place(SUDOERS, rules, 0o440)
    check = subprocess.run(["visudo", "-cf", sudoers], capture_output=True, text=True)
    if check.returncode:
        os.unlink(sudoers)
        os.unlink(helper)
        sys.exit(f"install-root: visudo refused the rule: {check.stdout}{check.stderr}")
    os.replace(helper, HELPER)
    os.replace(sudoers, SUDOERS)
    print(f"installed {HELPER} ({python}) and {SUDOERS} for {args.user}; run install-policy.py as {args.user} next")


if __name__ == "__main__":
    main()
