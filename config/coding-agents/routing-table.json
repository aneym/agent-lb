  "policy": {
    "mode": "adaptive",
    "owner_date": "2026-09-20",
    "pace": {
      "ahead_gt": 15,
      "behind_lt": -10,
      "cycle_hours": 168
    },
    "bands": {
      "ok": "eligible>=3",
      "low": "eligible==2",
      "critical": "eligible==1",
      "exhausted": "eligible==0"
    },
    "admit": {
      "ok_on_pace": "all classes in the pool ranking",
      "ahead": "all classes plus the next class down",
      "behind_or_low": "judgment classes only (plan, review, verify)",
      "critical": "nothing new",
      "exhausted": "nothing"
    },
    "judgment_classes": [
      "plan",
      "review",
      "verify",
      "design",
      "audit"
    ],
    "source_of_truth": "~/.agents/policy/coding-agents/ROUTING.md",
    "lineup": {
      "owner_date": "2026-09-22",
      "drivers": [
        "opus-latest",
        "sol-latest"
      ],
      "retired": "see top-level `retired`: Fable, the whole Astra family, the gpt-5.6 generation and older",
      "implementation": "opus-latest first while anthropic-general is on pace or ahead (min_pace -10), else grok-latest on Cursor, terra-latest when served, GLM, Kimi; each closeout audited by the other vendor: sol-latest for Anthropic authors, opus-latest otherwise"
    }
  },
  "notes": [
    "Codex seats take --model <id> plus a separate --effort; the effort suffix is not a model name.",
    "2026-09-22 canonical lineup (owner): no Fable, no Codex Astra, no gpt-5.6. Seats name family aliases (`aliases`); `route resolve <alias>` and `route pick` resolve them to the newest served, non-retired model, so a release needs no edit. Opus orchestrates; cheaper seats implement; the other vendor's stronger model audits (classes.*.audit).",
    "2026-09-22: gpt-6-terra is not in the upstream model catalog for these accounts (the LB answers 503 no available accounts), so terra-latest resolves to nothing and implement falls through to grok-latest.",
    "2026-09-22 (owner): while the Anthropic general pool is on pace or ahead, Opus takes implement first (min_pace -10, the policy's behind threshold) with Cursor Grok as the fallback; Opus-written code is audited by sol-latest. `route record` logs each implement outcome and `route report --implement` compares seats per model.",
    "2026-09-22: glm-*/kimi-* chain entries removed: cursor-agent serves neither (cursor-agent --list-models) and no other seat dispatches them, so they could only ever resolve to a literal wildcard. Re-add them behind a family alias once a seat can run GLM or Kimi."
  ],
  "aliases": {
    "opus-latest": {
      "vendor": "anthropic",
      "harness": "opus",
      "note": "Claude Code's opus alias: the newest Opus the installed Claude Code serves"
    },
    "sonnet-latest": {
      "vendor": "anthropic",
      "harness": "sonnet",
      "note": "Claude Code's sonnet alias"
    },
    "sol-latest": {
      "vendor": "openai",
      "family": "sol",
      "note": "newest non-retired gpt-*-sol the LB serves"
    },
    "terra-latest": {
      "vendor": "openai",
      "family": "terra",
      "note": "newest non-retired gpt-*-terra the LB serves; none today (gpt-6-terra is not in the upstream catalog, gpt-5.6-terra is retired), so it is skipped until one ships"
    },
    "luna-latest": {
      "vendor": "openai",
      "family": "luna",
      "note": "newest non-retired gpt-*-luna the LB serves (Codex-native delegation only)"
    },
    "grok-latest": {
      "vendor": "cursor",
      "family": "grok",
      "variant": "medium-fast",
      "note": "newest Grok on Cursor (cursor-agent --list-models), medium-fast"
    },
    "grok-latest-low": {
      "vendor": "cursor",
      "family": "grok",
      "variant": "low-fast",
      "note": "newest Grok on Cursor, low-fast (scouting)"
    }
  },
