        "opus-latest",
        "sol-latest"
      ],
      "retired": "see top-level `retired`: Fable, the whole Astra family, the gpt-5.6 generation and older",
      "implementation": "Q0: Grok first for bounded hands; Kimi mechanical only, Devin and Sol follow. Opus retains authority; Q4 owns tier-aware admission."
    },
    "review": {
      "timing": "on_request",
      "fresh_per_unit": true,
      "cross_vendor": true,
      "release_facts": false,
      "never_after_fail": false,
      "max_fix_rounds": 1,
      "money_path": {
        "lenses": 1,
        "timing": "on_request"
      }
    },
    "stage_effort": {
