{
  "version": 2,
  "policy_rev": "2026-10-26.q0",
  "precedence": [
    "explicit",
    "constraints",
    "sticky",
    "explore",
    "standard"
  ],
  "policy": {
    "concurrency": {
      "per_account": {
        "devin": 1,
        "cursor": 2,
        "openai": 3,
        "anthropic": 4,
        "kimi": 2,
        "glm": 2
      },
      "default": 2,
      "ttl_s": 120,
      "heartbeat_s": 30,
