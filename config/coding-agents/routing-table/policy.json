      "codex_error_minutes": 30,
      "never_tags": [
        "ui-critical",
        "contract",
        "trust-boundary",
        "money-path",
        "fix"
      ]
    },
    "stand_in_rollout": {
      "stage": "canary",
      "tabs": [
        "w5H:tC8"
      ],
      "lanes": []
