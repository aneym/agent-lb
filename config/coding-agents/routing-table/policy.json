      "min_eligible": 2,
      "headroom_min_percent": 40,
      "admit_classes": [
        "orchestrator",
        "lane-tab",
        "plan",
        "council",
        "lane",
        "spec",
        "scope",
        "contract",
        "architecture",
        "design",
        "review",
        "verdict",
        "judge",
        "audit",
        "plan-review",
