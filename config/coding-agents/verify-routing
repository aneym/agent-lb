#!/usr/bin/env python3
"""Check coding-agent routing against this policy directory.

The source is the directory this script lives in (the repo's
config/coding-agents or its ~/.agents/policy mirror). Source-only mode checks
this directory without consulting the installed home or a live LB; full mode
also checks the installation, launchers and live model resolution.
"""

from __future__ import annotations

import argparse
import ast
import fnmatch
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

PARSER = argparse.ArgumentParser(description="Verify coding-agent routing policy")
PARSER.add_argument("--source-only", action="store_true", help="Check source without installed policy or an LB")
SOURCE_ONLY = PARSER.parse_args().source_only
HOME = Path(os.environ.get("AGENT_LB_USER_HOME", Path.home()))
SOURCE = Path(__file__).resolve().parent
CANONICAL = HOME / ".agents" / "policy" / "coding-agents"
MARKER_START = "<!-- agent-lb:coding-agent-routing:start -->"
MARKER_END = "<!-- agent-lb:coding-agent-routing:end -->"
FORBIDDEN = ("fable", "claude-planner", "astra")
# A model id in a pin context: `--model X`, `model: X`, `model=X`, "model `X`".
MODEL_PIN = re.compile(r"(?:--model[ =]+|\bmodel\s*[:=]\s*|\bmodel\s+)[`'\"]?([A-Za-z0-9][\w.\-\[\]*]*)", re.IGNORECASE)
GPT_ID = re.compile(r"^gpt-(\d+(?:\.\d+)*)-([a-z]+)$")
MANAGED = (
    ("computer-use", ".claude/agents/computer-use.md", "agents/computer-use.md"),
    ("frontend-designer", ".claude/agents/frontend-designer.md", "agents/frontend-designer.md"),
    ("planner", ".claude/agents/planner.md", "agents/planner.md"),
    ("plan-reviewer", ".claude/agents/plan-reviewer.md", "agents/plan-reviewer.md"),
    ("codex-sol", ".claude/agents/codex-sol.md", "agents/codex-sol.md"),
    ("Explore", ".claude/agents/Explore.md", "agents/Explore.md"),
    ("opus-seat", ".claude/agents/opus-seat.md", "agents/opus-seat.md"),
    ("opus-seat-full", ".claude/agents/opus-seat-full.md", "agents/opus-seat-full.md"),
    ("cursor-seat", ".claude/agents/cursor-seat.md", "agents/cursor-seat.md"),
    ("devin-seat", ".claude/agents/devin-seat.md", "agents/devin-seat.md"),
    ("codex-verifier", ".claude/agents/codex-verifier.md", "agents/codex-verifier.md"),
    ("codex-test-runner", ".claude/agents/codex-test-runner.md", "agents/codex-test-runner.md"),
    ("verifier", ".claude/agents/verifier.md", "agents/verifier.md"),
    ("sonnet-verifier", ".claude/agents/sonnet-verifier.md", "agents/sonnet-verifier.md"),
    ("gpt-implementer", ".claude/agents/gpt-implementer.md", "agents/gpt-implementer.md"),
    ("gpt-explorer", ".claude/agents/gpt-explorer.md", "agents/gpt-explorer.md"),
    ("sol-consult", ".claude/agents/sol-consult.md", "agents/sol-consult.md"),
    ("astra-consult", ".claude/agents/astra-consult.md", "agents/astra-consult.md"),
    ("fable-orchestrator", ".claude/agents/fable-orchestrator.md", "agents/fable-orchestrator.md"),
    ("sonnet-implementer", ".claude/agents/sonnet-implementer.md", "agents/sonnet-implementer.md"),
    ("effort-xhigh", ".claude/agents/effort-xhigh.md", "agents/effort-xhigh.md"),
    ("host-relay", ".claude/agents/host-relay.md", "agents/host-relay.md"),
    ("seat-guard", ".claude/hooks/seat-guard.py", "hooks/seat-guard.py"),
    ("subagent-closeout", ".claude/hooks/subagent-closeout.py", "hooks/subagent-closeout.py"),
)
failures: list[str] = []


def check(condition: bool, message: str) -> None:
    print(f"{'PASS' if condition else 'FAIL'} {message}")
    if not condition:
        failures.append(message)


def read(path: Path) -> str:
    return path.read_text() if path.is_file() else ""


def forbidden(model: str) -> bool:
    return any(marker in model.lower() for marker in FORBIDDEN)


def readmitted(seat: str) -> tuple:
    """Retired patterns, and its alias with any effort suffix, the table's `readmitted` map grants this seat (2026-10-05)."""
    try:
        entry = (json.loads(read(SOURCE / "routing-table.json") or "{}").get("readmitted") or {}).get(seat)
    except (json.JSONDecodeError, AttributeError):
        return ()
    if not isinstance(entry, dict):
        return ()
    return (*(entry.get("patterns") or ()), *((entry["alias"] + "*",) if entry.get("alias") else ()))


def frontmatter_model(text: str) -> str | None:
    head = text.split("\n---", 1)[0]
    for line in head.splitlines():
        if line.startswith("model:"):
            return line.split(":", 1)[1].strip().strip("'\"")
    return None


settings = {}
if not SOURCE_ONLY:
    # Policy mirror and CLAUDE.md block.
    for name in ("ROUTING.md", "claude-adapter.md", "routing-table.json"):
        check(read(CANONICAL / name) == read(SOURCE / name) != "", f"{CANONICAL / name} matches {SOURCE / name}")

    claude_doc = HOME / ".claude" / "CLAUDE.md"
    claude_text = read(claude_doc)
    check(
        claude_text.count(MARKER_START) == 1 and claude_text.count(MARKER_END) == 1,
        f"{claude_doc} has exactly one managed routing block",
    )
    check(read(SOURCE / "claude-adapter.md").strip() in claude_text, f"{claude_doc} routing block matches the adapter")
    check(
        MARKER_START not in read(HOME / ".codex" / "AGENTS.md"),
        "~/.codex/AGENTS.md carries no managed routing block",
    )

    settings_path = HOME / ".claude" / "settings.json"
    try:
        settings = json.loads(read(settings_path) or "{}")
    except json.JSONDecodeError:
        settings = {}
        check(False, f"{settings_path} contains valid JSON")
    check(settings.get("model") == "opus", "direct Claude Code default model is opus (Opus 5.5)")
    check(settings.get("effortLevel") == "high", "direct Claude Code default effort is high")
    sonnet_pin = (settings.get("env") or {}).get("ANTHROPIC_DEFAULT_SONNET_MODEL") if isinstance(settings.get("env"), dict) else None
    check(isinstance(sonnet_pin, str) and re.fullmatch(r"claude-sonnet-\d+(?:-\d+)?", sonnet_pin) is not None,
          f"settings.json pins Claude Code's sonnet alias (ANTHROPIC_DEFAULT_SONNET_MODEL={sonnet_pin})")
    guard_registered = any(
        "seat-guard.py" in hook.get("command", "")
        for group in settings.get("hooks", {}).get("PreToolUse", [])
        if group.get("matcher") == "Agent"
        for hook in group.get("hooks", [])
    )
    check(guard_registered, "seat guard is registered as the Agent PreToolUse hook")

    # Managed seat definitions and the hook.
    for name, installed, source in MANAGED:
        check(read(HOME / installed) == read(SOURCE / source) != "", f"{installed} matches {source}")
        owner = HOME / ".agent-lb" / "managed" / "coding-agents" / name
        check(read(owner) == f"agent-lb:{name}:v1\n", f"{owner} records installer ownership")

    for retired_seat in ("astra", "implementer"):
        installed = (HOME / ".claude" / "agents" / f"{retired_seat}.md").exists()
        check(not installed, f"the retired {retired_seat} seat is not installed")

    # No subagent type runs on Fable or Astra, managed or not, except a seat the table readmits.
    for path in sorted((HOME / ".claude" / "agents").glob("*.md")):
        model = frontmatter_model(read(path)) or ""
        allowed = any(fnmatch.fnmatchcase(model.lower(), pattern) for pattern in readmitted(path.stem))
        check(not forbidden(model) or allowed, f"{path.name} does not pin a Fable model ({model or 'unset'})")
for name in ("planner", "plan-reviewer", "frontend-designer"):
    model = frontmatter_model(read(SOURCE / "agents" / f"{name}.md"))
    check(model == "opus", f"{name} runs on the newest Opus via `model: opus` (got {model})")
check(
    'route resolve sol-latest)" --effort xhigh' in read(SOURCE / "agents" / "codex-verifier.md"),
    "codex-verifier forwards to the newest Sol at xhigh",
)

# Routing table: installed copy equals source except learned overrides in full mode.
try:
    source_table = json.loads(read(SOURCE / "routing-table.json") or "{}")
except json.JSONDecodeError:
    source_table = {}
    check(False, "routing tables are valid JSON")
if not SOURCE_ONLY:
    table_path = HOME / ".agent-lb" / "managed" / "coding-agents" / "routing-table.json"
    try:
        live_table = json.loads(read(table_path) or "{}")
    except json.JSONDecodeError:
        live_table = {}
        check(False, "routing tables are valid JSON")
    strip = lambda table: {key: value for key, value in table.items() if key != "overrides"}  # noqa: E731
    check(bool(source_table) and strip(live_table) == strip(source_table), f"{table_path} matches the source table")
classes = source_table.get("classes", {})
chain_models = [entry.get("model", "") for spec in classes.values() for entry in spec.get("chain", [])]
check(bool(chain_models) and not any(forbidden(m) for m in chain_models), "no routing-table class runs on Fable")
check(not any(forbidden(key) for key in source_table.get("pools", {})), "no routing-table pool maps a Fable model")
# Every seat the table names (chains and the seats map) has an installed definition.
if not SOURCE_ONLY:
    chain_seats = sorted({entry.get("seat", "") for spec in classes.values() for entry in spec.get("chain", [])}
        | set(source_table.get("seats", {})))
    missing_seats = [seat for seat in chain_seats if not (HOME / ".claude" / "agents" / f"{seat}.md").is_file()]
    check(
        not missing_seats,
        "every routing-table seat has a definition in ~/.claude/agents"
        + (f": missing {missing_seats}" if missing_seats else ""),
    )
plan_chain = [entry.get("model") for entry in classes.get("plan", {}).get("chain", [])]
check(
    plan_chain[:1] in (["opus-latest"], ["sol-latest"]), f"plan leads with opus-latest or sol-latest ({plan_chain[:1]})"
)
for name in ("implement", "mechanical"):
    spec = classes.get(name, {})
    unpaced_opus = [
        entry for entry in spec.get("chain", []) if entry.get("model") == "opus-latest" and "min_pace" not in entry
    ]
    check(not unpaced_opus, f"{name} puts Opus only behind a pace gate (min_pace), else on cheaper seats")
    audit = spec.get("audit", {})
    by_vendor = audit.get("by_author_vendor", {})
    check(
        audit.get("required") is True
        and by_vendor.get("anthropic", {}).get("model") == "sol-latest"
        and all(
            by_vendor.get(v, {}).get("model") == "opus-latest"
            for v in ("openai", "cursor", "devin", "glm", "kimi")
        ),
        f"{name} closeouts are audited cross-vendor (newest Opus / newest Sol)",
    )

# Factory invariants are source checks in both modes.
def factory(rule: str, valid: bool, detail: str) -> None:
    check(valid, f"factory:{rule} {detail}")


# implement_default (2026-09-28) is the revert switch: route moves its seat to the head of both chains, and the
# other default implementer stays in each chain as the fallback.
DEFAULT_HEADS = {
    "sonnet-implementer": {"seat": "sonnet-implementer", "model": "sonnet-latest", "vendor": "anthropic", "effort": "high"},
    "gpt-implementer": {"seat": "gpt-implementer", "model": "sol-latest", "vendor": "openai", "effort": "medium"},
}
implement_default = source_table.get("implement_default")
head_rows = [
    [{key: entry.get(key) for key in ("seat", "model", "vendor", "effort")}
     for entry in classes.get(name, {}).get("chain", []) if isinstance(entry, dict)]
    for name in ("implement", "mechanical")
]
factory(
    "implement-head",
    implement_default in DEFAULT_HEADS
    and all(DEFAULT_HEADS[implement_default] in rows and all(row in rows for row in DEFAULT_HEADS.values())
        and rows[0] in DEFAULT_HEADS.values() for rows in head_rows),
    f"implement and mechanical hold both default implementers with one at the head; implement_default={implement_default}",
)
off_default = source_table.get("off_default", [])
off_seats = {item.get("seat") for item in off_default}
factory(
    "off-default",
    all(all(item.get(field) for field in ("seat", "since", "evidence", "returns_when"))
        for item in off_default)
    and not any(entry.get("seat") in off_seats | {"luna-implementer"}
        for spec in classes.values() for entry in spec.get("chain", [])),
    "dated off-default seats are absent from chains",
)
expected_auditors = {
    vendor: {"seat": "verifier", "model": "opus-latest", "vendor": "anthropic", "effort": "high"}
    for vendor in ("openai", "cursor", "devin", "glm", "kimi")
}
expected_auditors["anthropic"] = {
    "seat": "codex-verifier", "model": "sol-latest", "vendor": "openai", "effort": "xhigh"
}
for task_class in ("implement", "mechanical"):
    audit = classes.get(task_class, {}).get("audit", {})
    auditors = audit.get("by_author_vendor", {})
    factory(
        "audit-cross-vendor",
        all(audit.get(key) is True for key in ("required", "fresh_per_unit", "release_facts"))
        and auditors == expected_auditors
        and all(author != auditor.get("vendor") for author, auditor in auditors.items()),
        f"{task_class} requires fresh cross-vendor auditors and release facts",
    )
review = source_table.get("policy", {}).get("review", {})
factory(
    "review-policy",
    classes.get("verify", {}).get("cross_vendor") is True
    and any(entry.get("seat") == "codex-verifier" and entry.get("effort") == "xhigh"
        for entry in classes.get("verify", {}).get("chain", []))
    and review.get("money_path") == {"lenses": 3, "rule": "any-fail", "effort": "xhigh"}
    and all(review.get(key) is True for key in ("never_after_fail", "fresh_per_unit", "cross_vendor", "release_facts"))
    and review.get("max_fix_rounds") == 2,
    "fresh cross-vendor review, any-fail money path and two fix rounds",
)
bands = source_table.get("policy", {}).get("stage_effort", {}).get("bands", {})
forwarders = {"codex-sol", "codex-verifier", "codex-test-runner", "computer-use", "cursor-seat", "devin-seat"}
VENDORS = ("anthropic", "openai", "cursor", "devin", "glm", "kimi")
BOX_ADAPTERS = {"codex": "openai", "claude-code": "anthropic", "cursor": "cursor", "devin": "devin"}
EFFORTS = ("low", "medium", "high", "xhigh")
SEAT_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def valid_effort(entry: dict, band: str) -> bool:
    effort = entry.get("effort")
    if entry.get("vendor") in ("openai", "anthropic") and effort not in bands.get(band, []):
        return False
    text = read(SOURCE / "agents" / f"{entry.get('seat')}.md")
    head = text.split("\n---", 1)[0]
    field = next((line.split(":", 1)[1].strip() for line in head.splitlines() if line.startswith("effort:")), None)
    if entry.get("seat") in forwarders:
        return field in bands.get("relay", [])
    model = frontmatter_model(text) or ""
    if entry.get("seat", "").startswith("gpt-") or entry.get("seat") == "sol-consult":
        if not re.fullmatch(r"(?:sol|luna)-latest-(?:low|medium|high|xhigh)", model):
            return False
    if re.fullmatch(r"(?:sol|luna)-latest-(?:low|medium|high|xhigh)", model):
        return model.rsplit("-", 1)[-1] == effort
    return field is None or field == effort


effort_valid = all(
    valid_effort(entry, task_class)
    and (entry.get("vendor") in ("openai", "anthropic") or "effort" not in entry)
    for task_class, spec in classes.items() for entry in spec.get("chain", [])
)
effort_valid = effort_valid and all(
    valid_effort(auditor, "verify")
    for spec in classes.values() for auditor in spec.get("audit", {}).get("by_author_vendor", {}).values()
)
second = classes.get("plan", {}).get("second_opinion", {})
effort_valid = effort_valid and valid_effort(second, "plan")
factory("stage-effort", effort_valid, "chain, audit and second-opinion efforts match their stage and definition")
factory(
    "second-opinion",
    second == {"seat": "sol-consult", "model": "sol-latest", "vendor": "openai", "effort": "high",
        "when": "complex or risky plans, before the work is split"},
    "complex plans get sol-consult/sol-latest/openai/high",
)
routing_text = read(SOURCE / "ROUTING.md")
factory(
    "routing-doc",
    bool(routing_text) and len(routing_text.splitlines()) <= 150
    and all(re.search(r"20\d\d-\d\d-\d\d", line) for line in routing_text.splitlines() if line.startswith("## ")),
    "ROUTING.md headings are dated and document is at most 150 lines",
)
seats = {entry.get("seat") for spec in classes.values() for entry in spec.get("chain", [])}
seats.update(auditor.get("seat") for spec in classes.values()
    for auditor in spec.get("audit", {}).get("by_author_vendor", {}).values())
seats.add(second.get("seat"))
missing = sorted(seat for seat in seats if not seat or not (SOURCE / "agents" / f"{seat}.md").is_file())
factory(
    "seat-definitions", not missing,
    f"source defines every chain, auditor and second-opinion seat; missing {missing}",
)

# Validate the seat map against every dispatch path and each source definition.
seat_map = source_table.get("seats")
problems: list[str] = []
if not isinstance(seat_map, dict) or not seat_map:
    problems.append("seats must be a non-empty object")
    seat_map = {}
class_entries = []
auditor_seats = set()
for task_class, spec in classes.items():
    for entry in spec.get("chain", []):
        if isinstance(entry, dict) and isinstance(entry.get("seat"), str):
            class_entries.append((task_class, entry))
    opinion = spec.get("second_opinion")
    if isinstance(opinion, dict) and isinstance(opinion.get("seat"), str):
        class_entries.append((task_class, opinion))
    for entry in spec.get("audit", {}).get("by_author_vendor", {}).values():
        if isinstance(entry, dict) and isinstance(entry.get("seat"), str):
            class_entries.append((task_class, entry))
            auditor_seats.add(entry["seat"])
class_seats = {entry["seat"] for _, entry in class_entries}
definitions = {path.stem for path in (SOURCE / "agents").glob("*.md")}
if set(seat_map) != definitions:
    problems.append(
        f"definitions differ: missing {sorted(definitions - set(seat_map))}, "
        f"extra {sorted(set(seat_map) - definitions)}"
    )
named = class_seats | off_seats | {classes.get("implement", {}).get("escalation", {}).get("seat")}
for name in named - set(seat_map):
    problems.append(f"missing referenced seat {name}")
if any(isinstance(value, dict) and value.get("needs_test_run") is True for value in seat_map.values()):
    if "codex-test-runner" not in seat_map:
        problems.append("needs_test_run requires codex-test-runner")
for name, value in seat_map.items():
    if not isinstance(name, str) or not SEAT_NAME.fullmatch(name):
        problems.append(f"invalid seat name {name!r}")
        continue
    if not isinstance(value, dict):
        problems.append(f"{name} is not an object")
        continue
    if not {"vendor", "box"} <= value.keys() or value.keys() - {"vendor", "box", "model", "effort", "needs_test_run"}:
        problems.append(f"{name} has invalid fields")
    if value.get("vendor") not in VENDORS:
        problems.append(f"{name} has invalid vendor")
    box = value.get("box")
    if box is not None and (not isinstance(box, dict) or set(box) != {"adapter"}
                            or not isinstance(box.get("adapter"), str)
                            or BOX_ADAPTERS.get(box["adapter"]) != value.get("vendor")):
        problems.append(f"{name} has invalid box adapter")
    if name in auditor_seats:
        if type(value.get("needs_test_run")) is not bool:
            problems.append(f"{name} auditor needs boolean needs_test_run")
    elif "needs_test_run" in value:
        problems.append(f"{name} is not an auditor")
    if name in class_seats:
        if "model" in value or "effort" in value:
            problems.append(f"{name} class seat has model or effort")
    else:
        if value.get("model") not in source_table.get("aliases", {}) or value.get("effort") not in EFFORTS:
            problems.append(f"{name} needs model alias and effort")
        if name not in forwarders and (SOURCE / "agents" / f"{name}.md").is_file():
            head = read(SOURCE / "agents" / f"{name}.md").split("\n---", 1)[0]
            fields = dict(line.split(":", 1) for line in head.splitlines() if ":" in line)
            model = fields.get("model", "").strip()
            match = re.fullmatch(r"(sol|luna|astra)-latest-(low|medium|high|xhigh)", model)
            if match and (value.get("model") != match.group(1) + "-latest"
                          or value.get("effort") != match.group(2)):
                problems.append(f"{name} model effort disagrees with definition")
            elif not match and "effort" in fields and value.get("effort") != fields["effort"].strip():
                problems.append(f"{name} effort disagrees with definition")
for task_class, entry in class_entries:
    name = entry["seat"]
    if isinstance(seat_map.get(name), dict) and seat_map[name].get("vendor") != entry.get("vendor"):
        problems.append(f"{name} vendor disagrees with {task_class}")
factory("seats-map", not problems, "seats map: " + "; ".join(problems[:5]) if problems else
        "every dispatchable seat has one seats entry that agrees with its chains and definition")

escalation = classes.get("implement", {}).get("escalation")
implement = classes.get("implement", {})
chain = implement.get("chain", [])
review = source_table.get("policy", {}).get("review", {})
valid_escalation = isinstance(escalation, dict) and set(escalation) == {"seat", "at_fix_round", "since", "evidence"}
if valid_escalation:
    target = escalation["seat"]
    valid_escalation = (isinstance(target, str) and target in seat_map and bool(chain)
        and any(entry.get("seat") == target for entry in chain) and target != chain[0].get("seat")
        and isinstance(seat_map.get(target), dict)
        and seat_map[target].get("vendor") in implement.get("audit", {}).get("by_author_vendor", {})
        and type(escalation["at_fix_round"]) is int
        and type(review.get("max_fix_rounds")) is int
        and 1 <= escalation["at_fix_round"] <= review["max_fix_rounds"]
        and isinstance(escalation["since"], str) and re.fullmatch(r"20\d\d-\d\d-\d\d", escalation["since"])
        and isinstance(escalation["evidence"], str) and bool(escalation["evidence"].strip()))
factory("escalation", valid_escalation, "implement escalates to an audited chain seat within max_fix_rounds")

# Names of people and machines stay out of this public file too: each operator lists their own private literals
# (people, machines, hosts), one per line, in the file named by AGENT_LB_PRIVATE_LITERALS. Unset means only the
# generic patterns run; set but unreadable or empty is a failed check, not a silent pass.
private_literals: list[str] = []
literals_error = ""
literals_path = os.environ.get("AGENT_LB_PRIVATE_LITERALS")
if literals_path:
    try:
        private_literals = [
            item.strip() for item in Path(literals_path).expanduser().read_text().splitlines() if item.strip()
        ]
    except OSError as exc:
        literals_error = f"cannot read AGENT_LB_PRIVATE_LITERALS: {type(exc).__name__}"
    if not private_literals and not literals_error:
        literals_error = "AGENT_LB_PRIVATE_LITERALS names an empty file"
factory("private-literals", not literals_error, literals_error or "operator literal list loaded or not configured")
public_pattern = re.compile(
    "|".join(
        [r"/Users/|/Volumes/|\.ts\.net\b|[Tt]ailscale|[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\.[A-Za-z]{2,}"]
        + [rf"(?<![A-Za-z0-9_]){re.escape(literal)}(?![A-Za-z0-9_])" for literal in private_literals]
    )
