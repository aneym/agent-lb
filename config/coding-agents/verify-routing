#!/usr/bin/env python3


from __future__ import annotations

import argparse
import ast
import fnmatch
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

PARSER = argparse.ArgumentParser(description="Verify coding-agent routing policy")
PARSER.add_argument("--source-only", action="store_true", help="Check source without installed policy or an LB")
SOURCE_ONLY = PARSER.parse_args().source_only
HOME = Path(os.environ.get("AGENT_LB_USER_HOME", Path.home()))
SOURCE = Path(__file__).resolve().parent
CANONICAL = HOME / ".agents" / "policy" / "coding-agents"
MARKER_START = "<!-- agent-lb:coding-agent-routing:start -->"
MARKER_END = "<!-- agent-lb:coding-agent-routing:end -->"
FORBIDDEN = ("fable", "claude-planner", "astra")

MODEL_PIN = re.compile(r"(?:--model[ =]+|\bmodel\s*[:=]\s*|\bmodel\s+)[`'\"]?([A-Za-z0-9][\w.\-\[\]*]*)", re.IGNORECASE)
GPT_ID = re.compile(r"^gpt-(\d+(?:\.\d+)*)-([a-z]+)$")
from hooks.routing_factory_verification import verify_factory
from hooks.routing_installation_verification import verify_installation
from policy_files import source_routing_table  # type: ignore[missing-import]
from policy_verification import MANAGED  # type: ignore[missing-import]

failures: list[str] = []



def check(condition: bool, message: str) -> None:
    print(f"{'PASS' if condition else 'FAIL'} {message}")
    if not condition:
        failures.append(message)


def read(path: Path) -> str:
    return path.read_text() if path.is_file() else ""


def forbidden(model: str) -> bool:
    return any(marker in model.lower() for marker in FORBIDDEN)


def unpinned(text: str) -> str:
    return re.sub(r"(?m)^(model|effort):.*\n?", "", text)


def readmitted(seat: str) -> tuple:

    if seat == "fable-orchestrator":
        return ("claude-fable-*", "fable-latest*")
    try:
        entry = (json.loads(read(SOURCE / "routing-table" / "models.json") or "{}").get("readmitted") or {}).get(seat)
    except (json.JSONDecodeError, AttributeError):
        return ()
    if not isinstance(entry, dict):
        return ()
    return (*(entry.get("patterns") or ()), *((entry["alias"] + "*",) if entry.get("alias") else ()))


def frontmatter_model(text: str) -> str | None:
    head = text.split("\n---", 1)[0]
    for line in head.splitlines():
        if line.startswith("model:"):
            return line.split(":", 1)[1].strip().strip("'\"")
    return None




settings = verify_installation(SOURCE_ONLY, HOME, SOURCE, CANONICAL, check, read, unpinned, frontmatter_model, forbidden, readmitted, MARKER_START, MARKER_END, MANAGED)
for name in ("planner", "plan-reviewer", "frontend-designer"):
    model = frontmatter_model(read(SOURCE / "agents" / f"{name}.md"))
    check(model == "opus", f"{name} runs on the newest Opus via `model: opus` (got {model})")
check(
    'seat-exec --seat codex-verifier --effort "$dispatch_effort"' in read(SOURCE / "agents" / "codex-verifier.md"),
    "codex-verifier forwards to its seat at dispatch-selected effort",
)


try:
    source_table = source_routing_table(SOURCE / "routing-table")
except json.JSONDecodeError:
    source_table = {}
    check(False, "routing tables are valid JSON")
if not SOURCE_ONLY:
    table_path = HOME / ".agent-lb" / "managed" / "coding-agents" / "routing-table.json"
    try:
        live_table = json.loads(read(table_path) or "{}")
    except json.JSONDecodeError:
        live_table = {}
        check(False, "routing tables are valid JSON")
    strip = lambda table: {key: value for key, value in table.items() if key != "overrides"}  # noqa: E731
    check(bool(source_table) and strip(live_table) == strip(source_table), f"{table_path} matches the source table")
classes = source_table.get("classes", {})
chain_models = [entry.get("model", "") for spec in classes.values() for entry in spec.get("chain", [])]
check(bool(chain_models) and not any(forbidden(m) for m in chain_models), "no routing-table class runs on Fable")
check(not any(forbidden(key) for key in source_table.get("pools", {})), "no routing-table pool maps a Fable model")

if not SOURCE_ONLY:
    chain_seats = sorted({entry.get("seat", "") for spec in classes.values() for entry in spec.get("chain", [])}
        | set(source_table.get("seats", {})))
    missing_seats = [seat for seat in chain_seats if not (HOME / ".claude" / "agents" / f"{seat}.md").is_file()]
    check(
        not missing_seats,
        "every routing-table seat has a definition in ~/.claude/agents"
        + (f": missing {missing_seats}" if missing_seats else ""),
    )
plan_chain = [entry.get("model") for entry in classes.get("plan", {}).get("chain", [])]
check(
    plan_chain == ["opus-latest"], f"plan uses only opus-latest, without a Sol fallback ({plan_chain})"
)
for name in ("implement", "mechanical"):
    spec = classes.get(name, {})
    unpaced_opus = [
        entry for entry in spec.get("chain", []) if entry.get("model") == "opus-latest" and "min_pace" not in entry
    ]
    check(not unpaced_opus, f"{name} puts Opus only behind a pace gate (min_pace), else on cheaper seats")
    audit = spec.get("audit", {})
    by_vendor = audit.get("by_author_vendor", {})
    check(
        audit.get("required") is False
        and audit.get("mode") == "on_request"
        and by_vendor.get("anthropic", {}).get("model") == "sol-latest"
        and all(
            by_vendor.get(v, {}).get("model") == "sonnet-latest"
            for v in ("openai", "cursor", "devin", "glm", "kimi")
        ),
        f"{name} names its on-request cross-vendor auditors (Sonnet / newest Sol); review is optional pre-launch",
    )




routing_sections = verify_factory(SOURCE, source_table, classes, check, read, frontmatter_model)


retired = tuple(source_table.get("retired") or ())
aliases = source_table.get("aliases") or {}
older_allowed = source_table.get("older_allowed") if isinstance(source_table.get("older_allowed"), dict) else {}


def eval_reference_ok(value) -> bool:
    if not isinstance(value, str) or not value.strip():
        return False
    if re.search(r"\bE\d+\b", value):
        return True
    return any(token.strip("`'\",;:)]").endswith((".md", ".jsonl")) for token in value.split())


def older_allowed_index() -> dict:
    return {key.lower(): value for key, value in older_allowed.items() if isinstance(key, str)}


def retired_id(model_id: str) -> bool:
    bare = model_id.strip().lower()
    return any(fnmatch.fnmatchcase(bare, pattern) or fnmatch.fnmatchcase(pattern, bare) for pattern in retired)


allowed_problems = []
if not isinstance(source_table.get("older_allowed"), dict):
    allowed_problems.append("older_allowed entry has no eval reference")
else:
    for allowed_id, reference in source_table["older_allowed"].items():
        if not isinstance(allowed_id, str) or retired_id(allowed_id):
            allowed_problems.append(f"older_allowed lists retired id {allowed_id}")
        elif not eval_reference_ok(reference):
            allowed_problems.append(f"older_allowed entry has no eval reference ({allowed_id})")
check(
    not allowed_problems,
    "older_allowed names only live ids with eval references"
    if not allowed_problems
    else "; ".join(allowed_problems),
)
check(bool(retired) and bool(aliases), "the table declares family aliases and retired models")
newest_by_family = {}
if not SOURCE_ONLY:
    try:
        served_out = subprocess.run(
            [
                sys.executable,
                str((SOURCE / ".." / ".." / "clients" / "route").resolve())
                if (SOURCE / ".." / ".." / "clients" / "route").exists()
                else str(HOME / ".agent-lb" / "bin" / "route"),
                "models",
                "--json",
            ],
            text=True,
            capture_output=True,
            timeout=30,
            env=os.environ | {"ROUTE_TABLE": str(SOURCE / "routing-table")},
        )
        resolution = {row["alias"]: row["model"] for row in json.loads(served_out.stdout)["aliases"]}
    except Exception:
        resolution = {}
        check(False, "route models resolves the family aliases")
    for alias, spec in aliases.items():
        if spec.get("family") and resolution.get(alias):
            newest_by_family[spec["family"]] = resolution[alias]


if not SOURCE_ONLY:

    pricing_root = SOURCE.parent.parent
    if not (pricing_root / "app/core/usage/pricing.py").is_file():
        pricing_root = Path(__file__).resolve().parent
        for parent in pricing_root.parents:
            if (parent / "app/core/usage/pricing.py").is_file():
                pricing_root = parent
                break
    if not (pricing_root / "app/core/usage/pricing.py").is_file():
        print("SKIP served GPT alias pricing check: pricing.py is absent from this installation")
    else:
        sys.path.insert(0, str(pricing_root))
        try:


            catalogue = ast.parse((pricing_root / "app/core/usage/pricing.py").read_text())
            priced = set()
            price_aliases = {}
            for node in catalogue.body:
                if not isinstance(node, ast.AnnAssign) or not isinstance(node.target, ast.Name):
                    continue
                if node.target.id == "DEFAULT_PRICING_MODELS":
                    priced = {ast.literal_eval(key) for key in node.value.keys}
                elif node.target.id == "DEFAULT_MODEL_ALIASES":
                    price_aliases = eval(compile(ast.Expression(node.value), "pricing aliases", "eval"), {"__builtins__": {}})

            def has_price(model):
                if model in priced:
                    return True
                matches = [(len(pattern), target) for pattern, target in price_aliases.items()
                           if fnmatch.fnmatchcase(model.lower(), pattern.lower())]
                return bool(matches) and max(matches)[1] in priced

            def openai_aliases(value):
                found = set()
                if isinstance(value, dict):
                    if value.get("vendor") == "openai" and value.get("model") in aliases:
                        found.add(value["model"])
                    for child in value.values():
                        found.update(openai_aliases(child))
                elif isinstance(value, list):
                    for child in value:
                        found.update(openai_aliases(child))
                return found

            route = (SOURCE / "../../clients/route").resolve()
            if not route.is_file():
                route = HOME / ".agent-lb/bin/route"
            for alias in sorted({"sol-latest"} | openai_aliases(source_table)):
                result = subprocess.run(
                    [sys.executable, str(route), "resolve", alias], text=True, capture_output=True,
                    timeout=60, env=os.environ | {"ROUTE_TABLE": str(SOURCE / "routing-table")},
                )
                model = result.stdout.strip()
                check(result.returncode == 0 and has_price(model),
                      f"{alias} resolved id {model or '(unresolved)'} has pricing")
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            check(False, f"served GPT alias pricing check unavailable: {exc}")


def stale_reason(model, exempt=()):
    bare = model.strip("`'\"").lower().split("[", 1)[0]

    if any(fnmatch.fnmatchcase(bare, pattern) or fnmatch.fnmatchcase(pattern, bare)
           for pattern in retired if pattern not in exempt):
        return "retired"
    if ("*" in bare or "?" in bare) and bare.startswith(("gpt-", "claude-")):


        return "wildcard version pin; use a family alias"
    if bare in aliases or bare in ("opus", "sonnet", "haiku", "inherit") or "*" in bare:
        return None
    match = GPT_ID.match(bare)
    if match and match.group(2) in newest_by_family and newest_by_family[match.group(2)] != bare:
        newest = newest_by_family[match.group(2)]
        if bare in older_allowed_index():
            if eval_reference_ok(older_allowed_index()[bare]):
                return None
            return "older_allowed entry has no eval reference"
        return f"older than {newest}; add it to older_allowed with an eval reference"
    return None


if SOURCE_ONLY:
    pinned_sources = [(path, read(path)) for path in sorted((SOURCE / "agents").glob("*.md"))]
    pinned_sources += [(SOURCE / name, read(SOURCE / name)) for name in ("claude-adapter.md",)]
else:
    pinned_sources = [(path, read(path)) for path in sorted((HOME / ".claude" / "agents").glob("*.md"))]
    pinned_sources += [(SOURCE / name, read(SOURCE / name)) for name in ("claude-adapter.md",)]
    pinned_sources += [(HOME / ".codex" / "AGENTS.md", read(HOME / ".codex" / "AGENTS.md"))]
pinned_sources += [(path, read(path)) for path in routing_sections]
stale = []
for path, text in pinned_sources:
    for match in MODEL_PIN.finditer(text):
        reason = stale_reason(match.group(1).rstrip(".,;:)"), readmitted(path.stem))
        if reason:
            stale.append(f"{path.name}: {match.group(1)} ({reason})")
table_models = [entry.get("model", "") for spec in classes.values() for entry in spec.get("chain", [])]
table_models += [
    auditor.get("model", "")
    for spec in classes.values()
    for auditor in (spec.get("audit", {}).get("by_author_vendor", {}) or {}).values()
]
table_models += [classes.get("plan", {}).get("second_opinion", {}).get("model", "")]
table_models += list(source_table.get("pools", {}))
for model in table_models:
    reason = stale_reason(model)
    if reason:
        stale.append(f"routing-table: {model} ({reason})")
env_slots = settings.get("env", {}) if isinstance(settings.get("env"), dict) else {}
for key, value in env_slots.items():
    if key.startswith("ANTHROPIC_DEFAULT_") and isinstance(value, str) and stale_reason(value):
        stale.append(f"settings.json env {key}: {value} ({stale_reason(value)})")
check(
    not stale,
    "no retired model, and no older model without an eval reference, is pinned"
    + (": " + "; ".join(stale) if stale else ""),
)



if not SOURCE_ONLY:

    route_bin = HOME / ".agent-lb" / "bin" / "route"
    if route_bin.is_file():
        for task_class, spec in classes.items():
            extra = ["--author-vendor", "anthropic"] if spec.get("cross_vendor") else []
            result = subprocess.run(
                [sys.executable, str(route_bin), "pick", task_class, *extra, "--json"],
                text=True,
                capture_output=True,
                timeout=30,
            )
            try:
                picked = json.loads(result.stdout)
            except json.JSONDecodeError:
                picked = {}
            model = picked.get("model") or ""
            ok = bool(model) and not forbidden(model) and stale_reason(model) is None
            if task_class == "plan":
                ok = ok and picked.get("alias") in ("opus-latest", "sol-latest")
            check(ok, f"route pick {task_class} -> {picked.get('seat')}/{model or result.stderr.strip()}")
    else:
        check(False, f"route CLI exists at {route_bin}")


    cc_text = read((HOME / ".local" / "bin" / "cc").resolve())
    check('with_name("opus")' in cc_text, "~/.local/bin/cc execs the opus client")
    check(
        'MODEL = "opus[1m]"' in read((HOME / ".local" / "bin" / "opus").resolve()),
        "~/.local/bin/opus launches Claude Code's newest Opus (opus[1m])",
    )
    for name in ("ccdex", "ccdex-worker-mcp"):
        check(not (HOME / ".local" / "bin" / name).exists(), f"retired client {name} is absent")

if failures:
    print(f"\n{len(failures)} routing check(s) failed", file=sys.stderr)
    raise SystemExit(1)
print("\nAll coding-agent routing checks passed.")
