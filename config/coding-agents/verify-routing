        try:
            # Read the static catalogue without loading service-only dependencies in
            # the policy CLI's system Python.
            catalogue = ast.parse((pricing_root / "app/core/usage/pricing.py").read_text())
            priced = set()
            price_aliases = {}
            for node in catalogue.body:
                if not isinstance(node, ast.AnnAssign) or not isinstance(node.target, ast.Name):
                    continue
                if node.target.id == "DEFAULT_PRICING_MODELS":
                    priced = {ast.literal_eval(key) for key in node.value.keys}
                elif node.target.id == "DEFAULT_MODEL_ALIASES":
                    price_aliases = eval(compile(ast.Expression(node.value), "pricing aliases", "eval"), {"__builtins__": {}})

            def has_price(model):
                if model in priced:
                    return True
                matches = [(len(pattern), target) for pattern, target in price_aliases.items()
                           if fnmatch.fnmatchcase(model.lower(), pattern.lower())]
                return bool(matches) and max(matches)[1] in priced

            def openai_aliases(value):
                found = set()
                if isinstance(value, dict):
                    if value.get("vendor") == "openai" and value.get("model") in aliases:
                        found.add(value["model"])
                    for child in value.values():
                        found.update(openai_aliases(child))
                elif isinstance(value, list):
                    for child in value:
                        found.update(openai_aliases(child))
                return found

