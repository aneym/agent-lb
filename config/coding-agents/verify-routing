#!/usr/bin/env python3
"""Check the installed coding-agent routing against this policy directory.

The source is the directory this script lives in (the repo's
config/coding-agents or its ~/.agents/policy mirror), so the same checks run
from either copy. Lineup (owner, 2026-09-22): the newest Opus or Sol plans
and drives, nothing runs on Fable or a retired model, models are named by
family alias and resolved to the newest served model, and implementation is
cheap and audited cross-vendor.
"""

from __future__ import annotations

import fnmatch
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path(os.environ.get("AGENT_LB_USER_HOME", Path.home()))
SOURCE = Path(__file__).resolve().parent
CANONICAL = HOME / ".agents" / "policy" / "coding-agents"
MARKER_START = "<!-- agent-lb:coding-agent-routing:start -->"
MARKER_END = "<!-- agent-lb:coding-agent-routing:end -->"
FORBIDDEN = ("fable", "claude-planner", "astra")
# A model id in a pin context: `--model X`, `model: X`, `model=X`, "model `X`".
MODEL_PIN = re.compile(r"(?:--model[ =]+|\bmodel\s*[:=]\s*|\bmodel\s+)[`'\"]?([A-Za-z0-9][\w.\-\[\]*]*)", re.IGNORECASE)
GPT_ID = re.compile(r"^gpt-(\d+(?:\.\d+)*)-([a-z]+)$")
MANAGED = (
    ("implementer", ".claude/agents/implementer.md", "agents/implementer.md"),
    ("computer-use", ".claude/agents/computer-use.md", "agents/computer-use.md"),
    ("frontend-designer", ".claude/agents/frontend-designer.md", "agents/frontend-designer.md"),
    ("planner", ".claude/agents/planner.md", "agents/planner.md"),
    ("plan-reviewer", ".claude/agents/plan-reviewer.md", "agents/plan-reviewer.md"),
    ("codex-sol", ".claude/agents/codex-sol.md", "agents/codex-sol.md"),
    ("Explore", ".claude/agents/Explore.md", "agents/Explore.md"),
    ("opus-seat", ".claude/agents/opus-seat.md", "agents/opus-seat.md"),
    ("cursor-seat", ".claude/agents/cursor-seat.md", "agents/cursor-seat.md"),
    ("codex-verifier", ".claude/agents/codex-verifier.md", "agents/codex-verifier.md"),
    ("codex-test-runner", ".claude/agents/codex-test-runner.md", "agents/codex-test-runner.md"),
    ("verifier", ".claude/agents/verifier.md", "agents/verifier.md"),
    ("seat-guard", ".claude/hooks/seat-guard.py", "hooks/seat-guard.py"),
)
failures: list[str] = []


def check(condition: bool, message: str) -> None:
    print(f"{'PASS' if condition else 'FAIL'} {message}")
    if not condition:
        failures.append(message)


def read(path: Path) -> str:
    return path.read_text() if path.is_file() else ""


def forbidden(model: str) -> bool:
    return any(marker in model.lower() for marker in FORBIDDEN)


def frontmatter_model(text: str) -> str | None:
    head = text.split("\n---", 1)[0]
    for line in head.splitlines():
        if line.startswith("model:"):
            return line.split(":", 1)[1].strip().strip("'\"")
    return None


# Policy mirror and CLAUDE.md block.
for name in ("ROUTING.md", "claude-adapter.md", "routing-table.json"):
    check(read(CANONICAL / name) == read(SOURCE / name) != "", f"{CANONICAL / name} matches {SOURCE / name}")

claude_doc = HOME / ".claude" / "CLAUDE.md"
claude_text = read(claude_doc)
check(
    claude_text.count(MARKER_START) == 1 and claude_text.count(MARKER_END) == 1,
    f"{claude_doc} has exactly one managed routing block",
)
check(read(SOURCE / "claude-adapter.md").strip() in claude_text, f"{claude_doc} routing block matches the adapter")
check(
    all(value in claude_text for value in ("Aside on Book", "Tailscale URLs", "MACHINES.md")),
    f"{claude_doc} keeps the approved delivery defaults",
)
check(MARKER_START not in read(HOME / ".codex" / "AGENTS.md"), "~/.codex/AGENTS.md carries no managed routing block")

settings_path = HOME / ".claude" / "settings.json"
try:
    settings = json.loads(read(settings_path) or "{}")
except json.JSONDecodeError:
    settings = {}
    check(False, f"{settings_path} contains valid JSON")
check(settings.get("model") == "opus", "direct Claude Code default model is opus (Opus 5.5)")
check(settings.get("effortLevel") == "high", "direct Claude Code default effort is high")
guard_registered = any(
    "seat-guard.py" in hook.get("command", "")
    for group in settings.get("hooks", {}).get("PreToolUse", [])
    if group.get("matcher") == "Agent"
    for hook in group.get("hooks", [])
)
check(guard_registered, "seat guard is registered as the Agent PreToolUse hook")

# Managed seat definitions and the hook.
for name, installed, source in MANAGED:
    check(read(HOME / installed) == read(SOURCE / source) != "", f"{installed} matches {source}")
    owner = HOME / ".agent-lb" / "managed" / "coding-agents" / name
    check(read(owner) == f"agent-lb:{name}:v1\n", f"{owner} records installer ownership")

check(not (HOME / ".claude" / "agents" / "astra.md").exists(), "the retired astra seat is not installed")

# No subagent type runs on Fable or Astra, managed or not.
for path in sorted((HOME / ".claude" / "agents").glob("*.md")):
    model = frontmatter_model(read(path)) or ""
    check(not forbidden(model), f"{path.name} does not pin a Fable model ({model or 'unset'})")
for name in ("planner", "plan-reviewer", "frontend-designer"):
    model = frontmatter_model(read(SOURCE / "agents" / f"{name}.md"))
    check(model == "opus", f"{name} runs on the newest Opus via `model: opus` (got {model})")
check(
    'route resolve terra-latest)" --effort medium' in read(SOURCE / "agents" / "implementer.md"),
    "implementer forwards to the newest Terra at medium",
)
check(
    'route resolve sol-latest)" --effort xhigh' in read(SOURCE / "agents" / "codex-verifier.md"),
    "codex-verifier forwards to the newest Sol at xhigh",
)

# Routing table: installed copy equals the source apart from learned overrides.
table_path = HOME / ".agent-lb" / "managed" / "coding-agents" / "routing-table.json"
try:
    live_table = json.loads(read(table_path) or "{}")
    source_table = json.loads(read(SOURCE / "routing-table.json") or "{}")
except json.JSONDecodeError:
    live_table, source_table = {}, {}
    check(False, "routing tables are valid JSON")
strip = lambda table: {key: value for key, value in table.items() if key != "overrides"}  # noqa: E731
check(bool(source_table) and strip(live_table) == strip(source_table), f"{table_path} matches the source table")
classes = source_table.get("classes", {})
chain_models = [entry.get("model", "") for spec in classes.values() for entry in spec.get("chain", [])]
check(bool(chain_models) and not any(forbidden(m) for m in chain_models), "no routing-table class runs on Fable")
check(not any(forbidden(key) for key in source_table.get("pools", {})), "no routing-table pool maps a Fable model")
plan_chain = [entry.get("model") for entry in classes.get("plan", {}).get("chain", [])]
check(
    plan_chain[:1] in (["opus-latest"], ["sol-latest"]), f"plan leads with opus-latest or sol-latest ({plan_chain[:1]})"
)
for name in ("implement", "mechanical"):
    spec = classes.get(name, {})
    unpaced_opus = [
        entry for entry in spec.get("chain", []) if entry.get("model") == "opus-latest" and "min_pace" not in entry
    ]
    check(not unpaced_opus, f"{name} puts Opus only behind a pace gate (min_pace), else on cheaper seats")
    audit = spec.get("audit", {})
    by_vendor = audit.get("by_author_vendor", {})
    check(
        audit.get("required") is True
        and by_vendor.get("anthropic", {}).get("model") == "sol-latest"
        and all(by_vendor.get(v, {}).get("model") == "opus-latest" for v in ("openai", "cursor", "glm", "kimi")),
        f"{name} closeouts are audited cross-vendor (newest Opus / newest Sol)",
    )

# Retired and older-than-newest model ids, anywhere a seat could be pinned.
retired = tuple(source_table.get("retired") or ())
aliases = source_table.get("aliases") or {}
check(bool(retired) and bool(aliases), "the table declares family aliases and retired models")
try:
    served_out = subprocess.run(
        [
            sys.executable,
            str((SOURCE / ".." / ".." / "clients" / "route").resolve())
            if (SOURCE / ".." / ".." / "clients" / "route").exists()
            else str(HOME / ".agent-lb" / "bin" / "route"),
            "models",
            "--json",
        ],
        text=True,
        capture_output=True,
        timeout=30,
        env=os.environ | {"ROUTE_TABLE": str(SOURCE / "routing-table.json")},
    )
    resolution = {row["alias"]: row["model"] for row in json.loads(served_out.stdout)["aliases"]}
except Exception:
    resolution = {}
    check(False, "route models resolves the family aliases")
newest_by_family = {}
for alias, spec in aliases.items():
    if spec.get("family") and resolution.get(alias):
        newest_by_family[spec["family"]] = resolution[alias]


def stale_reason(model):
    bare = model.strip("`'\"").lower().split("[", 1)[0]
    if bare in aliases or bare in ("opus", "sonnet", "haiku", "inherit") or "*" in bare:
        return None
    if any(fnmatch.fnmatchcase(bare, pattern) for pattern in retired):
        return "retired"
    match = GPT_ID.match(bare)
    if match and match.group(2) in newest_by_family and newest_by_family[match.group(2)] != bare:
        return f"older than {newest_by_family[match.group(2)]}"
    return None


pinned_sources = [(path, read(path)) for path in sorted((HOME / ".claude" / "agents").glob("*.md"))]
pinned_sources += [(SOURCE / name, read(SOURCE / name)) for name in ("ROUTING.md", "claude-adapter.md")]
pinned_sources += [(HOME / ".codex" / "AGENTS.md", read(HOME / ".codex" / "AGENTS.md"))]
stale = []
for path, text in pinned_sources:
    for match in MODEL_PIN.finditer(text):
        reason = stale_reason(match.group(1).rstrip(".,;:)"))
        if reason:
            stale.append(f"{path.name}: {match.group(1)} ({reason})")
table_models = [entry.get("model", "") for spec in classes.values() for entry in spec.get("chain", [])]
table_models += [
    auditor.get("model", "")
    for spec in classes.values()
    for auditor in (spec.get("audit", {}).get("by_author_vendor", {}) or {}).values()
]
table_models += list(source_table.get("pools", {}))
for model in table_models:
    reason = stale_reason(model)
    if reason:
        stale.append(f"routing-table.json: {model} ({reason})")
env_slots = settings.get("env", {}) if isinstance(settings.get("env"), dict) else {}
for key, value in env_slots.items():
    if key.startswith("ANTHROPIC_DEFAULT_") and isinstance(value, str) and stale_reason(value):
        stale.append(f"settings.json env {key}: {value} ({stale_reason(value)})")
check(not stale, "no retired or older-than-newest model is pinned" + (": " + "; ".join(stale) if stale else ""))

# Seat guard behaviour: deny a pinned Fable model and a Fable-defined type.
hook = SOURCE / "hooks" / "seat-guard.py"
with tempfile.TemporaryDirectory() as scratch:
    agents_dir = Path(scratch) / "agents"
    agents_dir.mkdir()
    (agents_dir / "legacy-fable.md").write_text("---\nname: legacy-fable\nmodel: claude-fable-5-1\n---\nbody\n")
    env = os.environ | {
        "SEAT_GUARD_AGENTS_DIR": str(agents_dir),
        "DISPATCH_LEDGER": str(Path(scratch) / "dispatch.jsonl"),
        "LIMIT_WATCH_SNAPSHOT": str(Path(scratch) / "missing.json"),
    }

    def decision(tool_input: dict) -> str | None:
        payload = json.dumps({"tool_name": "Agent", "tool_input": {"prompt": "x", **tool_input}})
        result = subprocess.run(
            ["/usr/bin/python3" if Path("/usr/bin/python3").exists() else sys.executable, str(hook)],
            input=payload,
            text=True,
            capture_output=True,
            env=env,
            timeout=30,
        )
        try:
            return json.loads(result.stdout)["hookSpecificOutput"].get("permissionDecision")
        except (json.JSONDecodeError, KeyError):
            return "error"

    check(decision({"subagent_type": "opus-seat", "model": "fable"}) == "deny", "seat guard denies model=fable")
    check(decision({"subagent_type": "legacy-fable"}) == "deny", "seat guard denies a Fable-defined subagent type")
    check(decision({"subagent_type": "implementer", "model": "sonnet"}) is None, "seat guard admits a cheap seat")

# The installed router returns a live, non-retired seat for every class.
route_bin = HOME / ".agent-lb" / "bin" / "route"
if route_bin.is_file():
    for task_class, spec in classes.items():
        extra = ["--author-vendor", "anthropic"] if spec.get("cross_vendor") else []
        result = subprocess.run(
            [sys.executable, str(route_bin), "pick", task_class, *extra, "--json"],
            text=True,
            capture_output=True,
            timeout=30,
        )
        try:
            picked = json.loads(result.stdout)
        except json.JSONDecodeError:
            picked = {}
        model = picked.get("model") or ""
        ok = bool(model) and not forbidden(model) and stale_reason(model) is None
        if task_class == "plan":
            ok = ok and picked.get("alias") in ("opus-latest", "sol-latest")
        check(ok, f"route pick {task_class} -> {picked.get('seat')}/{model or result.stderr.strip()}")
else:
    check(False, f"route CLI exists at {route_bin}")

# Launchers: cc drives on Opus 5.5.
cc_text = read((HOME / ".local" / "bin" / "cc").resolve())
check('with_name("opus")' in cc_text, "~/.local/bin/cc execs the opus client")
check(
    'MODEL = "opus[1m]"' in read((HOME / ".local" / "bin" / "opus").resolve()),
    "~/.local/bin/opus launches Claude Code's newest Opus (opus[1m])",
)
for name in ("ccdex", "ccdex-worker-mcp"):
    check(not (HOME / ".local" / "bin" / name).exists(), f"retired client {name} is absent")

if failures:
    print(f"\n{len(failures)} routing check(s) failed", file=sys.stderr)
    raise SystemExit(1)
print("\nAll coding-agent routing checks passed.")
