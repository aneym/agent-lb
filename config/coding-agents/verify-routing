def stale_reason(model, exempt=()):
    bare = model.strip("`'\"").lower().split("[", 1)[0]
    # Retirement first: a wildcard pin such as gpt-5.6* is as retired as the ids it covers.
    if any(fnmatch.fnmatchcase(bare, pattern) or fnmatch.fnmatchcase(pattern, bare)
           for pattern in retired if pattern not in exempt):
        return "retired"
    if ("*" in bare or "?" in bare) and bare.startswith(("gpt-", "claude-")):
        # A version glob can overlap a retired generation without matching its pattern
        # (gpt-5.*-sol vs gpt-5.6*); name the family alias instead.
        return "wildcard version pin; use a family alias"
    if bare in aliases or bare in ("opus", "sonnet", "haiku", "inherit") or "*" in bare:
        return None
    match = GPT_ID.match(bare)
    if match and match.group(2) in newest_by_family and newest_by_family[match.group(2)] != bare:
        newest = newest_by_family[match.group(2)]
        if bare in older_allowed_index():
            if eval_reference_ok(older_allowed_index()[bare]):
                return None
            return "older_allowed entry has no eval reference"
        return f"older than {newest}; add it to older_allowed with an eval reference"
    return None


