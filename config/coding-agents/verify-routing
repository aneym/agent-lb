def eval_reference_ok(value) -> bool:
    if not isinstance(value, str) or not value.strip():
        return False
    if re.search(r"\bE\d+\b", value):
        return True
    return any(token.strip("`'\",;:)]").endswith((".md", ".jsonl")) for token in value.split())


