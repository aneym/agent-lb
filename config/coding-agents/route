# --- paths and configuration -------------------------------------------------


def base_url() -> str:
    return (os.environ.get("AGENT_LB_URL") or DEFAULT_BASE_URL).rstrip("/")


def _env_path(name: str, default: Path) -> Path:
    value = (os.environ.get(name) or "").strip()
    return Path(value).expanduser() if value else default


def table_path() -> Path:
    managed = Path.home() / ".agent-lb" / "managed" / "coding-agents" / "routing-table.json"
    repo = Path(__file__).resolve().with_name("routing-table.json")
    configured = (os.environ.get("ROUTE_TABLE") or "").strip()
    if configured:
        return Path(configured).expanduser()
    return repo if repo.is_file() else managed


def state_path() -> Path:
    return _env_path("ROUTE_STATE", Path.home() / ".claude" / "routing-state.json")


def alert_path() -> Path:
    return _env_path("ROUTE_ALERT", Path.home() / ".claude" / "routing-ALERT")


def ledger_path() -> Path:
    value = (os.environ.get("ROUTE_LEDGER") or os.environ.get("DISPATCH_LEDGER") or "").strip()
    return Path(value).expanduser() if value else Path.home() / ".claude" / "logs" / "dispatch.jsonl"


def cursor_command() -> list[str]:
    return shlex.split(os.environ.get("ROUTE_CURSOR_CMD") or "cursor-agent status")


def codex_command() -> list[str]:
    configured = os.environ.get("ROUTE_CODEX_CMD")
    if configured:
        return shlex.split(configured)
    return ["node", str(Path(DEFAULT_CODEX_COMPANION).expanduser()), "status"]


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_table() -> dict[str, Any]:
    path = table_path()
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"routing table not found at {path}")
    except (OSError, json.JSONDecodeError) as error:
        fail(f"routing table at {path} is unreadable: {error}")
    if not isinstance(value, dict):
        fail(f"routing table at {path} is not an object")
    return value


def fail(message: str) -> Any:
    print(f"route: {message}", file=sys.stderr)
    raise SystemExit(EXIT_UNROUTABLE)


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{secrets.token_hex(4)}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


# --- HTTP --------------------------------------------------------------------


class HttpResult:
    """One HTTP call: transport success, the status, and the decoded body."""

    def __init__(self, *, ok: bool, status: int | None, body: Any, error: str | None) -> None:
        self.ok = ok
        self.status = status
        self.body = body
        self.error = error

    @property
    def json_ok(self) -> bool:
        return self.ok and self.status == 200 and self.body is not None


def _fixture_file(path: str) -> Path | None:
    directory = (os.environ.get("ROUTE_FIXTURE_DIR") or "").strip()
    if not directory:
        return None
    slug = path.split("?", 1)[0].strip("/").replace("/", "_") or "root"
    return Path(directory).expanduser() / f"{slug}.json"


def _fixture_result(path: str) -> HttpResult:
    fixture = _fixture_file(path)
    assert fixture is not None
    try:
        body = json.loads(fixture.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return HttpResult(ok=False, status=404, body=None, error="HTTP 404 (fixture missing)")
    except (OSError, json.JSONDecodeError) as error:
        return HttpResult(ok=False, status=None, body=None, error=f"fixture unreadable: {error}")
    if isinstance(body, dict) and "__status" in body:
        status = body["__status"]
        return HttpResult(ok=status == 200, status=status, body=body.get("__body"), error=f"HTTP {status}")
    return HttpResult(ok=True, status=200, body=body, error=None)


def _request(method: str, path: str, *, payload: dict[str, Any] | None, timeout: float) -> HttpResult:
    if _fixture_file(path) is not None:
        return _fixture_result(path)
    headers = {"accept": "application/json"}
    data = None
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["content-type"] = "application/json"
        headers["anthropic-version"] = "2023-06-01"
    request = urllib.request.Request(f"{base_url()}{path}", data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310 - operator-set base URL
            raw = response.read().decode("utf-8", errors="replace")
            status = response.status
    except urllib.error.HTTPError as error:
        raw = error.read().decode("utf-8", errors="replace")
        body = _decode(raw)
        return HttpResult(ok=False, status=error.code, body=body, error=f"HTTP {error.code}")
    except TimeoutError:
        return HttpResult(ok=False, status=None, body=None, error="timeout")
    except (OSError, urllib.error.URLError) as error:
        reason = getattr(error, "reason", error)
        if isinstance(reason, TimeoutError) or "timed out" in str(reason).lower():
            return HttpResult(ok=False, status=None, body=None, error="timeout")
        return HttpResult(ok=False, status=None, body=None, error=f"{type(error).__name__}: {reason}")
    return HttpResult(ok=True, status=status, body=_decode(raw), error=None)


def _decode(raw: str) -> Any:
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return None


def http_get(path: str, *, timeout: float = READ_TIMEOUT_SECONDS) -> HttpResult:
    return _request("GET", path, payload=None, timeout=timeout)


def http_post(path: str, payload: dict[str, Any], *, timeout: float) -> HttpResult:
    return _request("POST", path, payload=payload, timeout=timeout)


# --- pools -------------------------------------------------------------------


def pool_status(headroom: float) -> str:
    if headroom >= POOL_OK_HEADROOM:
        return "ok"
    if headroom >= POOL_LOW_HEADROOM:
        return "low"
    return "exhausted"


def window_percent(account: dict[str, Any], key: str) -> float | None:
    usage = account.get("usage")
    value = usage.get(key) if isinstance(usage, dict) else None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return float(value) if math.isfinite(value) and 0 <= value <= 100 else None


def _additional_quota_windows(account: dict[str, Any]) -> dict[str, dict[str, float | None]]:
    normalized: dict[str, dict[str, float | None]] = {}
    quotas = account.get("additionalQuotas")
    if not isinstance(quotas, list):
        return normalized
    for quota in quotas:
        if not isinstance(quota, dict) or not isinstance(quota.get("quotaKey"), str):
            continue
        windows: dict[str, float | None] = {}
        for name, field in (("primary", "primaryWindow"), ("secondary", "secondaryWindow")):
            window = quota.get(field)
            if not isinstance(window, dict):
                continue
            used = window.get("usedPercent")
            if isinstance(used, bool) or not isinstance(used, (int, float)) or not math.isfinite(used):
                windows[name] = None
            elif 0 <= used <= 100:
                windows[name] = 100.0 - float(used)
            else:
                windows[name] = None
        if windows:
            normalized[quota["quotaKey"]] = windows
    return normalized


def account_limit(account: dict[str, Any], reserve: float) -> dict[str, Any]:
    short = window_percent(account, "primaryRemainingPercent")
    weekly = window_percent(account, "secondaryRemainingPercent")
    usage = account.get("usage") if isinstance(account.get("usage"), dict) else {}
    windows = {
        "primary": (short, account.get("resetAtPrimary")),
        "weekly": (weekly, account.get("resetAtSecondary")),
    }
    reported = {name: percent for name, (percent, reset) in windows.items() if percent is not None or reset is not None}
    known = {name: percent for name, percent in reported.items() if percent is not None}
    window = min(known, key=known.get) if known else (next(iter(reported), "unknown"))
    remaining = known.get(window)
    cooldown = _parse_ts(account.get("rateLimitResetAt"))
    status = account.get("status")
    if status != "active":
        reason = f"status {status or 'unknown'}"
    elif cooldown is not None and cooldown > datetime.now(timezone.utc):
        reason = f"rate limited until {account['rateLimitResetAt']}"
    elif not reported:
        reason = "unknown window data"
    elif not known:
        reason = "unknown reported window percent"
    elif any(percent is None for percent in reported.values()):
        reason = "unknown reported window percent"
    elif remaining is not None and remaining <= reserve:
        reason = f"{window} {remaining:g}% <= reserve {reserve:g}%"
    else:
        reason = "admitted"
    return {"account": account.get("accountId", "unknown"), "window": window,
            "remainingPercent": remaining, "reason": reason, "usable": reason == "admitted",
            "additionalQuotaWindows": _additional_quota_windows(account),
            "fableEligible": account.get("fableEligible")}


def _anthropic_quota_key(model: str, effort: str | None) -> str | None:
    if not model.startswith("claude-"):
        return None
    if "haiku" in model.lower():
        return "anthropic_standard"
    if (effort or "medium").lower() in {"", "none", "off"}:
        return "anthropic_top"
    return "anthropic_top_thinking"


def model_account_limit(limit: dict[str, Any], entry: dict[str, Any], reserve: float) -> dict[str, Any]:
    if not limit.get("usable"):
        return limit
    model = entry.get("model")
    if not isinstance(model, str):
        return limit
    quota_keys: list[str] = []
    quota_key = _anthropic_quota_key(model, entry.get("effort"))
    if quota_key is not None:
        quota_keys.append(quota_key)
    if "fable" in model.lower():
        quota_keys.append("anthropic_fable_scoped_weekly")
        if limit.get("fableEligible") is False:
            return {**limit, "window": "anthropic_fable_scoped_weekly", "remainingPercent": None,
                    "reason": "fable eligibility false", "usable": False}

    reported: list[tuple[str, float | None]] = []
    all_windows = limit.get("additionalQuotaWindows")
    if isinstance(all_windows, dict):
        for key in quota_keys:
            windows = all_windows.get(key)
            if not isinstance(windows, dict):
                continue
            reported.extend((f"{key} {name}", percent) for name, percent in windows.items())
    if not reported:
        return limit
    unknown = next((name for name, percent in reported if percent is None), None)
    if unknown is not None:
        return {**limit, "window": unknown, "remainingPercent": None,
                "reason": f"{unknown} unknown reported window percent", "usable": False}
    window, remaining = min(reported, key=lambda item: item[1])
    if remaining is not None and remaining <= reserve:
        return {**limit, "window": window, "remainingPercent": remaining,
                "reason": f"{window} {remaining:g}% <= reserve {reserve:g}%", "usable": False}
    base_remaining = limit.get("remainingPercent")
    if isinstance(base_remaining, (int, float)) and base_remaining <= remaining:
        return limit
    return {**limit, "window": window, "remainingPercent": remaining,
            "reason": "admitted", "usable": True}


def _pool_ids(account: dict[str, Any]) -> list[str]:
    provider = account.get("provider")
    if provider == "anthropic":
        ids = ["anthropic-general"]
        if account.get("fableEligible"):
            ids.append("anthropic-fable")
        return ids
    if provider == "openai":
        return ["openai-codex"]
    if isinstance(provider, str) and provider:
        return [provider]
    return []


def pools_from_accounts(body: Any, reserve: float = 20) -> dict[str, Any]:
    accounts = body.get("accounts") if isinstance(body, dict) else None
    if not isinstance(accounts, list):
        raise ValueError("unknown-account-data: /api/accounts has no accounts list")
    grouped: dict[str, list[dict[str, Any]]] = {}
    for account in accounts:
        if isinstance(account, dict):
            for pool_id in _pool_ids(account):
                grouped.setdefault(pool_id, []).append(account)
    pools = []
    for pool_id, members in sorted(grouped.items()):
        limits = [account_limit(account, reserve) for account in members]
        usable = [limit for limit in limits if limit["usable"]]
        weekly = [v for a in members if (v := window_percent(a, "secondaryRemainingPercent")) is not None]
        short = [v for a in members if (v := window_percent(a, "primaryRemainingPercent")) is not None]
        # Name the bottleneck of the best eligible account; retain all rejection reasons.
        limiting = max(usable, key=lambda item: item["remainingPercent"]) if usable else limits[0]
        pools.append({"id": pool_id, "accounts": len(members), "usableNow": len(usable),
                      "eligibleAccounts": len(usable), "headroomPercent": max(weekly) if weekly else None,
                      "aggregateRemainingPercent": statistics.fmean(weekly) if weekly else None,
                      "minShortWindowPercent": min(short) if short else None,
                      "status": "ok" if usable else "blocked", "limitingWindow": limiting,
                      "accountLimits": limits, "reserve": reserve})
    return {"generatedAt": now_iso(), "pools": pools, "source": "accounts"}


def fetch_pools(
    *, timeout: float = READ_TIMEOUT_SECONDS, reserve: float = 20
) -> tuple[dict[str, Any] | None, str | None]:
    accounts = http_get("/api/accounts", timeout=timeout)
    if accounts.json_ok:
        try:
            return pools_from_accounts(accounts.body, reserve), None
        except ValueError as error:
            return None, str(error)
    return None, f"accounts-refresh-failed: /api/accounts {accounts.error or accounts.status}"


def pools_by_id(document: dict[str, Any] | None) -> dict[str, dict[str, Any]]:
    if not isinstance(document, dict):
        return {}
    pools = document.get("pools")
    if not isinstance(pools, list):
        return {}
    return {pool["id"]: pool for pool in pools if isinstance(pool, dict) and isinstance(pool.get("id"), str)}


def _percent(value: Any) -> str:
    """C1 allows a null percent when a pool has no usable account; print it as such."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return "-"
    return f"{float(value):.1f}%"


def command_pools(args: argparse.Namespace) -> int:
    document, error = fetch_pools(reserve=args.reserve)
    if document is None:
        print(f"route: {error}", file=sys.stderr)
        return EXIT_DEGRADED
    if args.json:
        print(json.dumps(document, indent=2, sort_keys=True))
        return EXIT_OK
    print(f"pools at {document.get('generatedAt')} (source: {document.get('source')})")
    header = f"{'pool':<20} {'status':<10} {'headroom':>9} {'aggregate':>10} {'usable-now':>10} {'min short':>10}"
    print(header)
    print("-" * len(header))
    for pool in document.get("pools", []):
        usable = f"{pool.get('eligibleAccounts')}/{pool.get('accounts')}"
        print(
            f"{pool.get('id', '?'):<20} {pool.get('status', '?'):<10} "
            f"{_percent(pool.get('headroomPercent')):>9} {_percent(pool.get('aggregateRemainingPercent')):>10} "
            f"{usable:>10} {_percent(pool.get('minShortWindowPercent')):>10}"
        )
    return EXIT_OK


# --- pick --------------------------------------------------------------------


def pool_for_model(table: dict[str, Any], model: str) -> str | None:
    pools = table.get("pools")
    if not isinstance(pools, dict):
        return None
    exact = pools.get(model)
    if isinstance(exact, str):
        return exact
    for key, value in pools.items():
        if key.endswith("*") and model.startswith(key[:-1]) and isinstance(value, str):
            return value
    return None


def vendor_for(entry: dict[str, Any], pool: str | None) -> str | None:
    declared = entry.get("vendor")
    if isinstance(declared, str) and declared:
        return declared
    if pool:
        return pool.split("-")[0]
    return None


def read_state() -> dict[str, Any]:
    try:
        value = json.loads(state_path().read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def state_age_seconds(state: dict[str, Any]) -> float | None:
    if not state:
        return None
    stamp = _parse_ts(state.get("ts"))
    if stamp is None:
        return None
    return (datetime.now(timezone.utc) - stamp).total_seconds() if stamp.tzinfo else None


def seat_is_up(seats: Any, seat: str) -> bool:
    """A seat with no recorded state is treated as up; only a recorded failure takes it out."""
    if not isinstance(seats, dict):
        return True
    record = seats.get(seat)
    if not isinstance(record, dict):
        return True
    return record.get("ok") is not False


def _override_matches(override: Any, class_name: str, entry: dict[str, Any]) -> bool:
    if not isinstance(override, dict) or override.get("class") != class_name:
        return False
    demote = override.get("demote")
    if not isinstance(demote, dict):
        return False
    if demote.get("seat") != entry.get("seat"):
        return False
    model = demote.get("model")
    return model is None or model == entry.get("model")


def apply_overrides(chain: list[dict[str, Any]], overrides: Any, class_name: str) -> list[dict[str, Any]]:
    if not isinstance(overrides, list) or not overrides:
        return list(chain)
    kept: list[dict[str, Any]] = []
    demoted: list[dict[str, Any]] = []
    for entry in chain:
        target = demoted if any(_override_matches(o, class_name, entry) for o in overrides) else kept
        target.append(entry)
    return kept + demoted


def pick(task_class: str, *, reserve: float = 20, difficulty: float = 1,
         money_path: bool = False, author_vendor: str | None = None,
         table: dict[str, Any] | None = None) -> dict[str, Any]:
    table = load_table() if table is None else table
    spec = table.get("classes", {}).get(task_class)
    if not isinstance(spec, dict):
        fail(f"unknown class {task_class!r}")
    if spec.get("driver"):
        verification = pick("verify", reserve=reserve, money_path=True, author_vendor=author_vendor, table=table) if money_path else None
        return {"class": task_class, "seat": "driver", "model": "claude-fable-5", "effort": "high",
                "pool": None, "limitingWindow": None,
                "verifiers": verification["verifiers"] if verification else [], "fallbacks": [],
                "reason": "plan stays on the Fable driver", "state_age_s": None}
    state = read_state()
    age = state_age_seconds(state)
    stale = bool(state) and (age is None or age < 0 or age > STATE_MAX_AGE_SECONDS)
    document, error = fetch_pools(reserve=reserve)
    if document is None:
        prefix = "stale-state: older than 300s or invalid timestamp; " if stale else ""
        fail(prefix + str(error))
    seats = None if stale else state.get("seats")
    pools = pools_by_id(document)
    skipped: list[str] = []

    def admitted(entry: dict[str, Any], *, exclude_author_vendor: bool = False) -> dict[str, Any] | None:
        pool = pool_for_model(table, entry["model"])
        status = pools.get(pool, {})
        vendor = vendor_for(entry, pool)
        if exclude_author_vendor and author_vendor and vendor == author_vendor:
            skipped.append(f"{entry['seat']}/{entry['model']}: author vendor {author_vendor} excluded")
            return None
        if not seat_is_up(seats, entry["seat"]):
            skipped.append(f"{entry['seat']}: seat-down")
            return None
        model_limits = [model_account_limit(item, entry, reserve)
                        for item in status.get("accountLimits", []) if isinstance(item, dict)]
        usable = [item for item in model_limits if item.get("usable")]
        if not usable:
            reasons = "; ".join(f"{item['account']} {item['window']}: {item['reason']}"
                                for item in model_limits)
            skipped.append(
                f"{entry['seat']}/{entry['model']}: pool {pool} blocked ({reasons or 'unknown-account-data'})"
            )
            return None
        limiting = max(usable, key=lambda item: item["remainingPercent"])
        return {**entry, "effort": entry.get("effort", "medium"), "pool": pool, "vendor": vendor,
                "limitingWindow": limiting}

    chain = apply_overrides(spec.get("chain", []), table.get("overrides"), task_class)
    if task_class == "implement" and difficulty >= 4:
        chain = [entry for entry in chain if entry["model"] != "gpt-5.6-terra"]
    routable = [found for entry in chain if (found := admitted(
        entry, exclude_author_vendor=task_class == "verify"
    )) is not None]
    if not routable:
        fail(f"nothing routable for {task_class}: " + "; ".join(skipped))
    verifiers: list[dict[str, Any]] = []
    verifier: dict[str, Any] | None = None
    verifier_reason: str | None = None
    warnings: list[str] = []
    if task_class in ("implement", "mechanical", "verify") or money_path:
        verification = table["classes"]["verify"]
        verify_chain = list(verification.get("chain", []))
        money_second = verification.get("money_path_second")
        if money_path and isinstance(money_second, dict) and not any(
            entry.get("model") == money_second.get("model") for entry in verify_chain
        ):
            verify_chain.append(money_second)
        for entry in verify_chain:
            found = admitted(entry, exclude_author_vendor=author_vendor is not None)
            if found is not None:
                verifier = {**found, "required": True, "read_only": True}
                verifiers.append(verifier)
                break
        if verifier is None:
            verifier_reason = "no admitted cross-vendor verifier"
            warnings.append("verifier unavailable; implementer remains routable")
        if money_path:
            second = next((entry for entry in verify_chain if entry.get("model") == "claude-opus-5"), None)
            if isinstance(second, dict) and (verifier is None or verifier.get("model") != second.get("model")):
                found = admitted(second, exclude_author_vendor=author_vendor is not None)
                if found is None:
                    warnings.append("money-path Opus second read unavailable")
                else:
                    verifiers.append({**found, "required": False, "read_only": True})
    return {"class": task_class, **routable[0], "verifiers": verifiers, "verifier": verifier,
            "verifier_reason": verifier_reason, "warnings": warnings,
            "fallbacks": routable[1:], "state_age_s": age,
            "reason": "fresh /api/accounts; active, no current rate limit, and reported windows above reserve"
                      + ("; stale-state refreshed" if stale else ""), "skipped": skipped}


MONEY_PATH = re.compile(
    r"\b(auth\w*|rls|billing|migrations?|receipts?|idempotenc\w*|tool[ _-]boundar\w*)\b", re.I
)


def command_pick(args: argparse.Namespace) -> int:
    result = pick(args.task_class, reserve=args.reserve, money_path=bool(MONEY_PATH.search(args.task_text)),
                  author_vendor=args.author_vendor)
    _print_pick(result, as_json=args.json)
    return EXIT_OK


def _print_pick(result: dict[str, Any], *, as_json: bool) -> None:
    if as_json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return
    print(f"seat      {result['seat']}")
    print(f"model     {result['model'] or '-'}")
    print(f"pool      {result['pool'] or '-'}")
    print(f"effort    {result['effort']}")
    print(f"limiting  {json.dumps(result.get('limitingWindow'))}")
    print(f"verifiers {json.dumps(result.get('verifiers', []))}")
    age = result.get("state_age_s")
    print(f"state age {'no state file' if age is None else f'{age}s'}")
    print(f"reason    {result['reason']}")
    fallbacks = ", ".join(f"{entry['seat']}/{entry['model']}" for entry in result["fallbacks"]) or "none"
    print(f"fallbacks {fallbacks}")


# --- doctor ------------------------------------------------------------------


def _probe(name: str, started: float, *, ok: bool, error: str | None, **detail: Any) -> dict[str, Any]:
    record = {"name": name, "ok": ok, "latency_ms": int((time.monotonic() - started) * 1000), "error": error}
    record.update(detail)
    return record


def probe_lb_health() -> dict[str, Any]:
    started = time.monotonic()
    result = http_get("/api/health", timeout=4.0)
    path = "/api/health"
    if result.status == 404:
        result = http_get("/health", timeout=4.0)
        path = "/health"
    ok = result.ok and result.status == 200
    error = None if ok else (result.error or f"HTTP {result.status}")
    return _probe("lb-health", started, ok=ok, error=error, path=path)


def probe_pools() -> tuple[dict[str, Any], dict[str, Any] | None]:
    started = time.monotonic()
    document, error = fetch_pools()
    ok = document is not None
    record = _probe(
        "lb-pools",
        started,
        ok=ok,
        error=error,
        source=document.get("source") if document else None,
    )
    return record, document


def probe_command(name: str, command: list[str], timeout: float) -> dict[str, Any]:
    started = time.monotonic()
    if not command:
        return _probe(name, started, ok=False, error="probe command is empty")
    try:
        completed = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            text=True,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return _probe(name, started, ok=False, error=f"timeout after {timeout:.0f}s")
    except OSError as error:
        return _probe(name, started, ok=False, error=f"{type(error).__name__}: {error}")
    ok = completed.returncode == 0
    error = None if ok else f"exit {completed.returncode}"
    return _probe(name, started, ok=ok, error=error)


def _message_head(body: Any) -> str | None:
    """The LB's own error text, collapsed and truncated. It carries no credential."""
    if not isinstance(body, dict):
        return None
    error = body.get("error")
    message = error.get("message") if isinstance(error, dict) else None
    if not isinstance(message, str) or not message.strip():
        return None
    return " ".join(message.split())[:MESSAGE_HEAD_CHARS]


def recent_model_traffic(*, window: int = SESSION_WINDOW_MINUTES) -> dict[str, dict[str, Any]]:
    """Ground truth per model: did real traffic get through in the window?

    Real sessions beat a synthetic probe. The probe takes a fresh selection decision, which
    a per-model cooldown can refuse while established traffic keeps flowing; a 429 there says
    nothing about whether the seat works. `errors` is a session-level count and cannot be
    attributed to one model, so a session that logged more requests for the model than it
    logged errors still proves the model answers — recorded with a weaker evidence tag.
    """
    result = http_get(f"/api/sessions?windowMinutes={window}&limit=200", timeout=4.0)
    traffic: dict[str, dict[str, Any]] = {}
    if not result.json_ok or not isinstance(result.body, dict):
        return traffic
    for session in result.body.get("sessions") or []:
        if not isinstance(session, dict):
            continue
        errors = session.get("errors")
        errors = int(errors) if isinstance(errors, (int, float)) and not isinstance(errors, bool) else 0
        for entry in session.get("models") or []:
            if not isinstance(entry, dict):
                continue
            model, requests = entry.get("model"), entry.get("requests")
            if not isinstance(model, str) or isinstance(requests, bool) or not isinstance(requests, (int, float)):
                continue
            requests = int(requests)
            if requests <= 0 or requests <= errors:
                continue
            candidate = {
                "requests": requests,
                "errors": errors,
                "clean": errors == 0,
                "lastSeen": session.get("lastSeen"),
            }
            current = traffic.get(model)
            if current is None or (candidate["clean"] and not current["clean"]) or requests > current["requests"]:
                traffic[model] = candidate
    return traffic


def _pool_verdict(
    model: str, table: dict[str, Any], pools: dict[str, Any], *, note: str, latency_ms: int | None
) -> dict[str, Any]:
    """No probe signal worth trusting: fall back to whether the model's pool has capacity."""
    pool = pool_for_model(table, model)
    status = pools.get(pool, {}).get("status") if pool else None
    ok = bool(pools.get(pool, {}).get("usableNow"))
    return {
        "name": f"model:{model}",
        "ok": ok,
        "latency_ms": latency_ms,
        "error": f"pool {pool} blocked or unknown" if not ok else None,
        "evidence": "pool_status",
        "note": note,
        "pool": pool,
        "poolStatus": status,
    }


def probe_model(
    model: str,
    *,
    table: dict[str, Any],
    traffic: dict[str, dict[str, Any]],
    pools: dict[str, Any],
    allow_probe: bool = True,
) -> dict[str, Any]:
    """Decide whether a Claude seat is up. Down means broken, never merely busy."""
    name = f"model:{model}"
    recent = traffic.get(model)
    if recent is not None:
        return {
            "name": name,
            "ok": True,
            "latency_ms": None,
            "error": None,
            "evidence": "recent_success" if recent["clean"] else "recent_success_with_errors",
            "note": (
                f"{recent['requests']} request(s) on {model} in the last {SESSION_WINDOW_MINUTES}m"
                f", {recent['errors']} session error(s), last seen {recent['lastSeen']}"
            ),
        }
    if not allow_probe:
        return _pool_verdict(
            model, table, pools, note="no recent traffic; probe dropped after the 2s budget", latency_ms=None
        )

    started = time.monotonic()
    payload = {"model": model, "max_tokens": 1, "messages": [{"role": "user", "content": "ok"}]}
    result = http_post("/v1/messages", payload, timeout=PROBE_BUDGET_SECONDS)
    latency = int((time.monotonic() - started) * 1000)
    status = result.status
    head = _message_head(result.body)

    if result.ok and status == 200:
        return {"name": name, "ok": True, "latency_ms": latency, "error": None, "evidence": "probe_success"}
    if status in (401, 403):
        presence = http_get("/api/models", timeout=4.0)
        ok = presence.ok and presence.status == 200
        return {
            "name": name,
            "ok": ok,
            "latency_ms": latency,
            "error": None if ok else (presence.error or f"HTTP {presence.status}"),
            "evidence": "api_models_presence",
            "note": "/v1/messages needs a credential this probe does not hold; probed /api/models instead",
        }
    if status in (400, 404):
        return {
            "name": name,
            "ok": False,
            "latency_ms": latency,
            "error": f"HTTP {status}: {head or 'model not recognised by the LB'}",
            "evidence": "unknown_model",
        }
    if status == 429:
        return _pool_verdict(
            model, table, pools, note=f"fresh selection 429: {head or 'no account selectable'}", latency_ms=latency
        )
    if result.error == "timeout":
        return _pool_verdict(
            model, table, pools, note=f"probe exceeded the {PROBE_BUDGET_SECONDS:.0f}s budget", latency_ms=latency
        )
    return {
        "name": name,
        "ok": False,
        "latency_ms": latency,
        "error": f"HTTP {status}" if status else (result.error or "request failed"),
        "evidence": "probe_failure",
    }


def probed_models(table: dict[str, Any]) -> list[str]:
    """Distinct non-Fable Claude models in the table, in first-seen order."""
    seen: list[str] = []
    classes = table.get("classes")
    if not isinstance(classes, dict):
        return seen
    for spec in classes.values():
        if not isinstance(spec, dict):
            continue
        for entry in spec.get("chain") or []:
            model = entry.get("model") if isinstance(entry, dict) else None
            if not isinstance(model, str) or not model.startswith("claude-"):
                continue
            if "fable" in model or pool_for_model(table, model) == "anthropic-fable":
                continue
            if model not in seen:
                seen.append(model)
    return seen


def backing_probe(table: dict[str, Any], seat: str, model: str, models: list[str]) -> str:
    if seat in SEAT_PROBE:
        return SEAT_PROBE[seat]
    if model.startswith("cursor-"):
        return "cursor-agent"
    if model.startswith("gpt-"):
        return "codex-companion"
    if model in models:
        return f"model:{model}"
    return "lb-health"


def seat_states(table: dict[str, Any], probes: dict[str, dict[str, Any]], models: list[str]) -> dict[str, Any]:
    seats: dict[str, Any] = {}
    classes = table.get("classes")
    if not isinstance(classes, dict):
        return seats
    for spec in classes.values():
        if not isinstance(spec, dict):
            continue
        for entry in spec.get("chain") or []:
            if not isinstance(entry, dict):
                continue
            seat, model = entry.get("seat"), entry.get("model")
            if not isinstance(seat, str) or not isinstance(model, str):
                continue
            probe = probes.get(backing_probe(table, seat, model, models))
            if probe is None:
                continue
            record = {
                "ok": probe["ok"],
                "latency_ms": probe.get("latency_ms"),
                "error": probe.get("error"),
                "evidence": probe.get("evidence", "probe"),
            }
            if probe.get("note"):
                record["note"] = probe["note"]
            current = seats.get(seat)
            if current is None or (current["ok"] and not probe["ok"]):
                seats[seat] = record
            elif current["ok"] == probe["ok"]:
                latencies = [value for value in (current["latency_ms"], probe.get("latency_ms")) if value is not None]
                current["latency_ms"] = max(latencies) if latencies else None
    return seats


def alert_text(state: dict[str, Any]) -> str:
    down = [f"{name} ({record['error']})" for name, record in sorted(state["seats"].items()) if not record["ok"]]
    broken = [f"{probe['name']} ({probe['error']})" for probe in state["probes"] if not probe["ok"]]
    pools = state.get("pools") or {}
    thin = [
        f"{pool.get('id')} {_percent(pool.get('headroomPercent'))} ({pool.get('status')})"
        for pool in (pools.get("pools") or [])
        if pool.get("status") in ("low", "exhausted", "blocked")
    ]
    lines = [
        f"ROUTING DEGRADED at {state['ts']}",
        f"failed probes : {', '.join(broken) or 'none'}",
        f"seats down    : {', '.join(down) or 'none'}",
        f"pools thin    : {', '.join(thin) or 'none'}",
        "",
        "`route pick <class>` already routes around this. Re-run `route doctor --write` to clear.",
    ]
    return "\n".join(lines) + "\n"


def command_doctor(args: argparse.Namespace) -> int:
    started = time.monotonic()
    table = load_table()
    probes: list[dict[str, Any]] = [probe_lb_health()]
    pools_probe, pools_document = probe_pools()
    probes.append(pools_probe)
    probes.append(probe_command("cursor-agent", cursor_command(), CURSOR_TIMEOUT_SECONDS))
    probes.append(probe_command("codex-companion", codex_command(), CODEX_TIMEOUT_SECONDS))

    traffic = recent_model_traffic()
    pools = pools_by_id(pools_document)
    allow_probe = True
    models = probed_models(table)
    for model in models:
        if time.monotonic() - started > DOCTOR_BUDGET_SECONDS - PROBE_BUDGET_SECONDS:
            allow_probe = False
        probe = probe_model(model, table=table, traffic=traffic, pools=pools, allow_probe=allow_probe)
        if probe.get("evidence") == "pool_status" and "budget" in (probe.get("note") or ""):
            allow_probe = False
        probes.append(probe)

    by_name = {probe["name"]: probe for probe in probes}
    state = {
        "ts": now_iso(),
        "seats": seat_states(table, by_name, models),
        "pools": pools_document,
        "probes": probes,
        "trafficWindowMinutes": SESSION_WINDOW_MINUTES,
        "auth": "loopback_unauthenticated",
        "elapsed_s": round(time.monotonic() - started, 2),
    }
    degraded = any(not probe["ok"] for probe in probes)

    if args.write:
        atomic_write(state_path(), json.dumps(state, indent=2, sort_keys=True) + "\n")
        if degraded:
            atomic_write(alert_path(), alert_text(state))
        else:
            try:
                alert_path().unlink()
            except FileNotFoundError:
                pass
        print(f"route doctor: {'DEGRADED' if degraded else 'ok'} -> {state_path()}")
    else:
        print(json.dumps(state, indent=2, sort_keys=True))
    return EXIT_DEGRADED if degraded else EXIT_OK


# --- ledger, report, learn ---------------------------------------------------


def _parse_ts(value: Any) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def read_ledger(since: datetime) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    dispatches: list[dict[str, Any]] = []
    closeouts: list[dict[str, Any]] = []
    try:
        lines = ledger_path().read_text(encoding="utf-8").splitlines()
    except (FileNotFoundError, OSError):
        return dispatches, closeouts
    for line in lines:
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(record, dict):
            continue
        stamp = _parse_ts(record.get("ts"))
        if stamp is None or stamp < since:
            continue
        if record.get("event") == "dispatch":
            dispatches.append(record)
        elif record.get("event") == "closeout":
            closeouts.append(record)
    return dispatches, closeouts


RowKey = tuple[str, str, str]


def aggregate(dispatches: list[dict[str, Any]], closeouts: list[dict[str, Any]]) -> dict[RowKey, dict[str, Any]]:
    """Join closeouts to dispatches by (session_id, name), oldest unmatched dispatch first."""
    pending: dict[tuple[Any, Any], list[dict[str, Any]]] = {}
    rows: dict[RowKey, dict[str, Any]] = {}

    def row_for(record: dict[str, Any]) -> dict[str, Any]:
        key: RowKey = (
            str(record.get("task_class") or "unknown"),
            str(record.get("subagent_type") or "unknown"),
            str(record.get("model") or "unknown"),
        )
        return rows.setdefault(
            key,
            {
                "class": key[0],
                "seat": key[1],
                "model": key[2],
                "dispatches": 0,
                "denied": 0,
                "closeouts": 0,
                "ok": 0,
                "durations": [],
                "sessions": set(),
            },
        )

    for record in dispatches:
        row = row_for(record)
        if record.get("denied"):
            row["denied"] += 1
            continue
        row["dispatches"] += 1
        if record.get("session_id"):
            row["sessions"].add(record["session_id"])
        pending.setdefault((record.get("session_id"), record.get("name")), []).append(record)

    for record in closeouts:
        key = (record.get("session_id"), record.get("name"))
        queue = pending.get(key) or []
        origin = queue.pop(0) if queue else None
        merged = dict(record)
        if origin is not None:
            merged.setdefault("task_class", origin.get("task_class"))
            merged.setdefault("model", origin.get("model"))
            merged.setdefault("subagent_type", origin.get("subagent_type"))
        row = row_for(merged)
        row["closeouts"] += 1
        if merged.get("ok") is True:
            row["ok"] += 1
        duration = merged.get("duration_s")
        if isinstance(duration, (int, float)) and not isinstance(duration, bool):
            row["durations"].append(float(duration))
        if merged.get("session_id"):
            row["sessions"].add(merged["session_id"])
    return rows


def session_costs(session_ids: set[str]) -> dict[str, float]:
    costs: dict[str, float] = {}
    for session_id in sorted(session_ids)[:ANALYTICS_SESSION_CAP]:
        result = http_get(f"/api/sessions/{session_id}/analytics", timeout=4.0)
        if not result.json_ok or not isinstance(result.body, dict):
            continue
        session = result.body.get("session")
        cost = session.get("costUsd") if isinstance(session, dict) else None
        if isinstance(cost, (int, float)) and not isinstance(cost, bool):
            costs[session_id] = float(cost)
    return costs


def ok_rate(row: dict[str, Any]) -> float | None:
    return row["ok"] / row["closeouts"] if row["closeouts"] else None


def command_report(args: argparse.Namespace) -> int:
    since = datetime.now(timezone.utc) - timedelta(days=args.days)
    dispatches, closeouts = read_ledger(since)
    rows = aggregate(dispatches, closeouts)
    if not rows:
        print(f"No dispatches in {ledger_path()} within {args.days} day(s).")
        return EXIT_OK
    every_session: set[str] = set()
    for row in rows.values():
        every_session |= row["sessions"]
    costs = session_costs(every_session)

    print(f"# route report — {args.days} day(s) to {now_iso()}\n")
    print(f"Ledger: `{ledger_path()}` · {len(dispatches)} dispatches · {len(closeouts)} closeouts\n")
    print("| class | seat | model | dispatches | denied | closeouts | ok-rate | median s | sessions | session cost |")
    print("|---|---|---|---|---:|---:|---:|---:|---:|---:|")
    for key in sorted(rows):
        row = rows[key]
        rate = ok_rate(row)
        median = f"{statistics.median(row['durations']):.0f}" if row["durations"] else "-"
        cost = sum(costs.get(session, 0.0) for session in row["sessions"])
        cost_text = f"${cost:.2f}" if cost else "-"
        print(
            f"| {row['class']} | {row['seat']} | {row['model']} | {row['dispatches']} | {row['denied']} | "
            f"{row['closeouts']} | {'-' if rate is None else f'{rate:.0%}'} | {median} | "
            f"{len(row['sessions'])} | {cost_text} |"
        )
    if costs:
        print("\nSession cost is the whole LB session's spend; a session shared by several rows is counted in each.")
    elif every_session:
        print("\nSession cost unavailable: the LB session analytics endpoint did not answer.")
    return EXIT_OK


def proposals(rows: dict[RowKey, dict[str, Any]], *, minimum: int, floor: float) -> list[dict[str, Any]]:
    found = []
    for key in sorted(rows):
        row = rows[key]
        rate = ok_rate(row)
        if row["closeouts"] < minimum or rate is None or rate >= floor:
            continue
        found.append(
            {
                "class": row["class"],
                "demote": {"seat": row["seat"], "model": row["model"]},
                "reason": f"ok-rate {rate:.0%} over {row['closeouts']} closeouts, below the {floor:.0%} floor",
                "evidence": {
                    "closeouts": row["closeouts"],
                    "ok": row["ok"],
                    "okRate": round(rate, 3),
                    "windowDays": None,
                    "ledger": str(ledger_path()),
                },
            }
        )
    return found


def command_learn(args: argparse.Namespace) -> int:
    since = datetime.now(timezone.utc) - timedelta(days=args.days)
    dispatches, closeouts = read_ledger(since)
    rows = aggregate(dispatches, closeouts)
    found = proposals(rows, minimum=args.min_closeouts, floor=args.ok_floor)
    for proposal in found:
        proposal["evidence"]["windowDays"] = args.days
        proposal["ts"] = now_iso()

    if not found:
        print(
            f"No demotions proposed: no (class, seat, model) reached {args.min_closeouts} closeouts below "
            f"a {args.ok_floor:.0%} ok-rate in {args.days} day(s)."
        )
        return EXIT_OK

    table = load_table()
    existing = table.get("overrides")
    existing = existing if isinstance(existing, list) else []
    fresh = [
        proposal
        for proposal in found
        if not any(_override_matches(current, proposal["class"], proposal["demote"]) for current in existing)
    ]

    if not args.apply:
        print(f"# route learn — proposed overrides for {table_path()}\n")
        for proposal in found:
            state = "already present" if proposal not in fresh else "new"
            print(
                f"+ {proposal['class']}: demote {proposal['demote']['seat']}/{proposal['demote']['model']} "
                f"({proposal['reason']}) [{state}]"
            )
        print("\nRun `route learn --apply` to write these into the table's `overrides`.")
        return EXIT_OK

    if not fresh:
        print("All proposed demotions are already recorded in the table; nothing written.")
        return EXIT_OK
    table["overrides"] = existing + fresh
    atomic_write(table_path(), json.dumps(table, indent=2) + "\n")
    for proposal in fresh:
        print(f"wrote override: {proposal['class']} demotes {proposal['demote']['seat']}/{proposal['demote']['model']}")
    print(f"table: {table_path()}")
    return EXIT_OK


