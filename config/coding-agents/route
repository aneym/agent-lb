def reserve_percent(value: str) -> float:
    try:
        reserve = float(value)
    except ValueError:
        raise argparse.ArgumentTypeError("reserve must be a percentage from 0 through 100") from None
    if not math.isfinite(reserve) or not 0 <= reserve <= 100:
        raise argparse.ArgumentTypeError("reserve must be a percentage from 0 through 100")
    return reserve


def command_classify(args: argparse.Namespace) -> int:
    import route_jev

    try:
        judgment = route_jev.ask(args.task_text, args.paths)
    except route_jev.JevUnavailable as error:
        print(f"JEV UNAVAILABLE ({error})", file=sys.stderr)
        return 3
    except ValueError as error:
        fail(f"jev-invalid-answer: {error}")
    money = judgment["money_path"] or bool(MONEY_PATH.search(" ".join([args.task_text, *args.paths])))
    result = pick(judgment["class"], reserve=args.reserve, difficulty=judgment["difficulty"], money_path=money)
    result.update(judgment)
    result["money_path"] = money
    if args.command == "dispatch-line":
        header = f"[class:{result['class']}] seat={result['seat']} model={result['model']} effort={result['effort']}"
        record = {"ts": now_iso(), "event": "dispatch", "source": "route dispatch-line",
                  "session_id": os.environ.get("CLAUDE_SESSION_ID"), "subagent_type": result["seat"],
                  "model": result["model"], "effort": result["effort"], "name": None,
                  "task_class": result["class"], "cwd": os.getcwd(),
                  "prompt_sha256": hashlib.sha256(args.task_text.encode()).hexdigest(), "decision": result}
        try:
            ledger_path().parent.mkdir(parents=True, exist_ok=True)
            with ledger_path().open("a", encoding="utf-8") as handle:
                handle.write(json.dumps(record, separators=(",", ":")) + "\n")
        except OSError as error:
            fail(f"dispatch-ledger-write-failed: {error}")
        print(header)
    elif args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"class     {result['class']}")
        _print_pick(result, as_json=False)
        print(f"Jev confidence {result['jev_confidence']}")
    return EXIT_OK


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="route", description="Route a task class to a live seat.")
    sub = parser.add_subparsers(dest="command", required=True)

    pools = sub.add_parser("pools", help="pool headroom from the LB")
    pools.add_argument("--json", action="store_true")
    pools.add_argument("--reserve", type=reserve_percent, default=20)
    pools.set_defaults(handler=command_pools)

    pick = sub.add_parser("pick", help="first routable seat for a class")
    pick.add_argument("task_class", metavar="class")
    pick.add_argument(
        "--author-vendor", default=None, help="exclude same-vendor seats when picking verify or a verifier"
    )
    pick.add_argument("--json", action="store_true")
    pick.add_argument("--reserve", type=reserve_percent, default=20)
    pick.add_argument("--task-text", default="")
    pick.set_defaults(handler=command_pick)

    for name in ("classify", "dispatch-line"):
        classify = sub.add_parser(name)
        classify.add_argument("task_text")
        classify.add_argument("--paths", nargs="*", default=[])
        classify.add_argument("--reserve", type=reserve_percent, default=20)
        classify.add_argument("--json", action="store_true")
        classify.set_defaults(handler=command_classify)

    doctor = sub.add_parser("doctor", help="probe seats and pools")
    doctor.add_argument("--write", action="store_true", help="write routing-state.json and the alert")
    doctor.set_defaults(handler=command_doctor)

    report = sub.add_parser("report", help="dispatch ledger joined with LB session cost")
    report.add_argument("--days", type=int, default=7)
    report.set_defaults(handler=command_report)

    learn = sub.add_parser("learn", help="propose chain demotions from recorded outcomes")
    learn.add_argument("--apply", action="store_true", help="write the overrides into the routing table")
    learn.add_argument("--days", type=int, default=14)
    learn.add_argument("--min-closeouts", type=int, default=10, dest="min_closeouts")
    learn.add_argument("--ok-floor", type=float, default=0.6, dest="ok_floor")
    learn.set_defaults(handler=command_learn)

    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    return int(args.handler(args))


if __name__ == "__main__":
    raise SystemExit(main())
