EXIT_OK = 0
EXIT_DEGRADED = 1
EXIT_UNROUTABLE = 2

POOL_OK_HEADROOM = 25.0
POOL_LOW_HEADROOM = 5.0

DOCTOR_BUDGET_SECONDS = 55.0
CURSOR_TIMEOUT_SECONDS = 10.0
CODEX_TIMEOUT_SECONDS = 15.0
READ_TIMEOUT_SECONDS = 5.0

# The 1-token probe is a secondary signal behind real session traffic, so it gets a short
# leash: over this, it is dropped for the rest of the run and pool status decides instead.
PROBE_BUDGET_SECONDS = 2.0
SESSION_WINDOW_MINUTES = 30
MESSAGE_HEAD_CHARS = 160

