-def _native():
-    if not _NATIVE:
-        import ctypes
-
-        _NATIVE["ctypes"] = ctypes
-        _NATIVE["proc"] = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
-        _NATIVE["libc"] = ctypes.CDLL(None, use_errno=True)
-    return _NATIVE
