-            kq.control(
-                [
-                    select.kevent(
-                        pid, filter=select.KQ_FILTER_PROC, flags=select.KQ_EV_ADD | select.KQ_EV_CLEAR, fflags=flags
-                    )
-                ],
-                0,
-                0,
-            )
-            live.add(pid)
-            return True
-        except OSError:
-            return False
-
-    def freeze(pids):
