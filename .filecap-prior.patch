-
-    watching = watch(root)
-    if not watching:
-        row["why"] = "kqueue watch failed"
-    os.write(gate_w, b"x")
-    os.close(gate_w)
-    started = time.monotonic()
-    root_exit = None
-    status = None
-    try:
-        while watching:
-            now = time.monotonic()
-            if root_exit is None and now - started > timeout:
