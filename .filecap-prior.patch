-        while frontier:
-            pid, new = frontier.pop()
-            for child in child_pids(pid):
-                if child in known:
-                    continue
-                known[child] = {"parent": pid, "by_dispatcher": pid in live and runs_dispatcher(pid)}
-                freeze([child])
-                watch(child)
-                frontier.append((child, True))
-
-            if new and reaped_children(pid) is not False:
