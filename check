#!/bin/sh
set -eu

test_guard="${KIT_ROOT:-$HOME/.agent-rails/kit-runtime/current}/bin/test-guard"
if [ "${1-}" = "--staged" ]; then
    "$test_guard" --staged
else
    "$test_guard" --base origin/main
fi


comment_guard="$HOME/.agent-rails/factory-runtime/bin/no-new-comments"
if [ "${1-}" = "--staged" ]; then
    "$comment_guard" HEAD "$(git write-tree)" --repo . --no-main
else
    "$comment_guard" origin/main HEAD --repo .
fi


usage() {
  printf '%s\n' 'usage: ./check [--staged|--full]' >&2
}

mode=all
while [ "$#" -gt 0 ]; do
  case "$1" in
    --staged) mode=staged ;;
    --full) mode=full ;;
    *) usage; exit 2 ;;
  esac
  shift
done

run_step() {
  name=$1
  shift
  start=$(date +%s)
  set +e
  "$@"
  result=$?
  set -e
  elapsed=$(($(date +%s) - start))
  printf '%s: %s s\n' "$name" "$elapsed"
  return "$result"
}

run_step 'make lint' make lint
if [ "$mode" = full ]; then
  run_step 'make architecture-check' make architecture-check
  run_step 'make test-floor' make test-floor
fi
if [ "$mode" = staged ]; then
  run_step 'filecap check --staged' filecap check --staged
else
  run_step 'filecap check' filecap check --rev HEAD
fi
run_step 'feature-map check' /Volumes/StudioExt/repos/agent-plugin-kit/bin/feature-map check --repo .
