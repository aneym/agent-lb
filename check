#!/bin/sh
set -eu

gate="${AGENT_RAILS_GATE_DIR:-/Volumes/StudioExt/repos/agent-rails/tools/gate}"
css_guard="$gate/css-changed"
if [ "${1-}" = "--staged" ]; then
    "$css_guard" --staged
else
    "$css_guard"
fi

if [ -f atoms.toml ]; then
    "${FACTORY_BIN:-$HOME/.agent-rails/factory-runtime/bin}/atoms" validate --repo . --base origin/main
fi

test_guard="$gate/test-guard"
if [ "${1-}" = "--staged" ]; then
    "$test_guard" --staged
else
    "$test_guard" --base origin/main
fi


if [ "${1-}" = "--staged" ]; then
    "$gate/gate-precheck" --staged
else
    "$gate/no-new-comments" origin/main HEAD --repo .
fi


usage() {
  printf '%s\n' 'usage: ./check [--staged|--full]' >&2
}

mode=all
while [ "$#" -gt 0 ]; do
  case "$1" in
    --staged) mode=staged ;;
    --full) mode=full ;;
    *) usage; exit 2 ;;
  esac
  shift
done

run_step() {
  name=$1
  shift
  start=$(date +%s)
  set +e
  "$@"
  result=$?
  set -e
  elapsed=$(($(date +%s) - start))
  printf '%s: %s s\n' "$name" "$elapsed"
  return "$result"
}

run_step 'make lint' make lint
if [ "$mode" = full ]; then
  run_step 'make architecture-check' make architecture-check
  run_step 'make test-floor' make test-floor
fi
if [ "$mode" != staged ]; then
  run_step 'filecap check' "$gate/filecap" check --rev HEAD
fi
run_step 'feature-map check' "${FACTORY_BIN:-$HOME/.agent-rails/factory-runtime/bin}/feature-map" check --repo .
