#!/bin/sh
set -eu

resolve_gate() {
    for candidate in \
        "${AGENT_RAILS_GATE_DIR:-}" \
        "$HOME/repos/agent-rails/tools/gate" \
        /Volumes/StudioExt/repos/agent-rails/tools/gate
    do
        if [ -n "$candidate" ] && [ -d "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    if command -v modcheck >/dev/null 2>&1; then
        resolved=$(readlink -f "$(command -v modcheck)" 2>/dev/null || command -v modcheck)
        dir=$(dirname "$resolved")
        if [ -d "$dir" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
    fi
    return 0
}

gate=$(resolve_gate)

usage() {
  printf '%s\n' 'usage: ./check [--staged|--full]' >&2
}

mode=all
while [ "$#" -gt 0 ]; do
  case "$1" in
    --staged) mode=staged ;;
    --full) mode=full ;;
    *) usage; exit 2 ;;
  esac
  shift
done

if [ -n "$gate" ] && [ -x "$gate/css-changed" ]; then
    if [ "$mode" = staged ]; then
        "$gate/css-changed" --staged
    else
        "$gate/css-changed"
    fi
fi

if [ -f atoms.toml ] && command -v atoms >/dev/null 2>&1; then
    atoms validate --repo . --base origin/main
fi

if [ "$mode" = staged ]; then
    python3 scripts/test_guard.py --staged
else
    python3 scripts/test_guard.py --base origin/main
fi

run_step() {
  name=$1
  shift
  start=$(date +%s)
  set +e
  "$@"
  result=$?
  set -e
  elapsed=$(($(date +%s) - start))
  printf '%s: %s s\n' "$name" "$elapsed"
  return "$result"
}

if [ "$mode" = staged ]; then
  run_step 'lint staged' python3 scripts/lint.py --staged
  run_step 'no comments' python3 scripts/check_no_comments.py --staged ${gate:+--gate "$gate"}
else
  run_step 'make lint' make lint
  run_step 'no comments' python3 scripts/check_no_comments.py ${gate:+--gate "$gate"}
fi
if [ "$mode" = full ]; then
  run_step 'make architecture-check' make architecture-check
  run_step 'make test-floor' make test-floor
fi
if [ -n "$gate" ] && [ -x "$gate/filecap" ]; then
  if [ "$mode" = staged ]; then
    run_step 'filecap check' "$gate/filecap" check --staged
  else
    run_step 'filecap check' "$gate/filecap" check --rev HEAD
  fi
fi
if command -v feature-map >/dev/null 2>&1; then
  run_step 'feature-map check' feature-map check --repo .
fi
