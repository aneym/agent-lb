def base_url() -> str:
    url = os.environ.get("AGENT_LB_URL") or _client_env_url() or DEFAULT_BASE_URL
    return url.rstrip("/")


def _client_env_url() -> str | None:
    # A factory box has no LB on 2455; its lb-proxy install writes the box proxy URL here (2026-10-06).
    try:
        text = (Path.home() / ".config" / "agent-lb" / "client.env").read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return None
    for line in text.splitlines():
        match = re.fullmatch(r"\s*(?:export\s+)?AGENT_LB_URL\s*=\s*['\"]?(https?://[^\s'\"]+)['\"]?\s*", line)
        if match:
            return match.group(1)
    return None


def _env_path(name: str, default: Path) -> Path:
    value = (os.environ.get(name) or "").strip()
    return Path(value).expanduser() if value else default


