    ids = [value for value in ids if re.fullmatch(r"[\w.\-]+", value)]
    cache_model_list(cache, ids)
    return ids


# A stop of `route reserve` ends a model listing in at most this long; the release then has the rest of
# STOP_BUDGET_SECONDS, which stays inside seat's 10 s stop grace (seat SIGKILLs route's group after it).
LISTING_TERM_GRACE_SECONDS = 1.0
LISTING_DRAIN_SECONDS = 3.0
STOP_BUDGET_SECONDS = 8.0
_UNDRAINED: list[str] = []


def run_listing(command: list[str], timeout: float) -> str:
    """A model listing's stdout, or "" when it fails or runs past `timeout`. The listing runs in its own process
    group, which is ended as a group (end_group) on a timeout or when a stop interrupts it, so a descendant the
    listing leaves behind is ended too and no other process can be signalled."""
    try:
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL, text=True, start_new_session=True)
    except (OSError, ValueError):
        return ""
    try:
        stdout, _stderr = process.communicate(timeout=timeout)
    except BaseException as interrupted:
        if not end_group(process, LISTING_DRAIN_SECONDS):
            _UNDRAINED.append(f"model listing group {process.pid} outlived SIGKILL for {LISTING_DRAIN_SECONDS:.0f}s")
        if process.stdout is not None:
            process.stdout.close()
        if isinstance(interrupted, subprocess.TimeoutExpired):
            return ""
        raise
    return stdout if process.returncode == 0 else ""


def _signal_group(pgid: int, signum: int) -> bool:
    """killpg; False once the group is gone (ESRCH)."""
    try:
        os.killpg(pgid, signum)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def end_group(process: subprocess.Popen, within: float) -> bool:
    """End the process group `process` leads: SIGTERM the group, wait on the leader for a short grace, then SIGKILL
    the group until killpg(pgid, 0) answers ESRCH. Only killpg is used, never a pid read from a process table, so a
    pid reused by an unrelated process cannot be signalled: the group id stays allocated while any member is left,
    and the loop stops at the first ESRCH. True once the group is gone within `within` seconds; False when a member
    (a zombie no one reaps, or one in uninterruptible I/O) is still there at the deadline."""
    pgid = process.pid
    deadline = time.monotonic() + within
    _signal_group(pgid, signal.SIGTERM)
    try:
        process.wait(timeout=max(0.0, min(LISTING_TERM_GRACE_SECONDS, deadline - time.monotonic())))
    except subprocess.TimeoutExpired:
        pass
    while True:
        _signal_group(pgid, signal.SIGKILL)
        try:
            process.wait(timeout=0.05)
        except subprocess.TimeoutExpired:
            pass
        if process.returncode is not None and not _signal_group(pgid, 0):
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.05)


