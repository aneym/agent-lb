def pools_by_id(document: dict[str, Any] | None) -> dict[str, dict[str, Any]]:
    if not isinstance(document, dict):
        return {}
    pools = document.get("pools")
    if not isinstance(pools, list):
        return {}
    return {pool["id"]: pool for pool in pools if isinstance(pool, dict) and isinstance(pool.get("id"), str)}


def pool_pace(pool: dict[str, Any], cycle_hours: float) -> float | None:
    """ROUTING.md rule 1: remaining% minus the share of the cycle still ahead of the reset.

    Positive means the pool has more left than time left (spend it), negative means it is
    being spent faster than the cycle allows.
    """
    # Only the per-account weekly pace (each account against its own reset) is
    # trusted: a pool-level mean remaining paired with one reset lets an early
    # reset lift a pool that is behind, and the aggregate is capped by the
    # five-hour window. An LB without the field gets the /api/accounts figure.
    pace = pool.get("weeklyPacePercent")
    if isinstance(pace, (int, float)) and not isinstance(pace, bool):
        return float(pace)
    return None


def _pace_number(value: Any) -> float | None:
    if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value):
        return float(value)
    return None


def _pool_remaining(pool: dict[str, Any]) -> float | None:
    key = "monthlyRemainingPercent" if pool.get("windowLabel") == "month" else "weeklyRemainingPercent"
    remaining = _pace_number(pool.get(key))
    return remaining if remaining is not None else _pace_number(pool.get("aggregateRemainingPercent"))


def _pace_timestamp(value: Any) -> datetime | None:
    stamp = _parse_ts(value)
    return stamp if stamp is not None and stamp.tzinfo is not None else None


def load_pool_history(now: datetime) -> list[dict]:
    path = _env_path("ROUTE_POOL_HISTORY", Path.home() / ".claude" / "route-pool-history.jsonl")
    rows = []
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(row, dict):
                continue
            stamp = _pace_timestamp(row.get("ts"))
            if (stamp is not None and now - timedelta(hours=72) <= stamp <= now
                    and isinstance(row.get("pool"), str) and _pace_number(row.get("remaining")) is not None):
                rows.append(row)
    except (OSError, UnicodeError):
        pass
    return rows


def record_pool_history(document: dict, now: datetime) -> None:
    rows = load_pool_history(now)
    path = _env_path("ROUTE_POOL_HISTORY", Path.home() / ".claude" / "route-pool-history.jsonl")
    try:
        original_count = len(path.read_text(encoding="utf-8").splitlines())
    except (OSError, UnicodeError):
        original_count = 0
    changed = original_count != len(rows)
    newest: dict[str, datetime] = {}
    for row in rows:
        stamp = _pace_timestamp(row["ts"])
        if row["pool"] not in newest or stamp > newest[row["pool"]]:
            newest[row["pool"]] = stamp
    for pool_id, pool in pools_by_id(document).items():
        remaining = _pool_remaining(pool)
        if remaining is None or (pool_id in newest and now - newest[pool_id] < timedelta(minutes=15)):
            continue
        rows.append({"ts": now.isoformat(), "pool": pool_id, "remaining": remaining})
        changed = True
    if not changed:
        return
    try:
        atomic_write(path, "".join(json.dumps(row) + "\n" for row in rows))
    except OSError:
        pass


def pace_state(pool: dict, history: list[dict], policy: dict, now: datetime) -> dict:
    result = dict(state="unknown", remaining=None, hours_left=None, burn_per_hour=None,
                  empties_in_h=None, leftover=None, basis="none", next_refill_h=None)
    result["next_refill_h"] = pool.get("pace", {}).get("next_refill_h")
    if pool.get("status") == "exhausted":
        result["state"] = "exhausted"
        return result
    monthly = pool.get("windowLabel") == "month"
    remaining = _pool_remaining(pool)
    reset = (_pace_timestamp(pool.get("cycleResetAt" if monthly else "weeklyResetAt"))
             or _pace_timestamp(pool.get("resetAt")))
    hours_left = (reset - now).total_seconds() / 3600 if reset is not None else None
    if hours_left is not None and hours_left <= 0:
        hours_left = None
    burn = _pace_number(pool.get("burn24hPercent"))
    burn = max(0.0, burn / 24) if burn is not None else None
    if burn is None and remaining is not None:
        samples = []
        for row in history:
            if not isinstance(row, dict) or row.get("pool") != pool.get("id"):
                continue
            stamp = _pace_timestamp(row.get("ts"))
            value = _pace_number(row.get("remaining"))
            if stamp is not None and stamp <= now and value is not None:
                samples.append((stamp, value))
        samples.sort()
        baseline = next((sample for sample in samples
                         if now - timedelta(hours=28) <= sample[0] <= now - timedelta(hours=20)), None)
        if baseline is not None:
            later = [sample for sample in samples if sample[0] > baseline[0]]
            values = [baseline[1], *(sample[1] for sample in later), remaining]
            if not any(current > previous + 5 for previous, current in zip(values, values[1:])):
                elapsed = (now - baseline[0]).total_seconds() / 3600
                burn = max(0.0, (baseline[1] - remaining) / elapsed)
    result.update(remaining=remaining, hours_left=hours_left, burn_per_hour=burn)
    pace_policy = policy.get("pace") if isinstance(policy, dict) else None
    pace_policy = pace_policy if isinstance(pace_policy, dict) else {}
    thresholds = {}
    for key, default in (("rich_leftover", 15), ("behind_lt", -10), ("ahead_gt", 15)):
        value = _pace_number(pace_policy.get(key))
        thresholds[key] = default if value is None else value
    if burn is not None and remaining is not None and hours_left is not None:
        empties = remaining / burn if burn != 0 else None
        leftover = remaining - burn * hours_left
        rich_leftover = thresholds["rich_leftover"]
        state = "low" if empties is not None and empties < hours_left else (
            "rich" if leftover >= rich_leftover else "on_pace")
        result.update(state=state, empties_in_h=empties, leftover=leftover, basis="burn_24h")
    elif burn is None:
        pace = _pace_number(pool.get("monthlyPacePercent" if monthly else "weeklyPacePercent"))
        if pace is not None:
            state = "low" if pace < thresholds["behind_lt"] else (
                "rich" if pace > thresholds["ahead_gt"] else "on_pace")
            result.update(state=state, basis="pace")
    return result


def accounts_pace(pool_id: str) -> float | None:
    """Per-account weekly pace for one pool, computed from /api/accounts."""
    result = http_get("/api/accounts", timeout=3.0)
    if not result.ok or result.body is None:
        return None
    for pool in pools_from_accounts(result.body).get("pools", []):
        if pool.get("id") == pool_id:
            return pool_pace(pool, WEEKLY_CYCLE_HOURS)
    return None


def _percent(value: Any) -> str:
    """C1 allows a null percent when a pool has no usable account; print it as such."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return "-"
    return f"{float(value):.1f}%"


