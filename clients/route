    return ids


def _version_key(version: str) -> tuple[int, ...]:
    return tuple(int(part) for part in version.split("."))


def resolve_alias(table: dict[str, Any], name: str, served: list[str],
                  seat: str | None = None) -> tuple[str | None, str]:
    """resolve_one, then the alias's `fallback` alias when it yields nothing (fable-latest -> opus-latest)."""
    model, reason = resolve_one(table, name, served, seat)
    aliases = table.get("aliases") if isinstance(table.get("aliases"), dict) else {}
    fallback = (aliases.get(name) or {}).get("fallback") if isinstance(aliases.get(name), dict) else None
    if model or not isinstance(fallback, str) or fallback == name or reason.startswith(f"{name} is readmitted for"):
        return model, reason
    model, why = resolve_one(table, fallback, served, seat)
    return model, f"{reason}; fallback {fallback}: {why}"


def resolve_one(table: dict[str, Any], name: str, served: list[str],
                seat: str | None = None) -> tuple[str | None, str]:
    """(model, reason). A name that is not an alias is returned unchanged unless retired.

    A routed seat (`seat` given) reaches a readmitted alias only when it is the seat the
    `readmitted` map names; a direct `route resolve`/`route models` call has no seat."""
    retired = retired_patterns(table)
    aliases = table.get("aliases") if isinstance(table.get("aliases"), dict) else {}
    spec = aliases.get(name)
    if isinstance(spec, dict):
        readmitted = table.get("readmitted") if isinstance(table.get("readmitted"), dict) else {}
        owners = [key for key, entry in readmitted.items() if isinstance(entry, dict) and entry.get("alias") == name]
        if owners and seat is not None and seat not in owners:
            return None, f"{name} is readmitted for {', '.join(owners)} only"
        exempt = readmitted_patterns(table, name)
        retired = tuple(pattern for pattern in retired if pattern not in exempt)
    # Blocked models are gone upstream: no alias resolves to one and no readmit exempts it.
    blocked = blocked_patterns(table)
    retired = (*retired, *(pattern for pattern in blocked if pattern not in retired))
    if not isinstance(spec, dict):
        if re.search(r"-latest(?:-(?:low|medium|high|xhigh))?$", name):
            return None, f"unknown alias {name}"
        if is_retired(name, blocked):
            return None, f"{name} is no longer served (blocked)"
        if is_retired(name, retired):
            return None, f"{name} is retired"
        if "*" in name or "?" in name:
            # A wildcard is not a model a seat can be sent; it needs a family alias
            # with a served-model source before it can route.
            return None, f"{name} is a wildcard, not a served model"
        return name, "not an alias"
    if spec.get("vendor") == "anthropic" or (spec.get("harness") and not spec.get("family")):
        return resolve_claude_family(spec, retired)
    family = spec.get("family")
    if not isinstance(family, str) or not family:
        return None, f"alias {name} has no family"
    if spec.get("vendor") == "cursor":
        # Cursor families: `<family>-<version>-<variant>`, optionally `cursor-` prefixed.
        variant = spec.get("variant")
        suffix = "-" + re.escape(variant) if variant else ""
        version = r"\d+(?:-\d{1,2})?" if family.startswith("claude-") else r"\d+(?:\.\d+)*"
        pattern = re.compile(rf"^(?:cursor-)?{re.escape(family)}-({version}){suffix}$")
        served = cursor_models()
        if not served:
            return None, "Cursor model list unavailable (cursor-agent --list-models)"
    elif spec.get("vendor") == "devin":
        # Devin families: `<family>-<major>-<variant>` (swe-2-high).
        variant = spec.get("variant") or "high"
        pattern = re.compile(rf"^{re.escape(family)}-(\d+)-{re.escape(variant)}$")
        served = devin_models()
        if not served:
            return None, "Devin model list unavailable (devin models list)"
    else:
        pattern = re.compile(rf"^gpt-(\d+(?:\.\d+)*)-{re.escape(family)}$")
    candidates = []
    for model in served:
        match = pattern.match(model)
        if match and not is_retired(model, retired):
            candidates.append((_version_key(match.group(1).replace("-", ".")), model))
    if not candidates:
        return None, f"no non-retired {family} model is served"
    return max(candidates)[1], f"newest served {family}"


def _now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def append_ledger(record: dict[str, Any]) -> None:
    """Append one event to the routing ledger (dispatch.jsonl); never fail the caller."""
    try:
        path = ledger_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps({"ts": _now_iso(), **record, "cwd": os.getcwd()}, sort_keys=True) + "\n")
    except OSError:
        pass


def record_explicit_model(model: str, source: str) -> None:
    """Log an explicitly requested off-ladder model to the routing ledger."""
    append_ledger({"event": "explicit_model", "model": model, "source": source})


def command_resolve(args: argparse.Namespace) -> int:
    table = load_table()
    served, source = served_models()
    reasons = []
    unknown = []
    for name in args.aliases:
        model, reason = resolve_alias(table, name, served)
        if not model and reason == f"{name} is retired":
            # A retired id named outright is an explicit request (Alex, 2026-10-05): it resolves and
            # the ledger records it; a blocked id, gone upstream, never reaches here.
            model = name
            record_explicit_model(name, "route resolve")
        if model:
            print(model)
            return EXIT_OK
        if reason == f"unknown alias {name}":
            unknown.append(name)
        reasons.append(f"{name}: {reason}")
    if unknown:
        print(f"route: unknown alias {', '.join(unknown)}", file=sys.stderr)
        return EXIT_SETUP
    print(f"route: nothing resolvable ({'; '.join(reasons)}; models from {source})", file=sys.stderr)
    return EXIT_UNROUTABLE


def command_models(args: argparse.Namespace) -> int:
    table = load_table()
    served, source = served_models()
    aliases = table.get("aliases") if isinstance(table.get("aliases"), dict) else {}
    rows = []
    for name in aliases:
        model, reason = resolve_alias(table, name, served)
        rows.append({"alias": name, "model": model, "reason": reason})
    if args.json:
        print(json.dumps({"source": source, "aliases": rows, "retired": list(retired_patterns(table))}, indent=2))
        return EXIT_OK
    print(f"models from {source}")
    for row in rows:
        print(f"{row['alias']:<15} {row['model'] or '-':<18} {row['reason']}")
    print("retired         " + ", ".join(retired_patterns(table)))
    return EXIT_OK


