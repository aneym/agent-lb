def command_learn(args: argparse.Namespace) -> int:
    if args.override_evidence and not args.promote:
        fail("--override-evidence requires --promote")
    table = load_table(apply_default=False)
    report = learning_report(table, args.since)
    overrides = table.setdefault("overrides", [])
    changed = False
    if args.purge_legacy:
        if not args.apply:
            fail("--purge-legacy requires --apply")
        kept = [entry for entry in overrides if v2_override(entry)]
        report["purged"] = len(overrides) - len(kept)
        table["overrides"] = overrides = kept
        changed = bool(report["purged"])
    elif args.apply:
        fail("--apply is only supported with --purge-legacy; use --promote explicitly")
    if args.promote:
        class_name, arm_id = args.promote
        if not args.reason:
            fail("--promote requires --reason")
        if class_name not in report["classes"]:
            fail(f"unknown standard class: {class_name}")
        arm = next((arm for arm in learning_arms(table, class_name) if arm_key(arm) == arm_id), None)
        if arm is None:
            fail(f"unknown exploration arm: {class_name}/{arm_id}")
        if arm_id == report["classes"][class_name]["default"]:
            fail("arm is already the default")
        gate = eval_gate(class_name, arm_id, report["classes"][class_name]["default"])
        if gate["veto"] and not args.override_evidence:
            print(f"route: eval gate veto: {gate['reason']}; --override-evidence must be explicit",
                  file=sys.stderr)
            return EXIT_SETUP
        proposal = next((p for p in report["proposals"] if p["class"] == class_name
                         and p["arm_id"] == arm_id), None)
        if proposal is None and not args.override_evidence:
            fail("promotion criteria not met; --override-evidence must be explicit")
        metrics = next(row for row in report["classes"][class_name]["arms"] if row["arm_id"] == arm_id)
        entry = learning_entry(class_name, "promote", arm_id,
                               learning_evidence(metrics, args.since, table), args.reason)
        previous = table["standards"][class_name]
        entry["previous_default"] = previous
        entry["override_evidence"] = bool(args.override_evidence)
        entry["eval_gate"] = gate
        protected = {"plan", "review", "design", "audit", "judge", "ui_critical", "trust"}
        claude = str(previous.get("model", "")).startswith(("opus", "sonnet", "haiku", "claude"))
        entry["pending_alex"] = class_name in protected and claude
        if not entry["pending_alex"]:
            table["standards"][class_name] = arm
        overrides.append(entry)
        report["entry"] = entry
        changed = True
    if args.revert:
        entry = next((entry for entry in overrides if isinstance(entry, dict)
                      and entry.get("id") == args.revert and entry.get("action") == "promote"), None)
        if entry is None or entry.get("reverted_at"):
            fail("no active promotion with that id")
        if not entry.get("pending_alex"):
            if arm_key(table["standards"][entry["class"]]) != entry["arm_id"]:
                fail("a newer default is active; revert it first")
            table["standards"][entry["class"]] = entry["previous_default"]
        entry["reverted_at"] = now_iso()
        report["reverted"] = args.revert
        changed = True
    if args.apply_pauses:
        since, until = learning_window(args.since)
        outcomes = learning_outcomes(since, until)
        threshold = table.get("explore", {}).get("stop_after_nonaccepts", 3)
        if not isinstance(threshold, int) or threshold < 1:
            fail("stop_after_nonaccepts must be positive")
        for class_name, data in report["classes"].items():
            for arm in data["arms"]:
                if arm["default"] or arm["paused"]:
                    continue
                rows = [row for row in outcomes if row.get("class") == class_name
                        and row.get("arm_id") == arm["arm_id"] and attributed_outcome(row)]
                streak = 0
                longest = 0
                for row in rows:
                    streak = 0 if row["outcome"] == "accepted" else streak + 1
                    longest = max(longest, streak)
                if longest >= threshold:
                    entry = learning_entry(class_name, "pause", arm["arm_id"],
                                           learning_evidence(arm, args.since, table),
                                           f"{longest} consecutive non-accepts")
                    overrides.append(entry)
                    changed = True
    if changed:
        write_learning_table(table)
        updated = learning_report(table, args.since)
        for key in ("classes", "proposals", "vetoed", "pending_alex"):
            report[key] = updated[key]
    print(json.dumps(report, indent=2) if args.json else learning_text(report))
    return EXIT_OK

def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="route", description="Route a task class to a live seat.")
    sub = parser.add_subparsers(dest="command", required=True)

    target = sub.add_parser("target", help="T3 delegate target and admission lease for a task class",
                            description="Route through dispatch policy, then lease capacity for at most 10 minutes. "
                            "Release the lease with route release ID --outcome ok when the child starts.")
    target.add_argument("task_class", metavar="class")
    target.add_argument("--write", action="store_true", help="write child: local environment only")
    target.add_argument("--mac", action="store_true", help="require Studio")
    target.add_argument("--here", metavar="ENV_NAME", help="caller's environment; remote writes are unsupported")
    target.add_argument("--caller")
    target.add_argument("--job")
    target.add_argument("--author-vendor")
    target.add_argument("--effort", choices=("low", "medium", "high", "xhigh", "max"))
    target.add_argument("--json", action="store_true")
    target.add_argument("--dry-run", action="store_true", help="no decision log or lease")
    target.set_defaults(handler=command_target)

    quota_status = sub.add_parser("quota-mode", help="show Anthropic quota swap mode")
    quota_status.add_argument("--json", action="store_true")
    quota_status.set_defaults(handler=command_quota_mode)

    eval_seat = sub.add_parser("eval-seat", help="print the request-log seat for a decision")
    eval_seat.add_argument("decision_id")
    eval_seat.set_defaults(handler=command_eval_seat)

    pace = sub.add_parser("pace", help="Read canonical shadow pace from agent-lb")
    pace.add_argument("--json", action="store_true")
    pace.set_defaults(handler=command_pace)

    pools = sub.add_parser("pools", help="pool headroom from the LB")
    pools.add_argument("--json", action="store_true")
    pools.set_defaults(handler=command_pools)

    plan = sub.add_parser("plan", help="account recommendations from live pools and trial costs")
    plan.add_argument("--level", choices=("budget", "balanced", "unlimited"))
    plan.add_argument("--json", action="store_true")
    plan.set_defaults(handler=command_plan)

    stand_ins = sub.add_parser("stand-ins", help="sessions standing in and recent returns")
    stand_ins.add_argument("--json", action="store_true")
    stand_ins.set_defaults(handler=command_stand_ins)

    pick = sub.add_parser("pick", help="first routable seat for a class")
    pick.add_argument("task_class", metavar="class")
    pick.add_argument("--author-vendor", "--author-maker", dest="author_vendor", default=None,
                      help="required for cross_vendor classes")
    pick.add_argument("--skip", action="append", default=[], help="skip a ladder rung id")
    pick.add_argument("--prefer", default=None, help="run this rung id or seat instead of the default (needs --reason)")
    pick.add_argument("--effort", default=None, choices=("low", "medium", "high", "xhigh", "max"),
                      help="override the rung's effort (needs --reason)")
    pick.add_argument("--reason", default=None, help="why the caller overrides the default; logged to dispatch.jsonl")
    pick.add_argument("--json", action="store_true")
    pick.set_defaults(handler=command_pick)

    reservation = sub.add_parser("reserve", help="lease live provider capacity (a reservation)")
    reservation.add_argument("task_class", metavar="class")
    reservation.add_argument("--job", required=True)
    reservation.add_argument("--author-vendor", default=None)
    reservation.add_argument("--skip", action="append", default=[])
    reservation.add_argument("--prefer", default=None)
    reservation.add_argument("--model", default=None,
                             help="with --prefer: reserve the preferred rung that runs this model id or alias")
    reservation.add_argument("--reason", default=None)
    reservation.add_argument("--ttl", type=int, default=None)
    reservation.add_argument("--json", action="store_true")
    reservation.set_defaults(handler=command_reserve)

    heartbeat = sub.add_parser("heartbeat", help="renew a live reservation")
    heartbeat.add_argument("reservation_id")
    heartbeat.add_argument("--ttl", type=int, default=None)
    heartbeat.add_argument("--json", action="store_true")
    heartbeat.set_defaults(handler=command_heartbeat)

    release = sub.add_parser("release", help="end a reservation")
    release.add_argument("reservation_id")
    release.add_argument("--outcome", required=True, choices=("ok", "failed", "cancelled"))
    release.add_argument("--json", action="store_true")
    release.set_defaults(handler=command_release)

    reservations = sub.add_parser("reservations", help="list live and recent reservations")
    reservations.add_argument("--json", action="store_true")
    reservations.set_defaults(handler=command_reservations)

    menu = sub.add_parser("menu", help="every seat runnable now, per class, with pool facts")
    menu.add_argument("--class", dest="task_class", default=None, help="one class only")
    menu.add_argument("--json", action="store_true")
    menu.set_defaults(handler=command_menu)

    seat = sub.add_parser("seat", help="resolve one seat at a rules version")
    seat.add_argument("name")
    seat.add_argument("--class", dest="task_class", default=None)
    seat.add_argument("--rules", default=None)
    seat.add_argument("--json", action="store_true")
    seat.set_defaults(handler=command_seat)

    seats = sub.add_parser("seats", help="list seats, chains and auditors at a rules version")
    seats.add_argument("--rules", default=None)
    seats.add_argument("--json", action="store_true")
    seats.set_defaults(handler=command_seats)

    doctor = sub.add_parser("doctor", help="probe seats and pools")
    doctor.add_argument("--write", action="store_true", help="write routing-state.json and the alert")
    doctor.set_defaults(handler=command_doctor)

    report = sub.add_parser("report", help="dispatch ledger with subscription quota and API-equivalent value")
    report.add_argument("--days", type=int, default=7)
    report.add_argument("--implement", action="store_true", help="only the implement comparison per seat/model")
    report.set_defaults(handler=command_report)

    record = sub.add_parser("record", help="log one implement outcome for the seat comparison")
    record.add_argument("--class", dest="task_class", default="implement")
    record.add_argument("--task", required=True, help="short task id shared by the A/B arms")
    record.add_argument("--seat", required=True)
    record.add_argument("--model", required=True)
    record.add_argument("--tokens-in", dest="tokens_in", type=int, default=None)
    record.add_argument("--tokens-out", dest="tokens_out", type=int, default=None)
    record.add_argument("--wall-s", dest="wall_s", type=float, default=None)
    record.add_argument("--audit", choices=AUDIT_VERDICTS, required=True)
    record.add_argument("--rework", type=int, default=0, help="audit-fix rounds before acceptance")
    record.add_argument("--tests", default=None, help="e.g. '12 passed' or 'fail: 2'")
    record.add_argument("--notes", default=None)
    record.set_defaults(handler=command_record)

    resolve = sub.add_parser("resolve", help="newest served model for the first resolvable family alias")
    resolve.add_argument("aliases", nargs="+", metavar="alias")
    resolve.add_argument("--json", action="store_true")
    resolve.set_defaults(handler=command_resolve)

    models = sub.add_parser("models", help="every family alias and what it resolves to now")
    models.add_argument("--json", action="store_true")
    models.set_defaults(handler=command_models)

    workflow_args = sub.add_parser("workflow-args",
                                   help="JSON of agent() options per class for Workflow scripts (always JSON)")
    workflow_args.set_defaults(handler=command_workflow_args)

    dispatch = sub.add_parser("dispatch", help="one routing decision for a class, logged to route-decisions.jsonl")
    dispatch.add_argument("task_class", metavar="class")
    dispatch.add_argument("--job", default=None, help="job id; the same job keeps its first arm")
    dispatch.add_argument("--parent", default=None, help="parent decision id")
    dispatch.add_argument("--caller", default=None)
    dispatch.add_argument("--author-vendor", "--author-maker", dest="author_vendor", default=None)
    dispatch.add_argument("--seat", default=None)
    dispatch.add_argument("--exclude", action="append", default=[], metavar="SEAT")
    dispatch.add_argument("--model", default=None)
    dispatch.add_argument("--effort", default=None)
    dispatch.add_argument("--seed", type=int, default=None)
    dispatch.add_argument("--dry-run", dest="dry_run", action="store_true")
    dispatch.add_argument("--pools-file", default=None)
    dispatch.add_argument("--tag", action="append", default=[])
    dispatch.add_argument("--json", action="store_true")
    dispatch.set_defaults(handler=command_dispatch)

    outcomes = sub.add_parser("outcomes", help="outcome events and one outcome row per routed job")
    outcomes.add_argument("action", choices=("ingest", "build", "replay"))
    outcomes.add_argument("directory", nargs="?", default=None, help="fixture directory for replay")
    outcomes.add_argument("--since", default="7d")
    outcomes.add_argument("--write", action="store_true")
    outcomes.add_argument("--json", action="store_true")
    outcomes.set_defaults(handler=command_outcomes)

    policy = sub.add_parser("policy", help="the versioned routing policy")
    policy_sub = policy.add_subparsers(dest="policy_command", required=True)
    snapshot = policy_sub.add_parser("snapshot", help="standards and per-seat model and effort")
    snapshot.add_argument("--json", action="store_true")
    snapshot.set_defaults(handler=command_policy)

    learn = sub.add_parser("learn", help="propose evidence-based promotions from outcomes")
    learn.add_argument("--since", default="30d")
    learn.add_argument("--json", action="store_true")
    actions = learn.add_mutually_exclusive_group()
    actions.add_argument("--apply-pauses", action="store_true")
    actions.add_argument("--promote", nargs=2, metavar=("CLASS", "ARM_ID"))
    actions.add_argument("--revert", metavar="ID")
    actions.add_argument("--purge-legacy", action="store_true")
    learn.add_argument("--reason")
    learn.add_argument("--override-evidence", action="store_true")
    learn.add_argument("--apply", action="store_true")
    learn.set_defaults(handler=command_learn)

    standings = sub.add_parser("standings", help="show attributed routing evidence by class and arm")
    standings.add_argument("--class", dest="task_class")
    standings.add_argument("--since", default="30d")
    standings.add_argument("--source", choices=("prod", "eval", "all"), default="prod")
    standings.add_argument("--json", action="store_true")
    standings.add_argument("--mdx")
    standings.set_defaults(handler=command_standings)

    return parser.parse_args(argv)

def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    return int(args.handler(args))


if __name__ == "__main__":
    raise SystemExit(main())
