def outcome_event(kind: str, source: str, key: str, ts: datetime, decision: dict[str, Any],
                  data: dict[str, Any], job_id: str | None = None) -> dict[str, Any]:
    return {
        "v": 1,
        "event_id": outcome_event_id(source, key),
        "job_id": job_id or decision.get("job_id"),
        "decision_id": decision.get("decision_id"),
        "attempt": decision.get("attempt"),
        "parent_id": decision.get("parent_id"),
        "kind": kind,
        "ts": utc_stamp(ts),
        "source": source,
        "data": data,
    }


class DecisionIndex:
    def __init__(self, decisions: list[dict[str, Any]]) -> None:
        self.by_id = {row["decision_id"]: row for row in decisions}
        self.by_job: dict[str, list[dict[str, Any]]] = {}
        for row in decisions:
            self.by_job.setdefault(str(row.get("job_id")), []).append(row)
        for rows in self.by_job.values():
            rows.sort(key=lambda row: (row.get("attempt") or 1, str(row.get("ts") or "")))

    def lookup(self, ref: Any) -> dict[str, Any] | None:
        if not isinstance(ref, str) or not ref:
            return None
        if ref in self.by_id:
            return self.by_id[ref]
        rows = self.by_job.get(ref)
        return rows[-1] if rows else None

    def parent(self, row: dict[str, Any]) -> dict[str, Any] | None:
        parent = self.lookup(row.get("parent_id"))
        if parent is None or parent.get("job_id") == row.get("job_id"):
            return None
        return self.by_job[str(parent.get("job_id"))][0]

    def root(self, row: dict[str, Any]) -> dict[str, Any]:
        seen = {row.get("job_id")}
        current = row
        while True:
            parent = self.parent(current)
            if parent is None or parent.get("job_id") in seen:
                return current
            seen.add(parent.get("job_id"))
            current = parent


def closeout_events(src: OutcomeSources, index: DecisionIndex, start: datetime) -> list[dict[str, Any]]:
    events = []
    for row in src.ledger:
        ts = row_time(row)
        if ts is None or ts < start:
            continue
        decision = index.lookup(row.get("decision_id"))
        if decision is None:
            continue
        if row.get("event") == "closeout":
            key = f"{row.get('session_id')}|{row.get('agent_id') or row.get('name')}|{row.get('ts')}"
            data = {name: row.get(name) for name in CLOSEOUT_DATA_KEYS if name in row}
            event = outcome_event("infra" if row.get("infra_reason") else "closeout", "subagent-closeout",
                                  key, ts, decision, data)
            if isinstance(row.get("event_id"), str) and re.fullmatch(r"evt_[0-9a-f]{32}", row["event_id"]):
                event["event_id"] = row["event_id"]
            events.append(event)
        elif row.get("event") == "route_fallback" or isinstance(row.get("fallback"), dict):
            fallback = row.get("fallback") if isinstance(row.get("fallback"), dict) else row
            data = {"fallback": {"seat": fallback.get("seat"), "model": fallback.get("model"),
                                 "reason": fallback.get("reason")},
                    "pool_pct": number_or_none(row.get("pool_pct"))}
            events.append(outcome_event("infra", "route-fallback",
                                        f"{row.get('decision_id')}|{row.get('ts')}|{fallback.get('seat')}",
                                        ts, decision, data))
    return events


def merge_events(src: OutcomeSources, index: DecisionIndex, start: datetime) -> list[dict[str, Any]]:
    events = []
    for receipt in src.receipts:
        ts = row_time(receipt)
        status = str(receipt.get("status") or "merged").lower()
        if ts is None or ts < start or status in MERGE_REFUSED:
            continue
        merge_sha = receipt.get("merged_sha")
        if not isinstance(merge_sha, str) or not merge_sha:
            continue
        commits = [commit for commit in receipt.get("commits") or [] if isinstance(commit, dict)]
        if not commits and receipt.get("dispatch_ids"):
            commits = [{"sha": merge_sha, "dispatch_ids": receipt.get("dispatch_ids")}]
        for commit in commits:
            commit_sha = str(commit.get("sha") or merge_sha)
            for ref in commit.get("dispatch_ids") or []:
                decision = index.lookup(ref)
                if decision is None:
                    continue
                data = {"merge_sha": merge_sha, "commit_sha": commit_sha, "branch": receipt.get("branch"),
                        "repo": receipt.get("repo")}
                events.append(outcome_event("merge", "studio-merge", f"{merge_sha}|{commit_sha}|{ref}",
                                            ts, decision, data))
    return events


def revert_events(src: OutcomeSources, merges: list[dict[str, Any]], index: DecisionIndex,
                  start: datetime) -> list[dict[str, Any]]:
    events = []
    for row in src.reverts:
        ts = row_time(row)
        reverted = row.get("reverts")
        targets = [reverted] if isinstance(reverted, str) else [ref for ref in reverted or [] if isinstance(ref, str)]
        if ts is None or ts < start or not targets:
            continue
        for merge in merges:
            shas = (merge["data"].get("merge_sha") or "", merge["data"].get("commit_sha") or "")
            hit = next((target for target in targets if any(sha.startswith(target) or target.startswith(sha)
                                                              for sha in shas if sha)), None)
            if hit is None:
                continue
            decision = index.lookup(merge.get("decision_id")) or {}
            events.append(outcome_event("revert", "git-revert", f"{row.get('sha')}|{merge['job_id']}", ts, decision,
                                        {"revert_sha": row.get("sha"), "reverted_sha": hit}))
    return events


def repair_events(index: DecisionIndex, start: datetime) -> list[dict[str, Any]]:
    events = []
    for row in index.by_id.values():
        ts = row_time(row)
        if ts is None or ts < start or (row.get("attempt") or 1) != 1:
            continue
        parent = index.parent(row)
        if parent is None:
            continue
        root = index.root(row)
        kind = "repair" if row.get("seat") == parent.get("seat") and row.get("class") == parent.get("class") \
            else "escalation"
        events.append(outcome_event(kind, "route-decisions", str(row["decision_id"]), ts, row,
                                    {"child_job": row.get("job_id"), "parent_job": parent.get("job_id"),
                                     "root_decision": root.get("decision_id")}, job_id=str(root.get("job_id"))))
    return events


def collect_outcome_events(src: OutcomeSources, since: timedelta | None) -> list[dict[str, Any]]:
    start = src.now - since if since is not None else datetime.min.replace(tzinfo=timezone.utc)
    index = DecisionIndex(src.decisions)
    merges = merge_events(src, index, start)
    seeds = [row for row in src.seeds if row.get("v") == 1 and isinstance(row.get("event_id"), str)]
    return (closeout_events(src, index, start) + merges + revert_events(src, merges, index, start)
            + repair_events(index, start) + seeds)


def worker_cost_source(table: dict[str, Any], seat: str | None, model: str | None) -> str:
    seat = (seat or "").lower()
    if seat.startswith("cursor-"):
        return "cursor_pool"
    if seat.startswith(("muse-", "devin-")):
        return "subscription"
    vendor = alias_vendor(table, model) if model else None
    if vendor == "cursor":
        return "cursor_pool"
    if vendor in SUBSCRIPTION_VENDORS:
        return "subscription"
    return "request_logs"


def log_value(row: dict[str, Any], *keys: str) -> Any:
    for key in keys:
        if key in row:
            return row[key]
    return None


def summed_part(part: str, rows: list[dict[str, Any]]) -> dict[str, Any]:
    costs = []
    for row in rows:
        cost = number_or_none(log_value(row, "cost_usd", "costUsd"))
        tokens = number_or_none(row.get("tokens")) or sum(
            number_or_none(log_value(row, *keys)) or 0
            for keys in (("input_tokens", "inputTokens"), ("output_tokens", "outputTokens")))
        costs.append(None if cost == 0 and tokens > 0 else cost)
    if not rows or any(cost is None for cost in costs):
        return {"part": part, "source": "unknown", "usd": None}
    return {"part": part, "source": "request_logs", "usd": round(sum(costs), 6)}


def pool_part(part: str, source: str, pool_pct: float | None) -> dict[str, Any]:
    entry: dict[str, Any] = {"part": part, "source": source, "usd": None}
    if source == "cursor_pool":
        entry["pool_pct"] = pool_pct
    return entry


class JobView:
    def __init__(self, job_id: str, decisions: list[dict[str, Any]], events: list[dict[str, Any]]) -> None:
        self.job_id = job_id
        self.decisions = decisions
        self.first = decisions[0]
        self.events = sorted(events, key=lambda event: (event["ts"], event["event_id"]))

    def kind(self, *kinds: str) -> list[dict[str, Any]]:
        return [event for event in self.events if event["kind"] in kinds]

    def fallback(self) -> dict[str, Any] | None:
        for event in reversed(self.kind("infra", "closeout")):
            value = event["data"].get("fallback")
            if isinstance(value, dict) and (value.get("seat") or value.get("model")):
                return {"seat": value.get("seat"), "model": value.get("model"), "reason": value.get("reason")}
        return None

    def latest(self, key: str) -> Any:
        for event in reversed(self.kind("closeout", "infra")):
            value = event["data"].get(key)
            if value not in (None, "", []):
                return value
        return None

    def tagged(self, key: str) -> Any:
        for event in reversed(self.kind("verdict", "closeout")):
            value = event[key] if key in event else event["data"].get(key)
            if value not in (None, "", []):
                return value
        return None

    def session_ids(self, decision_id: str | None = None) -> list[str]:
        found: set[str] = set()
        for event in self.kind("closeout", "infra"):
            if decision_id is None or event.get("decision_id") == decision_id:
                found.update(item for item in event["data"].get("session_ids") or [] if isinstance(item, str) and item)
        return sorted(found)


def eval_seat_id(decision_id: str) -> str:
    return "eval." + decision_id[len("dcn_"):].lower()


def command_eval_seat(args: argparse.Namespace) -> int:
    print(eval_seat_id(args.decision_id))
    return EXIT_OK


def job_own_parts(table: dict[str, Any], view: JobView, logs: list[dict[str, Any]]) -> list[dict[str, Any]]:
    fallback = view.fallback()
    seat = (fallback or {}).get("seat") or view.first.get("seat")
    model = (fallback or {}).get("model") or view.first.get("model_alias")
    source = worker_cost_source(table, seat, model)
    worker_vendor = alias_vendor(table, model) if model else None
    wrapper = view.latest("wrapper_model") or view.first.get("wrapper_model")
    pool_pct = number_or_none(view.latest("pool_pct"))
    has_wrapper = bool(wrapper) and not (source == "request_logs" and worker_vendor == "anthropic")
    parts = []
    for decision in view.decisions:
        decision_id = decision.get("decision_id")
        sessions = set(view.session_ids(decision_id))
        rows = [row for row in logs
                if log_value(row, "caller_seat", "callerSeat") in (decision_id, eval_seat_id(decision_id))
                or (sessions and log_value(row, "session_id", "sessionId") in sessions)]
        wrapper_rows = [row for row in rows if has_wrapper
                        and str(log_value(row, "model") or "").startswith("claude-")]
        worker_rows = [row for row in rows if not any(row is other for other in wrapper_rows)]
        if (decision.get("attempt") or 1) > 1:
            if source == "request_logs":
                parts.append(summed_part("retry", rows))
            else:
                parts.append(pool_part("retry", source, pool_pct))
                if has_wrapper:
                    parts.append(summed_part("retry", wrapper_rows))
            continue
        parts.append(summed_part("worker", worker_rows) if source == "request_logs"
                     else pool_part("worker", source, pool_pct))
        if has_wrapper:
            parts.append(summed_part("wrapper", wrapper_rows))
    return parts


def parts_total(parts: list[dict[str, Any]]) -> tuple[float | None, float]:
    known = round(sum(part["usd"] for part in parts if part["usd"] is not None), 6)
    return (known if all(part["usd"] is not None for part in parts) else None), known


def job_status(view: JobView, index: DecisionIndex, now: datetime) -> tuple[str, str]:
    cls = str(view.first.get("class"))
    closeouts = view.kind("closeout")
    merges = view.kind("merge")
    failures = [event for event in view.kind("infra") if event["data"].get("infra_reason")]
    rule = ("merged_no_repair_72h" if cls in MERGE_CLASSES else "verdict_matches" if cls in VERDICT_CLASSES
            else "metric_moved" if cls in METRIC_CLASSES else "closeout_ok_no_redispatch_2h")
    if not closeouts and not merges:
        return ("infra_failure" if failures else "pending"), rule
    last_attempt = max((decision.get("attempt") or 1) for decision in view.decisions)
    last_close = closeouts[-1] if closeouts else None
    awaiting = last_close is None or (last_close.get("attempt") or 1) < last_attempt
    failed = last_close is not None and not last_close["data"].get("ok", False) and not awaiting
    if rule == "merged_no_repair_72h":
        merged_at = _parse_ts(merges[0]["ts"]) if merges else None
        horizon = merged_at + REPAIR_WINDOW if merged_at else None
        trouble = [event for event in view.kind("repair", "escalation", "revert")
                   if horizon is None or _parse_ts(event["ts"]) <= horizon]
        if trouble:
            return "rejected", rule
        if merged_at is not None:
            return ("accepted" if now >= horizon else "pending"), rule
        return ("rejected" if failed else "pending"), rule
    if view.kind("repair", "escalation"):
        return "rejected", rule
    if rule == "verdict_matches":
        verdicts = view.kind("verdict")
        if verdicts:
            data = verdicts[-1]["data"]
            matches = data["matches"] if isinstance(data.get("matches"), bool) else (
                data.get("verdict") is not None and data.get("verdict") == data.get("expected"))
            return ("accepted" if matches else "rejected"), rule
        return ("rejected" if failed else "pending"), rule
    if rule == "metric_moved":
        metrics = view.kind("metric")
        if metrics:
            data = metrics[-1]["data"]
            delta = number_or_none(data.get("delta"))
            if delta is None and number_or_none(data.get("before")) is not None:
                after = number_or_none(data.get("after"))
                delta = after - float(data["before"]) if after is not None else None
            moved = delta is not None and ((delta > 0) if data.get("direction") == "up" else (delta < 0)
                                           if data.get("direction") == "down" else False)
            return ("accepted" if moved else "rejected"), rule
        return ("rejected" if failed else "pending"), rule
    if failed:
        return "rejected", rule
    if awaiting or last_close is None:
        return "pending", rule
    closed_at = _parse_ts(last_close["ts"])
    caller = view.first.get("caller")
    if caller:
        for rows in index.by_job.values():
            other = rows[0]
            stamp = row_time(other)
            if (other.get("job_id") != view.job_id and other.get("caller") == caller
                    and other.get("class") == cls and stamp is not None
                    and closed_at < stamp <= closed_at + REDISPATCH_WINDOW):
                return "rejected", rule
    return ("accepted" if now >= closed_at + REDISPATCH_WINDOW else "pending"), rule


def build_outcomes(table: dict[str, Any], events: list[dict[str, Any]], decisions: list[dict[str, Any]],
                   logs: list[dict[str, Any]], now: datetime) -> list[dict[str, Any]]:
    index = DecisionIndex([row for row in decisions if row.get("v") == 1 and row.get("decision_id")])
    unique: dict[str, dict[str, Any]] = {}
    for event in events:
        unique.setdefault(event["event_id"], event)
    by_job: dict[str, list[dict[str, Any]]] = {}
    for event in unique.values():
        by_job.setdefault(str(event.get("job_id")), []).append(event)
    views = {job: JobView(job, rows, by_job.get(job, [])) for job, rows in index.by_job.items()}
    own = {job: job_own_parts(table, view, logs) for job, view in views.items()}
    children: dict[str, list[str]] = {}
    for view in views.values():
        for event in view.kind("repair", "escalation"):
            child = event["data"].get("child_job")
            if isinstance(child, str) and child in views and child != view.job_id:
                children.setdefault(view.job_id, []).append(child)
    rows = []
    for job, view in sorted(views.items()):
        status, rule = job_status(view, index, now)
        parts = list(own[job])
        for child in sorted(set(children.get(job, []))):
            child_cost, _ = parts_total(own[child])
            parts.append({"part": "repair", "source": "request_logs" if child_cost is not None else "unknown",
                          "usd": child_cost})
        cost, known = parts_total(parts)
        fallback = view.fallback()
        walls = [number_or_none(event["data"].get("wall_s")) for event in view.kind("closeout", "infra")]
        walls = [wall for wall in walls if wall is not None]
        infra = [event["data"].get("infra_reason") or (event["data"].get("fallback") or {}).get("reason")
                 for event in view.kind("infra")]
        infra = [reason for reason in infra if reason]
        settled = {event.get("decision_id") for event in view.kind("closeout", "infra")}
        first = view.first
        row = {
            "v": 1,
            "job_id": job,
            "decision_ids": [str(decision["decision_id"]) for decision in view.decisions],
            "class": str(first.get("class")),
            "arm": first.get("arm") if first.get("arm") in ("default", "explore", "explicit") else "default",
            "arm_id": str(first.get("arm_id") or "standard"),
            "propensity": float(first.get("propensity", 1.0)),
            "policy_rev": str(first.get("policy_rev") or "unversioned"),
            "seat": str(first.get("seat")),
            "worker_model": view.latest("worker_model") or (fallback or {}).get("model") or first.get("model"),
            "worker_effort_requested": first.get("effort"),
            "worker_effort_effective": view.latest("worker_effort"),
            "wrapper_model": view.latest("wrapper_model") or first.get("wrapper_model"),
            "fallback": fallback,
            "status": status,
            "outcome": status,
            "ts": view.events[-1]["ts"] if view.events else first.get("ts"),
            "eligible_arms": first.get("eligible_arms", []),
            "success_rule": rule,
            "repairs": len(view.kind("repair")),
            "escalations": len(view.kind("escalation")),
            "infra_reason": infra[-1] if infra else None,
            "merge_shas": sorted({str(event["data"].get("merge_sha")) for event in view.kind("merge")}),
            "cost_usd": cost,
            "cost_known_usd": known,
            "cost_known": cost is not None,
            "cost_parts": parts,
            "attribution_complete": cost is not None and all(
                decision.get("decision_id") in settled for decision in view.decisions),
            "wall_s": round(sum(walls), 1) if walls else None,
            "session_ids": view.session_ids(),
            "evidence": [event["event_id"] for event in view.events],
        }
        if view.tagged("source") == "eval":
            row["source"] = "eval"
        for key in ("task_version", "validation_hash", "eligible_arms"):
            value = view.tagged(key)
            if value is not None:
                row[key] = value
        rows.append(row)
    return rows


def outcome_lines(rows: list[dict[str, Any]]) -> str:
    return "".join(json.dumps(row, sort_keys=True) + "\n" for row in rows)


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temp.write_text(text, encoding="utf-8")
    os.replace(temp, path)


def stored_events(path: Path) -> list[dict[str, Any]]:
    return [row for row in read_jsonl(path) if row.get("v") == 1 and isinstance(row.get("event_id"), str)]


def ingest_outcomes(table: dict[str, Any], src: OutcomeSources, since: timedelta | None, events_file: Path,
                    outcomes_file: Path, write: bool) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    existing = stored_events(events_file)
    seen = {row["event_id"] for row in existing}
    fresh = []
    for event in collect_outcome_events(src, since):
        if event["event_id"] not in seen:
            seen.add(event["event_id"])
            fresh.append(event)
    outcomes = build_outcomes(table, existing + fresh, src.decisions, src.request_logs, src.now)
    if write:
        if fresh:
            events_file.parent.mkdir(parents=True, exist_ok=True)
            with events_file.open("a", encoding="utf-8") as handle:
                handle.write("".join(json.dumps(event, sort_keys=True) + "\n" for event in fresh))
        write_atomic(outcomes_file, outcome_lines(outcomes))
    return fresh, outcomes


def outcome_summary(outcomes: list[dict[str, Any]]) -> dict[str, int]:
    counts: dict[str, int] = {}
    for row in outcomes:
        counts[row["status"]] = counts.get(row["status"], 0) + 1
    return dict(sorted(counts.items()))


def print_outcomes(document: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(document, sort_keys=True))
        return
    for row in document.get("outcomes", []):
        cost = "?" if row["cost_usd"] is None else f"${row['cost_usd']:.2f}"
        print(f"{row['job_id']} {row['class']} {row['seat']} {row['status']} {cost}")
    print(" ".join(f"{key}={value}" for key, value in document.get("summary", {}).items()) or "no jobs")


def command_outcomes(args: argparse.Namespace) -> int:
    table = load_table()
    if args.action == "replay":
        if not args.directory or not Path(args.directory).is_dir():
            print(f"route: outcomes replay needs a fixture directory, got {args.directory!r}", file=sys.stderr)
            return EXIT_UNROUTABLE
        src = replay_sources(Path(args.directory))
        with tempfile.TemporaryDirectory(prefix="route-outcomes-") as scratch:
            events_file = Path(scratch) / "outcome-events.jsonl"
            outcomes_file = Path(scratch) / "outcomes.jsonl"
            first_new, _ = ingest_outcomes(table, src, None, events_file, outcomes_file, True)
            first_text = outcomes_file.read_text(encoding="utf-8")
            second_new, outcomes = ingest_outcomes(table, src, None, events_file, outcomes_file, True)
            idempotent = outcomes_file.read_text(encoding="utf-8") == first_text and not second_new
            events = stored_events(events_file)
        document = {"now": utc_stamp(src.now), "idempotent": idempotent, "events": events,
                    "new_events": [len(first_new), len(second_new)], "outcomes": outcomes,
                    "summary": outcome_summary(outcomes)}
        print_outcomes(document, args.json)
        return EXIT_OK if idempotent else EXIT_DEGRADED
    if args.directory:
        print(f"route: outcomes {args.action} takes no directory", file=sys.stderr)
        return EXIT_UNROUTABLE
    try:
        since = parse_since(args.since)
    except ValueError as error:
        print(f"route: {error}", file=sys.stderr)
        return EXIT_UNROUTABLE
    src = live_sources(since)
    if args.action == "ingest":
        fresh, outcomes = ingest_outcomes(table, src, since, outcome_events_path(), outcomes_path(), args.write)
        document = {"new_events": len(fresh), "written": args.write, "outcomes": outcomes,
                    "summary": outcome_summary(outcomes)}
    else:
        outcomes = build_outcomes(table, stored_events(outcome_events_path()), src.decisions, src.request_logs,
                                  src.now)
        if args.write:
            write_atomic(outcomes_path(), outcome_lines(outcomes))
        document = {"written": args.write, "outcomes": outcomes, "summary": outcome_summary(outcomes)}
    print_outcomes(document, args.json)
    return EXIT_OK


# --- doctor ------------------------------------------------------------------


def _probe(name: str, started: float, *, ok: bool, error: str | None, **detail: Any) -> dict[str, Any]:
    record = {"name": name, "ok": ok, "latency_ms": int((time.monotonic() - started) * 1000), "error": error}
    record.update(detail)
    return record


LB_HEALTH_ATTEMPTS = 3
LB_HEALTH_RETRY_SECONDS = 5.0


def probe_lb_health() -> dict[str, Any]:
    # A single miss must not mark every Claude seat down until the next
    # 30-minute doctor run: on 2026-09-25 one probe landed inside a routine
    # LB restart and `route pick` refused all Claude seats for 16 minutes.
    started = time.monotonic()
    for attempt in range(LB_HEALTH_ATTEMPTS):
        result = http_get("/api/health", timeout=4.0)
        path = "/api/health"
        if result.status == 404:
            result = http_get("/health", timeout=4.0)
            path = "/health"
        ok = result.ok and result.status == 200
        if ok or attempt == LB_HEALTH_ATTEMPTS - 1:
            break
        time.sleep(LB_HEALTH_RETRY_SECONDS)
    error = None if ok else (result.error or f"HTTP {result.status}")
    return _probe("lb-health", started, ok=ok, error=error, path=path, attempts=attempt + 1)


def probe_pools() -> tuple[dict[str, Any], dict[str, Any] | None]:
    started = time.monotonic()
    document, error = fetch_pools()
    ok = document is not None
    record = _probe(
        "lb-pools",
        started,
        ok=ok,
        error=error,
        source=document.get("source") if document else None,
    )
    return record, document


def probe_command(name: str, command: list[str], timeout: float) -> dict[str, Any]:
    started = time.monotonic()
    if not command:
        return _probe(name, started, ok=False, error="probe command is empty")
    try:
        completed = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            text=True,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return _probe(name, started, ok=False, error=f"timeout after {timeout:.0f}s")
    except OSError as error:
        return _probe(name, started, ok=False, error=f"{type(error).__name__}: {error}")
    ok = completed.returncode == 0
    error = None if ok else f"exit {completed.returncode}"
    return _probe(name, started, ok=ok, error=error)


def _message_head(body: Any) -> str | None:
    """The LB's own error text, collapsed and truncated. It carries no credential."""
    if not isinstance(body, dict):
        return None
    error = body.get("error")
    message = error.get("message") if isinstance(error, dict) else None
    if not isinstance(message, str) or not message.strip():
        return None
    return " ".join(message.split())[:MESSAGE_HEAD_CHARS]


def recent_model_traffic(*, window: int = SESSION_WINDOW_MINUTES) -> dict[str, dict[str, Any]]:
    """Ground truth per model: did real traffic get through in the window?

    Real sessions beat a synthetic probe. The probe takes a fresh selection decision, which
    a per-model cooldown can refuse while established traffic keeps flowing; a 429 there says
    nothing about whether the seat works. `errors` is a session-level count and cannot be
    attributed to one model, so a session that logged more requests for the model than it
    logged errors still proves the model answers — recorded with a weaker evidence tag.
    """
    result = http_get(f"/api/sessions?windowMinutes={window}&limit=200", timeout=4.0)
    traffic: dict[str, dict[str, Any]] = {}
    if not result.json_ok or not isinstance(result.body, dict):
        return traffic
    for session in result.body.get("sessions") or []:
        if not isinstance(session, dict):
            continue
        errors = session.get("errors")
        errors = int(errors) if isinstance(errors, (int, float)) and not isinstance(errors, bool) else 0
        for entry in session.get("models") or []:
            if not isinstance(entry, dict):
                continue
            model, requests = entry.get("model"), entry.get("requests")
            if not isinstance(model, str) or isinstance(requests, bool) or not isinstance(requests, (int, float)):
                continue
            requests = int(requests)
            if requests <= 0 or requests <= errors:
                continue
            candidate = {
                "requests": requests,
                "errors": errors,
                "clean": errors == 0,
                "lastSeen": session.get("lastSeen"),
            }
            current = traffic.get(model)
            if current is None or (candidate["clean"] and not current["clean"]) or requests > current["requests"]:
                traffic[model] = candidate
    return traffic


def _pool_verdict(
    model: str, table: dict[str, Any], pools: dict[str, Any], *, note: str, latency_ms: int | None
) -> dict[str, Any]:
    """No probe signal worth trusting: fall back to whether the model's pool has capacity."""
    pool = pool_for_model(table, model)
    status = pools.get(pool, {}).get("status") if pool else None
    ok = status != "exhausted"
    return {
        "name": f"model:{model}",
        "ok": ok,
        "latency_ms": latency_ms,
        "error": f"pool {pool} exhausted" if not ok else None,
        "evidence": "pool_status",
        "note": note,
        "pool": pool,
        "poolStatus": status,
    }


def probe_model(
    model: str,
    *,
    table: dict[str, Any],
    traffic: dict[str, dict[str, Any]],
    pools: dict[str, Any],
    allow_probe: bool = True,
) -> dict[str, Any]:
    """Decide whether a Claude seat is up. Down means broken, never merely busy."""
    name = f"model:{model}"
    recent = traffic.get(model)
    if recent is not None:
        return {
            "name": name,
            "ok": True,
            "latency_ms": None,
            "error": None,
            "evidence": "recent_success" if recent["clean"] else "recent_success_with_errors",
            "note": (
                f"{recent['requests']} request(s) on {model} in the last {SESSION_WINDOW_MINUTES}m"
                f", {recent['errors']} session error(s), last seen {recent['lastSeen']}"
            ),
        }
    if not allow_probe:
        return _pool_verdict(
            model, table, pools, note="no recent traffic; probe dropped after the 2s budget", latency_ms=None
        )

    started = time.monotonic()
    payload = {"model": model, "max_tokens": 1, "messages": [{"role": "user", "content": "ok"}]}
    result = http_post("/v1/messages", payload, timeout=PROBE_BUDGET_SECONDS)
    latency = int((time.monotonic() - started) * 1000)
    status = result.status
    head = _message_head(result.body)

    if result.ok and status == 200:
        return {"name": name, "ok": True, "latency_ms": latency, "error": None, "evidence": "probe_success"}
    if status in (401, 403):
        presence = http_get("/api/models", timeout=4.0)
        ok = presence.ok and presence.status == 200
        return {
            "name": name,
            "ok": ok,
            "latency_ms": latency,
            "error": None if ok else (presence.error or f"HTTP {presence.status}"),
            "evidence": "api_models_presence",
            "note": "/v1/messages needs a credential this probe does not hold; probed /api/models instead",
        }
    if status in (400, 404):
        return {
            "name": name,
            "ok": False,
            "latency_ms": latency,
            "error": f"HTTP {status}: {head or 'model not recognised by the LB'}",
            "evidence": "unknown_model",
        }
    if status == 429:
        return _pool_verdict(
            model, table, pools, note=f"fresh selection 429: {head or 'no account selectable'}", latency_ms=latency
        )
    if result.error == "timeout":
        return _pool_verdict(
            model, table, pools, note=f"probe exceeded the {PROBE_BUDGET_SECONDS:.0f}s budget", latency_ms=latency
        )
    return {
        "name": name,
        "ok": False,
        "latency_ms": latency,
        "error": f"HTTP {status}" if status else (result.error or "request failed"),
        "evidence": "probe_failure",
    }


def probed_models(table: dict[str, Any]) -> list[str]:
    """Distinct non-Fable Claude models in the table, in first-seen order."""
    seen: list[str] = []
    classes = table.get("classes")
    if not isinstance(classes, dict):
        return seen
    for spec in classes.values():
        if not isinstance(spec, dict):
            continue
        for entry in spec.get("chain") or []:
            model = entry.get("model") if isinstance(entry, dict) else None
            if not isinstance(model, str) or not model.startswith("claude-"):
                continue
            if "fable" in model or pool_for_model(table, model) == "anthropic-fable":
                continue
            if model not in seen:
                seen.append(model)
    return seen


def backing_probe(table: dict[str, Any], seat: str, model: str, models: list[str]) -> str:
    if seat in SEAT_PROBE:
        return SEAT_PROBE[seat]
    if model.startswith("cursor-"):
        return "cursor-agent"
    alias = (table.get("aliases") or {}).get(model) if isinstance(table.get("aliases"), dict) else None
    if model.startswith("gpt-") or (isinstance(alias, dict) and alias.get("vendor") == "openai"):
        return "codex-companion"
    if model in models:
        return f"model:{model}"
    return "lb-health"


def seat_states(table: dict[str, Any], probes: dict[str, dict[str, Any]], models: list[str]) -> dict[str, Any]:
    seats: dict[str, Any] = {}
    classes = table.get("classes")
    if not isinstance(classes, dict):
        return seats
    for spec in classes.values():
        if not isinstance(spec, dict):
            continue
        for entry in spec.get("chain") or []:
            if not isinstance(entry, dict):
                continue
            seat, model = entry.get("seat"), entry.get("model")
            if not isinstance(seat, str) or not isinstance(model, str):
                continue
            probe = probes.get(backing_probe(table, seat, model, models))
            if probe is None:
                continue
            record = {
                "ok": probe["ok"],
                "latency_ms": probe.get("latency_ms"),
                "error": probe.get("error"),
                "evidence": probe.get("evidence", "probe"),
            }
            if probe.get("note"):
                record["note"] = probe["note"]
            current = seats.get(seat)
            if current is None or (current["ok"] and not probe["ok"]):
                seats[seat] = record
            elif current["ok"] == probe["ok"]:
                latencies = [value for value in (current["latency_ms"], probe.get("latency_ms")) if value is not None]
                current["latency_ms"] = max(latencies) if latencies else None
    return seats


def apply_cli_seat_holds(seats: dict[str, Any], previous: dict[str, Any]) -> None:
    """Count consecutive CLI-probe failures per CLI seat across doctor runs; hold a seat only from the
    CLI_SEAT_HOLD_AFTER_FAILURES-th, until a short deadline. A stale previous state counts from zero."""
    age = state_age_seconds(previous)
    fresh = age is not None and age <= STATE_MAX_AGE_SECONDS
    prior_seats = previous.get("seats") if fresh and isinstance(previous.get("seats"), dict) else {}
    now = datetime.now(timezone.utc)
    for seat in SEAT_PROBE:
        record = seats.get(seat)
        if not isinstance(record, dict) or record["ok"]:
            continue
        prior = prior_seats.get(seat)
        count = prior.get("failures") if isinstance(prior, dict) else None
        failures = (count if isinstance(count, int) and not isinstance(count, bool) else 0) + 1
        record["failures"] = failures
        if failures < CLI_SEAT_HOLD_AFTER_FAILURES:
            record["ok"] = True
            record["note"] = (
                f"probe failed ({record['error']}); {failures} consecutive failure(s), "
                f"held only after {CLI_SEAT_HOLD_AFTER_FAILURES}"
            )
        else:
            record["hold_until"] = (now + timedelta(seconds=CLI_SEAT_HOLD_SECONDS)).strftime("%Y-%m-%dT%H:%M:%SZ")


def alert_text(state: dict[str, Any]) -> str:
    down = [f"{name} ({record['error']})" for name, record in sorted(state["seats"].items()) if not record["ok"]]
    broken = [f"{probe['name']} ({probe['error']})" for probe in state["probes"] if not probe["ok"]]
    pools = state.get("pools") or {}
    thin = [
        f"{pool.get('id')} {_percent(pool.get('headroomPercent'))} ({pool.get('status')})"
        for pool in (pools.get("pools") or [])
        if pool.get("status") in ("low", "exhausted")
    ]
    lines = [
        f"ROUTING DEGRADED at {state['ts']}",
        f"failed probes : {', '.join(broken) or 'none'}",
        f"seats down    : {', '.join(down) or 'none'}",
        f"pools thin    : {', '.join(thin) or 'none'}",
        "",
        "`route pick <class>` already routes around this. Re-run `route doctor --write` to clear.",
    ]
    return "\n".join(lines) + "\n"


def command_doctor(args: argparse.Namespace) -> int:
    started = time.monotonic()
    table = load_table()
    probes: list[dict[str, Any]] = [probe_lb_health()]
    pools_probe, pools_document = probe_pools()
    if args.write and pools_document is not None:
        record_pool_history(pools_document, datetime.now(timezone.utc))
    probes.append(pools_probe)
    probes.append(probe_command("cursor-agent", cursor_command(), CURSOR_TIMEOUT_SECONDS))
    probes.append(probe_command("devin", devin_command(), DEVIN_TIMEOUT_SECONDS))
    probes.append(probe_command("codex-companion", codex_command(), CODEX_TIMEOUT_SECONDS))

    traffic = recent_model_traffic()
    pools = pools_by_id(pools_document)
    allow_probe = True
    models = probed_models(table)
    for model in models:
        if time.monotonic() - started > DOCTOR_BUDGET_SECONDS - PROBE_BUDGET_SECONDS:
            allow_probe = False
        probe = probe_model(model, table=table, traffic=traffic, pools=pools, allow_probe=allow_probe)
        if probe.get("evidence") == "pool_status" and "budget" in (probe.get("note") or ""):
            allow_probe = False
        probes.append(probe)

    by_name = {probe["name"]: probe for probe in probes}
    seats = seat_states(table, by_name, models)
    apply_cli_seat_holds(seats, read_state())
    state = {
        "ts": now_iso(),
        "seats": seats,
        "pools": pools_document,
        "probes": probes,
        "trafficWindowMinutes": SESSION_WINDOW_MINUTES,
        "auth": "loopback_unauthenticated",
        "rules": rules_status(),
        "elapsed_s": round(time.monotonic() - started, 2),
    }
    degraded = any(not probe["ok"] for probe in probes)

    if args.write:
        atomic_write(state_path(), json.dumps(state, indent=2, sort_keys=True) + "\n")
        if degraded:
            atomic_write(alert_path(), alert_text(state))
        else:
            try:
                alert_path().unlink()
            except FileNotFoundError:
                pass
        print(f"route doctor: {'DEGRADED' if degraded else 'ok'} -> {state_path()}")
    else:
        print(json.dumps(state, indent=2, sort_keys=True))
    return EXIT_DEGRADED if degraded else EXIT_OK


