def pool_for_model(table: dict[str, Any], model: str) -> str | None:
    pools = table.get("pools")
    if not isinstance(pools, dict):
        return None
    exact = pools.get(model)
    if isinstance(exact, str):
        return exact
    for key, value in pools.items():
        if key.endswith("*") and model.startswith(key[:-1]) and isinstance(value, str):
            return value
    return None


def vendor_for(entry: dict[str, Any], pool: str | None) -> str | None:
    declared = entry.get("vendor")
    if isinstance(declared, str) and declared:
        return declared
    if pool:
        return pool.split("-")[0]
    return None


def read_state() -> dict[str, Any]:
    try:
        value = json.loads(state_path().read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def state_age_seconds(state: dict[str, Any]) -> float | None:
    if not state:
        return None
    stamp = _parse_ts(state.get("ts"))
    if stamp is None:
        return None
    return (datetime.now(timezone.utc) - stamp).total_seconds()


def seat_is_up(seats: Any, seat: str) -> bool:
    """A seat with no recorded state is treated as up; only a recorded failure takes it out."""
    if not isinstance(seats, dict):
        return True
    record = seats.get(seat)
    if not isinstance(record, dict):
        return True
    if record.get("ok") is not False:
        return True
    hold_until = _parse_ts(record.get("hold_until"))
    return hold_until is not None and hold_until <= datetime.now(timezone.utc)


def _override_matches(override: Any, class_name: str, entry: dict[str, Any]) -> bool:
    if not isinstance(override, dict) or override.get("class") != class_name:
        return False
    demote = override.get("demote")
    if not isinstance(demote, dict):
        return False
    if demote.get("seat") != entry.get("seat"):
        return False
    model = demote.get("model")
    return model is None or model == entry.get("model")


def apply_overrides(chain: list[dict[str, Any]], overrides: Any, class_name: str) -> list[dict[str, Any]]:
    if not isinstance(overrides, list) or not overrides:
        return list(chain)
    kept: list[dict[str, Any]] = []
    demoted: list[dict[str, Any]] = []
    for entry in chain:
        target = demoted if any(_override_matches(o, class_name, entry) for o in overrides) else kept
        target.append(entry)
    return kept + demoted


class ServedModels:
    """The LB's served model list, fetched once and only when an alias needs it."""

    def __init__(self) -> None:
        self._models: list[str] | None = None

    def get(self) -> list[str]:
        if self._models is None:
            self._models, _ = served_models()
        return self._models


def reserve_state(
    table: dict[str, Any], pools: dict[str, dict[str, Any]], class_name: str
) -> dict[str, Any] | None:
    policy = table.get("policy")
    reserve = policy.get("reserve") if isinstance(policy, dict) else None
    if not isinstance(reserve, dict):
        return None
    pool = reserve.get("pool")
    min_eligible = reserve.get("min_eligible")
    min_headroom = reserve.get("headroom_min_percent")
    admit_classes = reserve.get("admit_classes")
    if not isinstance(pool, str) or not isinstance(admit_classes, list):
        return None
    if any(not isinstance(value, (int, float)) or isinstance(value, bool) for value in (min_eligible, min_headroom)):
        return None
    pool_doc = pools.get(pool, {})
    eligible = pool_doc.get("eligibleAccounts")
    headroom = pool_doc.get("headroomPercent")
    why = None
    if isinstance(eligible, (int, float)) and not isinstance(eligible, bool) and eligible < min_eligible:
        noun = "account" if eligible == 1 else "accounts"
        why = f"{eligible:g} eligible {noun} (keep {min_eligible:g})"
    elif isinstance(headroom, (int, float)) and not isinstance(headroom, bool) and headroom < min_headroom:
        why = f"headroom {headroom:g}% (keep {min_headroom:g}%)"
    return {
        "pool": pool,
        "active": why is not None,
        "admitted": class_name in admit_classes,
        "eligible": eligible,
        "headroom": headroom,
        "why": why,
    }


def class_candidates(
    table: dict[str, Any],
    class_name: str,
    spec: dict[str, Any],
    *,
    author_vendor: str | None,
    pools: dict[str, dict[str, Any]],
    seats: Any,
    served: ServedModels,
    leases: dict | None = None,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str]]:
    """(routable, skipped, paced) for one class chain: the eligibility rule pick and menu share.

    A cross_vendor class with no author vendor keeps every vendor; pick refuses that case
    before calling here, menu lists it with the flag so the caller applies it.
    """
    chain = spec.get("chain") if isinstance(spec.get("chain"), list) else []
    entries = [entry for entry in chain if isinstance(entry, dict)]
    ordered = apply_overrides(entries, table.get("overrides"), class_name)
    routable: list[dict[str, Any]] = []
    skipped: list[dict[str, Any]] = []
    aliases = table.get("aliases") if isinstance(table.get("aliases"), dict) else {}
    paced: list[str] = []
    cross_vendor = bool(spec.get("cross_vendor"))

    def skip(seat: str, alias: str, reason: str) -> None:
        skipped.append({"seat": seat, "alias": alias, "reason": reason})

    pace_policy = (table.get("policy") or {}).get("pace") if isinstance(table.get("policy"), dict) else None
    cycle_hours = float((pace_policy or {}).get("cycle_hours") or 168)
    for entry in ordered:
        seat = entry.get("seat")
        alias = entry.get("model")
        if not isinstance(seat, str) or not isinstance(alias, str):
            continue
        model, why = resolve_alias(table, alias, served.get() if family_alias(table, alias) in aliases else [], seat)
        if model is None:
            skip(seat, alias, why)
            continue
        pool = pool_for_model(table, alias)
        vendor = vendor_for(entry, pool)
        if cross_vendor and author_vendor and vendor == author_vendor:
            skip(seat, alias, f"same vendor as author: {vendor}")
            continue
        if not seat_is_up(seats, seat):
            skip(seat, alias, "seat down per routing-state.json")
            continue
        pool_doc = pools.get(pool, {}) if pool else {}
        status = pool_doc.get("status")
        if pool_exhausted(pool_doc):
            skip(seat, alias, f"pool {pool} exhausted")
            continue
        lease_reason = lease_unavailable(table, {"seat": seat, "pool": pool}, pools, leases)
        if lease_reason:
            skip(seat, alias, lease_reason)
            continue
        min_pace = entry.get("min_pace")
        if isinstance(min_pace, (int, float)) and not isinstance(min_pace, bool):
            # Pace-gated entries (Opus on implement) only take work while their pool can
            # afford it; with no pool data they are skipped rather than assumed healthy.
            pace = pool_pace(pool_doc, cycle_hours) if pool_doc else None
            if pace is None and pool_doc and pool:
                pace = accounts_pace(pool)
            if pace is None:
                skip(seat, alias, f"pool {pool} pace unknown")
                continue
            eligible = pool_doc.get("eligibleAccounts")
            if isinstance(eligible, int) and eligible <= LOW_BAND_MAX_ELIGIBLE:
                # ROUTING.md rule 1: a low (2) or critical (1) pool serves judgment only.
                band = "critical" if eligible <= 1 else "low"
                skip(seat, alias, f"pool {pool} {band}: {eligible} eligible account(s)")
                continue
            if pace < min_pace:
                skip(seat, alias, f"pool {pool} behind pace: {pace:+.1f} < {min_pace:+g}")
                continue
            paced.append(f"{seat} admitted: pool {pool} pace {pace:+.1f} >= {min_pace:+g}")
        # Canonical Codex stand-ins retain their own admission rule, independent of review.
        codex_pool = pools.get("openai-codex", {})
        codex_eligible = codex_pool.get("eligibleAccounts")
        if (spec.get("codex_empty_fallback") and vendor == "anthropic"
                and (pool_exhausted(codex_pool) or (
                    isinstance(codex_eligible, int) and not isinstance(codex_eligible, bool)
                    and codex_eligible <= 1))):
            band = "exhausted" if pool_exhausted(codex_pool) else f"critical: {codex_eligible} eligible"
            skip(seat, alias, f"Codex stand-in admission: its auditor's pool openai-codex is {band}")
            continue

        def resolve_auditor() -> tuple[dict[str, Any] | None, str | None]:
            # (auditor, gap): gap names why the declared auditor cannot serve this entry.
            auditor = None
            audit_spec = spec.get("audit")
            if isinstance(audit_spec, dict) and isinstance(audit_spec.get("by_author_vendor"), dict):
                audit_entry = audit_spec["by_author_vendor"].get(vendor)
                if not isinstance(audit_entry, dict) or not isinstance(audit_entry.get("model"), str):
                    return None, f"no auditor declared for author vendor {vendor}"
                audit_alias = audit_entry["model"]
                audit_models = served.get() if family_alias(table, audit_alias) in aliases else []
                audit_model, audit_why = resolve_alias(
                    table, audit_alias, audit_models, str(audit_entry.get("seat") or ""))
                if audit_model is None:
                    return None, f"its auditor {audit_entry['model']} is unavailable: {audit_why}"
                audit_pool = pool_for_model(table, audit_entry["model"])
                audit_lease_reason = lease_unavailable(
                    table, {"seat": audit_entry["seat"], "pool": audit_pool}, pools, leases)
                audit_seat = str(audit_entry.get("seat") or "")
                audit_pool_doc = pools.get(audit_pool, {}) if audit_pool else {}
                audit_eligible = audit_pool_doc.get("eligibleAccounts")
                audit_unavailable = f"its auditor: {audit_lease_reason}" if audit_lease_reason else None
                if pool_exhausted(audit_pool_doc):
                    audit_unavailable = f"its auditor's pool {audit_pool} is exhausted"
                elif isinstance(audit_eligible, int) and not isinstance(audit_eligible, bool) and audit_eligible <= 1:
                    audit_unavailable = f"its auditor's pool {audit_pool} is critical: {audit_eligible} eligible"
                alternate = None
                if audit_unavailable:
                    policy = table.get("policy")
                    via = policy.get("auditor_via") if isinstance(policy, dict) else None
                    alternate = via.get(audit_pool) if isinstance(via, dict) else None
                    if isinstance(alternate, dict) and all(
                        isinstance(alternate.get(key), str) and alternate[key] for key in ("pool", "vendor", "model")
                    ):
                        alternate_doc = pools.get(alternate["pool"], {})
                        alternate_eligible = alternate_doc.get("eligibleAccounts")
                        critical = (
                            isinstance(alternate_eligible, int)
                            and not isinstance(alternate_eligible, bool)
                            and alternate_eligible <= 1
                        )
                        if (
                            not alternate_doc
                            or pool_exhausted(alternate_doc)
                            or critical
                            or lease_unavailable(table, {"seat": "cursor-seat", "pool": alternate["pool"]},
                                                 pools, leases)
                            or not seat_is_up(seats, "cursor-seat")
                            or alternate["model"] not in cursor_models()
                        ):
                            alternate = None
                        else:
                            audit_seat = "cursor-seat"
                    else:
                        alternate = None
                    if alternate is None:
                        return None, audit_unavailable
                if audit_seat and not seat_is_up(seats, audit_seat):
                    return None, f"its auditor seat {audit_seat} is down per routing-state.json"
                auditor = {**audit_entry, "alias": audit_entry["model"], "model": audit_model, "reason": audit_why}
                if alternate is not None:
                    auditor.update({
                        "seat": audit_seat,
                        "via": alternate["vendor"],
                        "pool": alternate["pool"],
                        "model": alternate["model"],
                        "reason": f"{audit_unavailable}; auditor via {alternate['vendor']} pool {alternate['pool']}",
                    })
            return auditor, None

        auditor, audit_gap = resolve_auditor()
        if audit_gap:
            paced.append(f"{seat} advisory: {audit_gap}; review is on request only")
        routable.append(
            {
                "seat": seat,
                "model": model,
                "alias": alias,
                "pool": pool,
                "vendor": vendor,
                "poolStatus": status,
                "auditor": auditor,
                "audit_gap": audit_gap,
            }
        )

    reserve = reserve_state(table, pools, class_name)
    if reserve and reserve["active"] and not reserve["admitted"]:
        kept = []
        reserved = []
        for entry in routable:
            if entry["pool"] == reserve["pool"]:
                entry["reserved"] = f"reserved for orchestrators: {reserve['why']}"
                reserved.append(entry)
            else:
                kept.append(entry)
        routable = kept + reserved
    return routable, skipped, paced


def ladder_entries(table: dict[str, Any], class_name: str, author: str | None = None) -> list[dict] | None:
    ladders = table.get("ladders", {})
    name = table.get("ladder")
    def invalid(message: str) -> Any:
        setup_error("invalid_ladder", message, "--json" in sys.argv)
    if not isinstance(ladders, dict):
        invalid("ladders must be an object")
    if name is not None and (not isinstance(name, str) or name not in ladders):
        invalid("unknown or malformed ladder name")
    ladder = ladders.get(name, {})
    if not isinstance(ladder, dict):
        invalid("ladder must be an object")
    for task, definition in ladder.items():
        if task == "verify":
            if not isinstance(definition, dict):
                invalid("verify ladder must be an object")
            rungs = definition.get("rungs")
            authors = definition.get("by_author_maker")
            if not isinstance(rungs, dict) or not rungs or not isinstance(authors, dict):
                invalid("verify ladder requires rungs and by_author_maker")
            for refs in authors.values():
                if not isinstance(refs, list) or any(not isinstance(ref, str) or not ref.startswith("@")
                                                    or ref[1:] not in rungs for ref in refs):
                    invalid("invalid verify rung reference")
            values = list(rungs.values())
        else:
            if not isinstance(definition, list) or not definition:
                invalid(f"{task} ladder must be a list")
            values = definition
        for entry in values:
            if not isinstance(entry, dict) or any(not isinstance(entry.get(key), str)
                    for key in ("seat", "model", "maker")) or (
                        task != "verify" and not isinstance(entry.get("id"), str)):
                invalid(f"malformed rung in {task}")
            if "gate" in entry and not isinstance(entry["gate"], dict):
                invalid(f"gate in {task} must be an object")
            if "pool" in entry and not isinstance(entry["pool"], str):
                invalid(f"pool in {task} must be a string")
    spec = ladder.get(class_name)
    if isinstance(spec, list):
        return [dict(entry) for entry in spec]
    if isinstance(spec, dict) and class_name == "verify":
        rungs = spec.get("rungs", {})
        author = "cognition" if author == "devin" else author
        references = spec.get("by_author_maker", {}).get(author)
        if author is not None and references is None:
            setup_error("unknown_author", f"unknown author maker {author!r}", "--json" in sys.argv)
        if references is None:
            references = ["@" + key for key in rungs]
        return [{"id": ref[1:], **rungs[ref[1:]]} for ref in references]
    return None


def rung_pool(table: dict, entry: dict, pools: dict) -> str | None:
    return entry["pool"] if entry.get("pool") in pools else pool_for_model(table, entry["model"])


def rung_model(table: dict, entry: dict, served: ServedModels) -> tuple[str | None, str]:
    """(model, why). While `route reserve` defers discovery, a rung whose vendor list is not cached yet comes back
    as its alias with a `pending: ` why; the reserve resolves it once it holds capacity."""
    alias = entry["model"]
    models = served.get() if family_alias(table, alias) in table.get("aliases", {}) else []
    model, why = resolve_alias(table, alias, models, entry.get("seat") or "")
    if model is None and why.startswith("pending: "):
        return alias, why
    if model and family_alias(table, alias) not in table.get("aliases", {}):
        vendor = {"cursor-seat": "cursor", "devin-seat": "devin", "muse-seat-local": "muse"}.get(entry["seat"])
        listed = cursor_models() if vendor == "cursor" else (devin_models() if vendor == "devin" else [])
        if not listed and vendor in _DEFERRED_DISCOVERY:
            return model, model_list_pending(vendor)
        if listed and model not in listed:
            return None, f"{model} is not listed for {entry['seat']}"
    return model, why


EFFORT_SUFFIX = re.compile(r"-(?:low|medium|high|xhigh|max)$")


def same_model(wanted: str, *names: str | None) -> bool:
    """Whether a caller's model names one of `names` (a rung's alias or resolved id): exactly, or as the same family
    alias or model id at another effort. The ladder sets the effort per class, so `grok-latest` runs the mechanical
    rung's grok-latest-low and `swe-latest` its swe-latest-medium; another family (Grok for a Sonnet rung) never
    matches (2026-10-06, a4d-4)."""
    base = EFFORT_SUFFIX.sub("", wanted)
    return any(name and (wanted == name or base == EFFORT_SUFFIX.sub("", name)) for name in names)


def ladder_walk(table: dict, class_name: str, pools: dict, seats: Any, served: ServedModels,
                history: list[dict], now: datetime, author: str | None = None,
                skip_ids: list[str] | None = None, prefer: str | None = None, model: str | None = None,
                leases: dict | None = None) -> dict:
    """Walk the ladder; the first open rung is the default. A caller's `prefer` (rung id or
    seat) waives the table's policy holds on that rung (gate, when, reserve, stand-in), never
    a physical or floor one (unresolvable, pool exhausted, seat down, same maker, no reviewer).
    A caller's `model` picks, among the preferred rungs, the one that runs it (by alias or
    resolved id, at any effort: see same_model; a rung whose model is pending discovery stays a candidate)."""
    wanted = model
    author = "cognition" if author == "devin" else author
    entries = apply_overrides(ladder_entries(table, class_name, author) or [],
                              table.get("overrides"), class_name)
    policy = table.get("policy") or {}
    guarded_pools = (policy.get("pace") or {}).get("guarded_pools")
    pace = {pool: pace_state(pools.get(pool, {}), history, policy, now)
            for entry in entries if (pool := rung_pool(table, entry, pools))}
    for pool in pace:
        if pool_exhausted(pools.get(pool, {})):
            pace[pool]["state"] = "exhausted"
    reserve = reserve_state(table, pools, class_name)
    ordered = [entry for entry in entries if (
        entry["id"] != "sonnet-cursor-high" or (reserve and reserve["active"]))
        and entry.get("promote") == pace.get(
        rung_pool(table, entry, pools), {}).get("state") and entry.get("promote")]
    ordered += [entry for entry in entries if entry not in ordered]
    rows, opened, soft, skipped = [], [], [], []
    intended = None
    for entry in ordered:
        pool = rung_pool(table, entry, pools)
        state = pace.get(pool, {}).get("state", "unknown")
        gate = entry.get("gate") or {}
        reason = None
        if "gate" in entry and gate.get("open") is not True:
            reason = f"gated: {gate.get('until')}"
        elif entry.get("when") and entry["when"] != state:
            reason = f"when {entry['when']}: {pool} is {state}"
        if intended is None and reason is None:
            intended = entry["id"]
        if reason is None and entry["id"] == "sonnet-cursor-high" and not (
                reserve and reserve["active"]):
            reason = "review adapter only while Claude is short"
        if (reason is None and entry.get("reserve_hard") and reserve and reserve["active"]
                and not reserve["admitted"] and pool == reserve["pool"]):
            reason = f"reserved for orchestrators: {reserve['why']}"
        if reason is None and entry.get("stand_in_only"):
            unavailable = all(row["status"] == "skipped" for row in rows
                              if not row.get("stand_in_only"))
            if not unavailable:
                reason = "stand-in only when the default is unavailable"
        waived = None
        if reason is not None and prefer in (entry["id"], entry["seat"]):
            waived, reason = reason, None
        if reason is None and entry["id"] in (skip_ids or []):
            reason = "skipped by caller"
        if reason is None and entry.get("pool") and entry["pool"] not in pools and pool is None:
            reason = f"unresolvable: pool {entry['pool']} unavailable"
        if reason is None and pool_exhausted(pools.get(pool, {})):
            reason = f"pool {pool} exhausted"
        if reason is None:
            reason = lease_unavailable(table, {"seat": entry["seat"], "pool": pool}, pools, leases)
        model, why = rung_model(table, entry, served) if reason is None else (None, "")
        pending = model is not None and why.startswith("pending: ")
        if reason is None and model is None:
            reason = f"unresolvable: {why}"
        if reason is None and not seat_is_up(seats, entry["seat"]):
            record = seats.get(entry["seat"], {}) if isinstance(seats, dict) else {}
            reason = f"seat down: {record.get('error') or 'routing-state.json'}"
        if (reason is None and class_name == "verify" and entry["maker"] == author
                and not entry.get("same_vendor_fallback")):
            reason = f"same maker {author}"
        audit = None
        audit_gap = None
        # Explore is read-only and no decision rides on it, so it needs no auditor (2026-10-06).
        if reason is None and class_name in ("implement", "mechanical"):
            review = ladder_walk(table, "verify", pools, seats, served, history, now, entry["maker"], leases=leases)
            audit = review["chosen"]
            primary = pools.get("anthropic-general", {})
            eligible = primary.get("eligibleAccounts")
            critical = pool_exhausted(primary) or (
                isinstance(eligible, int) and not isinstance(eligible, bool) and eligible <= 1)
            if audit is None and entry["maker"] != "anthropic" and critical:
                # auditor_via remains the availability adapter, independent of ladder ordering.
                legacy = table["classes"].get(class_name, {}).get("audit", {})
                candidate = {**entry, "vendor": {"xai": "cursor", "cognition": "devin"}.get(
                    entry["maker"], entry["maker"])}
                available, rejected, _ = class_candidates(
                    table, class_name, {"chain": [candidate], "audit": legacy},
                    author_vendor=None, pools=pools, seats=seats, served=served, leases=leases)
                audit = available[0]["auditor"] if available else None
                if audit is not None:
                    audit.update(rung=None, maker="anthropic" if audit.get("via") else audit.get("vendor"))
                if audit is None:
                    audit_gap = (available[0].get("audit_gap") if available else
                                 rejected[0]["reason"] if rejected else None)
            if audit is None:
                gaps = "; ".join(f"{row['rung']}: {row['reason']}" for row in review["skipped"])
                audit_gap = audit_gap or f"no open reviewer for {entry['maker']}: {gaps}"
        row = {"rung": entry["id"], "seat": entry["seat"], "model": model,
               "alias": entry["model"], "effort": entry.get("effort"), "maker": entry["maker"],
               "vendor": entry["maker"], "stand_in_only": bool(entry.get("stand_in_only")),
               "pool": pool, "same_vendor": class_name == "verify" and entry["maker"] == author,
               "audit": audit, "auditor": audit, "audit_gap": audit_gap,
               "read_only": bool(entry.get("read_only"))}
        if pending:
            row["model_pending"] = True
        if waived:
            row["waived"] = waived
        if reason:
            row.update(status="skipped", reason=reason)
        else:
            reasons = []
            if state == "low" and (guarded_pools is None or pool in guarded_pools):
                facts = pace[pool]
                empties, reset = facts.get("empties_in_h"), facts.get("hours_left")
                reasons.append(f"running low: empties in {empties:.3g} h, resets in {reset:.3g} h"
                               if empties is not None and reset is not None else "running low: pace below policy")
            if reserve and reserve["active"] and not reserve["admitted"] and pool == reserve["pool"]:
                reasons.append(f"reserved for orchestrators: {reserve['why']}")
            if entry.get("same_vendor_fallback"):
                reasons.append(f"same maker {entry['maker']}")
            row.update(status="soft" if reasons else "open",
                       reason="; ".join(reasons) if reasons else "first open rung")
            (soft if reasons else opened).append(row)
        rows.append(row)
        if row["status"] != "open":
            skipped.append({"rung": row["rung"], "reason": row["reason"]})
    chosen = next(iter(opened or soft), None)
    if chosen is not None and not opened:
        chosen = {**chosen, "reason": chosen["reason"] + "; no other rung open"}
    # The default is what the table alone would pick: a walk with no preference, since a
    # waived rung also changes later rungs' conditions (a stand-in opens only when all else is shut).
    default = chosen if prefer is None else ladder_walk(
        table, class_name, pools, seats, served, history, now, author, skip_ids, leases=leases)["chosen"]
    refused = None
    if prefer is not None:
        preferred = [row for row in opened + soft if prefer in (row["rung"], row["seat"])]
        if wanted is not None and preferred:
            runs = sorted({row["alias"] for row in preferred})
            preferred = ([row for row in preferred if same_model(wanted, row["model"], row["alias"])]
                         or [row for row in preferred if row.get("model_pending")])
            if not preferred:
                refused = (f"no open {prefer} rung on the {class_name} ladder runs {wanted}; "
                           f"it runs {', '.join(runs)}")
        chosen = next(iter(preferred), None)
        if chosen is not None and chosen["same_vendor"] and default is not None and not default["same_vendor"]:
            # Cross-vendor review is a kept floor: same-maker review only when no other maker is open.
            refused = f"same maker {author} while {default['rung']} can review"
            chosen = None
        if chosen is not None:
            chosen = {**chosen, "reason": f"preferred by caller over {default['rung'] if default else 'none'}"
                      + (f"; {chosen['reason']}" if chosen["status"] == "soft" else "")
                      + (f"; waived {chosen['waived']}" if chosen.get("waived") else "")}
    return {"chosen": chosen, "default": default["rung"] if default else None, "refused": refused,
            "rungs": rows, "routable": opened + soft,
            "fallbacks": [row for row in opened + soft if chosen is None or row["rung"] != chosen["rung"]],
            "skipped": skipped,
            "intended": intended, "pace": pace}


def command_ladder_pick(args: argparse.Namespace, table: dict) -> int:
    if args.task_class == "verify" and not args.author_vendor:
        setup_error("unknown_author", "verify requires --author-vendor <maker>", args.json)
    state = read_state()
    age = state_age_seconds(state)
    stale = bool(state) and (age is None or age > STATE_MAX_AGE_SECONDS)
    document, error = fetch_pools(timeout=3.0)
    now = datetime.now(timezone.utc)
    history = load_pool_history(now)
    if document is not None:
        record_pool_history(document, now)
    elif isinstance(state.get("pools"), dict):
        document = state["pools"]
    pools = pools_by_id(document)
    leases = pick_leases()
    walk = ladder_walk(table, args.task_class, pools, None if stale else state.get("seats"),
                       ServedModels(), history, now, args.author_vendor, args.skip, args.prefer, leases=leases)
    walk["lease_availability"] = "known" if leases is not None else "unknown"
    chosen = walk.pop("chosen")
    refused = walk.pop("refused")
    rungs = walk.pop("rungs")
    walk.pop("routable")
    if args.prefer and not any(args.prefer in (row["rung"], row["seat"]) for row in rungs):
        setup_error("unknown_rung", f"--prefer {args.prefer!r} is not a rung or seat on the {args.task_class} ladder",
                    args.json)
    if chosen is None:
        message = f"nothing routable for class {args.task_class!r}"
        if args.prefer:
            why = refused or next(row.get("reason") for row in rungs if args.prefer in (row["rung"], row["seat"]))
            message = f"preferred {args.prefer!r} cannot run: {why}"
        print(f"route: {message}", file=sys.stderr)
        if args.json:
            print(json.dumps({"error": "unroutable", "message": message, **walk}))
        else:
            for entry in walk["skipped"]:
                print(f"  skipped {entry['rung']}: {entry['reason']}", file=sys.stderr)
        return EXIT_UNROUTABLE
    chosen.pop("status")
    result = {"class": args.task_class, "ladder": table["ladder"],
              "state_age_s": None if age is None else round(age, 1),
              "reserve": reserve_state(table, pools, args.task_class), **chosen, **walk}
    fields = ("session_id", "lane", "intended", "running", "since", "expected_return")
    result["standing_in"] = [{key: record.get(key) for key in fields} for record in fetch_stand_ins()["active"]]
    if error:
        result["reason"] += f"; pool status unknown ({error})"
    record_caller_choice(args, result)
    if args.json:
        print(json.dumps(result))
    else:
        for pool, facts in result["pace"].items():
            label = pool.replace("-general", "").replace("-codex", "")
            label = "cursor" if pool in ("cursor-models", "cursor-other") else label
            words = {"low": "running low", "rich": "running rich", "on_pace": "on pace",
                     "exhausted": "empty", "unknown": "unknown"}[facts["state"]]
            detail = f"remaining {_percent(facts['remaining'])}"
            print(f"{label:<12}{words:<14}{detail}")
        for entry in result["skipped"]:
            print(f"  skipped {entry['rung']}: {entry['reason']}")
        auditor = result.get("audit")
        if auditor and auditor.get("via"):
            print(f"audit     {auditor['seat']}/{auditor['model']} via {auditor['via']}")
        for record in result["standing_in"]:
            _print_stand_in(record)
        print(f"→ {result['model']} ({result['pool']})")
    return EXIT_OK


def record_caller_choice(args: argparse.Namespace, result: dict) -> None:
    """Honor and log a caller's --prefer/--effort: the table is the default, a named choice
    with a reason is allowed (Alex, 2026-10-05: allow models "if we request or we want t
    escalate things")."""
    prefer, effort = args.prefer, args.effort
    if not prefer and not effort:
        return
    if effort:
        result["effort_default"] = result.get("effort")
        result["effort"] = effort
        result["reason"] = f"{result.get('reason')}; effort {effort} by caller"
    result["caller_choice"] = {"prefer": prefer, "effort": effort, "why": args.reason}
    append_ledger({"event": "route_override", "class": args.task_class, "prefer": prefer, "effort": effort,
                   "why": args.reason, "rung": result.get("rung"), "seat": result.get("seat"),
                   "model": result.get("model"), "default": result.get("default"),
                   "effort_default": result.get("effort_default")})


def reservation_capacity(row: dict, pools: dict, policy: dict) -> tuple[str, int]:
    pool = row.get("pool")
    facts = pools.get(pool, {})
    provider = facts.get("provider")
    key = provider if isinstance(provider, str) and provider.strip() else (
        pool.split("-", 1)[0] if pool else f"seat:{row['seat']}")
    eligible = next((facts[field] for field in ("eligibleAccounts", "usableAccounts")
                     if isinstance(facts.get(field), int) and not isinstance(facts[field], bool)), 1)
    multiplier = (policy.get("per_account") or {}).get(key, policy.get("default", 2))
    return key, max(0, eligible) * multiplier


def pick_leases() -> dict | None:
    code, snapshot = _reservation_request("GET", "", timeout=3.0, fixture=True)
    rows = snapshot.get("live")
    if (code == EXIT_OK and isinstance(rows, list) and all(
            isinstance(row, dict) and isinstance(row.get("capacity_key"), str)
            and isinstance(row.get("expires_at"), str) for row in rows)):
        return snapshot
    print("route: reservation availability unknown; reserve remains the admission gate", file=sys.stderr)
    return None


def lease_unavailable(table: dict, row: dict, pools: dict, leases: dict | None) -> str | None:
    if leases is None:
        return None  # Unknown is advisory; the atomic reserve remains the launch gate.
    policy = (table.get("policy") or {}).get("concurrency") or {}
    key, capacity = reservation_capacity(row, pools, policy)
    stamp = _now_iso()
    live = sum(1 for held in leases["live"] if held.get("capacity_key") == key
               and held.get("expires_at", "") > stamp)
    if live < capacity:
        return None
    reason = f"lease capacity reserved: {key} ({live}/{capacity}); all candidate capacity is reserved"
    append_ledger({"event": "route_pick_lease_skip", "seat": row["seat"], "capacity_key": key,
                   "live": live, "capacity": capacity, "reason": reason})
    return reason


def _reservation_request(method: str, path: str, payload: dict | None = None,
                         timeout: float = READ_TIMEOUT_SECONDS, *, fixture: bool = False) -> tuple[int, dict]:
    response = _request(method, "/api/pools/reservations" + path, payload=payload, timeout=timeout, fixture=fixture)
    if response.ok and isinstance(response.body, dict):
        return EXIT_OK, response.body
    if response.status in (404, 410) and path:
        return EXIT_UNROUTABLE, {**(response.body if isinstance(response.body, dict) else {}), "status": "gone"}
    return EXIT_DEGRADED, {"status": "error", "error": "reservations_unavailable",
                           "message": response.error or "invalid reservation response"}


class ReserveStopped(Exception):
    """SIGTERM or SIGINT while `route reserve` runs: whatever this job holds is released `cancelled`."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum
        self.at = time.monotonic()


def _stop_reserve(signum: int, _frame: Any) -> None:
    for each in (signal.SIGTERM, signal.SIGINT):
        signal.signal(each, signal.SIG_IGN)  # the release below must not be cut short by a second signal
    raise ReserveStopped(signum)


def release_job_hold(job: str, until: float) -> str | None:
    """Release whatever this job holds. Looked up by job, since a stop can land after agent-lb took the hold and
    before route read its id. A failed lookup or release is retried, and the listing read again to confirm, until
    the monotonic deadline `until`; every request's timeout is cut to the time left, so the answer comes before seat's
    stop grace ends. Returns None once the job holds nothing, else why a hold may still be live (agent-lb's lease TTL
    then ends it)."""
    why = "not attempted"
    while True:
        left = until - time.monotonic()
        if left < 0.2:
            return why
        code, listing = _reservation_request("GET", "", timeout=min(READ_TIMEOUT_SECONDS, left))
        if code != EXIT_OK:
            why = f"listing holds failed: {listing.get('message') or listing.get('status')}"
        else:
            held = [row for row in listing.get("live") or [] if row.get("job") == job]
            if not held:
                return None
            for row in held:
                left = until - time.monotonic()
                if left < 0.2:
                    return why
                _code, body = _reservation_request("POST", f"/{row['reservation_id']}/release",
                                                   {"outcome": "cancelled"}, timeout=min(READ_TIMEOUT_SECONDS, left))
                why = f"releasing {row['reservation_id']} failed: {body.get('message') or body.get('status')}"
        time.sleep(max(0.0, min(0.5, until - time.monotonic() - 0.2)))


def command_reserve(args: argparse.Namespace) -> int:
    table = load_table()
    args.effort = None
    if args.prefer and not args.reason:
        setup_error("missing_reason", "--prefer needs --reason <why>; it goes to the routing ledger", args.json)
    if args.task_class not in (table.get("classes") or {}):
        fail(f"unknown class {args.task_class!r}")
    if ladder_entries(table, args.task_class) is None:
        setup_error("missing_ladder", f"class {args.task_class!r} has no ladder", args.json)
    if args.task_class == "verify" and not args.author_vendor:
        setup_error("unknown_author", "verify requires --author-vendor <maker>", args.json)
    # A stop (seat stops route's process group, model listing included) releases this job's hold, never leaves it.
    previous = {each: signal.signal(each, _stop_reserve) for each in (signal.SIGTERM, signal.SIGINT)}
    try:
        code, result = reserve_walk(args, table)
    except ReserveStopped as stop:
        reason = f"cancelled by signal {signal.Signals(stop.signum).name}"
        status = "cancelled"
        if _UNDRAINED:
            # A listing descendant outlived SIGKILL (a zombie no one reaps, or uninterruptible I/O). Its group was
            # signalled as a group only; the hold goes back anyway and agent-lb's lease TTL is the backstop.
            reason = f"{reason}; {'; '.join(_UNDRAINED)}, released anyway"
            print(f"route: {'; '.join(_UNDRAINED)}; releasing the hold anyway", file=sys.stderr)
        left = release_job_hold(args.job, until=stop.at + STOP_BUDGET_SECONDS)
        if left is not None:
            status, reason = "error", f"{reason}; the hold may still be live until its TTL: {left}"
        append_ledger({"event": "route_reserve", "class": args.task_class, "job": args.job,
                       "status": status, "reason": reason})
        print(json.dumps({"status": status, "reason": reason}))
        return 128 + stop.signum
    finally:
        for each, handler in previous.items():
            signal.signal(each, handler)
    record_caller_choice(args, result)
    append_ledger({"event": "route_reserve", "class": args.task_class, "job": args.job,
                   **{key: result.get(key) for key in ("status", "rung", "seat", "reservation_id", "reason")}})
    print(json.dumps(result))
    return code


def settle_pending(table: dict, row: dict, wanted: str | None) -> tuple[dict | None, str | None]:
    """Under the hold, list the models a deferred rung and its reviewer wait on. Returns the resolved worker and
    reviewer models, or why the hold must go: a worker that resolves to another model than the caller's, or a worker
    that does not resolve. Reviewer discovery is advisory."""
    allow_discovery()
    resolved: dict = {}
    try:
        if row.get("model_pending"):
            model, why = rung_model(table, {"model": row["alias"], "seat": row["seat"]}, ServedModels())
            if not model:
                return None, f"{row['rung']} unresolvable once held: {why}"
            if wanted is not None and not same_model(wanted, model, row["alias"]):
                return None, f"{row['rung']} runs {model}, not {wanted}"
            resolved["model"] = model
        audit = row.get("audit")
        if isinstance(audit, dict) and audit.get("model_pending"):
            model, why = rung_model(table, {"model": audit["alias"], "seat": audit["seat"]}, ServedModels())
            if not model:
                resolved.update(audit=None, auditor=None,
                                audit_gap=f"{row['rung']}'s reviewer {audit['rung']} unresolvable once held: {why}")
            else:
                resolved["audit"] = {**{k: v for k, v in audit.items() if k != "model_pending"}, "model": model}
                resolved["auditor"] = resolved["audit"]
        return resolved, None
    finally:
        global _DEFER_DISCOVERY
        _DEFER_DISCOVERY = True


def reserve_walk(args: argparse.Namespace, table: dict) -> tuple[int, dict]:
    state = read_state()
    age = state_age_seconds(state)
    stale = bool(state) and (age is None or age > STATE_MAX_AGE_SECONDS)
    document, _error = fetch_pools(timeout=3.0)
    now = datetime.now(timezone.utc)
    history = load_pool_history(now)
    if document is not None:
        record_pool_history(document, now)
    elif isinstance(state.get("pools"), dict):
        document = state["pools"]
    pools = pools_by_id(document)
    policy = (table.get("policy") or {}).get("concurrency") or {}
    # No vendor CLI starts before capacity is held (A4d): a cold vendor model list is fetched only once the hold is
    # taken, and a rung that then fails to resolve (or whose reviewer does not), or resolves to another model than the
    # caller's, is released and the walk goes on.
    global _DEFER_DISCOVERY
    _DEFER_DISCOVERY = True
    skip = list(args.skip)
    released: str | None = None
    while True:
        walk = ladder_walk(table, args.task_class, pools, None if stale else state.get("seats"),
                           ServedModels(), history, now, args.author_vendor, skip, args.prefer, args.model)
        if args.prefer and not any(args.prefer in (row["rung"], row["seat"]) for row in walk["rungs"]):
            setup_error("unknown_rung",
                        f"--prefer {args.prefer!r} is not a rung or seat on the {args.task_class} ladder", args.json)
        chosen = walk["chosen"]
        if chosen is None:
            reason = released or walk["refused"] or (next(row.get("reason") for row in walk["rungs"]
                      if args.prefer in (row["rung"], row["seat"])) if args.prefer else
                      f"nothing routable for class {args.task_class!r}")
            return EXIT_UNROUTABLE, {"status": "refused", "reason": reason}
        rows = [chosen] if args.prefer else walk["routable"]
        candidates = []
        for row in rows:
            key, capacity = reservation_capacity(row, pools, policy)
            candidates.append({**{field: row.get(field) for field in ("rung", "seat", "model", "pool")},
                               "capacity_key": key, "capacity": capacity})
        code, result = _reservation_request("POST", "", {"job": args.job, "class": args.task_class,
            "host": os.environ.get("ROUTE_HOST") or socket.gethostname(),
            "ttl_s": args.ttl if args.ttl is not None else policy.get("ttl_s", 120),
            "pinned": bool(args.prefer), "candidates": candidates})
        if code == EXIT_OK and result.get("status") == "wait":
            code = 75
        if code != EXIT_OK or result.get("status") != "reserved":
            return code, result
        row = next((row for row in walk["rungs"] if row["rung"] == result.get("rung")), chosen)
        result.update(alias=row.get("alias"), effort=row.get("effort"), audit=row.get("audit"),
                      reason=row.get("reason"), heartbeat_s=policy.get("heartbeat_s", 30))
        audit = row.get("audit")
        if not row.get("model_pending") and not (isinstance(audit, dict) and audit.get("model_pending")):
            return code, result
        resolved, released = settle_pending(table, row, args.model)
        lost = False
        if resolved is not None:
            # Renew the hold the listing ran under and store the model that will run: a lease that expired while
            # models were listed is gone, and the reservation names what runs, not the alias.
            beat, body = _reservation_request("POST", f"/{result['reservation_id']}/heartbeat",
                                              {"model": resolved.get("model", result.get("model"))})
            if beat == EXIT_OK and body.get("status") == "reserved":
                result.update(resolved)
                result["expires_at"] = body.get("expires_at", result.get("expires_at"))
                return code, result
            lost = beat == EXIT_UNROUTABLE
            # A heartbeat that timed out or failed says nothing about the hold, which may still be live: it is
            # released like any hold route gives up.
            released = (f"{row['rung']} hold was lost while its models were listed" if lost else
                        f"{row['rung']} hold could not be renewed after its models were listed: "
                        f"{body.get('message') or body.get('status')}")
        if not lost:
            # agent-lb hands a job its live hold back, so a hold that stays live would come back as the next rung's:
            # one retry, then stop rather than report another rung's model.
            for _attempt in range(2):
                _freed, body = _reservation_request("POST", f"/{result['reservation_id']}/release",
                                                    {"outcome": "failed"})
                if body.get("status") in ("released", "gone"):
                    break
            else:
                return EXIT_DEGRADED, {"status": "error", "reason": f"{released}; and releasing "
                                       f"{result['reservation_id']} failed: {body.get('reason') or body.get('status')}"}
        append_ledger({"event": "route_reserve_released", "class": args.task_class, "job": args.job,
                       "rung": row["rung"], "reservation_id": result["reservation_id"], "reason": released})
        skip.append(row["rung"])


