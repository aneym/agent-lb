def implement_results(since: datetime) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    try:
        lines = ledger_path().read_text(encoding="utf-8").splitlines()
    except (FileNotFoundError, OSError):
        return rows
    for line in lines:
        if IMPLEMENT_EVENT not in line:
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        stamp = _parse_ts(record.get("ts"))
        if (
            record.get("event") == IMPLEMENT_EVENT
            and record.get("class", "implement") == "implement"
            and stamp is not None
            and stamp >= since
        ):
            rows.append(record)
    return rows


def print_implement_report(since: datetime, days: int) -> None:
    results = implement_results(since)
    print(f"\n## Implement comparison — {days} day(s)\n")
    if not results:
        print("No implement_result rows yet (`route record` writes them).")
        return
    # One row per task per seat/model: repeated records for a task are its rework
    # attempts, so they add tokens and time but not tasks; the last verdict stands.
    tasks: dict[tuple[str, str, str], dict[str, Any]] = {}
    for record in results:
        key = (str(record.get("seat")), str(record.get("model")), str(record.get("task")))
        task = tasks.setdefault(key, {"attempts": 0, "tokens_in": 0, "tokens_out": 0, "wall_s": 0.0, "rework": 0})
        task["attempts"] += 1
        task["audit"] = record.get("audit")
        for field in ("tokens_in", "tokens_out"):
            if isinstance(record.get(field), int) and not isinstance(record.get(field), bool):
                task[field] += record[field]
        if isinstance(record.get("wall_s"), (int, float)):
            task["wall_s"] += float(record["wall_s"])
        if isinstance(record.get("rework"), int):
            task["rework"] = max(task["rework"], record["rework"])
    groups: dict[tuple[str, str], list[dict[str, Any]]] = {}
    for (seat, model, _task), task in tasks.items():
        task["rework"] = max(task["rework"], task["attempts"] - 1)
        groups.setdefault((seat, model), []).append(task)
    print("| seat | model | tasks | audit pass | mean rework | median wall s | tokens in | tokens out | tokens/task |")
    print("|---|---|---:|---:|---:|---:|---:|---:|---:|")
    for (seat, model), group in sorted(groups.items()):
        passes = sum(1 for task in group if task.get("audit") == "pass")
        tin = sum(task["tokens_in"] for task in group)
        tout = sum(task["tokens_out"] for task in group)
        walls = [task["wall_s"] for task in group if task["wall_s"]]
        per_task = f"{(tin + tout) / len(group):,.0f}" if (tin or tout) else "-"
        mean_rework = f"{statistics.mean(task['rework'] for task in group):.1f}"
        median_wall = f"{statistics.median(walls):.0f}" if walls else "-"
        print(
            f"| {seat} | {model} | {len(group)} | {passes}/{len(group)} | {mean_rework} | "
            f"{median_wall} | {tin:,} | {tout:,} | {per_task} |"
        )


def learning_window(value: str) -> tuple[datetime, datetime]:
    match = re.fullmatch(r"([1-9][0-9]*)d", value)
    if not match:
        fail("--since must be a positive number of days, for example 30d")
    until = datetime.now(timezone.utc)
    return until - timedelta(days=int(match[1])), until


def learning_outcomes(since: datetime, until: datetime, source: str = "prod") -> list[dict[str, Any]]:
    try:
        lines = outcomes_path().read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return []
    records = {}
    for line in lines:
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(row, dict):
            continue
        if source != "all" and (row.get("source") == "eval") != (source == "eval"):
            continue
        stamp = _parse_ts(row.get("ts"))
        if stamp is None or stamp.tzinfo is None or not since <= stamp <= until:
            continue
        job = row.get("job_id")
        if not isinstance(job, str) or not job:
            continue
        if job not in records or stamp >= records[job][0]:
            records[job] = (stamp, row)
    return [row for _, row in sorted(records.values(), key=lambda item: item[0])]


def arm_key(arm: dict[str, Any]) -> str:
    return str(arm.get("arm_id") or arm.get("id") or "")


def learning_arms(table: dict[str, Any], class_name: str) -> list[dict[str, Any]]:
    arms = table.get("explore", {}).get("arms", {}).get(class_name, [])
    return arms if isinstance(arms, list) else []


def attributed_outcome(row: dict[str, Any]) -> bool:
    propensity = row.get("propensity")
    return (
        row.get("attribution_complete") is True
        and row.get("outcome") not in ("infra_failure", "pending")
        and isinstance(row.get("outcome"), str)
        and isinstance(propensity, (float, int))
        and not isinstance(propensity, bool)
        and math.isfinite(propensity)
        and 0 < propensity <= 1
    )


def wilson_interval(rate: float, weight: float) -> list[float]:
    if not weight:
        return [0.0, 1.0]
    z = 1.6448536269514722
    denominator = 1 + z * z / weight
    center = (rate + z * z / (2 * weight)) / denominator
    radius = z * math.sqrt(rate * (1 - rate) / weight + z * z / (4 * weight * weight)) / denominator
    return [max(0.0, center - radius), min(1.0, center + radius)]


def learning_metrics(rows: list[dict[str, Any]], total: int) -> dict[str, Any]:
    weight = sum(1 / row["propensity"] for row in rows)
    accepted_weight = sum(1 / row["propensity"] for row in rows if row["outcome"] == "accepted")
    rate = accepted_weight / weight if weight else 0.0
    known = [row for row in rows if isinstance(row.get("cost_usd"), (float, int))
             and not isinstance(row["cost_usd"], bool) and math.isfinite(row["cost_usd"])
             and row["cost_usd"] >= 0]
    known_weight = sum(1 / row["propensity"] for row in known)
    known_accepted = sum(1 / row["propensity"] for row in known if row["outcome"] == "accepted")
    walls = [row["wall_s"] for row in rows if isinstance(row.get("wall_s"), (float, int))
             and not isinstance(row["wall_s"], bool) and math.isfinite(row["wall_s"]) and row["wall_s"] >= 0]
    coverage = len(known) / len(rows) if rows else 0.0
    cost = (sum(row["cost_usd"] / row["propensity"] for row in known) / known_accepted
            if known_accepted and coverage >= 0.8 and known_weight / weight >= 0.8 else None)
    return {
        "n": len(rows), "accepted": sum(row["outcome"] == "accepted" for row in rows),
        "attributed_share": len(rows) / total if total else 0.0,
        "weighted_n": weight, "accept_rate": rate if rows else None,
        "interval": wilson_interval(rate, weight), "cost_known_share": coverage,
        "cost_per_accepted": cost, "median_wall_s": statistics.median(walls) if walls else None,
    }


def v2_override(entry: Any) -> bool:
    if not isinstance(entry, dict):
        return False
    evidence = entry.get("evidence")
    return (isinstance(evidence, dict)
            and {"n", "accepted", "lower_bound", "cost_per_accepted", "window", "policy_rev"} <= evidence.keys()
            and {"class", "action", "arm_id", "reason", "ts", "id"} <= entry.keys())


def arm_paused(table: dict[str, Any], class_name: str, arm_id: str) -> bool:
    return any(entry.get("class") == class_name and entry.get("arm_id") == arm_id
               and entry.get("action") == "pause" and not entry.get("reverted_at")
               for entry in table.get("overrides", []) if isinstance(entry, dict))


EVAL_MDD = "MDD ~30pp per-trial at 30 trials/arm (alpha .1 one-sided, power .8)"
EVAL_ARM_MAP = {"sol-med": "implement standard", "sol-low": "mechanical standard"}


def eval_standings_path() -> Path:
    return Path(os.environ.get("ROUTE_EVAL_STANDINGS")
                or Path.home() / ".agent-lb/audits/routing/eval-standings.json").expanduser()


def load_eval_standings() -> dict[str, Any]:
    try:
        data = json.loads(eval_standings_path().read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def eval_arm(standings: dict[str, Any], class_name: str, arm_id: str, default_arm: str) -> dict[str, Any] | None:
    mapping = standings.get("_map") if isinstance(standings.get("_map"), dict) else EVAL_ARM_MAP
    targets = {f"{class_name} {arm_id}"} | ({f"{class_name} standard"} if arm_id == default_arm else set())
    names = [name for name, target in mapping.items() if target in targets]
    if not names and isinstance(standings.get(arm_id), dict) and standings[arm_id].get("class") == class_name:
        names = [arm_id]
    for name in names:
        entry = standings.get(name)
        tasks = entry.get("tasks") if isinstance(entry, dict) else None
        if not isinstance(tasks, dict):
            continue
        runs = sum(int(task.get("runs") or 0) for task in tasks.values() if isinstance(task, dict))
        passes = sum(int(task.get("passes") or 0) for task in tasks.values() if isinstance(task, dict))
        if not runs:
            continue
        rate = entry.get("per_trial_rate")
        if not isinstance(rate, (float, int)) or isinstance(rate, bool):
            rate = passes / runs
        return {"eval_arm": name, "task_version_set": sorted(entry.get("task_version_set") or []),
                "trials": runs, "passes": passes, "per_trial_rate": rate,
                "upper_bound": wilson_interval(rate, runs)[1],
                "solved_all3": int(entry.get("solved_all3") or 0)}
    return None


def eval_gate(class_name: str, candidate_arm: str, default_arm: str,
              standings: dict[str, Any] | None = None) -> dict[str, Any]:
    standings = load_eval_standings() if standings is None else standings
    candidate = eval_arm(standings, class_name, candidate_arm, default_arm)
    default = eval_arm(standings, class_name, default_arm, default_arm)
    evidence = {"candidate": candidate, "default": default}
    if (candidate is None or default is None or not candidate["task_version_set"]
            or candidate["task_version_set"] != default["task_version_set"]):
        return {"veto": False, "reason": "no-eval-evidence", "evidence": evidence}
    if candidate["upper_bound"] < default["per_trial_rate"]:
        return {"veto": True, "evidence": evidence,
                "reason": f"eval per-trial upper bound {candidate['upper_bound']:.1%} is below "
                          f"default {default['per_trial_rate']:.1%}"}
    if candidate["solved_all3"] < default["solved_all3"] - 1:
        return {"veto": True, "evidence": evidence,
                "reason": f"eval solved_all3 {candidate['solved_all3']} is below "
                          f"default {default['solved_all3']} - 1"}
    return {"veto": False, "reason": "eval-ok", "evidence": evidence}


def learning_report(table: dict[str, Any], window: str, only: str | None = None,
                    source: str = "prod") -> dict[str, Any]:
    since, until = learning_window(window)
    outcomes = learning_outcomes(since, until, source)
    standings = load_eval_standings()
    standards = table.get("standards", {})
    classes = {}
    proposals = []
    vetoed = []
    minimum = table.get("explore", {}).get("min_n_per_arm", 40)
    if not isinstance(minimum, int) or minimum < 1:
        fail("min_n_per_arm must be positive")
    for class_name, default in standards.items():
        if only and class_name != only:
            continue
        default_id = arm_key(default)
        class_rows = [row for row in outcomes if row.get("class") == class_name]
        valid = [row for row in class_rows if attributed_outcome(row)]
        arms = []
        for arm in [default, *learning_arms(table, class_name)]:
            arm_id = arm_key(arm)
            if not arm_id or any(item["arm_id"] == arm_id for item in arms):
                continue
            eligible = [row for row in valid if default_id in row.get("eligible_arms", [])
                        and arm_id in row.get("eligible_arms", [])]
            selected = [row for row in eligible if row.get("arm_id") == arm_id]
            total = sum(row.get("arm_id") == arm_id for row in class_rows)
            metrics = learning_metrics(selected, total)
            paused = arm_paused(table, class_name, arm_id) or arm.get("paused", False)
            gate = None if arm_id == default_id else eval_gate(class_name, arm_id, default_id, standings)
            arms.append({"arm_id": arm_id, "default": arm_id == default_id,
                         **metrics, "paused": bool(paused), "eval_gate": gate})
            if arm_id == default_id:
                continue
            baseline = learning_metrics([row for row in eligible if row.get("arm_id") == default_id],
                                        len(eligible))
            if (source == "prod" and metrics["n"] >= minimum and baseline["n"] >= minimum
                    and metrics["interval"][0] >= baseline["accept_rate"] - 0.05
                    and metrics["cost_per_accepted"] is not None
                    and baseline["cost_per_accepted"] is not None
                    and metrics["cost_per_accepted"] < baseline["cost_per_accepted"]
                    and not paused):
                proposal = {"class": class_name, "action": "promote", "arm_id": arm_id,
                            "evidence": learning_evidence(metrics, window, table), "eval_gate": gate}
                (vetoed if gate["veto"] else proposals).append(proposal)
        classes[class_name] = {"default": default_id, "arms": arms}
    report = {"window": window, "source": source, "policy_rev": table.get("policy_rev"), "classes": classes,
              "proposals": proposals, "vetoed": vetoed,
            "pending_alex": [entry for entry in table.get("overrides", [])
                             if isinstance(entry, dict) and entry.get("pending_alex")
                             and not entry.get("reverted_at") and (not only or entry.get("class") == only)]}
    if source != "prod":
        report["mdd"] = EVAL_MDD
    return report


def learning_evidence(metrics: dict[str, Any], window: str, table: dict[str, Any]) -> dict[str, Any]:
    return {"n": metrics["n"], "accepted": metrics["accepted"], "lower_bound": metrics["interval"][0],
            "cost_per_accepted": metrics["cost_per_accepted"], "window": window,
            "policy_rev": table.get("policy_rev")}


def learning_entry(class_name: str, action: str, arm_id: str, evidence: dict[str, Any],
                   reason: str) -> dict[str, Any]:
    return {"class": class_name, "action": action, "arm_id": arm_id, "evidence": evidence,
            "reason": reason, "ts": now_iso(), "id": secrets.token_hex(12)}


def write_learning_table(table: dict[str, Any]) -> None:
    canonical = Path(__file__).resolve().parent.parent / "config/coding-agents/routing-table.json"
    if table_path().resolve() == canonical:
        fail("learning writes require a managed routing table, set ROUTE_TABLE to its path")
    atomic_write(table_path(), json.dumps(table, indent=2) + "\n")


def command_learn(args: argparse.Namespace) -> int:
    if args.override_evidence and not args.promote:
        fail("--override-evidence requires --promote")
    table = load_table(apply_default=False)
    report = learning_report(table, args.since)
    overrides = table.setdefault("overrides", [])
    changed = False
    if args.purge_legacy:
        if not args.apply:
            fail("--purge-legacy requires --apply")
        kept = [entry for entry in overrides if v2_override(entry)]
        report["purged"] = len(overrides) - len(kept)
        table["overrides"] = overrides = kept
        changed = bool(report["purged"])
    elif args.apply:
        fail("--apply is only supported with --purge-legacy; use --promote explicitly")
    if args.promote:
        class_name, arm_id = args.promote
        if not args.reason:
            fail("--promote requires --reason")
        if class_name not in report["classes"]:
            fail(f"unknown standard class: {class_name}")
        arm = next((arm for arm in learning_arms(table, class_name) if arm_key(arm) == arm_id), None)
        if arm is None:
            fail(f"unknown exploration arm: {class_name}/{arm_id}")
        if arm_id == report["classes"][class_name]["default"]:
            fail("arm is already the default")
        gate = eval_gate(class_name, arm_id, report["classes"][class_name]["default"])
        if gate["veto"] and not args.override_evidence:
            print(f"route: eval gate veto: {gate['reason']}; --override-evidence must be explicit",
                  file=sys.stderr)
            return EXIT_SETUP
        proposal = next((p for p in report["proposals"] if p["class"] == class_name
                         and p["arm_id"] == arm_id), None)
        if proposal is None and not args.override_evidence:
            fail("promotion criteria not met; --override-evidence must be explicit")
        metrics = next(row for row in report["classes"][class_name]["arms"] if row["arm_id"] == arm_id)
        entry = learning_entry(class_name, "promote", arm_id,
                               learning_evidence(metrics, args.since, table), args.reason)
        previous = table["standards"][class_name]
        entry["previous_default"] = previous
        entry["override_evidence"] = bool(args.override_evidence)
        entry["eval_gate"] = gate
        protected = {"plan", "review", "design", "audit", "judge", "ui_critical", "trust"}
        claude = str(previous.get("model", "")).startswith(("opus", "sonnet", "haiku", "claude"))
        entry["pending_alex"] = class_name in protected and claude
        if not entry["pending_alex"]:
            table["standards"][class_name] = arm
        overrides.append(entry)
        report["entry"] = entry
        changed = True
    if args.revert:
        entry = next((entry for entry in overrides if isinstance(entry, dict)
                      and entry.get("id") == args.revert and entry.get("action") == "promote"), None)
        if entry is None or entry.get("reverted_at"):
            fail("no active promotion with that id")
        if not entry.get("pending_alex"):
            if arm_key(table["standards"][entry["class"]]) != entry["arm_id"]:
                fail("a newer default is active; revert it first")
            table["standards"][entry["class"]] = entry["previous_default"]
        entry["reverted_at"] = now_iso()
        report["reverted"] = args.revert
        changed = True
    if args.apply_pauses:
        since, until = learning_window(args.since)
        outcomes = learning_outcomes(since, until)
        threshold = table.get("explore", {}).get("stop_after_nonaccepts", 3)
        if not isinstance(threshold, int) or threshold < 1:
            fail("stop_after_nonaccepts must be positive")
        for class_name, data in report["classes"].items():
            for arm in data["arms"]:
                if arm["default"] or arm["paused"]:
                    continue
                rows = [row for row in outcomes if row.get("class") == class_name
                        and row.get("arm_id") == arm["arm_id"] and attributed_outcome(row)]
                streak = 0
                longest = 0
                for row in rows:
                    streak = 0 if row["outcome"] == "accepted" else streak + 1
                    longest = max(longest, streak)
                if longest >= threshold:
                    entry = learning_entry(class_name, "pause", arm["arm_id"],
                                           learning_evidence(arm, args.since, table),
                                           f"{longest} consecutive non-accepts")
                    overrides.append(entry)
                    changed = True
    if changed:
        write_learning_table(table)
        updated = learning_report(table, args.since)
        for key in ("classes", "proposals", "vetoed", "pending_alex"):
            report[key] = updated[key]
    print(json.dumps(report, indent=2) if args.json else learning_text(report))
    return EXIT_OK


def learning_text(report: dict[str, Any]) -> str:
    lines = ['---', 'title: "Routing standings"', '---', "", "# Routing standings", ""]
    for class_name, data in report["classes"].items():
        lines.extend([f"## {class_name}", "",
                      "| Arm | Default | n | Attributed share | Acceptance (90% interval) | "
                      "$/accepted | Median wall s | Paused |",
                      "|---|---|---:|---:|---|---:|---:|---|"])
        for arm in data["arms"]:
            cost = arm["cost_per_accepted"]
            rate = arm["accept_rate"]
            low, high = arm["interval"]
            acceptance = f"{rate:.1%} ({low:.1%} to {high:.1%})" if rate is not None else "unknown"
            price = f"{cost:.4f}" if cost is not None else "cost unknown"
            lines.append(f"| {arm['arm_id']} | {arm['default']} | {arm['n']} | {arm['attributed_share']:.1%} | "
                         f"{acceptance} | {price} | {arm['median_wall_s']} | {arm['paused']} |")
        lines.append("")
    for proposal in report["proposals"]:
        lines.append(f"Propose promoting {proposal['arm_id']} for {proposal['class']}.")
    for proposal in report.get("vetoed", []):
        lines.append(f"Eval gate vetoed promoting {proposal['arm_id']} for {proposal['class']}: "
                     f"{proposal['eval_gate']['reason']}.")
    if report.get("mdd"):
        lines.append(report["mdd"])
    for entry in report["pending_alex"]:
        lines.append(f"Alex's approval is pending for {entry['class']} promotion to {entry['arm_id']}.")
    if not report["proposals"]:
        lines.append("No promotions proposed.")
    return "\n".join(lines) + "\n"


def command_standings(args: argparse.Namespace) -> int:
    report = learning_report(load_table(apply_default=False), args.since, args.task_class, args.source)
    if args.mdx:
        atomic_write(Path(args.mdx).expanduser(), learning_text(report))
    print(json.dumps(report, indent=2) if args.json else learning_text(report))
    return EXIT_OK


