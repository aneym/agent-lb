def pool_for_model(table: dict[str, Any], model: str) -> str | None:
    pools = table.get("pools")
    if not isinstance(pools, dict):
        return None
    exact = pools.get(model)
    if isinstance(exact, str):
        return exact
    for key, value in pools.items():
        if key.endswith("*") and model.startswith(key[:-1]) and isinstance(value, str):
            return value
    return None


def vendor_for(entry: dict[str, Any], pool: str | None) -> str | None:
    declared = entry.get("vendor")
    if isinstance(declared, str) and declared:
        return declared
    if pool:
        return pool.split("-")[0]
    return None


def read_state() -> dict[str, Any]:
    try:
        value = json.loads(state_path().read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def state_age_seconds(state: dict[str, Any]) -> float | None:
    if not state:
        return None
    stamp = _parse_ts(state.get("ts"))
    if stamp is None:
        return None
    return (datetime.now(timezone.utc) - stamp).total_seconds()


def seat_is_up(seats: Any, seat: str) -> bool:
    """A seat with no recorded state is treated as up; only a recorded failure takes it out."""
    if not isinstance(seats, dict):
        return True
    record = seats.get(seat)
    if not isinstance(record, dict):
        return True
    return record.get("ok") is not False


def _override_matches(override: Any, class_name: str, entry: dict[str, Any]) -> bool:
    if not isinstance(override, dict) or override.get("class") != class_name:
        return False
    demote = override.get("demote")
    if not isinstance(demote, dict):
        return False
    if demote.get("seat") != entry.get("seat"):
        return False
    model = demote.get("model")
    return model is None or model == entry.get("model")


def apply_overrides(chain: list[dict[str, Any]], overrides: Any, class_name: str) -> list[dict[str, Any]]:
    if not isinstance(overrides, list) or not overrides:
        return list(chain)
    kept: list[dict[str, Any]] = []
    demoted: list[dict[str, Any]] = []
    for entry in chain:
        target = demoted if any(_override_matches(o, class_name, entry) for o in overrides) else kept
        target.append(entry)
    return kept + demoted


class ServedModels:
    """The LB's served model list, fetched once and only when an alias needs it."""

    def __init__(self) -> None:
        self._models: list[str] | None = None

    def get(self) -> list[str]:
        if self._models is None:
            self._models, _ = served_models()
        return self._models


def reserve_state(
    table: dict[str, Any], pools: dict[str, dict[str, Any]], class_name: str
) -> dict[str, Any] | None:
    policy = table.get("policy")
    reserve = policy.get("reserve") if isinstance(policy, dict) else None
    if not isinstance(reserve, dict):
        return None
    pool = reserve.get("pool")
    min_eligible = reserve.get("min_eligible")
    min_headroom = reserve.get("headroom_min_percent")
    admit_classes = reserve.get("admit_classes")
    if not isinstance(pool, str) or not isinstance(admit_classes, list):
        return None
    if any(not isinstance(value, (int, float)) or isinstance(value, bool) for value in (min_eligible, min_headroom)):
        return None
    pool_doc = pools.get(pool, {})
    eligible = pool_doc.get("eligibleAccounts")
    headroom = pool_doc.get("headroomPercent")
    why = None
    if isinstance(eligible, (int, float)) and not isinstance(eligible, bool) and eligible < min_eligible:
        noun = "account" if eligible == 1 else "accounts"
        why = f"{eligible:g} eligible {noun} (keep {min_eligible:g})"
    elif isinstance(headroom, (int, float)) and not isinstance(headroom, bool) and headroom < min_headroom:
        why = f"headroom {headroom:g}% (keep {min_headroom:g}%)"
    return {
        "pool": pool,
        "active": why is not None,
        "admitted": class_name in admit_classes,
        "eligible": eligible,
        "headroom": headroom,
        "why": why,
    }


def class_candidates(
    table: dict[str, Any],
    class_name: str,
    spec: dict[str, Any],
    *,
    author_vendor: str | None,
    pools: dict[str, dict[str, Any]],
    seats: Any,
    served: ServedModels,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[str]]:
    """(routable, skipped, paced) for one class chain: the eligibility rule pick and menu share.

    A cross_vendor class with no author vendor keeps every vendor; pick refuses that case
    before calling here, menu lists it with the flag so the caller applies it.
    """
    chain = spec.get("chain") if isinstance(spec.get("chain"), list) else []
    entries = [entry for entry in chain if isinstance(entry, dict)]
    ordered = apply_overrides(entries, table.get("overrides"), class_name)
    routable: list[dict[str, Any]] = []
    skipped: list[dict[str, Any]] = []
    aliases = table.get("aliases") if isinstance(table.get("aliases"), dict) else {}
    paced: list[str] = []
    cross_vendor = bool(spec.get("cross_vendor"))

    def skip(seat: str, alias: str, reason: str) -> None:
        skipped.append({"seat": seat, "alias": alias, "reason": reason})

    pace_policy = (table.get("policy") or {}).get("pace") if isinstance(table.get("policy"), dict) else None
    cycle_hours = float((pace_policy or {}).get("cycle_hours") or 168)
    for entry in ordered:
        seat = entry.get("seat")
        alias = entry.get("model")
        if not isinstance(seat, str) or not isinstance(alias, str):
            continue
        model, why = resolve_alias(table, alias, served.get() if alias in aliases else [], seat)
        if model is None:
            skip(seat, alias, why)
            continue
        pool = pool_for_model(table, alias)
        vendor = vendor_for(entry, pool)
        if cross_vendor and author_vendor and vendor == author_vendor:
            skip(seat, alias, f"same vendor as author: {vendor}")
            continue
        if not seat_is_up(seats, seat):
            skip(seat, alias, "seat down per routing-state.json")
            continue
        pool_doc = pools.get(pool, {}) if pool else {}
        status = pool_doc.get("status")
        if pool_exhausted(pool_doc):
            skip(seat, alias, f"pool {pool} exhausted")
            continue
        min_pace = entry.get("min_pace")
        if isinstance(min_pace, (int, float)) and not isinstance(min_pace, bool):
            # Pace-gated entries (Opus on implement) only take work while their pool can
            # afford it; with no pool data they are skipped rather than assumed healthy.
            pace = pool_pace(pool_doc, cycle_hours) if pool_doc else None
            if pace is None and pool_doc and pool:
                pace = accounts_pace(pool)
            if pace is None:
                skip(seat, alias, f"pool {pool} pace unknown")
                continue
            eligible = pool_doc.get("eligibleAccounts")
            if isinstance(eligible, int) and eligible <= LOW_BAND_MAX_ELIGIBLE:
                # ROUTING.md rule 1: a low (2) or critical (1) pool serves judgment only.
                band = "critical" if eligible <= 1 else "low"
                skip(seat, alias, f"pool {pool} {band}: {eligible} eligible account(s)")
                continue
            if pace < min_pace:
                skip(seat, alias, f"pool {pool} behind pace: {pace:+.1f} < {min_pace:+g}")
                continue
            paced.append(f"{seat} admitted: pool {pool} pace {pace:+.1f} >= {min_pace:+g}")
        auditor = None
        audit_spec = spec.get("audit")
        if isinstance(audit_spec, dict) and isinstance(audit_spec.get("by_author_vendor"), dict):
            audit_entry = audit_spec["by_author_vendor"].get(vendor)
            if not isinstance(audit_entry, dict) or not isinstance(audit_entry.get("model"), str):
                skip(seat, alias, f"no auditor declared for author vendor {vendor}")
                continue
            audit_alias = audit_entry["model"]
            audit_model, audit_why = resolve_alias(table, audit_alias, served.get() if audit_alias in aliases else [],
                                                   str(audit_entry.get("seat") or ""))
            if audit_model is None:
                # Work nobody can audit is not accepted work; route to a seat that can be.
                skip(seat, alias, f"its auditor {audit_entry['model']} is unavailable: {audit_why}")
                continue
            audit_pool = pool_for_model(table, audit_entry["model"])
            audit_seat = str(audit_entry.get("seat") or "")
            audit_pool_doc = pools.get(audit_pool, {}) if audit_pool else {}
            audit_eligible = audit_pool_doc.get("eligibleAccounts")
            audit_unavailable = None
            if pool_exhausted(audit_pool_doc):
                audit_unavailable = f"its auditor's pool {audit_pool} is exhausted"
            elif isinstance(audit_eligible, int) and not isinstance(audit_eligible, bool) and audit_eligible <= 1:
                audit_unavailable = f"its auditor's pool {audit_pool} is critical: {audit_eligible} eligible"
            alternate = None
            if audit_unavailable:
                policy = table.get("policy")
                via = policy.get("auditor_via") if isinstance(policy, dict) else None
                alternate = via.get(audit_pool) if isinstance(via, dict) else None
                if isinstance(alternate, dict) and all(
                    isinstance(alternate.get(key), str) and alternate[key] for key in ("pool", "vendor", "model")
                ):
                    alternate_doc = pools.get(alternate["pool"], {})
                    alternate_eligible = alternate_doc.get("eligibleAccounts")
                    critical = (
                        isinstance(alternate_eligible, int)
                        and not isinstance(alternate_eligible, bool)
                        and alternate_eligible <= 1
                    )
                    if (
                        not alternate_doc
                        or pool_exhausted(alternate_doc)
                        or critical
                        or not seat_is_up(seats, "cursor-seat")
                        or alternate["model"] not in cursor_models()
                    ):
                        alternate = None
                    else:
                        audit_seat = "cursor-seat"
                else:
                    alternate = None
                if alternate is None:
                    skip(seat, alias, audit_unavailable)
                    continue
            if audit_seat and not seat_is_up(seats, audit_seat):
                skip(seat, alias, f"its auditor seat {audit_seat} is down per routing-state.json")
                continue
            auditor = {**audit_entry, "alias": audit_entry["model"], "model": audit_model, "reason": audit_why}
            if alternate is not None:
                auditor.update({
                    "seat": audit_seat,
                    "via": alternate["vendor"],
                    "pool": alternate["pool"],
                    "model": alternate["model"],
                    "reason": f"{audit_unavailable}; auditor via {alternate['vendor']} pool {alternate['pool']}",
                })
        routable.append(
            {
                "seat": seat,
                "model": model,
                "alias": alias,
                "pool": pool,
                "vendor": vendor,
                "poolStatus": status,
                "auditor": auditor,
            }
        )

    reserve = reserve_state(table, pools, class_name)
    if reserve and reserve["active"] and not reserve["admitted"]:
        kept = []
        reserved = []
        for entry in routable:
            if entry["pool"] == reserve["pool"]:
                entry["reserved"] = f"reserved for orchestrators: {reserve['why']}"
                reserved.append(entry)
            else:
                kept.append(entry)
        routable = kept + reserved
    return routable, skipped, paced


def ladder_entries(table: dict[str, Any], class_name: str, author: str | None = None) -> list[dict] | None:
    ladders = table.get("ladders", {})
    name = table.get("ladder")
    def invalid(message: str) -> Any:
        setup_error("invalid_ladder", message, "--json" in sys.argv)
    if not isinstance(ladders, dict):
        invalid("ladders must be an object")
    if name is not None and (not isinstance(name, str) or name not in ladders):
        invalid("unknown or malformed ladder name")
    ladder = ladders.get(name, {})
    if not isinstance(ladder, dict):
        invalid("ladder must be an object")
    for task, definition in ladder.items():
        if task == "verify":
            if not isinstance(definition, dict):
                invalid("verify ladder must be an object")
            rungs = definition.get("rungs")
            authors = definition.get("by_author_maker")
            if not isinstance(rungs, dict) or not rungs or not isinstance(authors, dict):
                invalid("verify ladder requires rungs and by_author_maker")
            for refs in authors.values():
                if not isinstance(refs, list) or any(not isinstance(ref, str) or not ref.startswith("@")
                                                    or ref[1:] not in rungs for ref in refs):
                    invalid("invalid verify rung reference")
            values = list(rungs.values())
        else:
            if not isinstance(definition, list) or not definition:
                invalid(f"{task} ladder must be a list")
            values = definition
        for entry in values:
            if not isinstance(entry, dict) or any(not isinstance(entry.get(key), str)
                    for key in ("seat", "model", "maker")) or (
                        task != "verify" and not isinstance(entry.get("id"), str)):
                invalid(f"malformed rung in {task}")
            if "gate" in entry and not isinstance(entry["gate"], dict):
                invalid(f"gate in {task} must be an object")
            if "pool" in entry and not isinstance(entry["pool"], str):
                invalid(f"pool in {task} must be a string")
    spec = ladder.get(class_name)
    if isinstance(spec, list):
        return [dict(entry) for entry in spec]
    if isinstance(spec, dict) and class_name == "verify":
        rungs = spec.get("rungs", {})
        author = "cognition" if author == "devin" else author
        references = spec.get("by_author_maker", {}).get(author)
        if author is not None and references is None:
            setup_error("unknown_author", f"unknown author maker {author!r}", "--json" in sys.argv)
        if references is None:
            references = ["@" + key for key in rungs]
        return [{"id": ref[1:], **rungs[ref[1:]]} for ref in references]
    return None


def rung_pool(table: dict, entry: dict, pools: dict) -> str | None:
    return entry["pool"] if entry.get("pool") in pools else pool_for_model(table, entry["model"])


def rung_model(table: dict, entry: dict, served: ServedModels) -> tuple[str | None, str]:
    alias = entry["model"]
    model, why = resolve_alias(table, alias, served.get() if alias in table.get("aliases", {}) else [],
                               entry.get("seat") or "")
    if model and alias not in table.get("aliases", {}):
        listed = cursor_models() if entry["seat"] == "cursor-seat" else (
            devin_models() if entry["seat"] == "devin-seat" else [])
        if listed and model not in listed:
            return None, f"{model} is not listed for {entry['seat']}"
    return model, why


def ladder_walk(table: dict, class_name: str, pools: dict, seats: Any, served: ServedModels,
                history: list[dict], now: datetime, author: str | None = None,
                skip_ids: list[str] | None = None, prefer: str | None = None) -> dict:
    """Walk the ladder; the first open rung is the default. A caller's `prefer` (rung id or
    seat) waives the table's policy holds on that rung (gate, when, reserve, stand-in), never
    a physical or floor one (unresolvable, pool exhausted, seat down, same maker, no reviewer)."""
    author = "cognition" if author == "devin" else author
    entries = apply_overrides(ladder_entries(table, class_name, author) or [],
                              table.get("overrides"), class_name)
    policy = table.get("policy") or {}
    guarded_pools = (policy.get("pace") or {}).get("guarded_pools")
    pace = {pool: pace_state(pools.get(pool, {}), history, policy, now)
            for entry in entries if (pool := rung_pool(table, entry, pools))}
    for pool in pace:
        if pool_exhausted(pools.get(pool, {})):
            pace[pool]["state"] = "exhausted"
    reserve = reserve_state(table, pools, class_name)
    ordered = [entry for entry in entries if (
        entry["id"] != "sonnet-cursor-high" or (reserve and reserve["active"]))
        and entry.get("promote") == pace.get(
        rung_pool(table, entry, pools), {}).get("state") and entry.get("promote")]
    ordered += [entry for entry in entries if entry not in ordered]
    rows, opened, soft, skipped = [], [], [], []
    intended = None
    for entry in ordered:
        pool = rung_pool(table, entry, pools)
        state = pace.get(pool, {}).get("state", "unknown")
        gate = entry.get("gate") or {}
        reason = None
        if "gate" in entry and gate.get("open") is not True:
            reason = f"gated: {gate.get('until')}"
        elif entry.get("when") and entry["when"] != state:
            reason = f"when {entry['when']}: {pool} is {state}"
        if intended is None and reason is None:
            intended = entry["id"]
        if reason is None and entry["id"] == "sonnet-cursor-high" and not (
                reserve and reserve["active"]):
            reason = "review adapter only while Claude is short"
        if (reason is None and entry.get("reserve_hard") and reserve and reserve["active"]
                and not reserve["admitted"] and pool == reserve["pool"]):
            reason = f"reserved for orchestrators: {reserve['why']}"
        if reason is None and entry.get("stand_in_only"):
            unavailable = all(row["status"] == "skipped" for row in rows
                              if not row.get("stand_in_only"))
            if not unavailable:
                reason = "stand-in only when the default is unavailable"
        waived = None
        if reason is not None and prefer in (entry["id"], entry["seat"]):
            waived, reason = reason, None
        if reason is None and entry["id"] in (skip_ids or []):
            reason = "skipped by caller"
        if reason is None and entry.get("pool") and entry["pool"] not in pools and pool is None:
            reason = f"unresolvable: pool {entry['pool']} unavailable"
        if reason is None and pool_exhausted(pools.get(pool, {})):
            reason = f"pool {pool} exhausted"
        model, why = rung_model(table, entry, served) if reason is None else (None, "")
        if reason is None and model is None:
            reason = f"unresolvable: {why}"
        if reason is None and not seat_is_up(seats, entry["seat"]):
            record = seats.get(entry["seat"], {}) if isinstance(seats, dict) else {}
            reason = f"seat down: {record.get('error') or 'routing-state.json'}"
        if (reason is None and class_name == "verify" and entry["maker"] == author
                and not entry.get("same_vendor_fallback")):
            reason = f"same maker {author}"
        audit = None
        # Explore is read-only and no decision rides on it, so it needs no auditor (2026-10-06).
        if reason is None and class_name in ("implement", "mechanical"):
            review = ladder_walk(table, "verify", pools, seats, served, history, now, entry["maker"])
            audit = review["chosen"]
            primary = pools.get("anthropic-general", {})
            eligible = primary.get("eligibleAccounts")
            critical = pool_exhausted(primary) or (
                isinstance(eligible, int) and not isinstance(eligible, bool) and eligible <= 1)
            if audit is None and entry["maker"] != "anthropic" and critical:
                # auditor_via remains the availability adapter, independent of ladder ordering.
                legacy = table["classes"].get(class_name, {}).get("audit", {})
                candidate = {**entry, "vendor": {"xai": "cursor", "cognition": "devin"}.get(
                    entry["maker"], entry["maker"])}
                available, rejected, _ = class_candidates(
                    table, class_name, {"chain": [candidate], "audit": legacy},
                    author_vendor=None, pools=pools, seats=seats, served=served)
                audit = available[0]["auditor"] if available else None
                if audit is not None:
                    audit.update(rung=None, maker="anthropic" if audit.get("via") else audit.get("vendor"))
                if audit is None and rejected:
                    reason = rejected[0]["reason"]
            if audit is None and reason is None:
                reason = f"no open reviewer for {entry['maker']}"
        row = {"rung": entry["id"], "seat": entry["seat"], "model": model,
               "alias": entry["model"], "effort": entry.get("effort"), "maker": entry["maker"],
               "vendor": entry["maker"], "stand_in_only": bool(entry.get("stand_in_only")),
               "pool": pool, "same_vendor": class_name == "verify" and entry["maker"] == author,
               "audit": audit, "read_only": bool(entry.get("read_only"))}
        if waived:
            row["waived"] = waived
        if reason:
            row.update(status="skipped", reason=reason)
        else:
            reasons = []
            if state == "low" and (guarded_pools is None or pool in guarded_pools):
                facts = pace[pool]
                empties, reset = facts.get("empties_in_h"), facts.get("hours_left")
                reasons.append(f"running low: empties in {empties:.3g} h, resets in {reset:.3g} h"
                               if empties is not None and reset is not None else "running low: pace below policy")
            if reserve and reserve["active"] and not reserve["admitted"] and pool == reserve["pool"]:
                reasons.append(f"reserved for orchestrators: {reserve['why']}")
            if entry.get("same_vendor_fallback"):
                reasons.append(f"same maker {entry['maker']}")
            row.update(status="soft" if reasons else "open",
                       reason="; ".join(reasons) if reasons else "first open rung")
            (soft if reasons else opened).append(row)
        rows.append(row)
        if row["status"] != "open":
            skipped.append({"rung": row["rung"], "reason": row["reason"]})
    chosen = next(iter(opened or soft), None)
    if chosen is not None and not opened:
        chosen = {**chosen, "reason": chosen["reason"] + "; no other rung open"}
    # The default is what the table alone would pick: never a rung opened only by a waiver.
    default = next((row for row in opened + soft if not row.get("waived")), None)
    refused = None
    if prefer is not None:
        chosen = next((row for row in opened + soft if prefer in (row["rung"], row["seat"])), None)
        if chosen is not None and chosen["same_vendor"] and default is not None and not default["same_vendor"]:
            # Cross-vendor review is a kept floor: same-maker review only when no other maker is open.
            refused = f"same maker {author} while {default['rung']} can review"
            chosen = None
        if chosen is not None:
            chosen = {**chosen, "reason": f"preferred by caller over {default['rung'] if default else 'none'}"
                      + (f"; {chosen['reason']}" if chosen["status"] == "soft" else "")
                      + (f"; waived {chosen['waived']}" if chosen.get("waived") else "")}
    return {"chosen": chosen, "default": default["rung"] if default else None, "refused": refused, "rungs": rows, "routable": opened + soft, "fallbacks": [row for row in opened + soft
            if chosen is None or row["rung"] != chosen["rung"]], "skipped": skipped,
            "intended": intended, "pace": pace}


def command_ladder_pick(args: argparse.Namespace, table: dict) -> int:
    if args.task_class == "verify" and not args.author_vendor:
        setup_error("unknown_author", "verify requires --author-vendor <maker>", args.json)
    state = read_state()
    age = state_age_seconds(state)
    stale = bool(state) and (age is None or age > STATE_MAX_AGE_SECONDS)
    document, error = fetch_pools(timeout=3.0)
    now = datetime.now(timezone.utc)
    history = load_pool_history(now)
    if document is not None:
        record_pool_history(document, now)
    elif isinstance(state.get("pools"), dict):
        document = state["pools"]
    pools = pools_by_id(document)
    walk = ladder_walk(table, args.task_class, pools, None if stale else state.get("seats"),
                       ServedModels(), history, now, args.author_vendor, args.skip, args.prefer)
    chosen = walk.pop("chosen")
    refused = walk.pop("refused")
    rungs = walk.pop("rungs")
    walk.pop("routable")
    if args.prefer and not any(args.prefer in (row["rung"], row["seat"]) for row in rungs):
        setup_error("unknown_rung", f"--prefer {args.prefer!r} is not a rung or seat on the {args.task_class} ladder",
                    args.json)
    if chosen is None:
        message = f"nothing routable for class {args.task_class!r}"
        if args.prefer:
            why = refused or next(row.get("reason") for row in rungs if args.prefer in (row["rung"], row["seat"]))
            message = f"preferred {args.prefer!r} cannot run: {why}"
        print(f"route: {message}", file=sys.stderr)
        if args.json:
            print(json.dumps({"error": "unroutable", "message": message, **walk}))
        else:
            for entry in walk["skipped"]:
                print(f"  skipped {entry['rung']}: {entry['reason']}", file=sys.stderr)
        return EXIT_UNROUTABLE
    chosen.pop("status")
    result = {"class": args.task_class, "ladder": table["ladder"],
              "state_age_s": None if age is None else round(age, 1),
              "reserve": reserve_state(table, pools, args.task_class), **chosen, **walk}
    fields = ("session_id", "lane", "intended", "running", "since", "expected_return")
    result["standing_in"] = [{key: record.get(key) for key in fields} for record in fetch_stand_ins()["active"]]
    if error:
        result["reason"] += f"; pool status unknown ({error})"
    record_caller_choice(args, result)
    if args.json:
        print(json.dumps(result))
    else:
        for pool, facts in result["pace"].items():
            label = pool.replace("-general", "").replace("-codex", "")
            label = "cursor" if pool in ("cursor-models", "cursor-other") else label
            words = {"low": "running low", "rich": "running rich", "on_pace": "on pace",
                     "exhausted": "empty", "unknown": "unknown"}[facts["state"]]
            detail = f"remaining {_percent(facts['remaining'])}"
            print(f"{label:<12}{words:<14}{detail}")
        for entry in result["skipped"]:
            print(f"  skipped {entry['rung']}: {entry['reason']}")
        auditor = result.get("audit")
        if auditor and auditor.get("via"):
            print(f"audit     {auditor['seat']}/{auditor['model']} via {auditor['via']}")
        for record in result["standing_in"]:
            _print_stand_in(record)
        print(f"→ {result['model']} ({result['pool']})")
    return EXIT_OK


def record_caller_choice(args: argparse.Namespace, result: dict) -> None:
    """Honor and log a caller's --prefer/--effort: the table is the default, a named choice
    with a reason is allowed (Alex, 2026-10-05: allow models "if we request or we want t
    escalate things")."""
    prefer, effort = args.prefer, args.effort
    if not prefer and not effort:
        return
    if effort:
        result["effort_default"] = result.get("effort")
        result["effort"] = effort
        result["reason"] = f"{result.get('reason')}; effort {effort} by caller"
    result["caller_choice"] = {"prefer": prefer, "effort": effort, "why": args.reason}
    append_ledger({"event": "route_override", "class": args.task_class, "prefer": prefer, "effort": effort,
                   "why": args.reason, "rung": result.get("rung"), "seat": result.get("seat"),
                   "model": result.get("model"), "default": result.get("default"),
                   "effort_default": result.get("effort_default")})


def command_pick(args: argparse.Namespace, table: dict | None = None) -> int:
    table = load_table() if table is None else table
    for key in ("prefer", "effort", "reason"):
        setattr(args, key, getattr(args, key, None))
    if (args.prefer or args.effort) and not args.reason:
        setup_error("missing_reason", "--prefer and --effort need --reason <why>; it goes to the routing ledger",
                    args.json)
    classes = table.get("classes")
    if not isinstance(classes, dict) or args.task_class not in classes:
        known = ", ".join(sorted(classes)) if isinstance(classes, dict) else "none"
        fail(f"unknown class {args.task_class!r}; known classes: {known}")
    if ladder_entries(table, args.task_class) is not None:
        return command_ladder_pick(args, table)
    spec = classes[args.task_class]
    if not isinstance(spec, dict):
        fail(f"class {args.task_class!r} is malformed")

    if spec.get("driver"):
        state = read_state()
        document = state.get("pools") if isinstance(state.get("pools"), dict) else None
        result = {
            "reserve": reserve_state(table, pools_by_id(document), args.task_class),
            "class": args.task_class,
            "state_age_s": None,
            "seat": "driver",
            "model": None,
            "pool": None,
            "reason": "driver class: stays on the driver session, no subagent",
            "fallbacks": [],
        }
        _print_pick(result, as_json=args.json)
        return EXIT_OK

    cross_vendor = bool(spec.get("cross_vendor"))
    if cross_vendor and not args.author_vendor:
        fail(
            f"class {args.task_class!r} is cross_vendor: pass --author-vendor <vendor> "
            "so the author's vendor is excluded"
        )

    chain = spec.get("chain")
    if not isinstance(chain, list) or not chain:
        fail(f"class {args.task_class!r} has no chain")

    state = read_state()
    age = state_age_seconds(state)
    stale = bool(state) and (age is None or age > STATE_MAX_AGE_SECONDS)
    seats = None if stale else state.get("seats")

    document, pools_error = fetch_pools(timeout=3.0)
    if document is not None:
        record_pool_history(document, datetime.now(timezone.utc))
    if document is None and isinstance(state.get("pools"), dict):
        document = state["pools"]
    pools = pools_by_id(document)

    routable, skipped_entries, paced = class_candidates(
        table,
        args.task_class,
        spec,
        author_vendor=args.author_vendor,
        pools=pools,
        seats=seats,
        served=ServedModels(),
    )
    skipped = [f"{entry['seat']} ({entry['reason']})" for entry in skipped_entries]
    if not routable:
        detail = "; ".join(skipped) if skipped else "no chain entry survived filtering"
        print(f"route: nothing routable for class {args.task_class!r}: {detail}", file=sys.stderr)
        return EXIT_UNROUTABLE

    chosen = routable[0]
    reasons = ["first chain entry with the seat up and its pool not exhausted"]
    if args.prefer:
        if not any(isinstance(entry, dict) and entry.get("seat") == args.prefer for entry in chain):
            setup_error("unknown_rung", f"--prefer {args.prefer!r} is not a seat on the {args.task_class} chain",
                        args.json)
        preferred = next((entry for entry in routable if entry["seat"] == args.prefer), None)
        if preferred is None:
            why = next((entry["reason"] for entry in skipped_entries if entry["seat"] == args.prefer), "unroutable")
            message = f"preferred {args.prefer!r} cannot run: {why}"
            print(f"route: {message}", file=sys.stderr)
            if args.json:
                print(json.dumps({"error": "unroutable", "message": message}))
            return EXIT_UNROUTABLE
        reasons = [f"preferred by caller over {chosen['seat']}"]
        chosen = preferred
    if chosen.get("reserved"):
        reasons.insert(0, f"{chosen['reserved']}; no other seat open")
    if cross_vendor:
        reasons.append(f"cross_vendor: excluded author vendor {args.author_vendor}")
    if stale:
        reasons.append(
            f"ignored routing-state.json: {age and round(age)}s old, over the {STATE_MAX_AGE_SECONDS}s limit"
        )
    if paced:
        reasons.extend(paced)
    if skipped:
        reasons.append("skipped " + "; ".join(skipped))
    if pools_error:
        reasons.append(f"pool status unknown ({pools_error})")
    auditor = chosen["auditor"]
    result = {
        "class": args.task_class,
        "state_age_s": None if age is None else round(age, 1),
        "audit": auditor,
        "reserve": reserve_state(table, pools, args.task_class),
        "seat": chosen["seat"],
        "model": chosen["model"],
        "alias": chosen["alias"],
        "pool": chosen["pool"],
        "reason": "; ".join(reasons),
        "fallbacks": [
            {"seat": entry["seat"], "model": entry["model"], "pool": entry["pool"]}
            for entry in routable if entry is not chosen
        ],
    }
    if args.prefer:
        result["default"] = routable[0]["seat"]
    record_caller_choice(args, result)
    _print_pick(result, as_json=args.json)
    return EXIT_OK


def _five_hour_windows(accounts_body: Any) -> dict[str, dict[str, Any]]:
    """Per pool: the best 5-hour headroom among active accounts and the earliest 5-hour reset."""
    accounts = accounts_body.get("accounts") if isinstance(accounts_body, dict) else accounts_body
    windows: dict[str, dict[str, Any]] = {}
    for account in accounts if isinstance(accounts, list) else []:
        if not isinstance(account, dict) or account.get("status") != "active":
            continue
        remaining = (account.get("usage") or {}).get("primaryRemainingPercent")
        reset = account.get("resetAtPrimary")
        for pool_id in _pool_ids(account):
            window = windows.setdefault(pool_id, {"fiveHourHeadroomPercent": None, "fiveHourResetAt": None})
            if isinstance(remaining, (int, float)) and not isinstance(remaining, bool):
                best = window["fiveHourHeadroomPercent"]
                window["fiveHourHeadroomPercent"] = max(float(remaining), best if best is not None else 0.0)
            if isinstance(reset, str) and reset and (window["fiveHourResetAt"] or "~") > reset:
                window["fiveHourResetAt"] = reset
    return windows


MENU_POOL_FIELDS = (
    "status",
    "accounts",
    "eligibleAccounts",
    "headroomPercent",
    "weeklyRemainingPercent",
    "weeklyPacePercent",
    "weeklyResetAt",
    "resetAt",
    "refills",
)


def build_menu(class_names: list[str] | None = None) -> dict[str, Any]:
    """Every seat the host can run now, per class, with the pool facts a decider needs.

    Seats that cannot run are listed under `excluded` with the reason, never on the menu.
    """
    table = load_table()
    classes = table.get("classes") if isinstance(table.get("classes"), dict) else {}
    state = read_state()
    age = state_age_seconds(state)
    stale = bool(state) and (age is None or age > STATE_MAX_AGE_SECONDS)
    seats = None if stale else state.get("seats")
    accounts = http_get("/api/accounts", timeout=3.0)
    document, pools_error = fetch_pools(timeout=3.0, accounts=accounts, refills=True)
    if document is not None:
        record_pool_history(document, datetime.now(timezone.utc))
    if document is None and isinstance(state.get("pools"), dict):
        document = state["pools"]
    pools = pools_by_id(document)
    windows = _five_hour_windows(accounts.body) if accounts.json_ok else {}

    now = datetime.now(timezone.utc)
    history = load_pool_history(now)
    served = ServedModels()
    menu_classes: dict[str, Any] = {}
    used_pools: set[str] = set()
    for class_name in class_names or list(classes):
        spec = classes.get(class_name)
        if not isinstance(spec, dict):
            fail(f"unknown class {class_name!r}; known classes: {', '.join(sorted(classes))}")
        if spec.get("driver"):
            menu_classes[class_name] = {"driver": True, "crossVendor": False, "seats": [], "excluded": []}
            continue
        if ladder_entries(table, class_name) is not None:
            walk = ladder_walk(table, class_name, pools, seats, served, history, now)
            used_pools.update(walk["pace"])
            menu_classes[class_name] = {"driver": False, "crossVendor": class_name == "verify",
                                        "rungs": walk["rungs"],
                                        "seats": [{"id": f"{row['seat']}.{row['model']}", **row}
                                                  for row in walk["routable"]],
                                        "excluded": [{key: row.get(key)
                                                      for key in ("seat", "model", "alias", "rung", "reason")}
                                                     for row in walk["rungs"] if row["status"] != "open"],
                                        "paced": [], "ladder": table["ladder"]}
            continue
        routable, skipped, paced = class_candidates(
            table, class_name, spec, author_vendor=None, pools=pools, seats=seats, served=served
        )
        entries = []
        for entry in routable:
            entries.append({"id": f"{entry['seat']}.{entry['model']}", **entry})
            if entry["pool"]:
                used_pools.add(entry["pool"])
        menu_classes[class_name] = {
            "driver": False,
            "crossVendor": bool(spec.get("cross_vendor")),
            "seats": entries,
            "excluded": skipped,
            "paced": paced,
        }

    pool_facts = {}
    for pool_id in sorted(set(pools) | used_pools):
        pool = pools.get(pool_id, {})
        facts = {field: pool.get(field) for field in MENU_POOL_FIELDS}
        facts.update(windows.get(pool_id, {"fiveHourHeadroomPercent": None, "fiveHourResetAt": None}))
        pool_facts[pool_id] = facts
    return {
        "generatedAt": now_iso(),
        "poolsSource": (document or {}).get("source") if isinstance(document, dict) else None,
        "poolsError": pools_error,
        "stateAgeS": None if age is None else round(age, 1),
        "stateIgnored": stale,
        "pools": pool_facts,
        "classes": menu_classes,
    }


def command_menu(args: argparse.Namespace) -> int:
    menu = build_menu([args.task_class] if args.task_class else None)
    if args.json:
        print(json.dumps(menu, indent=2, sort_keys=True))
    else:
        print(f"menu at {menu['generatedAt']} (pools: {menu['poolsSource'] or menu['poolsError']})")
        for pool_id, pool in menu["pools"].items():
            if pool.get("refills"):
                print(f"{pool_id} refills: " + ", ".join(
                    f"{_parse_ts(row['at']):%m-%d %H:%MZ} +{row['accounts']} accounts"
                    for row in pool["refills"]))
        for class_name, entry in menu["classes"].items():
            if entry["driver"]:
                print(f"{class_name:<11} driver session")
                continue
            shown = ", ".join(seat.get("id", seat.get("rung", "?")) for seat in entry["seats"]) or "nothing routable"
            print(f"{class_name:<11} {shown}")
            for excluded in entry["excluded"]:
                name = excluded.get("seat", excluded.get("rung", "?"))
                print(f"{'':<11}   excluded {name}: {excluded['reason']}")
    routable = any(entry["seats"] or entry["driver"] for entry in menu["classes"].values())
    return EXIT_OK if routable else EXIT_UNROUTABLE


def _print_pick(result: dict[str, Any], *, as_json: bool) -> None:
    fields = ("session_id", "lane", "intended", "running", "since", "expected_return")
    result["standing_in"] = [{key: record.get(key) for key in fields} for record in fetch_stand_ins()["active"]]
    if as_json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return
    print(f"seat      {result['seat']}")
    alias = result.get("alias")
    shown = result["model"] or "-"
    if alias and alias != result["model"]:
        shown = f"{shown} (from {alias})"
    print(f"model     {shown}")
    print(f"pool      {result['pool'] or '-'}")
    age = result.get("state_age_s")
    print(f"state age {'no state file' if age is None else f'{age}s'}")
    print(f"reason    {result['reason']}")
    reserve = result.get("reserve")
    if reserve and reserve["active"] and not reserve["admitted"]:
        print(f"reserve: {reserve['why']}")
    fallbacks = ", ".join(f"{entry['seat']}/{entry['model']}" for entry in result["fallbacks"]) or "none"
    print(f"fallbacks {fallbacks}")
    auditor = result.get("audit")
    if isinstance(auditor, dict):
        shown = auditor.get("model") or f"unresolved {auditor.get('alias')}: {auditor.get('reason')}"
        via = f" via {auditor['via']}" if auditor.get("via") else ""
        print(f"audit     {auditor.get('seat')}/{shown}{via} audits this seat's closeout before acceptance")
    for record in result["standing_in"]:
        _print_stand_in(record)


# --- workflow args -----------------------------------------------------------
# Claude Code Workflow scripts have no shell, so a script cannot call `route
# pick`. `route workflow-args` runs the picks once in the launching turn and
# prints, per class, the agent() options that reach the picked seat and model;
# the caller passes the JSON as the Workflow `args`. How each seat kind takes a
# model and effort (measured 2026-10-05, ROUTING.md "Workflows"):
# - Bridge seats run in Claude Code on GPT through the ccgpt bridge. The bridge
#   locks reasoning effort from the model name suffix (`sol-latest-medium`) and
#   ignores the request's own effort, so the effort rides in opts.model.
# - Brief seats are thin forwarders whose CLI model is named in the brief
#   (`Seat model: <id>`, the pick's resolved id, which `seat` accepts); their
#   own Claude wrapper stays at low effort. codex-sol takes only its effort
#   from the brief (`Effort: <effort>`).
# - Fixed forwarders pin their CLI model and effort in the seat definition.
# - Every other seat is a Claude seat: opts.model and opts.effort override the
#   definition's frontmatter.
WORKFLOW_BRIDGE_SEATS = frozenset({"gpt-implementer", "gpt-explorer", "sol-consult"})
WORKFLOW_BRIEF_SEATS = frozenset({"cursor-seat", "devin-seat"})
WORKFLOW_EFFORT_BRIEF_SEATS = frozenset({"codex-sol"})
WORKFLOW_FIXED_FORWARDERS = frozenset({"codex-verifier", "codex-test-runner", "computer-use"})
WORKFLOW_AUTHOR_VENDORS = ("anthropic", "openai", "xai", "cursor", "cognition", "devin", "glm", "kimi")
CCGPT_EFFORTS = ("low", "medium", "high", "xhigh")
# Claude Code's own cap on concurrent agent() calls in one workflow.
WORKFLOW_AGENT_CAP = 16


def _chain_effort(table: dict[str, Any], class_name: str, seat: str) -> str | None:
    spec = (table.get("classes") or {}).get(class_name)
    for entry in (spec.get("chain") or []) if isinstance(spec, dict) else []:
        if isinstance(entry, dict) and entry.get("seat") == seat:
            return entry.get("effort")
    return None


def workflow_seat(table: dict[str, Any], class_name: str, entry: dict[str, Any]) -> dict[str, Any]:
    """Turn one pick entry into the agent() options and brief line that reach it."""
    seat = entry["seat"]
    model = entry.get("model")
    alias = entry.get("alias") or model
    effort = entry.get("effort") if "effort" in entry else _chain_effort(table, class_name, seat)
    if model and is_retired(model, retired_patterns(table)):
        raise ValueError(f"{seat} picked retired model {model}")
    opts: dict[str, Any] = {"agentType": seat}
    brief = ""
    if seat in WORKFLOW_BRIDGE_SEATS:
        if alias:
            base = next((alias[: -len(f"-{e}")] for e in CCGPT_EFFORTS if alias.endswith(f"-{e}")), alias)
            opts["model"] = f"{base}-{effort}" if effort in CCGPT_EFFORTS else alias
    elif seat in WORKFLOW_BRIEF_SEATS:
        opts["effort"] = "low"
        brief = f"Seat model: {model or alias}\n"
        if class_name == "verify":
            brief += "Seat mode: ask\nReviewer instructions: read ~/.claude/agents/verifier.md and follow it.\n"
        elif entry.get("read_only"):
            brief += "Seat mode: ask\n"
    elif seat in WORKFLOW_EFFORT_BRIEF_SEATS:
        brief = f"Effort: {effort}\n" if effort else ""
    elif seat not in WORKFLOW_FIXED_FORWARDERS:
        if model:
            opts["model"] = model
        if effort:
            opts["effort"] = effort
    out = {key: entry.get(key) for key in ("rung", "seat", "model", "alias", "vendor", "pool") if entry.get(key)}
    seat_spec = (table.get("seats") or {}).get(seat)
    if "vendor" not in out and isinstance(seat_spec, dict) and seat_spec.get("vendor"):
        out["vendor"] = seat_spec["vendor"]
    out.update(effort=effort, opts=opts, brief=brief)
    return out


def _pick_json(table: dict[str, Any], class_name: str, author_vendor: str | None) -> dict[str, Any]:
    args = argparse.Namespace(task_class=class_name, author_vendor=author_vendor, skip=[], json=True,
                              prefer=None, effort=None, reason=None)
    buffer, errors = io.StringIO(), io.StringIO()
    code = EXIT_OK
    try:
        with contextlib.redirect_stdout(buffer), contextlib.redirect_stderr(errors):
            code = command_pick(args, table)
    except SystemExit as stop:
        code = stop.code if isinstance(stop.code, int) else EXIT_UNROUTABLE
    text = buffer.getvalue().strip()
    result = json.loads(text) if text.startswith("{") else {}
    if code != EXIT_OK or "error" in result or not result.get("seat"):
        message = result.get("message") or errors.getvalue().strip().removeprefix("route: ") or f"exit {code}"
        raise ValueError(message)
    return result


def _workflow_pick(table: dict[str, Any], class_name: str, author_vendor: str | None) -> dict[str, Any]:
    picked = _pick_json(table, class_name, author_vendor)
    if picked.get("seat") == "driver":
        raise ValueError("driver class: stays on the driver session, no subagent")
    out = workflow_seat(table, class_name, picked)
    fallbacks = []
    for entry in picked.get("fallbacks") or []:
        try:
            fallbacks.append(workflow_seat(table, class_name, entry))
        except ValueError:
            continue
    out["fallbacks"] = fallbacks
    audit = picked.get("audit")
    if isinstance(audit, dict) and audit.get("seat"):
        try:
            out["audit"] = workflow_seat(table, "verify", audit)
        except ValueError as error:
            out["audit_error"] = str(error)
    return out


def command_workflow_args(args: argparse.Namespace) -> int:
    table = load_table()
    classes = table.get("classes") if isinstance(table.get("classes"), dict) else {}
    document: dict[str, Any] = {
        "generated_at": now_iso(),
        "ladder": table.get("ladder"),
        "table_sha256": hashlib.sha256(table_path().read_bytes()).hexdigest() if table_path().is_file() else None,
        "agent_cap": min(WORKFLOW_AGENT_CAP, max(1, (os.cpu_count() or 3) - 2)),
        "seats": {},
        "review_for": {},
        "errors": {},
    }
    for class_name in sorted(classes):
        if class_name == "verify":
            continue
        try:
            document["seats"][class_name] = _workflow_pick(table, class_name, None)
        except ValueError as error:
            document["errors"][class_name] = str(error)
    for vendor in WORKFLOW_AUTHOR_VENDORS:
        try:
            document["review_for"][vendor] = _workflow_pick(table, "verify", vendor)
        except ValueError as error:
            document["errors"][f"review_for.{vendor}"] = str(error)
    print(json.dumps(document, indent=2, sort_keys=True))
    if not document["seats"] and not document["review_for"]:
        return EXIT_UNROUTABLE
    return EXIT_DEGRADED if document["errors"] else EXIT_OK


# --- doctor ------------------------------------------------------------------


def _probe(name: str, started: float, *, ok: bool, error: str | None, **detail: Any) -> dict[str, Any]:
    record = {"name": name, "ok": ok, "latency_ms": int((time.monotonic() - started) * 1000), "error": error}
    record.update(detail)
    return record


LB_HEALTH_ATTEMPTS = 3
LB_HEALTH_RETRY_SECONDS = 5.0


def probe_lb_health() -> dict[str, Any]:
    # A single miss must not mark every Claude seat down until the next
    # 30-minute doctor run: on 2026-09-25 one probe landed inside a routine
    # LB restart and `route pick` refused all Claude seats for 16 minutes.
    started = time.monotonic()
    for attempt in range(LB_HEALTH_ATTEMPTS):
        result = http_get("/api/health", timeout=4.0)
        path = "/api/health"
        if result.status == 404:
            result = http_get("/health", timeout=4.0)
            path = "/health"
        ok = result.ok and result.status == 200
        if ok or attempt == LB_HEALTH_ATTEMPTS - 1:
            break
        time.sleep(LB_HEALTH_RETRY_SECONDS)
    error = None if ok else (result.error or f"HTTP {result.status}")
    return _probe("lb-health", started, ok=ok, error=error, path=path, attempts=attempt + 1)


def probe_pools() -> tuple[dict[str, Any], dict[str, Any] | None]:
    started = time.monotonic()
    document, error = fetch_pools()
    ok = document is not None
    record = _probe(
        "lb-pools",
        started,
        ok=ok,
        error=error,
        source=document.get("source") if document else None,
    )
    return record, document


def probe_command(name: str, command: list[str], timeout: float) -> dict[str, Any]:
    started = time.monotonic()
    if not command:
        return _probe(name, started, ok=False, error="probe command is empty")
    try:
        completed = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            text=True,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return _probe(name, started, ok=False, error=f"timeout after {timeout:.0f}s")
    except OSError as error:
        return _probe(name, started, ok=False, error=f"{type(error).__name__}: {error}")
    ok = completed.returncode == 0
    error = None if ok else f"exit {completed.returncode}"
    return _probe(name, started, ok=ok, error=error)


def _message_head(body: Any) -> str | None:
    """The LB's own error text, collapsed and truncated. It carries no credential."""
    if not isinstance(body, dict):
        return None
    error = body.get("error")
    message = error.get("message") if isinstance(error, dict) else None
    if not isinstance(message, str) or not message.strip():
        return None
    return " ".join(message.split())[:MESSAGE_HEAD_CHARS]


def recent_model_traffic(*, window: int = SESSION_WINDOW_MINUTES) -> dict[str, dict[str, Any]]:
    """Ground truth per model: did real traffic get through in the window?

    Real sessions beat a synthetic probe. The probe takes a fresh selection decision, which
    a per-model cooldown can refuse while established traffic keeps flowing; a 429 there says
    nothing about whether the seat works. `errors` is a session-level count and cannot be
    attributed to one model, so a session that logged more requests for the model than it
    logged errors still proves the model answers — recorded with a weaker evidence tag.
    """
    result = http_get(f"/api/sessions?windowMinutes={window}&limit=200", timeout=4.0)
    traffic: dict[str, dict[str, Any]] = {}
    if not result.json_ok or not isinstance(result.body, dict):
        return traffic
    for session in result.body.get("sessions") or []:
        if not isinstance(session, dict):
            continue
        errors = session.get("errors")
        errors = int(errors) if isinstance(errors, (int, float)) and not isinstance(errors, bool) else 0
        for entry in session.get("models") or []:
            if not isinstance(entry, dict):
                continue
            model, requests = entry.get("model"), entry.get("requests")
            if not isinstance(model, str) or isinstance(requests, bool) or not isinstance(requests, (int, float)):
                continue
            requests = int(requests)
            if requests <= 0 or requests <= errors:
                continue
            candidate = {
                "requests": requests,
                "errors": errors,
                "clean": errors == 0,
                "lastSeen": session.get("lastSeen"),
            }
            current = traffic.get(model)
            if current is None or (candidate["clean"] and not current["clean"]) or requests > current["requests"]:
                traffic[model] = candidate
    return traffic


def _pool_verdict(
    model: str, table: dict[str, Any], pools: dict[str, Any], *, note: str, latency_ms: int | None
) -> dict[str, Any]:
    """No probe signal worth trusting: fall back to whether the model's pool has capacity."""
    pool = pool_for_model(table, model)
    status = pools.get(pool, {}).get("status") if pool else None
    ok = status != "exhausted"
    return {
        "name": f"model:{model}",
        "ok": ok,
        "latency_ms": latency_ms,
        "error": f"pool {pool} exhausted" if not ok else None,
        "evidence": "pool_status",
        "note": note,
        "pool": pool,
        "poolStatus": status,
    }


def probe_model(
    model: str,
    *,
    table: dict[str, Any],
    traffic: dict[str, dict[str, Any]],
    pools: dict[str, Any],
    allow_probe: bool = True,
) -> dict[str, Any]:
    """Decide whether a Claude seat is up. Down means broken, never merely busy."""
    name = f"model:{model}"
    recent = traffic.get(model)
    if recent is not None:
        return {
            "name": name,
            "ok": True,
            "latency_ms": None,
            "error": None,
            "evidence": "recent_success" if recent["clean"] else "recent_success_with_errors",
            "note": (
                f"{recent['requests']} request(s) on {model} in the last {SESSION_WINDOW_MINUTES}m"
                f", {recent['errors']} session error(s), last seen {recent['lastSeen']}"
            ),
        }
    if not allow_probe:
        return _pool_verdict(
            model, table, pools, note="no recent traffic; probe dropped after the 2s budget", latency_ms=None
        )

    started = time.monotonic()
    payload = {"model": model, "max_tokens": 1, "messages": [{"role": "user", "content": "ok"}]}
    result = http_post("/v1/messages", payload, timeout=PROBE_BUDGET_SECONDS)
    latency = int((time.monotonic() - started) * 1000)
    status = result.status
    head = _message_head(result.body)

    if result.ok and status == 200:
        return {"name": name, "ok": True, "latency_ms": latency, "error": None, "evidence": "probe_success"}
    if status in (401, 403):
        presence = http_get("/api/models", timeout=4.0)
        ok = presence.ok and presence.status == 200
        return {
            "name": name,
            "ok": ok,
            "latency_ms": latency,
            "error": None if ok else (presence.error or f"HTTP {presence.status}"),
            "evidence": "api_models_presence",
            "note": "/v1/messages needs a credential this probe does not hold; probed /api/models instead",
        }
    if status in (400, 404):
        return {
            "name": name,
            "ok": False,
            "latency_ms": latency,
            "error": f"HTTP {status}: {head or 'model not recognised by the LB'}",
            "evidence": "unknown_model",
        }
    if status == 429:
        return _pool_verdict(
            model, table, pools, note=f"fresh selection 429: {head or 'no account selectable'}", latency_ms=latency
        )
    if result.error == "timeout":
        return _pool_verdict(
            model, table, pools, note=f"probe exceeded the {PROBE_BUDGET_SECONDS:.0f}s budget", latency_ms=latency
        )
    return {
        "name": name,
        "ok": False,
        "latency_ms": latency,
        "error": f"HTTP {status}" if status else (result.error or "request failed"),
        "evidence": "probe_failure",
    }


def probed_models(table: dict[str, Any]) -> list[str]:
    """Distinct non-Fable Claude models in the table, in first-seen order."""
    seen: list[str] = []
    classes = table.get("classes")
    if not isinstance(classes, dict):
        return seen
    for spec in classes.values():
        if not isinstance(spec, dict):
            continue
        for entry in spec.get("chain") or []:
            model = entry.get("model") if isinstance(entry, dict) else None
            if not isinstance(model, str) or not model.startswith("claude-"):
                continue
            if "fable" in model or pool_for_model(table, model) == "anthropic-fable":
                continue
            if model not in seen:
                seen.append(model)
    return seen


def backing_probe(table: dict[str, Any], seat: str, model: str, models: list[str]) -> str:
    if seat in SEAT_PROBE:
        return SEAT_PROBE[seat]
    if model.startswith("cursor-"):
        return "cursor-agent"
    alias = (table.get("aliases") or {}).get(model) if isinstance(table.get("aliases"), dict) else None
    if model.startswith("gpt-") or (isinstance(alias, dict) and alias.get("vendor") == "openai"):
        return "codex-companion"
    if model in models:
        return f"model:{model}"
    return "lb-health"


def seat_states(table: dict[str, Any], probes: dict[str, dict[str, Any]], models: list[str]) -> dict[str, Any]:
    seats: dict[str, Any] = {}
    classes = table.get("classes")
    if not isinstance(classes, dict):
        return seats
    for spec in classes.values():
        if not isinstance(spec, dict):
            continue
        for entry in spec.get("chain") or []:
            if not isinstance(entry, dict):
                continue
            seat, model = entry.get("seat"), entry.get("model")
            if not isinstance(seat, str) or not isinstance(model, str):
                continue
            probe = probes.get(backing_probe(table, seat, model, models))
            if probe is None:
                continue
            record = {
                "ok": probe["ok"],
                "latency_ms": probe.get("latency_ms"),
                "error": probe.get("error"),
                "evidence": probe.get("evidence", "probe"),
            }
            if probe.get("note"):
                record["note"] = probe["note"]
            current = seats.get(seat)
            if current is None or (current["ok"] and not probe["ok"]):
                seats[seat] = record
            elif current["ok"] == probe["ok"]:
                latencies = [value for value in (current["latency_ms"], probe.get("latency_ms")) if value is not None]
                current["latency_ms"] = max(latencies) if latencies else None
    return seats


def alert_text(state: dict[str, Any]) -> str:
    down = [f"{name} ({record['error']})" for name, record in sorted(state["seats"].items()) if not record["ok"]]
    broken = [f"{probe['name']} ({probe['error']})" for probe in state["probes"] if not probe["ok"]]
    pools = state.get("pools") or {}
    thin = [
        f"{pool.get('id')} {_percent(pool.get('headroomPercent'))} ({pool.get('status')})"
        for pool in (pools.get("pools") or [])
        if pool.get("status") in ("low", "exhausted")
    ]
    lines = [
        f"ROUTING DEGRADED at {state['ts']}",
        f"failed probes : {', '.join(broken) or 'none'}",
        f"seats down    : {', '.join(down) or 'none'}",
        f"pools thin    : {', '.join(thin) or 'none'}",
        "",
        "`route pick <class>` already routes around this. Re-run `route doctor --write` to clear.",
    ]
    return "\n".join(lines) + "\n"


def command_doctor(args: argparse.Namespace) -> int:
    started = time.monotonic()
    table = load_table()
    probes: list[dict[str, Any]] = [probe_lb_health()]
    pools_probe, pools_document = probe_pools()
    if args.write and pools_document is not None:
        record_pool_history(pools_document, datetime.now(timezone.utc))
    probes.append(pools_probe)
    probes.append(probe_command("cursor-agent", cursor_command(), CURSOR_TIMEOUT_SECONDS))
    probes.append(probe_command("devin", devin_command(), DEVIN_TIMEOUT_SECONDS))
    probes.append(probe_command("codex-companion", codex_command(), CODEX_TIMEOUT_SECONDS))

    traffic = recent_model_traffic()
    pools = pools_by_id(pools_document)
    allow_probe = True
    models = probed_models(table)
    for model in models:
        if time.monotonic() - started > DOCTOR_BUDGET_SECONDS - PROBE_BUDGET_SECONDS:
            allow_probe = False
        probe = probe_model(model, table=table, traffic=traffic, pools=pools, allow_probe=allow_probe)
        if probe.get("evidence") == "pool_status" and "budget" in (probe.get("note") or ""):
            allow_probe = False
        probes.append(probe)

    by_name = {probe["name"]: probe for probe in probes}
    state = {
        "ts": now_iso(),
        "seats": seat_states(table, by_name, models),
        "pools": pools_document,
        "probes": probes,
        "trafficWindowMinutes": SESSION_WINDOW_MINUTES,
        "auth": "loopback_unauthenticated",
        "rules": rules_status(),
        "elapsed_s": round(time.monotonic() - started, 2),
    }
    degraded = any(not probe["ok"] for probe in probes)

    if args.write:
        atomic_write(state_path(), json.dumps(state, indent=2, sort_keys=True) + "\n")
        if degraded:
            atomic_write(alert_path(), alert_text(state))
        else:
            try:
                alert_path().unlink()
            except FileNotFoundError:
                pass
        print(f"route doctor: {'DEGRADED' if degraded else 'ok'} -> {state_path()}")
    else:
        print(json.dumps(state, indent=2, sort_keys=True))
    return EXIT_DEGRADED if degraded else EXIT_OK


# --- ledger, report, learn ---------------------------------------------------


def _parse_ts(value: Any) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def read_ledger(since: datetime) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    dispatches: list[dict[str, Any]] = []
    closeouts: list[dict[str, Any]] = []
    try:
        lines = ledger_path().read_text(encoding="utf-8").splitlines()
    except (FileNotFoundError, OSError):
        return dispatches, closeouts
    for line in lines:
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(record, dict):
            continue
        stamp = _parse_ts(record.get("ts"))
        if stamp is None or stamp < since:
            continue
        if record.get("event") == "dispatch":
            dispatches.append(record)
        elif record.get("event") == "closeout":
            closeouts.append(record)
    return dispatches, closeouts


RowKey = tuple[str, str, str]


def aggregate(dispatches: list[dict[str, Any]], closeouts: list[dict[str, Any]]) -> dict[RowKey, dict[str, Any]]:
    """Join closeouts to dispatches by (session_id, name), oldest unmatched dispatch first."""
    pending: dict[tuple[Any, Any], list[dict[str, Any]]] = {}
    rows: dict[RowKey, dict[str, Any]] = {}

    def row_for(record: dict[str, Any]) -> dict[str, Any]:
        key: RowKey = (
            str(record.get("task_class") or "unknown"),
            str(record.get("subagent_type") or "unknown"),
            str(record.get("model") or "unknown"),
        )
        return rows.setdefault(
            key,
            {
                "class": key[0],
                "seat": key[1],
                "model": key[2],
                "dispatches": 0,
                "denied": 0,
                "closeouts": 0,
                "ok": 0,
                "durations": [],
                "sessions": set(),
                "tokens_in": 0,
                "tokens_out": 0,
            },
        )

    for record in dispatches:
        row = row_for(record)
        if record.get("denied"):
            row["denied"] += 1
            continue
        row["dispatches"] += 1
        if record.get("session_id"):
            row["sessions"].add(record["session_id"])
        pending.setdefault((record.get("session_id"), record.get("name")), []).append(record)

    for record in closeouts:
        key = (record.get("session_id"), record.get("name"))
        queue = pending.get(key) or []
        origin = queue.pop(0) if queue else None
        merged = dict(record)
        if origin is not None:
            merged.setdefault("task_class", origin.get("task_class"))
            merged.setdefault("subagent_type", origin.get("subagent_type"))
        # Group a closeout under the model its dispatch asked for, like the dispatch
        # row itself; since 2026-09-22 the closeout's own `model` is what answered.
        requested = merged.get("dispatch_model") or (origin or {}).get("model")
        if requested or "dispatch_model" in merged:
            merged["model"] = requested
        row = row_for(merged)
        row["closeouts"] += 1
        if merged.get("ok") is True:
            row["ok"] += 1
        duration = merged.get("duration_s")
        if isinstance(duration, (int, float)) and not isinstance(duration, bool):
            row["durations"].append(float(duration))
        if merged.get("session_id"):
            row["sessions"].add(merged["session_id"])
        for field in ("tokens_in", "tokens_out"):
            value = merged.get(field)
            if isinstance(value, int) and not isinstance(value, bool):
                row[field] += value
    return rows


def session_costs(session_ids: set[str]) -> dict[str, float]:
    costs: dict[str, float] = {}
    for session_id in sorted(session_ids)[:ANALYTICS_SESSION_CAP]:
        result = http_get(f"/api/sessions/{session_id}/analytics", timeout=4.0)
        if not result.json_ok or not isinstance(result.body, dict):
            continue
        session = result.body.get("session")
        cost = session.get("costUsd") if isinstance(session, dict) else None
        if isinstance(cost, (int, float)) and not isinstance(cost, bool):
            costs[session_id] = float(cost)
    return costs


def ok_rate(row: dict[str, Any]) -> float | None:
    return row["ok"] / row["closeouts"] if row["closeouts"] else None


def command_report(args: argparse.Namespace) -> int:
    since = datetime.now(timezone.utc) - timedelta(days=args.days)
    dispatches, closeouts = read_ledger(since)
    rows = aggregate(dispatches, closeouts)
    if getattr(args, "implement", False):
        print_implement_report(since, args.days)
        return EXIT_OK
    if not rows:
        print(f"No dispatches in {ledger_path()} within {args.days} day(s).")
        print_implement_report(since, args.days)
        return EXIT_OK
    every_session: set[str] = set()
    for row in rows.values():
        every_session |= row["sessions"]
    costs = session_costs(every_session)

    print(f"# route report — {args.days} day(s) to {now_iso()}\n")
    print(f"Ledger: `{ledger_path()}` · {len(dispatches)} dispatches · {len(closeouts)} closeouts\n")
    print(
        "| class | seat | model | dispatches | denied | closeouts | ok-rate | median s | tokens in | tokens out "
        "| sessions | session cost |"
    )
    print("|---|---|---|---|---:|---:|---:|---:|---:|---:|---:|---:|")
    for key in sorted(rows):
        row = rows[key]
        rate = ok_rate(row)
        median = f"{statistics.median(row['durations']):.0f}" if row["durations"] else "-"
        cost = sum(costs.get(session, 0.0) for session in row["sessions"])
        cost_text = f"${cost:.2f}" if cost else "-"
        print(
            f"| {row['class']} | {row['seat']} | {row['model']} | {row['dispatches']} | {row['denied']} | "
            f"{row['closeouts']} | {'-' if rate is None else f'{rate:.0%}'} | {median} | "
            f"{row['tokens_in']:,} | {row['tokens_out']:,} | {len(row['sessions'])} | {cost_text} |"
        )
    if costs:
        print("\nSession cost is the whole LB session's spend; a session shared by several rows is counted in each.")
    elif every_session:
        print("\nSession cost unavailable: the LB session analytics endpoint did not answer.")
    print_implement_report(since, args.days)
    return EXIT_OK


IMPLEMENT_EVENT = "implement_result"
AUDIT_VERDICTS = ("pass", "fix-needed")


def command_record(args: argparse.Namespace) -> int:
    """Append one implement outcome so seats can be compared on quality, tokens and time."""
    record = {
        "ts": now_iso(),
        "event": IMPLEMENT_EVENT,
        "class": args.task_class,
        "task": args.task,
        "seat": args.seat,
        "model": args.model,
        "tokens_in": args.tokens_in,
        "tokens_out": args.tokens_out,
        "wall_s": args.wall_s,
        "audit": args.audit,
        "rework": args.rework,
        "tests": args.tests,
        "notes": args.notes,
    }
    path = ledger_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, sort_keys=True) + "\n")
    print(f"recorded {args.task_class}/{args.seat}/{args.model} in {path}")
    return EXIT_OK


def implement_results(since: datetime) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    try:
        lines = ledger_path().read_text(encoding="utf-8").splitlines()
    except (FileNotFoundError, OSError):
        return rows
    for line in lines:
        if IMPLEMENT_EVENT not in line:
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        stamp = _parse_ts(record.get("ts"))
        if (
            record.get("event") == IMPLEMENT_EVENT
            and record.get("class", "implement") == "implement"
            and stamp is not None
            and stamp >= since
        ):
            rows.append(record)
    return rows


def print_implement_report(since: datetime, days: int) -> None:
    results = implement_results(since)
    print(f"\n## Implement comparison — {days} day(s)\n")
    if not results:
        print("No implement_result rows yet (`route record` writes them).")
        return
    # One row per task per seat/model: repeated records for a task are its rework
    # attempts, so they add tokens and time but not tasks; the last verdict stands.
    tasks: dict[tuple[str, str, str], dict[str, Any]] = {}
    for record in results:
        key = (str(record.get("seat")), str(record.get("model")), str(record.get("task")))
        task = tasks.setdefault(key, {"attempts": 0, "tokens_in": 0, "tokens_out": 0, "wall_s": 0.0, "rework": 0})
        task["attempts"] += 1
        task["audit"] = record.get("audit")
        for field in ("tokens_in", "tokens_out"):
            if isinstance(record.get(field), int) and not isinstance(record.get(field), bool):
                task[field] += record[field]
        if isinstance(record.get("wall_s"), (int, float)):
            task["wall_s"] += float(record["wall_s"])
        if isinstance(record.get("rework"), int):
            task["rework"] = max(task["rework"], record["rework"])
    groups: dict[tuple[str, str], list[dict[str, Any]]] = {}
    for (seat, model, _task), task in tasks.items():
        task["rework"] = max(task["rework"], task["attempts"] - 1)
        groups.setdefault((seat, model), []).append(task)
    print("| seat | model | tasks | audit pass | mean rework | median wall s | tokens in | tokens out | tokens/task |")
    print("|---|---|---:|---:|---:|---:|---:|---:|---:|")
    for (seat, model), group in sorted(groups.items()):
        passes = sum(1 for task in group if task.get("audit") == "pass")
        tin = sum(task["tokens_in"] for task in group)
        tout = sum(task["tokens_out"] for task in group)
        walls = [task["wall_s"] for task in group if task["wall_s"]]
        per_task = f"{(tin + tout) / len(group):,.0f}" if (tin or tout) else "-"
        mean_rework = f"{statistics.mean(task['rework'] for task in group):.1f}"
        median_wall = f"{statistics.median(walls):.0f}" if walls else "-"
        print(
            f"| {seat} | {model} | {len(group)} | {passes}/{len(group)} | {mean_rework} | "
            f"{median_wall} | {tin:,} | {tout:,} | {per_task} |"
        )


def proposals(rows: dict[RowKey, dict[str, Any]], *, minimum: int, floor: float) -> list[dict[str, Any]]:
    found = []
    for key in sorted(rows):
        row = rows[key]
        rate = ok_rate(row)
        if row["closeouts"] < minimum or rate is None or rate >= floor:
            continue
        found.append(
            {
                "class": row["class"],
                "demote": {"seat": row["seat"], "model": row["model"]},
                "reason": f"ok-rate {rate:.0%} over {row['closeouts']} closeouts, below the {floor:.0%} floor",
                "evidence": {
                    "closeouts": row["closeouts"],
                    "ok": row["ok"],
                    "okRate": round(rate, 3),
                    "windowDays": None,
                    "ledger": str(ledger_path()),
                },
            }
        )
    return found


def command_learn(args: argparse.Namespace) -> int:
    since = datetime.now(timezone.utc) - timedelta(days=args.days)
    dispatches, closeouts = read_ledger(since)
    rows = aggregate(dispatches, closeouts)
    found = proposals(rows, minimum=args.min_closeouts, floor=args.ok_floor)
    for proposal in found:
        proposal["evidence"]["windowDays"] = args.days
        proposal["ts"] = now_iso()

    if not found:
        print(
            f"No demotions proposed: no (class, seat, model) reached {args.min_closeouts} closeouts below "
            f"a {args.ok_floor:.0%} ok-rate in {args.days} day(s)."
        )
        return EXIT_OK

    table = load_table(apply_default=False)
    existing = table.get("overrides")
    existing = existing if isinstance(existing, list) else []
    fresh = [
        proposal
        for proposal in found
        if not any(_override_matches(current, proposal["class"], proposal["demote"]) for current in existing)
    ]

    if not args.apply:
        print(f"# route learn — proposed overrides for {table_path()}\n")
        for proposal in found:
            state = "already present" if proposal not in fresh else "new"
            print(
                f"+ {proposal['class']}: demote {proposal['demote']['seat']}/{proposal['demote']['model']} "
                f"({proposal['reason']}) [{state}]"
            )
        print("\nRun `route learn --apply` to write these into the table's `overrides`.")
        return EXIT_OK

    if not fresh:
        print("All proposed demotions are already recorded in the table; nothing written.")
        return EXIT_OK
    table["overrides"] = existing + fresh
    atomic_write(table_path(), json.dumps(table, indent=2) + "\n")
    for proposal in fresh:
        print(f"wrote override: {proposal['class']} demotes {proposal['demote']['seat']}/{proposal['demote']['model']}")
    print(f"table: {table_path()}")
    return EXIT_OK


