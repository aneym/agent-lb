def load_table(*, apply_default: bool = True) -> dict[str, Any]:
    path = table_path()
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"routing table not found at {path}")
    except (OSError, json.JSONDecodeError) as error:
        fail(f"routing table at {path} is unreadable: {error}")
    if not isinstance(value, dict):
        fail(f"routing table at {path} is not an object")
    return apply_implement_default(value) if apply_default else value


def apply_implement_default(table: dict[str, Any]) -> dict[str, Any]:
    """Move the `implement_default` seat to the head of the implement and mechanical chains.

    It is the one-line revert switch for the default implementer (2026-09-28): sonnet-implementer, or
    gpt-implementer to put Sol back in front. A seat missing from a chain leaves that chain as written.
    """
    seat = table.get("implement_default")
    classes = table.get("classes")
    if not isinstance(seat, str) or not isinstance(classes, dict):
        return table
    for name in ("implement", "mechanical"):
        spec = classes.get(name)
        chain = spec.get("chain") if isinstance(spec, dict) else None
        if isinstance(chain, list):
            lead = [entry for entry in chain if isinstance(entry, dict) and entry.get("seat") == seat]
            spec["chain"] = lead + [entry for entry in chain if not any(entry is item for item in lead)]
    return table


def fail(message: str) -> Any:
    print(f"route: {message}", file=sys.stderr)
    raise SystemExit(EXIT_UNROUTABLE)


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{secrets.token_hex(4)}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


# --- versioned seat rules ----------------------------------------------------

SEAT_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
COMMIT_NAME = re.compile(r"^[0-9a-f]{7,64}$")
FULL_COMMIT = re.compile(r"^[0-9a-f]{40}(?:[0-9a-f]{24})?$")


def setup_error(kind: str, message: str, as_json: bool) -> Any:
    print(f"route: {message}", file=sys.stderr)
    if as_json:
        print(json.dumps({"error": kind, "message": message}, sort_keys=True))
    raise SystemExit(EXIT_SETUP)


def policy_paths() -> tuple[Path, Path, Path]:
    clone = _env_path("AGENT_LB_POLICY_SRC", Path.home() / ".agent-lb" / "policy-src")
    managed = clone.parent / "managed" / "coding-agents"
    return clone, managed / "APPLIED", managed / "routing-table.json"


def policy_git(clone: Path, *args: str, binary: bool = False) -> subprocess.CompletedProcess[Any] | None:
    try:
        result = subprocess.run(["git", "-C", str(clone), *args], capture_output=True,
                                text=not binary, timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result if result.returncode == 0 else None


def applied_record(path: Path) -> dict[str, Any] | None:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return (value if isinstance(value, dict) and isinstance(value.get("commit"), str)
            and FULL_COMMIT.fullmatch(value["commit"]) else None)


def versioned_rules(pin: str | None, as_json: bool) -> tuple[dict[str, Any], dict[str, Any], Path]:
    clone, applied_path, installed_path = policy_paths()
    git_ready = clone.is_dir() and policy_git(clone, "rev-parse", "--git-dir") is not None
    source = "installed"
    commit = None
    if pin is not None:
        if not git_ready:
            setup_error("no_rules",
                        f"no policy clone {clone}; APPLIED {applied_path}; installed {installed_path}", as_json)
        if not COMMIT_NAME.fullmatch(pin):
            setup_error("unknown_rules", f"invalid rules commit {pin!r}", as_json)
        source = "pinned"
        revision = policy_git(clone, "rev-parse", "--verify", "--quiet", f"{pin}^{{commit}}")
        if revision is None:
            setup_error("unknown_rules", f"unknown rules commit {pin}", as_json)
        commit = revision.stdout.strip()
    elif git_ready:
        applied = applied_record(applied_path)
        if applied:
            revision = policy_git(clone, "rev-parse", "--verify", "--quiet", f"{applied['commit']}^{{commit}}")
            if revision is not None:
                source = "applied"
                commit = revision.stdout.strip()
    if commit:
        result = policy_git(clone, "show", f"{commit}:config/coding-agents/routing-table.json", binary=True)
        if result is None:
            setup_error("unknown_rules", f"routing table missing at commit {commit}", as_json)
        data = result.stdout
    else:
        try:
            data = installed_path.read_bytes()
        except OSError:
            setup_error("no_rules",
                        f"no policy clone/APPLIED {clone}, {applied_path} or installed table {installed_path}", as_json)
    try:
        table = json.loads(data)
    except (UnicodeError, ValueError):
        table = None
    if (not isinstance(table, dict) or not isinstance(table.get("classes"), dict)
            or not isinstance(table.get("seats"), dict)):
        setup_error("unknown_rules", f"invalid routing table at {commit or installed_path}", as_json)
    return (apply_implement_default(table),
            {"commit": commit, "source": source, "table_sha256": hashlib.sha256(data).hexdigest()}, clone)


def class_seat_entries(classes: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:
    entries = []
    for task_class, spec in classes.items():
        if not isinstance(spec, dict):
            continue
        candidates = list(spec.get("chain", [])) if isinstance(spec.get("chain"), list) else []
        candidates.append(spec.get("second_opinion"))
        audit = spec.get("audit", {})
        if isinstance(audit, dict) and isinstance(audit.get("by_author_vendor"), dict):
            candidates.extend(audit["by_author_vendor"].values())
        entries.extend((task_class, entry) for entry in candidates
                       if isinstance(entry, dict) and isinstance(entry.get("seat"), str))
    return entries


def command_seat(args: argparse.Namespace) -> int:
    table, rules, clone = versioned_rules(args.rules, args.json)
    seats = table["seats"]
    name = args.name
    if not SEAT_NAME.fullmatch(name) or name not in seats:
        setup_error("unknown_seat", f"unknown seat {name!r}", args.json)
    named = [(task_class, entry) for task_class, entry in class_seat_entries(table["classes"])
             if entry["seat"] == name]
    rung = None
    ladder = ladder_entries(table, args.task_class) if args.task_class is not None else None
    if ladder is not None:
        entry = next((entry for entry in ladder if entry["seat"] == name), None)
        if entry is None:
            spec = table["classes"].get(args.task_class, {})
            fallback = spec.get("codex_empty_fallback", {}).get("order", [])
            escalation = spec.get("escalation", {}).get("seat")
            entry = next((item for task, item in named if task == args.task_class), None)
            if entry is None or (name not in fallback and name != escalation):
                setup_error("unknown_class", f"class {args.task_class!r} does not name seat {name}", args.json)
        rung = entry.get("id")
        named = [(args.task_class, entry)]
    if args.task_class is not None:
        if args.task_class not in table["classes"]:
            setup_error("unknown_class", f"unknown class {args.task_class!r} for seat {name}", args.json)
        chosen = [(task_class, entry) for task_class, entry in named if task_class == args.task_class]
        if not chosen and named:
            setup_error("unknown_class", f"class {args.task_class!r} does not name seat {name}", args.json)
    else:
        chosen = named
    if chosen:
        if len({(entry.get("model"), entry.get("effort")) for _, entry in chosen}) != 1:
            setup_error("ambiguous_class",
                        f"seat {name} disagrees across classes {', '.join(dict.fromkeys(c for c, _ in chosen))}",
                        args.json)
        task_class = ("implement" if any(c == "implement" for c, _ in chosen) else chosen[0][0])
        entry = next(entry for c, entry in chosen if c == task_class)
        model_alias, effort = entry.get("model"), entry.get("effort")
    else:
        task_class = None
        model_alias, effort = seats[name].get("model"), seats[name].get("effort")
        if not isinstance(model_alias, str):
            setup_error("unknown_rules", f"seat {name} has no model in seats map", args.json)
    served = ServedModels().get() if model_alias in table.get("aliases", {}) else []
    model, reason = rung_model(table, entry, ServedModels()) if rung else resolve_alias(table, model_alias, served, name)
    if model is None:
        setup_error("unresolved_model", f"alias {model_alias}: {reason}", args.json)
    if rules["commit"]:
        result = policy_git(clone, "show", f"{rules['commit']}:config/coding-agents/agents/{name}.md", binary=True)
        if result is None:
            setup_error("unknown_rules", f"missing definition agents/{name}.md at {rules['commit']}", args.json)
        definition = result.stdout
    else:
        definition_path = Path.home() / ".claude" / "agents" / f"{name}.md"
        try:
            definition = definition_path.read_bytes()
        except OSError:
            setup_error("unknown_rules", f"missing installed definition {definition_path}", args.json)
    seat = seats[name]
    answer = {"seat": name, "class": task_class, "vendor": seat["vendor"], "box": seat["box"],
              "model_alias": model_alias, "model": model, "effort": effort,
              "definition_sha256": hashlib.sha256(definition).hexdigest(), "rules": rules}
    if rung:
        answer["rung"] = rung
    if args.json:
        print(json.dumps(answer, sort_keys=True))
    else:
        box = seat["box"]["adapter"] if isinstance(seat["box"], dict) else "studio only"
        revision = rules["commit"][:12] if rules["commit"] else "installed:" + rules["table_sha256"][:12]
        print(f"{name}: {model} ({model_alias}), effort {effort or '-'}, "
              f"vendor {seat['vendor']}, box {box}, rules {revision}")
    return EXIT_OK


def reduced_entry(entry: dict[str, Any], table: dict[str, Any]) -> dict[str, Any]:
    seat = entry.get("seat")
    model = entry.get("model")
    vendor = entry.get("vendor")
    if not isinstance(vendor, str):
        vendor = table["seats"].get(seat, {}).get("vendor") or vendor_for(entry, pool_for_model(table, model))
    return {"seat": seat, "model": model, "vendor": vendor, "effort": entry.get("effort")}


def command_seats(args: argparse.Namespace) -> int:
    table, rules, _ = versioned_rules(args.rules, args.json)
    ladder_entries(table, "verify")
    for name in table.get("ladders", {}):
        ladder_entries({**table, "ladder": name}, "verify")
    classes = {name: {"chain": [reduced_entry(entry, table) for entry in spec["chain"] if isinstance(entry, dict)]}
               for name, spec in table["classes"].items()
               if isinstance(spec, dict) and isinstance(spec.get("chain"), list)}
    implement = table["classes"].get("implement", {})
    audit = implement.get("audit", {}).get("by_author_vendor", {})
    escalation = implement.get("escalation")
    if (not isinstance(escalation, dict) or not isinstance(escalation.get("seat"), str)
            or type(escalation.get("at_fix_round")) is not int):
        setup_error("unknown_rules", f"invalid classes.implement.escalation: {escalation!r}", args.json)
    answer = {"rules": rules, "seats": table["seats"], "classes": classes,
              "audit": {"by_author_vendor": {name: reduced_entry(entry, table) for name, entry in audit.items()}},
              "escalation": {"implement": {"seat": escalation["seat"], "at_fix_round": escalation["at_fix_round"]}}}
    if "ladders" in table:
        answer["ladder"] = table.get("ladder")
        answer["ladders"] = json.loads(json.dumps(table["ladders"]))
        for ladder in answer["ladders"].values():
            verify = ladder.get("verify")
            if isinstance(verify, dict):
                verify["by_author_maker"] = {maker: [{"id": ref[1:], **verify["rungs"][ref[1:]]}
                    for ref in refs] for maker, refs in verify["by_author_maker"].items()}
    if args.json:
        print(json.dumps(answer))
    else:
        for name, spec in table["seats"].items():
            box = spec.get("box")
            print(f"{name} vendor={spec['vendor']} box={box['adapter'] if isinstance(box, dict) else 'studio'}")
    return EXIT_OK


def rules_status() -> dict[str, Any]:
    clone, applied_path, _ = policy_paths()
    state: dict[str, Any] = {"applied": None, "applied_at": None, "result": None,
                             "origin": None, "behind": None, "diverged": None, "error": "no_rules"}
    applied = applied_record(applied_path) if clone.is_dir() and policy_git(clone, "rev-parse", "--git-dir") else None
    if not applied:
        return state
    revision = policy_git(clone, "rev-parse", "--verify", "--quiet", f"{applied['commit']}^{{commit}}")
    if not revision:
        return state
    state.update(applied=revision.stdout.strip(), applied_at=applied.get("applied_at"), result=applied.get("result"))
    origin = policy_git(clone, "rev-parse", "--verify", "--quiet", "refs/remotes/origin/main")
    if not origin:
        state["error"] = "no_origin"
        return state
    state.update(origin=origin.stdout.strip(), error=None)
    ancestor = policy_git(clone, "merge-base", "--is-ancestor", state["applied"], state["origin"])
    state["diverged"] = ancestor is None
    if ancestor is not None:
        count = policy_git(clone, "rev-list", "--count", f"{state['applied']}..{state['origin']}")
        state["behind"] = int(count.stdout.strip()) if count else None
    return state


# --- HTTP --------------------------------------------------------------------


class HttpResult:
    """One HTTP call: transport success, the status, and the decoded body."""

    def __init__(self, *, ok: bool, status: int | None, body: Any, error: str | None) -> None:
        self.ok = ok
        self.status = status
        self.body = body
        self.error = error

    @property
    def json_ok(self) -> bool:
        return self.ok and self.status == 200 and self.body is not None


def _fixture_file(path: str) -> Path | None:
    directory = (os.environ.get("ROUTE_FIXTURE_DIR") or "").strip()
    if not directory:
        return None
    slug = path.split("?", 1)[0].strip("/").replace("/", "_") or "root"
    return Path(directory).expanduser() / f"{slug}.json"


def _fixture_result(path: str) -> HttpResult:
    fixture = _fixture_file(path)
    assert fixture is not None
    try:
        body = json.loads(fixture.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return HttpResult(ok=False, status=404, body=None, error="HTTP 404 (fixture missing)")
    except (OSError, json.JSONDecodeError) as error:
        return HttpResult(ok=False, status=None, body=None, error=f"fixture unreadable: {error}")
    if isinstance(body, dict) and "__status" in body:
        status = body["__status"]
        return HttpResult(ok=status == 200, status=status, body=body.get("__body"), error=f"HTTP {status}")
    return HttpResult(ok=True, status=200, body=body, error=None)


def _request(method: str, path: str, *, payload: dict[str, Any] | None, timeout: float) -> HttpResult:
    if _fixture_file(path) is not None:
        return _fixture_result(path)
    headers = {"accept": "application/json"}
    data = None
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["content-type"] = "application/json"
        headers["anthropic-version"] = "2023-06-01"
    request = urllib.request.Request(f"{base_url()}{path}", data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310 - operator-set base URL
            raw = response.read().decode("utf-8", errors="replace")
            status = response.status
    except urllib.error.HTTPError as error:
        raw = error.read().decode("utf-8", errors="replace")
        body = _decode(raw)
        return HttpResult(ok=False, status=error.code, body=body, error=f"HTTP {error.code}")
    except TimeoutError:
        return HttpResult(ok=False, status=None, body=None, error="timeout")
    except (OSError, urllib.error.URLError) as error:
        reason = getattr(error, "reason", error)
        if isinstance(reason, TimeoutError) or "timed out" in str(reason).lower():
            return HttpResult(ok=False, status=None, body=None, error="timeout")
        return HttpResult(ok=False, status=None, body=None, error=f"{type(error).__name__}: {reason}")
    return HttpResult(ok=True, status=status, body=_decode(raw), error=None)


def _decode(raw: str) -> Any:
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return None


def http_get(path: str, *, timeout: float = READ_TIMEOUT_SECONDS) -> HttpResult:
    return _request("GET", path, payload=None, timeout=timeout)


def http_post(path: str, payload: dict[str, Any], *, timeout: float) -> HttpResult:
    return _request("POST", path, payload=payload, timeout=timeout)


# --- pools -------------------------------------------------------------------


def pool_exhausted(pool_doc: Any) -> bool:
    """A pool is out when no account is eligible; a headroom label alone never empties it (2026-09-28).

    The eligible count decides when /api/pools reports it; the status label only when it does not.
    """
    if not isinstance(pool_doc, dict):
        return False
    eligible = pool_doc.get("eligibleAccounts")
    if isinstance(eligible, int) and not isinstance(eligible, bool):
        return eligible <= 0
    return pool_doc.get("status") == "exhausted"


def pool_status(headroom: float) -> str:
    if headroom >= POOL_OK_HEADROOM:
        return "ok"
    if headroom >= POOL_LOW_HEADROOM:
        return "low"
    return "exhausted"


def _window(usage: Any, key: str, missing: float) -> float:
    value = usage.get(key) if isinstance(usage, dict) else None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return missing
    return float(value)


def _remaining(account: dict[str, Any]) -> float:
    """What the account can serve now: the lower of its 5-hour and weekly windows."""
    if account.get("status") != "active":
        return 0.0
    usage = account.get("usage")
    # No 5-hour window reported is an unmetered provider, not a spent one.
    return min(_window(usage, "secondaryRemainingPercent", 0.0), _window(usage, "primaryRemainingPercent", 100.0))


_ROUTABLE_STATUSES = frozenset({"active", "rate_limited", "quota_exceeded"})
WEEKLY_CYCLE_HOURS = 168.0


def _account_weekly_pace(account: dict[str, Any]) -> float:
    """Weekly remaining minus the share of the cycle ahead of this account's own reset."""
    remaining = _window(account.get("usage"), "secondaryRemainingPercent", 100.0)
    reset_at = _parse_ts(account.get("resetAtSecondary"))
    hours_left = WEEKLY_CYCLE_HOURS
    if reset_at is not None:
        hours_left = max(0.0, (reset_at - datetime.now(timezone.utc)).total_seconds() / 3600)
    return remaining - min(100.0, hours_left / WEEKLY_CYCLE_HOURS * 100)


def _pool_ids(account: dict[str, Any]) -> list[str]:
    provider = account.get("provider")
    if provider == "anthropic":
        ids = ["anthropic-general"]
        if account.get("fableEligible"):
            ids.append("anthropic-fable")
        return ids
    if provider == "openai":
        return ["openai-codex"]
    if isinstance(provider, str) and provider:
        return [provider]
    return []


def pools_from_accounts(body: Any) -> dict[str, Any]:
    """Approximate C1 from /api/accounts while /api/pools is not deployed yet."""
    accounts = body.get("accounts") if isinstance(body, dict) else body
    if not isinstance(accounts, list):
        accounts = []
    grouped: dict[str, list[dict[str, Any]]] = {}
    for account in accounts:
        if not isinstance(account, dict):
            continue
        for pool_id in _pool_ids(account):
            grouped.setdefault(pool_id, []).append(account)

    pools = []
    for pool_id, members in sorted(grouped.items()):
        # Limited accounts stay in the aggregate at zero, as /api/pools counts them.
        routable = [account for account in members if account.get("status") in _ROUTABLE_STATUSES]
        usable = [account for account in routable if _remaining(account) > 0.0]
        headroom = max((_remaining(account) for account in usable), default=0.0)
        aggregate = statistics.fmean(_remaining(account) for account in routable) if routable else 0.0
        resets = sorted(
            value
            for value in (account.get("resetAtSecondary") for account in (usable or members))
            if isinstance(value, str) and value
        )
        provider = members[0].get("provider") if members else None
        weekly_members = [account for account in routable if account.get("status") in _ROUTABLE_STATUSES]
        weekly_paces = [_account_weekly_pace(account) for account in weekly_members]
        pools.append(
            {
                "id": pool_id,
                "provider": provider,
                "kind": "fable_scoped" if pool_id == "anthropic-fable" else "weekly",
                "accounts": len(members),
                "eligibleAccounts": len(usable),
                "headroomPercent": round(headroom, 1),
                "aggregateRemainingPercent": round(aggregate, 1),
                "resetAt": resets[0] if resets else None,
                "status": pool_status(headroom),
                **({"unavailableReason": "no balance"} if not routable and any(
                    account.get("status") == "paused"
                    and str(account.get("deactivationReason") or "").startswith("balance_exhausted:")
                    for account in members
                ) else {}),
                "source": "accounts_fallback",
                "weeklyRemainingPercent": (
                    round(
                        statistics.fmean(
                            _window(a.get("usage"), "secondaryRemainingPercent", 100.0) for a in weekly_members
                        ),
                        1,
                    )
                    if weekly_members
                    else None
                ),
                "weeklyPacePercent": round(statistics.fmean(weekly_paces), 1) if weekly_paces else None,
            }
        )
    return {"generatedAt": now_iso(), "pools": pools, "source": "accounts_fallback"}


def add_pool_refills(document: dict[str, Any], body: Any) -> None:
    """Attach weekly reset cohorts from the same account windows used by status."""
    accounts = body.get("accounts") if isinstance(body, dict) else body
    if not isinstance(accounts, list):
        return
    for pool in pools_by_id(document).values():
        if pool.get("windowLabel") == "month" or pool.get("id") == "anthropic-fable":
            continue
        resets = []
        now = datetime.now(timezone.utc)
        for account in accounts:
            if not isinstance(account, dict) or account.get("status") not in _ROUTABLE_STATUSES:
                continue
            subscription = account.get("subscription")
            if isinstance(subscription, dict) and str(subscription.get("status") or "").strip().lower() == "canceled":
                continue
            if pool.get("id") not in _pool_ids(account):
                continue
            stamp = _parse_ts(account.get("resetAtSecondary"))
            remaining = _window(account.get("usage"), "secondaryRemainingPercent", 100.0)
            if stamp is not None and stamp.tzinfo is not None and stamp > now:
                resets.append((stamp.astimezone(timezone.utc), remaining))
        if not resets:
            continue
        cohorts = []
        low_resets = []
        for stamp, remaining in sorted(resets):
            if not cohorts or (stamp - cohorts[-1][0]).total_seconds() > 3600:
                cohorts.append([stamp, 0, 0.0])
            cohorts[-1][1] += 1
            cohorts[-1][2] += remaining
            if remaining < 10 and stamp > now:
                low_resets.append(stamp)
        if "refills" not in pool:
            pool["refills"] = [{"at": stamp.isoformat().replace("+00:00", "Z"), "accounts": count,
                                "remainingPercent": round(remaining, 1)} for stamp, count, remaining in cohorts]
        if low_resets:
            pool.setdefault("pace", {})["next_refill_h"] = (min(low_resets) - now).total_seconds() / 3600


def fetch_pools(*, timeout: float = READ_TIMEOUT_SECONDS,
                accounts: HttpResult | None = None, refills: bool = False) -> tuple[dict[str, Any] | None, str | None]:
    """C1 from the LB, else an approximation from /api/accounts, else an error string."""
    direct = http_get("/api/pools", timeout=timeout)
    if direct.json_ok and isinstance(direct.body, dict) and isinstance(direct.body.get("pools"), list):
        document = dict(direct.body)
        document.setdefault("source", "lb")
        if not refills:
            return document, None
        accounts = accounts or http_get("/api/accounts", timeout=timeout)
        if accounts.json_ok:
            try:
                add_pool_refills(document, accounts.body)
            except Exception:
                for pool in pools_by_id(document).values():
                    pool.pop("refills", None)
                    pool.pop("pace", None)
        return document, None
    accounts = accounts or http_get("/api/accounts", timeout=timeout)
    if accounts.json_ok:
        document = pools_from_accounts(accounts.body)
        if refills:
            try:
                add_pool_refills(document, accounts.body)
            except Exception:
                for pool in pools_by_id(document).values():
                    pool.pop("refills", None)
                    pool.pop("pace", None)
        return document, None
    reason = direct.error or f"HTTP {direct.status}"
    return None, f"/api/pools unavailable ({reason}); /api/accounts unavailable ({accounts.error})"


def fetch_stand_ins(timeout: float = 2.0) -> dict:
    """Older or unavailable services do not prevent a pick."""
    empty = {"active": [], "recent": []}
    try:
        response = http_get("/api/pools/stand-ins", timeout=timeout)
        body = response.body
        if not response.json_ok or not isinstance(body, dict):
            return empty
        if any(
            not isinstance(body.get(key), list) or any(not isinstance(row, dict) for row in body[key])
            for key in ("active", "recent")
        ):
            return empty
        return body
    except Exception:
        return empty


def _print_stand_in(record: dict[str, Any]) -> None:
    print(
        f"standing in: {record.get('lane') or record.get('session_id')} "
        f"on {record.get('running')} for {record.get('intended')} since {record.get('since')}, "
        f"back ~{record.get('expected_return') or 'unknown'}"
    )


def command_stand_ins(args: argparse.Namespace) -> int:
