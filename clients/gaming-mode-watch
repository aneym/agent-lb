#!/usr/bin/python3
"""Automatic gaming mode: throttle agent-lb uploads while a game runs on the PC.

Run once a minute by launchd (com.aneyman.agent-lb-gaming-mode). Each run:
  1. `ssh pc tasklist` (read-only; the only thing ever sent to the PC), with the
     OpenSSH post-quantum warning lines stripped. A timeout or failure keeps
     the last known state.
  2. If any process in the game list is running, turn the Studio upload
     throttle ON. When no game has been seen for 2 consecutive polls, turn it
     OFF.
  3. Log every transition with a UTC timestamp.

Game list: ~/.agent-lb/state/gaming-games.txt (one executable name per line,
case-insensitive), else the defaults below. State: ~/.agent-lb/state/
gaming-mode.json. Log: ~/.agent-lb/logs/gaming-mode.log.
"""

import csv
import io
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

HOME = Path(os.environ.get("GAMING_MODE_HOME") or Path.home())
STATE = HOME / ".agent-lb" / "state" / "gaming-mode.json"
GAMES_FILE = HOME / ".agent-lb" / "state" / "gaming-games.txt"
LOG = HOME / ".agent-lb" / "logs" / "gaming-mode.log"
THROTTLE = Path(os.environ.get("GAMING_MODE_THROTTLE_CMD") or HOME / ".agent-lb" / "runtime" / "agent-lb" / ".venv" / "bin" / "agent-lb")
SSH = os.environ.get("GAMING_MODE_SSH") or "/usr/bin/ssh"
DEFAULT_GAMES = (
    "League of Legends.exe",
    "LeagueClient.exe",
    "VALORANT-Win64-Shipping.exe",
    "cs2.exe",
    "dota2.exe",
)
MISSES_TO_RELEASE = 2
SSH_TIMEOUT_SECONDS = 25


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def log(message: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as handle:
        handle.write(f"{now()} {message}\n")


def games() -> list:
    try:
        names = [line.strip() for line in GAMES_FILE.read_text().splitlines()]
        names = [name for name in names if name and not name.startswith("#")]
        if names:
            return names
    except OSError:
        pass
    return list(DEFAULT_GAMES)


def load_state() -> dict:
    try:
        state = json.loads(STATE.read_text())
        return state if isinstance(state, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temp = STATE.with_suffix(".tmp")
    temp.write_text(json.dumps(state) + "\n")
    os.replace(temp, STATE)


def running_images():
    """Set of lowercased image names on the PC, or None when the poll failed."""
    try:
        result = subprocess.run(
            [SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "pc", "tasklist /FO CSV /NH"],
            capture_output=True,
            text=True,
            timeout=SSH_TIMEOUT_SECONDS,
            stdin=subprocess.DEVNULL,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    if result.returncode != 0:
        return None
    images = set()
    lines = [line for line in result.stdout.splitlines() if line.strip() and not line.startswith("**")]
    for row in csv.reader(io.StringIO("\n".join(lines))):
        # CSV rows carry the full image name; the default table format cuts it at
        # 25 characters (VALORANT-Win64-Shipping.exe is 27).
        if row and row[0].strip():
            images.add(row[0].strip().lower())
    return images or None


def set_throttle(on: bool) -> bool:
    try:
        result = subprocess.run(
            [str(THROTTLE), "throttle", "on" if on else "off"],
            capture_output=True,
            text=True,
            timeout=30,
        )
    except (subprocess.TimeoutExpired, OSError) as error:
        log(f"ERROR throttle {'on' if on else 'off'} failed: {error}")
        return False
    if result.returncode != 0:
        log(f"ERROR throttle {'on' if on else 'off'} exit {result.returncode}: {result.stderr.strip()[:200]}")
        return False
    return True


def throttle_enabled() -> bool:
    """The throttle's actual state, so the watcher reconciles instead of trusting its memory."""
    path = HOME / ".agent-lb" / "state" / "upload-throttle.json"
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return True  # the service's default when no state file exists
    return not (isinstance(data, dict) and data.get("enabled") is False)


def main() -> int:
    state = load_state()
    gaming = throttle_enabled()
    misses = int(state.get("misses", 0))
    images = running_images()
    if images is None:
        # ssh failed or timed out: keep the throttle as it is, and restart the
        # idle count so only two consecutive successful idle polls release it.
        state["misses"] = 0
        state["last_poll"] = now()
        state["last_poll_ok"] = False
        save_state(state)
        return 0
    wanted = [name for name in games() if name.lower() in images or name.lower()[:25] in images]
    if wanted:
        misses = 0
        if not gaming and set_throttle(True):
            gaming = True
            log(f"ON  game running: {', '.join(wanted)} -> agent-lb upload throttle on")
    else:
        misses += 1
        if gaming and misses >= MISSES_TO_RELEASE and set_throttle(False):
            gaming = False
            log(f"OFF no game for {misses} consecutive polls -> agent-lb upload throttle off")
    state.update({"gaming": gaming, "note": "gaming mirrors the throttle state; the watcher owns the toggle", "misses": misses, "last_poll": now(), "last_poll_ok": True, "seen": wanted})
    save_state(state)
    return 0


if __name__ == "__main__":
    sys.exit(main())
