#!/usr/bin/env python3
"""Append a native Codex dispatch or closeout to the routing ledger."""
import argparse
import json
import os
from datetime import datetime, timezone
from pathlib import Path


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("event", choices=("dispatch", "closeout"))
    parser.add_argument("--name", required=True)
    parser.add_argument("--class", dest="task_class", required=True)
    parser.add_argument("--model", required=True)
    parser.add_argument("--cwd", default="")
    parser.add_argument("--status", type=int)
    parser.add_argument("--duration", type=float)
    parser.add_argument("--tokens-in", type=int)
    parser.add_argument("--tokens-out", type=int)
    parser.add_argument("--cache-read-tokens", type=int)
    args = parser.parse_args()
    path = Path(os.environ.get("ROUTE_LEDGER") or os.environ.get("DISPATCH_LEDGER") or Path.home() / ".claude/logs/dispatch.jsonl")
    record = {
        "ts": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
        "event": args.event,
        "session_id": f"codex:{args.name}",
        "name": args.name,
        "task_class": args.task_class,
        "subagent_type": "codex-native",
        "model": args.model,
        "transport": "codex-cli",
    }
    if args.event == "dispatch":
        record["cwd"] = args.cwd
    else:
        record.update(ok=args.status == 0, exit_code=args.status, duration_s=args.duration,
                      tokens_in=args.tokens_in, tokens_out=args.tokens_out,
                      cache_read_tokens=args.cache_read_tokens)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, separators=(",", ":")) + "\n")


if __name__ == "__main__":
    main()
