#!/usr/bin/env python3
import json
import os
import plistlib
import selectors
import socket
import socketserver
import stat
import subprocess
import sys
from pathlib import Path

TOOLS = frozenset({"Artifact", "ArtifactComments", "ArtifactData"})


def main():
    owner_file = Path(
        os.environ.get("AGENT_LB_ARTIFACT_OWNER_FILE", str(Path.home() / ".agent-lb/state/artifact-owner.json"))
    )
    owner = json.loads(owner_file.read_text())
    if owner.get("provider") != "anthropic" or not owner.get("account_id") or not owner.get("email"):
        raise ValueError("Artifact owner must identify one Anthropic account")
    env = {
        k: v
        for k, v in os.environ.items()
        if k
        not in {
            "ANTHROPIC_BASE_URL",
            "ANTHROPIC_API_KEY",
            "ANTHROPIC_AUTH_TOKEN",
            "ANTHROPIC_CUSTOM_HEADERS",
            "CLAUDE_CONFIG_DIR",
            "CLAUDECODE",
            "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
            "CLAUDE_CODE_DISABLE_ARTIFACT",
            "CLAUDE_CODE_OAUTH_TOKEN",
            "CLAUDE_CODE_USE_BEDROCK",
            "CLAUDE_CODE_USE_VERTEX",
            "CLAUDE_CODE_USE_FOUNDRY",
        }
    }
    if owner.get("config_dir"):
        env["CLAUDE_CONFIG_DIR"] = owner["config_dir"]
    env["CLAUDE_CODE_ARTIFACT"] = "1"
    env["CLAUDE_CODE_ARTIFACT_AUTO_OPEN"] = "0"
    binary = str(Path.home() / ".local/bin/claude")
    status = subprocess.run([binary, "auth", "status"], env=env, capture_output=True, text=True, timeout=20)
    try:
        auth = json.loads(status.stdout)
    except ValueError:
        raise ValueError("Artifact host could not verify the designated account") from None
    if (
        status.returncode
        or not auth.get("loggedIn")
        or auth.get("authMethod") != "claude.ai"
        or auth.get("email", "").casefold() != owner["email"].casefold()
    ):
        raise ValueError("Artifact host login does not match the designated owner; no account fallback permitted")
    child = subprocess.Popen(
        [binary, "mcp", "serve"],
        env=env,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=sys.stderr,
        text=True,
        bufsize=1,
    )
    pending = {}
    buffers = {"client": b"", "host": b""}
    selector = selectors.DefaultSelector()
    selector.register(sys.stdin, selectors.EVENT_READ, "client")
    selector.register(child.stdout, selectors.EVENT_READ, "host")

    def emit(message):
        sys.stdout.write(json.dumps(message) + "\n")
        sys.stdout.flush()

    try:
        while child.poll() is None:
            for key, _ in selector.select():
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    return
                buffers[key.data] += chunk
                while b"\n" in buffers[key.data]:
                    raw, buffers[key.data] = buffers[key.data].split(b"\n", 1)
                    line = raw.decode("utf-8") + "\n"
                    try:
                        message = json.loads(line)
                    except ValueError:
                        continue
                    if key.data == "client":
                        method = message.get("method", "")
                        request_id = message.get("id")
                        if method == "tools/call" and message.get("params", {}).get("name") not in TOOLS:
                            emit(
                                {
                                    "jsonrpc": "2.0",
                                    "id": request_id,
                                    "error": {
                                        "code": -32602,
                                        "message": "Only native artifact tools are exposed by this host",
                                    },
                                }
                            )
                            continue
                        if method not in {"initialize", "ping", "tools/list", "tools/call"} and not method.startswith(
                            "notifications/"
                        ):
                            if request_id is not None:
                                emit(
                                    {
                                        "jsonrpc": "2.0",
                                        "id": request_id,
                                        "error": {"code": -32601, "message": "Method not exposed by artifact host"},
                                    }
                                )
                            continue
                        if request_id is not None:
                            pending[request_id] = method
                        child.stdin.write(line)
                        child.stdin.flush()
                    else:
                        method = pending.pop(message.get("id"), None)
                        if method == "tools/list" and isinstance(message.get("result"), dict):
                            result = message["result"]
                            result["tools"] = [t for t in result.get("tools", []) if t.get("name") in TOOLS]
                        emit(message)
    finally:
        child.terminate()
        try:
            child.wait(timeout=5)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()


def install_host():
    home = Path.home()
    directory = home / ".agent-lb/artifact-host"
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    label = "com.aneyman.claude-artifact-host"
    plist = home / "Library/LaunchAgents" / f"{label}.plist"
    config = {
        "Label": label,
        "ProgramArguments": [
            sys.executable,
            str(home / ".local/bin/claude-artifact-bridge"),
            "--listen",
            str(directory / "native.sock"),
        ],
        "RunAtLoad": True,
        "StandardErrorPath": str(directory / "host.err"),
        "StandardOutPath": str(directory / "host.out"),
    }
    if plist.exists():
        existing = plistlib.loads(plist.read_bytes())
        existing_args = existing.get("ProgramArguments", [])
        if existing_args:
            existing_args[0] = str(Path(existing_args[0]).resolve())
        config["ProgramArguments"][0] = str(Path(config["ProgramArguments"][0]).resolve())
        if existing != config:
            raise ValueError("Existing artifact service differs; review before replacing")
        return
    plist.parent.mkdir(parents=True, exist_ok=True)
    plist.write_bytes(plistlib.dumps(config))
    subprocess.run(["/bin/launchctl", "bootstrap", f"gui/{os.getuid()}", str(plist)], check=True)


def serve_socket(path):
    target = Path(path)
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if target.parent.stat().st_uid != os.getuid() or target.parent.stat().st_mode & 0o077:
        raise ValueError("Artifact socket directory must be private")

    if target.exists():
        previous = target.lstat()
        if previous.st_uid != os.getuid() or not stat.S_ISSOCK(previous.st_mode):
            raise ValueError("Artifact socket path is not an owned socket")
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
            try:
                probe.connect(str(target))
            except ConnectionRefusedError:
                target.unlink()
            else:
                raise ValueError("Artifact host is already running")

    class Handler(socketserver.BaseRequestHandler):
        def handle(self):
            child = subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve())],
                stdin=self.request,
                stdout=self.request,
                stderr=sys.stderr,
            )
            child.wait()

    class Server(socketserver.ThreadingUnixStreamServer):
        daemon_threads = True

    previous = os.umask(0o077)
    try:
        with Server(str(target), Handler) as server:
            server.serve_forever()
    finally:
        os.umask(previous)
        target.unlink(missing_ok=True)


def connect_socket(path):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.connect(path)
        selector = selectors.DefaultSelector()
        selector.register(sys.stdin, selectors.EVENT_READ, "client")
        selector.register(connection, selectors.EVENT_READ, "host")
        while True:
            for key, _ in selector.select():
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    return
                if key.data == "client":
                    connection.sendall(chunk)
                else:
                    sys.stdout.buffer.write(chunk)
                    sys.stdout.buffer.flush()


if __name__ == "__main__":
    try:
        if len(sys.argv) == 2 and sys.argv[1] == "--install-host":
            install_host()
        elif len(sys.argv) == 3 and sys.argv[1] == "--listen":
            serve_socket(sys.argv[2])
        elif len(sys.argv) == 3 and sys.argv[1] == "--connect":
            connect_socket(sys.argv[2])
        elif len(sys.argv) == 1:
            main()
        else:
            raise ValueError("usage: claude-artifact-bridge [--install-host | --listen PATH | --connect PATH]")
    except (OSError, ValueError, subprocess.SubprocessError):
        print("Artifact host failed; verify owner designation and native Claude login", file=sys.stderr)
        sys.exit(1)
