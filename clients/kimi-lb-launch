#!/usr/bin/env python3

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit


def main() -> None:
    argv = sys.argv[1:]
    model = os.environ.get("AGENT_LB_KIMI_MODEL")
    if not model:
        source = Path(__file__).resolve()
        route_env = dict(os.environ)
        route_env.setdefault("ROUTE_TABLE", str(source.parents[1] / "config/coding-agents/routing-table"))
        resolved = subprocess.run(
            [str(source.with_name("route")), "resolve", "kimi-latest", "--json"],
            env=route_env,
            capture_output=True,
            text=True,
            check=True,
            timeout=30,
        )
        model = json.loads(resolved.stdout)["model"]
    for index, arg in enumerate(argv):
        if arg in {"--model", "-m"} and index + 1 < len(argv):
            model = argv[index + 1]
        elif arg.startswith("--model="):
            model = arg.partition("=")[2]
    base_url = os.environ.get("AGENT_LB_KIMI_BASE_URL") or os.environ.get(
        "CLAUDE_LB_BASE_URL", "https://studio.tailf266ac.ts.net:2455"
    )
    env = os.environ.copy()
    env.update(
        ANTHROPIC_BASE_URL=base_url,
        ANTHROPIC_AUTH_TOKEN=os.environ.get("AGENT_LB_API_KEY")
        or os.environ.get("AGENT_LB_PROXY_API_KEY", "local-kimi"),
        ANTHROPIC_MODEL=model,
        ANTHROPIC_DEFAULT_OPUS_MODEL=model,
        ANTHROPIC_DEFAULT_FABLE_MODEL=model,
        ANTHROPIC_DEFAULT_SONNET_MODEL=model,
        ANTHROPIC_DEFAULT_HAIKU_MODEL=model,
        CLAUDE_CODE_SUBAGENT_MODEL=model,
    )
    env.pop("ANTHROPIC_API_KEY", None)
    for name in ("NO_PROXY", "no_proxy"):
        env[name] = ",".join(
            value for value in (urlsplit(base_url).hostname, "127.0.0.1", "localhost", env.get(name)) if value
        )
    env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"] = "1048576" if "[1m]" in model or model == "kimi-for-coding" else "262144"
    env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = env["CLAUDE_CODE_AUTO_COMPACT_WINDOW"]
    env["CLAUDE_CODE_EFFORT_LEVEL"] = "medium"
    env.setdefault("ENABLE_TOOL_SEARCH", "true")
    env.setdefault("CLAUDE_CODE_WORKFLOWS", "1")
    env.setdefault("API_TIMEOUT_MS", "3000000")
    claude = str(Path.home() / ".local/bin/claude")
    scoped_env = {
        key: value
        for key, value in env.items()
        if key
        in {
            "ANTHROPIC_BASE_URL",
            "ANTHROPIC_MODEL",
            "ANTHROPIC_DEFAULT_OPUS_MODEL",
            "ANTHROPIC_DEFAULT_FABLE_MODEL",
            "ANTHROPIC_DEFAULT_SONNET_MODEL",
            "ANTHROPIC_DEFAULT_HAIKU_MODEL",
        }
        or key
        in {
            "CLAUDE_CODE_SUBAGENT_MODEL",
            "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
            "CLAUDE_CODE_MAX_CONTEXT_TOKENS",
            "CLAUDE_CODE_EFFORT_LEVEL",
        }
    }
    scoped_env["ANTHROPIC_API_KEY"] = ""
    command = [claude, "--settings", json.dumps({"env": scoped_env})]
    if not any(arg in {"--model", "-m"} or arg.startswith("--model=") for arg in argv):
        command.extend(["--model", model])
    if not any(
        arg in {"--permission-mode", "--dangerously-skip-permissions"} or arg.startswith("--permission-mode=")
        for arg in argv
    ):
        command.extend(["--permission-mode", "bypassPermissions"])
    os.execve(claude, [*command, *argv], env)


if __name__ == "__main__":
    main()
