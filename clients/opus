#!/usr/bin/env python3
"""opus: Claude Code harness on the newest Opus (5.5) with genuine 1M context."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

MODEL = "opus[1m]"


def main() -> None:
    if shutil.which("claude") is None:
        print("opus: Claude Code executable 'claude' was not found on PATH", file=sys.stderr)
        raise SystemExit(127)
    argv = list(sys.argv[1:])
    # No forced --autocompact: the compaction window comes from
    # ~/.claude/settings.json (autoCompactWindow). Forcing 1m let orchestrators
    # run for a day at 900k+ tokens, re-reading all of it every turn.
    if "--model" not in argv and "-m" not in argv:
        argv = ["--model", MODEL, *argv]
    launcher = Path(__file__).resolve().with_name("claude-lb-launch")
    os.execv(launcher, [str(launcher), *argv])


if __name__ == "__main__":
    main()