#!/usr/bin/env python3
"""cache-watch: push an alert when Claude sessions stop reading from the prompt cache.

Runs every 10 minutes under launchd. Reads the trailing-hour Anthropic cache
observation from `agent-lb status --json` (alert when under 90% read with at
least 50 requests). Two alert checks in a row write ~/.agent-lb/CACHE_ALERT and
post a macOS notification; one healthy check removes the file. Every new Claude
Code session prints that file through a SessionStart hook, so an agent sees the
problem on its first turn instead of a cost review finding it days later.

Why: 2026-09-21..25 the proxy broke prompt caching twice (43h and 12h) and a
partial fix left teammates rewriting their context on 99% of turns; the only
alert was a pull-only line in `agent-lb status` with a 50% threshold.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
STATE = HOME / ".agent-lb" / "cache-watch.json"
ALERT = HOME / ".agent-lb" / "CACHE_ALERT"
AGENT_LB = os.environ.get("AGENT_LB_BIN", str(HOME / ".local" / "bin" / "agent-lb"))
CONSECUTIVE = 2


def observe() -> dict:
    out = subprocess.run([AGENT_LB, "status", "--json"], capture_output=True, text=True, timeout=60)
    cache = json.loads(out.stdout).get("anthropic_cache") or {}
    return {"state": cache.get("state", "unknown"), "ratio": cache.get("ratio_percent"), "requests": cache.get("request_count")}


def notify(message: str) -> None:
    script = f'display notification {json.dumps(message)} with title "agent-lb: prompt cache"'
    subprocess.run(["/usr/bin/osascript", "-e", script], capture_output=True, timeout=10)


def main() -> int:
    try:
        obs = observe()
    except Exception as exc:  # the watcher must never crash-loop launchd
        obs = {"state": "unknown", "error": type(exc).__name__}
    try:
        prev = json.loads(STATE.read_text())
    except Exception:
        prev = {}
    streak = prev.get("alert_streak", 0) + 1 if obs["state"] == "alert" else 0
    STATE.write_text(json.dumps({**obs, "alert_streak": streak, "at": int(time.time())}))
    if streak >= CONSECUTIVE:
        line = (
            f"Claude prompt cache is failing: {obs['ratio']:.0f}% of input read from cache over the last hour "
            f"({obs['requests']} requests; healthy is 93-98%). Sessions are rewriting their whole context each turn. "
            "Check recent agent-lb deploys to app/core/anthropic or app/modules/proxy, then run "
            "scripts/claude_cache_eval.py."
        )
        if not ALERT.exists():
            notify(line)
        ALERT.write_text(line + "\n")
    elif obs["state"] == "ok" and ALERT.exists():
        ALERT.unlink()
    return 0


if __name__ == "__main__":
    sys.exit(main())
