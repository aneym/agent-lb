#!/usr/bin/env python3
"""cache-watch: alert on sustained prompt-cache failures across client groups.

Runs every 10 minutes under launchd. Two consecutive ALERT observations write
~/.agent-lb/CACHE_ALERT and post a macOS notification; a healthy observation
removes the file. Falls back to agent-lb status when lb-cache is unavailable.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
STATE = HOME / ".agent-lb" / "cache-watch.json"
ALERT = HOME / ".agent-lb" / "CACHE_ALERT"
AGENT_LB = os.environ.get("AGENT_LB_BIN", str(HOME / ".local" / "bin" / "agent-lb"))
LB_CACHE = str(HOME / ".agent-lb" / "bin" / "lb-cache")
CONSECUTIVE = 2


def observe() -> dict:
    try:
        out = subprocess.run([LB_CACHE, "--since", "1h", "--json"],
                             capture_output=True, text=True, timeout=90)
        if out.returncode not in (0, 1, 2):
            raise RuntimeError("lb-cache returned an error")
        result = json.loads(out.stdout)
        if result["verdict"] not in ("OK", "WARN", "ALERT"):
            raise ValueError("invalid lb-cache verdict")
        failing = result.get("failing_checks", [])
        return {"state": result["verdict"].lower(), "checks": failing,
                "source": "lb-cache"}
    except Exception:
        out = subprocess.run([AGENT_LB, "status", "--json"], capture_output=True, text=True, timeout=60)
        if out.returncode:
            raise RuntimeError("agent-lb status failed")
        cache = json.loads(out.stdout).get("anthropic_cache") or {}
        return {"state": cache.get("state", "unknown"), "ratio": cache.get("ratio_percent"),
                "requests": cache.get("request_count"), "source": "agent-lb status"}


def notify(message: str) -> None:
    script = f'display notification {json.dumps(message)} with title "agent-lb: prompt cache"'
    subprocess.run(["/usr/bin/osascript", "-e", script], capture_output=True, timeout=10)


def main() -> int:
    try:
        obs = observe()
        try:
            prev = json.loads(STATE.read_text())
        except Exception:
            prev = {}
        streak = prev.get("alert_streak", 0) + 1 if obs["state"] == "alert" else 0
        STATE.write_text(json.dumps({**obs, "alert_streak": streak, "at": int(time.time())}))
        if streak >= CONSECUTIVE:
            if obs.get("source") == "lb-cache":
                line = ("Prompt cache ALERT: " + ", ".join(obs["checks"]) +
                        ". Inspect the failing check; run lb-cache.")
            else:
                ratio = obs.get("ratio")
                line = (f"Anthropic prompt cache ALERT: {ratio:.0f}% read over the last hour "
                        f"({obs.get('requests')} requests); run lb-cache." if ratio is not None
                        else "Anthropic prompt cache ALERT; run lb-cache.")
            if not ALERT.exists():
                notify(line)
            ALERT.write_text(line + "\n")
        elif obs["state"] == "ok" and ALERT.exists():
            ALERT.unlink()
    except Exception:  # the watcher must never crash-loop launchd
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
