def resolve_model(vendor: str, model: str, control: RunControl | None = None) -> str:
    """Family aliases go through `route resolve`: an alias never reaches a retired model, a retired id named
    outright resolves as an explicit request and is logged, and a blocked id is refused. Route may list the
    vendor's models to resolve an alias, so under a RunControl it runs stoppable, in its own process group."""
    route = os.environ.get("ROUTE_BIN") or str(Path.home() / ".agent-lb" / "bin" / "route")
    try:
        completed = run_stoppable([route, "resolve", model], control, input=None, timeout=90)
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(f"route resolve {model} failed: {error}")
    if completed.returncode != 0:
        fail(completed.stderr.strip() or f"route resolve {model} exited {completed.returncode}")
    resolved = completed.stdout.strip().splitlines()[-1]
    if vendor == "devin" and not DEVIN_FREE_MODEL.match(resolved):
        fail(f"{resolved} is billed per token on Devin; the devin seat runs only SWE-2 (swe-2-high|medium|max)")
    return resolved


_CURSOR_MODELS: dict[str, tuple[str, ...]] = {}


def cursor_models(account: dict[str, Any], control: RunControl | None = None) -> tuple[str, ...]:
    """Discover served ids once per account; unavailable lists do not block dispatch. Under a RunControl the
    listing is a vendor CLI like the run itself: a stop ends its process group."""
    account_id = account["id"]
    if account_id in _CURSOR_MODELS:
        return _CURSOR_MODELS[account_id]
    _CURSOR_MODELS[account_id] = ()
    try:
        result = run_stoppable(
            [cli_bin("cursor"), "models"],
            control,
            input=None,
            env=account_env(account),
            stdin=subprocess.DEVNULL,
            timeout=PROBE_TIMEOUT_SECONDS,
        )
    except (OSError, RuntimeError, subprocess.SubprocessError):
        return ()
    if result.returncode != 0:
        return ()
    text = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", result.stdout)
    ids = [line.split(" - ", 1)[0].strip() for line in text.splitlines() if " - " in line]
    _CURSOR_MODELS[account_id] = tuple(dict.fromkeys(value for value in ids if re.fullmatch(r"[\w.\-]+", value)))
    return _CURSOR_MODELS[account_id]


def check_cursor_model(model: str, candidates: list[dict[str, Any]],
                       control: RunControl | None = None) -> list[dict[str, Any]]:
    """The accounts that serve `model`. A stop during the listings returns the candidates unchecked and lists no
    further account; the caller then ends the run on the stop, never on a half-listed refusal."""
    lists = []
    for account in candidates:
        if control and control.stop_reason():
            return candidates
        lists.append((account, cursor_models(account, control)))
    if control and control.stop_reason():
        return candidates
    listed = tuple(dict.fromkeys(value for _, models in lists for value in models))
    family = re.match(r"^(claude-(?:opus|sonnet)|[a-z]+)-", model)
    prefix = family.group(1) + "-" if family else model.split("-", 1)[0] + "-"
    older = re.fullmatch(r"claude-(opus|sonnet)-5-(?!5(?:-|$)).*?(low|medium|high|xhigh)", model)
    if older:
        name, effort = older.groups()
        pattern = re.compile(rf"^claude-{name}-(\d+)(?:-(\d{{1,2}}))?-{effort}$")
        candidates = []
        for value in listed:
            match = pattern.fullmatch(value)
            if match and (int(match[1]), int(match[2] or 0)) > (5, 0):
                candidates.append(((int(match[1]), int(match[2] or 0)), value))
        newest = max(candidates)[1] if candidates else f"claude-{name}-5-5-{effort}"
        print(f"seat: {model} is superseded by {newest}", file=sys.stderr)
    supported = [account for account, models in lists if not models or model in models]
    if not supported:
        route_path = os.environ.get("ROUTE_BIN") or str(Path.home() / ".agent-lb" / "bin" / "route")
        closest = [value for value in listed if value.startswith(prefix)]
        try:
            router = runpy.run_path(route_path)
            retired = router["retired_patterns"](router["load_table"]())
            closest = [value for value in closest if not router["is_retired"](value, retired)]
        except (Exception, SystemExit):
            pass
        closest = closest[:3]
        fail(f"{model} is not a Cursor model; closest: {', '.join(closest) or 'none'}")
    return supported


def build_command(vendor: str, model: str, mode: str, prompt_file: Path, export_file: Path) -> list[str]:
    if vendor == "cursor":
        command = [cli_bin("cursor"), "-p", "--trust", "--output-format", "json", "--model", model]
        command += ["--mode", "ask"] if mode == "ask" else ["--force"]
        return command
    # Devin's `auto` rejects every shell call in print mode, `ls` included, so a read-only
    # task cannot finish; `smart` runs what Devin's own safety model judges safe.
    permission = "smart" if mode == "ask" else "dangerous"
    return [
        cli_bin("devin"),
        "-p",
        "--model",
        model,
        "--permission-mode",
        permission,
        "--export",
        str(export_file),
        "--prompt-file",
        str(prompt_file),
    ]


def classify(text: str) -> str | None:
    if AUTH_RE.search(text):
        return "auth"
    if LIMIT_RE.search(text):
        return "limit"
    if MODEL_UNAVAILABLE_RE.search(text):
        return "model_unavailable"
    if TRANSIENT_RE.search(text):
        return "transient_infra"
    return None


def cooldown_until(text: str) -> datetime:
    match = RETRY_AFTER_RE.search(text)
    if match:
        unit = {"second": "seconds", "minute": "minutes", "hour": "hours"}[match.group(2).lower()]
        return now() + timedelta(**{unit: int(match.group(1))})
    return now() + DEFAULT_COOLDOWN


def parse_outcome(vendor: str, completed: subprocess.CompletedProcess[str], export_file: Path) -> dict[str, Any]:
    outcome: dict[str, Any] = {
        "ok": False,
        "result": None,
        "session_id": None,
        "tokens_in": None,
        "tokens_out": None,
        "cache_read_tokens": None,
        "error": None,
    }
    stderr = completed.stderr.strip()
    if vendor == "cursor":
        try:
            envelope = json.loads(completed.stdout.strip().splitlines()[-1]) if completed.stdout.strip() else {}
        except json.JSONDecodeError:
            envelope = {}
        usage = envelope.get("usage") if isinstance(envelope.get("usage"), dict) else {}
        outcome.update(
            result=envelope.get("result"),
            session_id=envelope.get("session_id"),
            tokens_in=usage.get("inputTokens"),
            tokens_out=usage.get("outputTokens"),
            cache_read_tokens=usage.get("cacheReadTokens"),
            ok=completed.returncode == 0 and envelope.get("is_error") is False,
        )
        if not outcome["ok"]:
            outcome["error"] = (
                stderr or str(envelope.get("result") or completed.stdout.strip()) or f"exit {completed.returncode}"
            )[:ERROR_CHARS]
        return outcome
    export = read_json(export_file, {}) if export_file.is_file() else {}
    metrics = export.get("final_metrics") if isinstance(export, dict) else None
    metrics = metrics if isinstance(metrics, dict) else {}
    outcome.update(
        result=completed.stdout.strip(),
        session_id=export.get("session_id") if isinstance(export, dict) else None,
        tokens_in=metrics.get("total_prompt_tokens"),
        tokens_out=metrics.get("total_completion_tokens"),
        cache_read_tokens=metrics.get("total_cached_tokens"),
        ok=completed.returncode == 0 and bool(completed.stdout.strip()),
    )
    if not outcome["ok"]:
        outcome["error"] = (stderr or completed.stdout.strip() or f"exit {completed.returncode}")[:ERROR_CHARS]
    return outcome


def order_accounts(
    registry: list[dict[str, Any]], state: dict[str, Any], vendor: str, model: str | None = None
) -> list[dict[str, Any]]:
    """Healthy accounts of the vendor, least used in the last five hours first."""
    window = now() - timedelta(hours=5)
    ready = []
    for account in registry:
        if account.get("vendor") != vendor or account.get("enabled", True) is False:
            continue
        record = state["accounts"].get(account["id"], {})
        pool = cursor_pool(model) if vendor == "cursor" and model else None
        peers = [record]
        if pool and account.get("plan"):
            peers = [
                state["accounts"].get(peer["id"], {})
                for peer in registry
                if peer.get("vendor") == vendor and peer.get("plan") == account["plan"]
            ]
        pool_cooling = pool and any(
            (until := parse_ts((peer.get("cooldowns") or {}).get(pool))) and until > now() for peer in peers
        )
        unavailable = parse_ts((record.get("model_unavailable") or {}).get(model)) if model else None
        if record.get("auth_ok") is False or cooling(record) or pool_cooling or (unavailable and unavailable > now()):
            continue
        leases = [lease for lease in state.get("leases", {}).values() if lease.get("account") == account["id"]]
        recent = usage_since(record, window)["runs"] + len(active_leases(state, account["id"], now()))
        last_use = max([record.get("last_run_at") or ""] + [lease.get("created_at") or "" for lease in leases])
        ready.append((recent, last_use, account))
    ready.sort(key=lambda item: (item[0], item[1]))
    return [account for _, _, account in ready]


def append_ledger(rows: list[dict[str, Any]]) -> None:
    path = ledger_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as stream:
        for row in rows:
            stream.write(json.dumps(row, sort_keys=True) + "\n")


def lease_error(
    code: str, vendor: str, message: str, json_output: bool, skipped: list[dict[str, str]] | None = None
) -> Any:
    print(f"seat: {message}", file=sys.stderr)
    if json_output:
        result: dict[str, Any] = {"error": code, "vendor": vendor, "message": message}
        if skipped is not None:
            result["skipped"] = skipped
        print(json.dumps(result, sort_keys=True))
    raise SystemExit(EXIT_NO_ACCOUNT if code in ("no_account", "unknown_account", "not_leasable") else EXIT_FAILED)


def leasable(account: dict[str, Any]) -> bool:
    return (account.get("vendor"), account.get("auth")) in (("cursor", "api-key"), ("devin", "data-dir"))


def bundle_secret(account: dict[str, Any]) -> str | bytes:
    if account["vendor"] == "cursor":
        return read_cursor_key(account)
    try:
        return (devin_data_dir(account) / "devin" / "credentials.toml").read_bytes()
    except OSError:
        raise RuntimeError(f"credentials missing for {account['id']}") from None


def skip_reason(account: dict[str, Any], state: dict[str, Any]) -> str | None:
    if not leasable(account):
        return "login_not_leasable"
    if account.get("enabled", True) is False:
        return "disabled"
    record = state["accounts"].get(account["id"], {})
    if record.get("auth_ok") is False:
        return "auth_failed"
    if cooling(record):
        return "cooling"
    try:
        bundle_secret(account)
    except RuntimeError as error:
        return (
            "key_file_empty"
            if "empty" in str(error)
            else ("key_file_missing" if account["vendor"] == "cursor" else "credentials_missing")
        )
    return None


def private_file(path: Path, content: bytes) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as stream:
            fd = -1
            stream.write(content)
    finally:
        if fd >= 0:
            os.close(fd)


def private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    path.chmod(0o700)


def write_bundle(
    out: Path, account: dict[str, Any], secret: str | bytes, trusts: list[str], meta: dict[str, str]
) -> None:
    written: list[Path] = []
    try:
        private_dir(out)
        private_dir(out / "data")
        if account["vendor"] == "cursor":
            env = f"CURSOR_API_KEY={shlex.quote(secret)}\nAGENT_CLI_CREDENTIAL_STORE=memory\n".encode()
        else:
            env = b""
            private_dir(out / "data" / "devin")
            private_dir(out / "data" / "devin" / "cli")
            credentials = out / "data" / "devin" / "credentials.toml"
            written.append(credentials)
            private_file(credentials, secret)
            trusted = out / "data" / "devin" / "cli" / "trusted_workspaces.json"
            written.append(trusted)
            private_file(
                trusted, (json.dumps({"trusted_paths": list(dict.fromkeys(trusts))}, indent=2) + "\n").encode()
            )
        env_path = out / "env"
        written.append(env_path)
        private_file(env_path, env)
        metadata = out / "lease.json"
        written.append(metadata)
        private_file(metadata, (json.dumps(meta, indent=2, sort_keys=True) + "\n").encode())
    except OSError:
        for path in written:
            try:
                path.unlink(missing_ok=True)
            except OSError:
                pass
        raise RuntimeError("cannot write lease bundle") from None


def command_lease(args: argparse.Namespace) -> int:
    def apply(registry: list[dict[str, Any]], state: dict[str, Any]) -> dict[str, Any]:
        vendor_accounts = [a for a in registry if a.get("vendor") == args.vendor]
        if args.account:
            candidates = [a for a in vendor_accounts if a["id"] == args.account]
            if not candidates:
                lease_error(
                    "unknown_account", args.vendor, f"no {args.vendor} account {args.account} registered", args.json
                )
            if not leasable(candidates[0]):
                lease_error("not_leasable", args.vendor, f"account {args.account} is not leasable", args.json)
        else:
            candidates = [a for a in order_accounts(registry, state, args.vendor) if leasable(a)]
        selected = None
        secret = None
        for account in candidates:
            try:
                secret = bundle_secret(account)
            except RuntimeError:
                continue
            selected = account
            break
        if selected is None:
            skipped = [
                {"account": a["id"], "reason": skip_reason(a, state) or "credentials_missing"} for a in vendor_accounts
            ]
            if args.account:
                lease_error("no_account", args.vendor, f"no credentials for {args.account}", args.json, skipped)
            message = f"no {args.vendor} account can be leased"
            if skipped:
                message += ": " + ", ".join(f"{s['account']} ({s['reason']})" for s in skipped)
            if args.vendor == "cursor" and skipped and all(s["reason"] == "login_not_leasable" for s in skipped):
                message += (
                    "; keychain login stays on this machine; add an API-key account with "
                    "seat add <id> --vendor cursor --api-key-prompt"
                )
            lease_error("no_account", args.vendor, message, args.json, skipped)
        created = now()
        lease_id = "lease-" + uuid.uuid4().hex
        expiry = iso(created + timedelta(seconds=args.ttl))
        meta = {"lease": lease_id, "vendor": args.vendor, "account": selected["id"], "expires_at": expiry}
        try:
            write_bundle(Path(args.out).expanduser(), selected, secret, args.trust, meta)
        except RuntimeError:
            lease_error("out_failed", args.vendor, "cannot write lease bundle", args.json)
        state["leases"][lease_id] = {
            "vendor": args.vendor,
            "account": selected["id"],
            "for": args.for_id,
            "created_at": iso(created),
            "expires_at": expiry,
            "released_at": None,
            "outcome": None,
        }
        return meta

    try:
        meta = update_state(apply)
    except (OSError, ValueError, TypeError) as error:
        lease_error("state_failed", args.vendor, f"cannot read registry or state: {type(error).__name__}", args.json)
    lease_id = meta["lease"]
    append_ledger(
        [
            {
                "ts": iso(now()),
                "event": "lease",
                "session_id": lease_id,
                "lease": lease_id,
                "subagent_type": SEAT_FOR_VENDOR[args.vendor],
                "vendor": args.vendor,
                "account": meta["account"],
                "for": args.for_id,
                "expires_at": meta["expires_at"],
                "source": "seat",
            }
        ]
    )
    if args.json:
        print(json.dumps(meta, sort_keys=True))
    else:
        print(f"leased {meta['account']} ({args.vendor}) as {lease_id} until {meta['expires_at']}")
    return EXIT_OK


def release_error(lease_id: str, json_output: bool) -> Any:
    message = f"no lease {lease_id}"
    print(f"seat: {message}", file=sys.stderr)
    if json_output:
        print(json.dumps({"error": "unknown_lease", "message": message}, sort_keys=True))
    raise SystemExit(EXIT_NO_ACCOUNT)


def release_diagnostic(kind: str, text: str, reported: bool) -> str:
    if reported:
        return f"outcome {kind} reported by caller"
    if kind in ("model_unavailable", "transient_infra"):
        return f"{kind} in seat log"
    if kind == "error":
        return "seat failed; no limit or auth text in its log"
    match = (AUTH_RE if kind == "auth" else LIMIT_RE).search(text)
    diagnostic = f"{kind} in seat log: {match.group(0)}"
    retry = RETRY_AFTER_RE.search(text) if kind == "limit" else None
    return diagnostic + (f"; {retry.group(0)}" if retry else "")


def release_log(path: str | None) -> tuple[str, bool]:
    if path is None:
        return "", False
    try:
        with Path(path).expanduser().open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            stream.seek(max(0, stream.tell() - 65536))
            text = stream.read().decode("utf-8", errors="replace")
        return re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text), True
    except OSError:
        return "", False


def command_release(args: argparse.Namespace) -> int:
    text, log_read = release_log(args.log)
    usage = release_usage(args.model, args.usage_file)
    outcome = args.outcome or ((classify(text) or "error") if log_read else "unknown")
    if outcome in ("model_unavailable", "transient_infra"):
        outcome = "error"
    snapshot = load_state().get("leases", {}).get(args.lease)
    if snapshot is None:
        release_error(args.lease, args.json)

    def already(lease: dict[str, Any]) -> dict[str, Any]:
        return {
            "lease": args.lease,
            "released": False,
            "reason": "already_released",
            "outcome": lease["outcome"],
            "released_at": lease["released_at"],
        }

    if snapshot.get("released_at") is not None:
        result = already(snapshot)
    else:
        probe_status = None
        if outcome == "auth":
            account = next((a for a in load_registry() if a["id"] == snapshot["account"]), None)
            if account is not None:
                probe, probe_text = run_probe(account)
                if probe.get("auth_ok") is True:
                    probe_status = "ok"
                elif probe_text is not None and classify(probe_text) == "auth" and probe.get("auth_ok") is False:
                    probe_status = "rejected"
            probe_status = probe_status or "inconclusive"

        def apply(registry: list[dict[str, Any]], state: dict[str, Any]) -> dict[str, Any]:
            lease = state["leases"].get(args.lease)
            if lease is None:
                release_error(args.lease, args.json)
            if lease.get("released_at") is not None:
                return already(lease)
            stamp = now()
            ts = iso(stamp)
            wall = round((stamp - (parse_ts(lease["created_at"]) or stamp)).total_seconds(), 1)
            expired = (parse_ts(lease["expires_at"]) or stamp) <= stamp
            lease["released_at"] = ts
            lease["outcome"] = outcome
            record = None
            ok = True if outcome == "ok" else (None if outcome == "unknown" else False)
            if any(a["id"] == lease["account"] for a in registry):
                record = state["accounts"].setdefault(lease["account"], {})
                record["last_run_at"] = ts
                record_run(record, {"ts": ts, **usage, "ok": ok, "wall_s": wall, "run_id": args.lease})
                if outcome == "ok":
                    record["last_error"] = None
                    record["auth_ok"] = True
                elif outcome in ("limit", "auth", "error"):
                    kind = "auth_unconfirmed" if outcome == "auth" and probe_status != "rejected" else outcome
                    record["last_error"] = {
                        "ts": ts,
                        "kind": kind,
                        "text": release_diagnostic(outcome, text, args.outcome is not None),
                    }
                    if outcome == "limit":
                        mark_limit(record, lease["vendor"], args.model or "", text)
                    elif outcome == "auth" and probe_status in ("rejected", "ok"):
                        record["auth_ok"] = probe_status == "ok"
                        record["auth_checked_at"] = ts
                        record["auth_error"] = (
                            "rejected by probe after a leased run" if probe_status == "rejected" else None
                        )
            result = {
                "lease": args.lease,
                "vendor": lease["vendor"],
                "account": lease["account"],
                "for": lease["for"],
                "released": True,
                "outcome": outcome,
                "expired": expired,
                "log_read": log_read,
                "auth_probe": probe_status if outcome == "auth" else None,
                "auth_confirmed": probe_status == "rejected" if outcome == "auth" else None,
                "auth_ok": record.get("auth_ok") if record else None,
                "cooldown_until": record.get("cooldown_until") if record else None,
            }
            result["ledger"] = {
                "ts": ts,
                "event": "release",
                **usage,
                "session_id": args.lease,
                "lease": args.lease,
                "subagent_type": SEAT_FOR_VENDOR[lease["vendor"]],
                "vendor": lease["vendor"],
                "account": lease["account"],
                "for": lease["for"],
                "outcome": outcome,
                "ok": ok,
                "wall_s": wall,
                "expired": expired,
                "source": "seat",
            }
            return result

        result = update_state(apply)
    ledger = result.pop("ledger", None)
    if ledger:
        append_ledger([ledger])
    if args.json:
        print(json.dumps(result, sort_keys=True))
    elif result["released"]:
        print(f"released {args.lease} ({result['account']}): {outcome}")
    else:
        print(f"lease {args.lease} already released")
    return EXIT_OK


def reserve_capacity(task_class: str, vendor: str, job: str, author_vendor: str | None,
                     model: str) -> tuple[int, dict[str, Any]]:
    """A4d: hold a `route reserve` lease for this run's seat, on the rung that runs the caller's model. Returns
    EXIT_OK and the lease, EXIT_CAPACITY_WAIT on a wait, EXIT_NO_ACCOUNT on a refusal, and EXIT_FAILED when route or
    agent-lb cannot answer (fail closed). Route lists no vendor models before the hold is taken."""
    route = os.environ.get("ROUTE_BIN") or str(Path.home() / ".agent-lb" / "bin" / "route")
    argv = [route, "reserve", task_class, "--job", job, "--prefer", SEAT_FOR_VENDOR[vendor], "--model", model,
            "--reason", "seat run", "--json"]
    if author_vendor:
        argv[3:3] = ["--author-vendor", author_vendor]
    try:
        completed = subprocess.run(argv, capture_output=True, text=True, timeout=90, check=False,
                                   start_new_session=True)
    except (OSError, subprocess.TimeoutExpired) as error:
        return EXIT_FAILED, {"status": "error", "reason": f"route reserve failed: {error}"}
    try:
        body = json.loads(completed.stdout.strip().splitlines()[-1])
    except (IndexError, json.JSONDecodeError):
        body = {}
    body = body if isinstance(body, dict) else {}
    status = body.get("status")
    if completed.returncode == EXIT_OK and status == "reserved" and body.get("reservation_id"):
        return EXIT_OK, body
    if completed.returncode == ROUTE_EXIT_WAIT and status == "wait":
        return EXIT_CAPACITY_WAIT, body
    if completed.returncode == EXIT_NO_ACCOUNT and status == "refused":
        return EXIT_NO_ACCOUNT, body
    reason = (body.get("reason") or body.get("message") or completed.stderr.strip()
              or f"route reserve exited {completed.returncode}")
    return EXIT_FAILED, {**body, "reason": reason}


class RunControl:
    """What stops a reserved run. The signal handlers only record (a count and the first time) and never raise, so
    nothing cuts the reserve, the run or the release short; the main loop polls stop_reason() and stops the vendor's
    process group itself. The heartbeat thread marks the lease lost when route says it is gone."""

    def __init__(self) -> None:
        self.signals: list[int] = []
        self.first_signal_at: float | None = None
        self.lost: str | None = None
        self.previous: dict[int, Any] = {}

    def record(self, signum: int, _frame: Any) -> None:
        self.signals.append(signum)
        if self.first_signal_at is None:
            self.first_signal_at = time.monotonic()

    def install(self) -> None:
        for signum in STOP_SIGNALS:
            self.previous[signum] = signal.signal(signum, self.record)

    def restore(self) -> None:
        for signum, handler in self.previous.items():
            signal.signal(signum, handler)

    def stop_reason(self) -> str | None:
        if self.signals:
            return f"cancelled by signal {signal.Signals(self.signals[0]).name}"
        return self.lost


def run_stoppable(command: list[str], control: RunControl | None, *, input: str | None, timeout: float,
                  **kwargs: Any) -> subprocess.CompletedProcess[str]:
    """subprocess.run, except that under a RunControl the command runs in its own process group, which is sent
    SIGTERM once the run must stop and SIGKILL on a second signal or after STOP_GRACE_SECONDS. It returns only once
    the whole group is gone: a descendant that outlives the leader is stopped the same way, so capacity is never
    released while a process of the run still works."""
    if control is None:
        return subprocess.run(command, input=input, capture_output=True, text=True, timeout=timeout, check=False,
                              **kwargs)
    if input is not None:
        kwargs["stdin"] = subprocess.PIPE
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                               start_new_session=True, **kwargs)
    stop = GroupStop(process.pid, control, time.monotonic() + timeout)
    pending = input
    while True:
        try:
            stdout, stderr = process.communicate(pending, timeout=STOP_POLL_SECONDS)
            break
        except subprocess.TimeoutExpired:
            pending = None
        stop.step(leader_done=False)
    stop.drain()
    if stop.timed_out:
        raise subprocess.TimeoutExpired(command, timeout, stdout, stderr)
    return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)


def group_alive(pgid: int) -> bool:
    """Whether any process is left in the group, portably (no /proc on macOS)."""
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


class GroupStop:
    """Escalation for one vendor process group: SIGTERM when the run must stop (or, once the leader has exited,
    when anything is left in its group), SIGKILL on a second stop signal or STOP_GRACE_SECONDS later, SIGKILL at
    once past the run's timeout."""

    def __init__(self, pgid: int, control: RunControl, deadline: float) -> None:
        self.pgid = pgid
        self.control = control
        self.deadline = deadline
        self.termed_at: float | None = None
        self.killed_at: float | None = None
        self.timed_out = False

    def send(self, signum: int) -> None:
        try:
            os.killpg(self.pgid, signum)
        except (ProcessLookupError, PermissionError):
            pass

    def step(self, *, leader_done: bool) -> None:
        clock = time.monotonic()
        if self.killed_at is not None:
            return
        if clock >= self.deadline:
            self.timed_out = not leader_done
            self.send(signal.SIGKILL)
            self.killed_at = clock
        elif self.termed_at is None and (leader_done or self.control.stop_reason()):
            self.send(signal.SIGTERM)
            self.termed_at = clock
        elif self.termed_at is not None and (len(self.control.signals) > 1
                                             or clock - self.termed_at >= STOP_GRACE_SECONDS):
            self.send(signal.SIGKILL)
            self.killed_at = clock

    def drain(self) -> None:
        """The leader is reaped; wait until no process is left in its group."""
        while group_alive(self.pgid):
            self.step(leader_done=True)
            if self.killed_at is not None and time.monotonic() - self.killed_at > STOP_GRACE_SECONDS:
                print(f"seat: process group {self.pgid} survived SIGKILL for {STOP_GRACE_SECONDS:.0f}s",
                      file=sys.stderr)
                return
            time.sleep(STOP_POLL_SECONDS)


class CapacityLease:
    """Renews a reservation every heartbeat_s while the vendor CLI runs, marks the run's control when route says the
    lease is gone, and releases it once."""

    def __init__(self, reservation: dict[str, Any], control: RunControl) -> None:
        self.reservation_id = reservation["reservation_id"]
        self.interval = max(1, int(reservation.get("heartbeat_s") or 300))
        self.route = os.environ.get("ROUTE_BIN") or str(Path.home() / ".agent-lb" / "bin" / "route")
        self.control = control
        self.stopped = threading.Event()
        self.thread = threading.Thread(target=self._beat, name="seat-reservation-heartbeat", daemon=True)

    def _beat(self) -> None:
        while not self.stopped.wait(self.interval):
            try:
                completed = subprocess.run([self.route, "heartbeat", self.reservation_id, "--json"],
                                           capture_output=True, text=True, timeout=30, check=False,
                                           start_new_session=True)
            except (OSError, subprocess.TimeoutExpired) as error:
                print(f"seat: route heartbeat {self.reservation_id} failed: {error}", file=sys.stderr)
                continue
            if completed.returncode == EXIT_NO_ACCOUNT:
                # The lease expired or was ended elsewhere, so another run may hold the slot: stop this one.
                self.control.lost = f"capacity: reservation {self.reservation_id} was lost; the vendor CLI was stopped"
                print(f"seat: reservation {self.reservation_id} is gone; stopping the vendor CLI", file=sys.stderr)
                return
            if completed.returncode != EXIT_OK:
                print(f"seat: route heartbeat {self.reservation_id} exited {completed.returncode}", file=sys.stderr)

    def start(self) -> None:
        self.thread.start()

    def release(self, outcome: str) -> None:
        """Stops the heartbeat, then releases with stop signals blocked and route in its own session, so neither
        SIGTERM nor a terminal Ctrl-C can cut the release short. One retry; a lease route calls gone is done."""
        self.stopped.set()
        if self.thread.is_alive():
            self.thread.join(timeout=5)
        masked = hasattr(signal, "pthread_sigmask")
        previous = signal.pthread_sigmask(signal.SIG_BLOCK, STOP_SIGNALS) if masked else None
        try:
            detail = "not attempted"
            for _attempt in range(2):
                try:
                    completed = subprocess.run(
                        [self.route, "release", self.reservation_id, "--outcome", outcome, "--json"],
                        capture_output=True, text=True, timeout=30, check=False, start_new_session=True)
                except (OSError, subprocess.TimeoutExpired) as error:
                    detail = f"failed: {error}"
                    continue
                if completed.returncode in (EXIT_OK, EXIT_NO_ACCOUNT):
                    return
                detail = f"exited {completed.returncode}"
            print(f"seat: route release {self.reservation_id} {detail}; it expires at its TTL", file=sys.stderr)
        finally:
            if previous is not None:
                signal.pthread_sigmask(signal.SIG_SETMASK, previous)


def run_envelope(args: argparse.Namespace, model: str | None, run_id: str, error: str, **extra: Any) -> None:
    """The envelope of a run that ended before any attempt."""
    print(json.dumps({"ok": False, "vendor": args.vendor, "account": None, "model": model, "run_id": run_id,
                      "vendor_session_id": None, "wall_s": 0, "tokens_in": None, "tokens_out": None,
                      "attempts": [], "error": error, **extra, "result": None}, indent=2))


def ready_candidates(args: argparse.Namespace, registry: list[dict[str, Any]], state: dict[str, Any], model: str,
                     run_id: str) -> tuple[list[dict[str, Any]] | None, int]:
    """The accounts this run may try for `model`, or None and the exit code once it has said why there are none."""
    if args.account:
        candidates = [a for a in registry if a["id"] == args.account and a.get("vendor") == args.vendor]
        if not candidates:
            fail(f"no {args.vendor} account {args.account!r} registered", EXIT_NO_ACCOUNT)
    else:
        candidates = order_accounts(registry, state, args.vendor, model)
    if args.vendor == "cursor" and args.account:
        ready = order_accounts(registry, state, args.vendor, model)
        candidates = [account for account in candidates if account in ready]
    if candidates:
        return candidates, EXIT_OK
    misses = [
        record for account_id, record in state["accounts"].items()
        if any(a["id"] == account_id and a.get("vendor") == args.vendor for a in registry)
        and (until := parse_ts((record.get("model_unavailable") or {}).get(model))) and until > now()
        and (not args.account or account_id == args.account)
    ]
    if misses:
        error = (misses[-1].get("model_unavailable_text") or {}).get(model) or f"Cannot use this model: {model}"
        run_envelope(args, model, run_id, error)
        return None, EXIT_NO_ACCOUNT
    fail(f"no {args.vendor} account is ready (see `seat accounts`)", EXIT_NO_ACCOUNT)
    return None, EXIT_NO_ACCOUNT


def command_run(args: argparse.Namespace) -> int:
    if args.prompt_file:
        prompt_path = Path(args.prompt_file).expanduser()
        prompt = prompt_path.read_text(encoding="utf-8")
    else:
        prompt = " ".join(args.prompt).strip()
    if not prompt:
        fail("empty prompt: pass --prompt-file or a prompt after --")
    cwd = Path(args.cwd or os.getcwd()).expanduser().resolve()
    registry = load_registry() + lease_accounts(args.vendor)
    state = load_state()
    run_id = f"seat-{uuid.uuid4()}"
    if not args.task_class or args.account:
        model = resolve_model(args.vendor, args.model)
        candidates, code = ready_candidates(args, registry, state, model, run_id)
        if candidates is None:
            return code
        if args.vendor == "cursor":
            candidates = check_cursor_model(model, candidates)
        why = "no --class" if not args.task_class else "--account pins one account; a lease is its own admission"
        return run_on_accounts(args, prompt, cwd, model, candidates, run_id, None, why, None)
    # Nothing that could start a vendor CLI runs before the reservation is held: not `route resolve` (which may list
    # the vendor's models), not `cursor-agent models`. Only a check that some account is ready at all comes first.
    if not order_accounts(registry, state, args.vendor):
        fail(f"no {args.vendor} account is ready (see `seat accounts`)", EXIT_NO_ACCOUNT)
    # The recording handlers go in first so a signal during the reserve is acted on inside the try/finally below,
    # never by dying with a lease.
    control = RunControl()
    control.install()
    host = os.environ.get("ROUTE_HOST") or socket.gethostname()
    code, reservation = reserve_capacity(args.task_class, args.vendor, f"seat/{host}/{run_id}", args.author_vendor,
                                         args.model)
    if code != EXIT_OK:
        control.restore()
        run_envelope(args, args.model, run_id, f"capacity: {reservation.get('reason') or 'no capacity'}",
                     wait=reservation.get("wait"))
        return 128 + control.signals[0] if control.signals else code
    code = EXIT_FAILED
    lease: CapacityLease | None = None
    try:
        lease = CapacityLease(reservation, control)
        lease.start()
        code = run_reserved(args, prompt, cwd, registry, state, run_id, reservation, control)
    except SystemExit as stop:
        # A refusal raised under the hold (fail()) still releases below and still yields to a signal's exit code.
        code = stop.code if isinstance(stop.code, int) else EXIT_FAILED
    finally:
        outcome = "cancelled" if control.signals else "ok" if code == EXIT_OK and not control.lost else "failed"
        if lease is None:
            lease = CapacityLease(reservation, control)
        lease.release(outcome)
        control.restore()
    return 128 + control.signals[0] if control.signals else code


EFFORT_SUFFIX = re.compile(r"-(?:low|medium|high|xhigh|max)$")


def same_model(wanted: str, *names: str | None) -> bool:
    """route's same_model: the same name, or the same family alias or model id at another effort, which the class's
    ladder sets (grok-latest runs the mechanical rung's grok-4.7-low)."""
    base = EFFORT_SUFFIX.sub("", wanted)
    return any(name and (wanted == name or base == EFFORT_SUFFIX.sub("", name)) for name in names)


def run_reserved(args: argparse.Namespace, prompt: str, cwd: Path, registry: list[dict[str, Any]],
                 state: dict[str, Any], run_id: str, reservation: dict[str, Any], control: RunControl) -> int:
    """The part of a reserved run that happens under the hold. The model that runs is the reserved one: the caller's
    --model must name it (as its id or rung alias, or as an alias route resolves to it, at any effort), or the run is
    refused."""
    reserved = reservation.get("model")
    if not isinstance(reserved, str) or not reserved:
        run_envelope(args, args.model, run_id, "capacity: the reservation names no model")
        return EXIT_FAILED
    if not same_model(args.model, reserved, reservation.get("alias")):
        caller = resolve_model(args.vendor, args.model, control)
        if (stopped := control.stop_reason()):
            run_envelope(args, args.model, run_id, stopped)
            return EXIT_FAILED
        if not same_model(caller, reserved):
            run_envelope(args, caller, run_id,
                         f"model: {args.model} is {caller}, but the {reservation.get('rung')} reservation holds "
                         f"{reserved}; seat runs only the reserved model")
            return EXIT_NO_ACCOUNT
    if args.vendor == "devin" and not DEVIN_FREE_MODEL.match(reserved):
        fail(f"{reserved} is billed per token on Devin; the devin seat runs only SWE-2 (swe-2-high|medium|max)")
    candidates, code = ready_candidates(args, registry, state, reserved, run_id)
    if candidates is None:
        return code
    if args.vendor == "cursor":
        candidates = check_cursor_model(reserved, candidates, control)
    return run_on_accounts(args, prompt, cwd, reserved, candidates, run_id, reservation["reservation_id"], None,
                           control)


def run_on_accounts(
    args: argparse.Namespace,
    prompt: str,
    cwd: Path,
    model: str,
    candidates: list[dict[str, Any]],
    run_id: str,
    reservation_id: str | None,
    why: str | None,
    control: RunControl | None,
) -> int:
    seat = SEAT_FOR_VENDOR[args.vendor]
    prompt_sha = hashlib.sha256(prompt.encode("utf-8")).hexdigest()
    base = {
        "session_id": run_id,
        "name": None,
        "subagent_type": seat,
        "task_class": args.task_class,
        "model": model,
        "vendor": args.vendor,
        "source": "seat",
        "prompt_sha256": prompt_sha,
        "cwd": str(cwd),
        "reservation": reservation_id,
    }
    unreserved = {} if reservation_id else {"why": why}
    append_ledger([{**base, **unreserved, "ts": iso(now()), "event": "dispatch",
                    "accounts": [a["id"] for a in candidates]}])

    attempts: list[dict[str, Any]] = []
    changes: dict[str, dict[str, Any]] = {}
    outcome: dict[str, Any] = {}
    account: dict[str, Any] = candidates[0]
    started_all = time.monotonic()
    removed_proxies = local_proxy_vars(dict(os.environ))
    if removed_proxies:
        print(f"seat: debug: dropped local proxy variables: {', '.join(removed_proxies)}", file=sys.stderr)
    with tempfile.TemporaryDirectory(prefix="seat-") as scratch:
        prompt_file = Path(scratch) / "prompt.md"
        prompt_file.write_text(prompt, encoding="utf-8")
        limited_plans: set[str] = set()
        kind: str | None = None
        for account in candidates:
            if control and (stopped := control.stop_reason()):
                outcome, kind = {"ok": False, "error": stopped}, "stopped"
                break
            if args.vendor == "cursor" and account.get("plan") in limited_plans:
                continue
            if args.vendor == "devin" and not devin_trusted(account, cwd):
                attempts.append({"account": account["id"], "outcome": "untrusted_workspace"})
                outcome = {
                    "ok": False,
                    "error": f"{cwd} is not a trusted Devin workspace for {account['id']}; "
                    "open `devin` there once interactively to trust it",
                }
                continue
            export_file = Path(scratch) / f"{account['id']}.export.json"
            command = build_command(args.vendor, model, args.mode, prompt_file, export_file)
            for retry in range(2):
                if control and (stopped := control.stop_reason()):
                    outcome, kind = {"ok": False, "error": stopped}, "stopped"
                    break
                started = time.monotonic()
                try:
                    completed = run_stoppable(
                        command,
                        control,
                        cwd=cwd,
                        env=account_env(account),
                        input=prompt_file.read_text(encoding="utf-8") if args.vendor == "cursor" else None,
                        stdin=None if args.vendor == "cursor" else subprocess.DEVNULL,
                        timeout=args.timeout,
                    )
                    outcome = parse_outcome(args.vendor, completed, export_file)
                except subprocess.TimeoutExpired:
                    outcome = {"ok": False, "error": f"timeout after {args.timeout:.0f}s"}
                except (OSError, RuntimeError) as error:
                    outcome = {"ok": False, "error": f"{type(error).__name__}: {error}"[:ERROR_CHARS]}
                wall = round(time.monotonic() - started, 1)
                if control and (stopped := control.stop_reason()):
                    # A signal or a lost lease stopped the CLI: not the account's fault, and nothing else runs.
                    outcome, kind = {"ok": False, "error": stopped}, "stopped"
                    attempts.append({"account": account["id"], "outcome": "cancelled" if control.signals
                                     else "reservation_lost", "wall_s": wall})
                    break
                kind = None if outcome["ok"] else classify(outcome.get("error") or "")
                change = changes.setdefault(account["id"], {"fields": {}, "runs": []})
                fields = change["fields"]
                fields["last_run_at"] = iso(now())
                change["runs"].append(
                    {
                        "ts": iso(now()),
                        "model": model,
                        "ok": outcome["ok"],
                        "wall_s": wall,
                        "tokens_in": outcome.get("tokens_in"),
                        "tokens_out": outcome.get("tokens_out"),
                        "cache_read": outcome.get("cache_read_tokens"),
                        "run_id": run_id,
                    }
                )
                attempts.append(
                    {"account": account["id"], "outcome": "ok" if outcome["ok"] else (kind or "error"), "wall_s": wall}
                )
                if account.get("auth") == "lease":
                    record_lease_usage(
                        account,
                        {
                            "ts": iso(now()),
                            "model": model,
                            "ok": outcome.get("ok"),
                            "wall_s": wall,
                            "tokens_in": outcome.get("tokens_in"),
                            "tokens_out": outcome.get("tokens_out"),
                            "cache_read_tokens": outcome.get("cache_read_tokens"),
                        },
                    )
                if outcome["ok"]:
                    fields["last_error"] = None
                    fields["auth_ok"] = True
                    break
                fields["last_error"] = {"ts": iso(now()), "kind": kind or "error", "text": outcome.get("error")}
                if kind == "limit":
                    mark_limit(fields, args.vendor, model, outcome.get("error") or "")
                    if args.vendor == "cursor" and account.get("plan"):
                        limited_plans.add(account["plan"])
                elif kind == "auth":
                    fields["auth_ok"] = False
                    if args.vendor == "cursor":
                        fields["cooldown_until"] = iso(cooldown_until(outcome.get("error") or ""))
                elif kind == "model_unavailable":
                    until = iso(now() + MODEL_UNAVAILABLE_TTL)
                    fields.setdefault("model_unavailable", {})[model] = until
                    vendor_text = outcome.get("error") or f"Cannot use this model: {model}"
                    fields.setdefault("model_unavailable_text", {})[model] = vendor_text

                    def mark_unavailable(registry: list[dict[str, Any]], state: dict[str, Any]) -> None:
                        if any(entry["id"] == account["id"] for entry in registry):
                            record = state["accounts"].setdefault(account["id"], {})
                            record.setdefault("model_unavailable", {})[model] = until
                            record.setdefault("model_unavailable_text", {})[model] = vendor_text

                    update_state(mark_unavailable)
                elif kind == "transient_infra":
                    if retry == 0:
                        lo, hi = map(float, os.environ.get("SEAT_RETRY_JITTER_S", "5,15").split(","))
                        time.sleep(random.uniform(lo, hi))
                        continue
                else:
                    # A task failure is not the account's fault; another account would repeat it.
                    break

                break
            if outcome.get("ok") or kind not in ("limit", "auth", "model_unavailable", "transient_infra"):
                break

    def apply_run(fresh_registry: list[dict[str, Any]], fresh: dict[str, Any]) -> None:
        known = {entry["id"] for entry in fresh_registry}
        for account_id, change in changes.items():
            if account_id not in known:
                continue
            record = fresh["accounts"].setdefault(account_id, {})
            fields = change["fields"].copy()
            for key in ("cooldowns", "limits", "model_unavailable", "model_unavailable_text"):
                if key in fields:
                    record.setdefault(key, {}).update(fields.pop(key))
            record.update(fields)
            for run in change["runs"]:
                record_run(record, run)

    update_state(apply_run)
    wall_all = round(time.monotonic() - started_all, 1)
    closeout = {
        **base,
        "ts": iso(now()),
        "event": "closeout",
        # The account that answered, or the last one tried when none did.
        "account": attempts[-1]["account"] if attempts else None,
        "attempts": attempts,
        "vendor_session_id": outcome.get("session_id"),
        "duration_s": wall_all,
        "wall_s": wall_all,
        "tokens_in": outcome.get("tokens_in"),
        "tokens_out": outcome.get("tokens_out"),
        "cache_read_tokens": outcome.get("cache_read_tokens"),
        "ok": bool(outcome.get("ok")),
        "error": outcome.get("error"),
    }
    append_ledger([closeout])
    envelope = {
        "ok": closeout["ok"],
        "vendor": args.vendor,
        "account": closeout["account"],
        "model": model,
        "run_id": run_id,
        "vendor_session_id": closeout["vendor_session_id"],
        "wall_s": wall_all,
        "tokens_in": closeout["tokens_in"],
        "tokens_out": closeout["tokens_out"],
        "attempts": attempts,
        "error": closeout["error"],
        "result": outcome.get("result"),
    }
    print(json.dumps(envelope, indent=2))
    if closeout["ok"]:
        return EXIT_OK
    exhausted = attempts and all(
        a["outcome"] in ("limit", "auth", "untrusted_workspace", "model_unavailable", "transient_infra")
        for a in attempts
    )
    return EXIT_NO_ACCOUNT if exhausted else EXIT_FAILED


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="seat", description="Run Cursor and Devin seats on registered accounts.")
    commands = parser.add_subparsers(dest="command", required=True)

    accounts = commands.add_parser("accounts", help="registry, auth, cooldowns and observed usage")
    accounts.add_argument("--json", action="store_true")
    accounts.set_defaults(handler=command_accounts)

    add = commands.add_parser("add", help="register an account")
    add.add_argument("id")
    add.add_argument("--vendor", choices=VENDORS, required=True)
    add.add_argument("--api-key-file", help="Cursor: a 0600 file holding a Cursor user API key")
    add.add_argument("--api-key-prompt", action="store_true", help="Cursor: type the key at a hidden prompt")
    add.add_argument("--data-dir", help="Devin: XDG_DATA_HOME this account logged in under")
    add.set_defaults(handler=command_add)

    setting = commands.add_parser("set", help="set an account's tier and monthly cycle day")
    setting.add_argument("id")
    setting.add_argument("--plan", help="shared subscription plan id; empty clears it")
    setting.add_argument("--tier")
    setting.add_argument("--cycle-day", type=int, choices=range(1, 32))
    setting.add_argument("--json", action="store_true")
    setting.set_defaults(handler=command_set)

    probe = commands.add_parser("probe", help="check each account's auth and record it")
    probe.add_argument("account", nargs="?", help="probe one account and clear its model misses")
    probe.add_argument("--vendor", choices=VENDORS)
    probe.add_argument("--json", action="store_true")
    probe.set_defaults(handler=command_probe)

    lease = commands.add_parser("lease", help="lease one account to a remote attempt")
    lease.add_argument("--vendor", choices=VENDORS, required=True)
    lease.add_argument("--account", help="pin an account, ignoring its health")
    lease.add_argument("--for", dest="for_id", required=True)
    lease.add_argument("--ttl", type=int, required=True)
    lease.add_argument("--trust", action="append", default=[])
    lease.add_argument("--out", required=True)
    lease.add_argument("--json", action="store_true")
    lease.set_defaults(handler=command_lease)

    release = commands.add_parser("release", help="record the outcome of a leased attempt")
    release.add_argument("lease")
    release.add_argument("--log")
    release.add_argument("--model")
    release.add_argument("--usage-file")
    release.add_argument("--outcome", choices=("ok", "limit", "auth", "error"))
    release.add_argument("--json", action="store_true")
    release.set_defaults(handler=command_release)

    run = commands.add_parser("run", help="dispatch one task to a vendor seat")
    run.add_argument("--vendor", choices=VENDORS, required=True)
    run.add_argument("--model", required=True, help="model id or family alias (grok-latest, swe-latest)")
    run.add_argument("--account", help="pin one account; no failover")
    run.add_argument("--class", dest="task_class", help="task class for the ledger (mechanical, explore, ...)")
    run.add_argument("--author-vendor", help="the vendor that wrote the work under review; --class verify needs it")
    run.add_argument("--cwd", help="working directory (default: current)")
    run.add_argument(
        "--mode",
        choices=("ask", "write"),
        default="write",
        help="ask: read-only tools; write: edits and shell (default)",
    )
    run.add_argument("--timeout", type=float, default=DEFAULT_RUN_TIMEOUT_SECONDS)
    run.add_argument("--prompt-file")
    run.add_argument("prompt", nargs="*")
    run.set_defaults(handler=command_run)
    args = parser.parse_args(argv)
    if args.command == "lease":
        if args.ttl < 1:
            parser.error("--ttl must be at least 1")
        if not FOR_RE.fullmatch(args.for_id):
            parser.error("--for must be a valid attempt id")
        if any(not trust.startswith("/") or "\n" in trust for trust in args.trust):
            parser.error("--trust must be an absolute path without a newline")
        if args.vendor == "devin" and not args.trust:
            parser.error("--vendor devin requires at least one --trust")
    if args.command == "run" and args.task_class == "verify" and not args.account and not args.author_vendor:
        parser.error("--class verify reserves a cross-vendor reviewer: pass --author-vendor <vendor that wrote it>")
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    return args.handler(args)


if __name__ == "__main__":
    raise SystemExit(main())
