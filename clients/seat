#!/usr/bin/env python3
# seat — run the CLI-only seats (Cursor, Devin) on registered accounts.
#
# Cursor and Devin traffic cannot pass through the LB: each CLI talks to its own
# backend on its own subscription. agent-lb still owns the accounts: this CLI keeps
# the registry, probes each account's auth, picks an account per dispatch, fails over
# on a limit or auth error, and writes receipts to the dispatch ledger. The LB reads
# the state file this CLI writes and serves it as the `cursor` and `devin` pools of
# /api/pools and as /api/pools/seat-accounts. Stdlib only, same family as `route`.
#
# Commands:
#   seat accounts [--json]                       registry, auth, cooldowns, observed usage
#   seat add <id> --vendor cursor|devin [--api-key-file F | --api-key-prompt] [--data-dir D]
#   seat probe [--vendor V] [--json]             auth status per account, written to state
#   seat lease --vendor V --for ID --ttl S --out DIR [--json]
#   seat release LEASE [--log FILE] [--outcome OUTCOME] [--json]
#   seat run --vendor V --model M [--account A] [--class C] [--cwd D] [--mode ask|write]
#            [--timeout S] (--prompt-file F | -- <prompt>)
#
# Account auth (never printed, never written anywhere but the key file):
#   cursor  auth=login    the CLI's own login (`cursor-agent login`, macOS keychain). One per Mac:
#                         a second login replaces the first, so extra accounts use api-key.
#           auth=api-key  a Cursor user API key read from a 0600 key file into CURSOR_API_KEY,
#                         with its own CURSOR_CONFIG_DIR and AGENT_CLI_CREDENTIAL_STORE=memory.
#                         Without the memory store the CLI saves the key's tokens to the keychain
#                         and replaces the login account (cursor-agent 2026.09.23).
#   devin   auth=data-dir credentials.toml under XDG_DATA_HOME (default ~/.local/share).
#                         Log an extra account in with
#                         `XDG_DATA_HOME=<dir> devin auth login --force-manual-token-flow`.
#
# Env:
#   SEAT_HOME     registry, state and keys (default ~/.agent-lb/seats)
#   ROUTE_LEDGER  dispatch ledger (default ~/.claude/logs/dispatch.jsonl)
#   ROUTE_BIN     route CLI used to resolve family aliases (default ~/.agent-lb/bin/route)
#   SEAT_CURSOR_BIN / SEAT_DEVIN_BIN  CLI binaries (default cursor-agent / devin on PATH)
from __future__ import annotations

import argparse
import fcntl
import getpass
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
import uuid
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Callable, Iterator, TypeVar

VENDORS = ("cursor", "devin")
SEAT_FOR_VENDOR = {"cursor": "cursor-seat", "devin": "devin-seat"}

EXIT_OK = 0
EXIT_FAILED = 1
EXIT_NO_ACCOUNT = 2

PROBE_TIMEOUT_SECONDS = 20.0
DEFAULT_RUN_TIMEOUT_SECONDS = 3600.0
DEFAULT_COOLDOWN = timedelta(hours=1)
RUNS_KEPT = 200
LEASES_KEPT = timedelta(days=7)
ERROR_CHARS = 400
FOR_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,199}\Z")
T = TypeVar("T")

# Devin bills every model except SWE-2 per token; the seat never spends past the subscription.
DEVIN_FREE_MODEL = re.compile(r"^swe-\d+-(?:high|medium|max)$")

# Matched against stderr and the CLI's error text. A limit cools the account down and
# the run fails over; an auth failure marks it for re-login and fails over.
LIMIT_RE = re.compile(
    r"rate.?limit|usage limit|quota|too many requests|\b429\b|limit (?:reached|exceeded)|"
    r"out of (?:credits|usage|requests)|exceeded your|resource.?exhausted|upgrade your plan",
    re.I,
)
AUTH_RE = re.compile(
    r"not logged in|authentication required|unauthori[sz]ed|\b401\b|invalid api key|api key is invalid|"
    r"log ?in again|token (?:has )?expired|reauth",
    re.I,
)
RETRY_AFTER_RE = re.compile(r"try again in (\d+)\s*(second|minute|hour)", re.I)


def seat_home() -> Path:
    return Path(os.environ.get("SEAT_HOME") or Path.home() / ".agent-lb" / "seats").expanduser()


def registry_path() -> Path:
    return seat_home() / "accounts.json"


def state_path() -> Path:
    return seat_home() / "state.json"


def ledger_path() -> Path:
    return Path(os.environ.get("ROUTE_LEDGER") or Path.home() / ".claude" / "logs" / "dispatch.jsonl").expanduser()


def cli_bin(vendor: str) -> str:
    return os.environ.get(f"SEAT_{vendor.upper()}_BIN") or {"cursor": "cursor-agent", "devin": "devin"}[vendor]


def now() -> datetime:
    return datetime.now(timezone.utc)


def iso(value: datetime) -> str:
    return value.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_ts(value: Any) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        stamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    return stamp if stamp.tzinfo else stamp.replace(tzinfo=timezone.utc)


def fail(message: str, code: int = EXIT_FAILED) -> Any:
    print(f"seat: {message}", file=sys.stderr)
    raise SystemExit(code)


def read_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return default
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read {path}: {error}")


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(handle, "w", encoding="utf-8") as stream:
        json.dump(value, stream, indent=2, sort_keys=True)
        stream.write("\n")
    os.chmod(temp, 0o600)
    os.replace(temp, path)


def load_registry() -> list[dict[str, Any]]:
    document = read_json(registry_path(), {"version": 1, "accounts": []})
    accounts = document.get("accounts") if isinstance(document, dict) else None
    return [account for account in accounts or [] if isinstance(account, dict) and account.get("id")]


def load_state() -> dict[str, Any]:
    state = read_json(state_path(), {})
    if not isinstance(state, dict):
        state = {}
    state.setdefault("version", 1)
    if not isinstance(state.get("accounts"), dict):
        state["accounts"] = {}
    if not isinstance(state.get("leases"), dict):
        state["leases"] = {}
    return state


@contextmanager
def state_lock() -> Iterator[None]:
    path = seat_home() / "state.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def update_state(apply: Callable[[list[dict[str, Any]], dict[str, Any]], T]) -> T:
    with state_lock():
        registry = load_registry()
        state = load_state()
        result = apply(registry, state)
        threshold = now() - LEASES_KEPT
        for lease_id, lease in list(state["leases"].items()):
            stamp = parse_ts(lease.get("released_at") or lease.get("expires_at"))
            if stamp is not None and stamp < threshold:
                del state["leases"][lease_id]
        save_state(state, registry)
        return result


def save_state(state: dict[str, Any], registry: list[dict[str, Any]]) -> None:
    # The LB reads vendor and enablement from the state alone, so every registered
    # account is mirrored here and unregistered ones are dropped.
    known = {account["id"]: account for account in registry}
    accounts = state["accounts"]
    for account_id in list(accounts):
        if account_id not in known:
            del accounts[account_id]
    for account_id, account in known.items():
        record = accounts.setdefault(account_id, {})
        record["vendor"] = account.get("vendor")
        record["auth"] = account.get("auth")
        record["enabled"] = account.get("enabled", True) is not False
        record["tier_override"] = account.get("tier")
        record["cycle_day"] = account.get("cycle_day")
        cutoff = (now() - timedelta(days=62)).date().isoformat()
        record["daily"] = {day: usage for day, usage in (record.get("daily") or {}).items() if day >= cutoff}
    state["updated_at"] = iso(now())
    write_json(state_path(), state)


def expand(value: Any) -> Path | None:
    return Path(value).expanduser() if isinstance(value, str) and value else None


def read_cursor_key(account: dict[str, Any]) -> str:
    key_file = expand(account.get("key_file"))
    if key_file is None or not key_file.is_file():
        raise RuntimeError(f"key file missing for {account['id']}")
    try:
        key = key_file.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        raise RuntimeError(f"key file missing for {account['id']}") from None
    if not key:
        raise RuntimeError(f"key file empty for {account['id']}")
    return key


def devin_data_dir(account: dict[str, Any]) -> Path:
    return expand(account.get("data_dir")) or Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")


def account_env(account: dict[str, Any]) -> dict[str, str]:
    """The environment that points the vendor CLI at this account and no other."""
    env = dict(os.environ)
    vendor, auth = account.get("vendor"), account.get("auth")
    if vendor == "cursor" and auth == "api-key":
        env["CURSOR_API_KEY"] = read_cursor_key(account)
        config_dir = seat_home() / "cursor" / account["id"]
        config_dir.mkdir(parents=True, exist_ok=True)
        env["CURSOR_CONFIG_DIR"] = str(config_dir)
        env["AGENT_CLI_CREDENTIAL_STORE"] = "memory"
    elif vendor == "cursor":
        env.pop("CURSOR_API_KEY", None)
        env.pop("AGENT_CLI_CREDENTIAL_STORE", None)
    elif vendor == "devin":
        if expand(account.get("data_dir")) is not None:
            env["XDG_DATA_HOME"] = str(devin_data_dir(account))
    return env


def devin_trusted(account: dict[str, Any], cwd: Path) -> bool:
    data_dir = devin_data_dir(account)
    trusted = read_json(data_dir / "devin" / "cli" / "trusted_workspaces.json", {})
    paths = trusted.get("trusted_paths") if isinstance(trusted, dict) else None
    resolved = cwd.resolve()
    for entry in paths or []:
        try:
            root = Path(entry).resolve()
        except (OSError, TypeError):
            continue
        if resolved == root or root in resolved.parents:
            return True
    return False


# --- probe -----------------------------------------------------------------------


def run_probe(account: dict[str, Any]) -> tuple[dict[str, Any], str | None]:
    vendor = account.get("vendor")
    if vendor == "devin":
        command = [cli_bin("devin"), "auth", "status"]
    elif account.get("auth") == "api-key":
        # `status` and `about` report the keychain login even when CURSOR_API_KEY is set;
        # listing models is the cheapest call that authenticates with the key itself.
        command = [cli_bin("cursor"), "models"]
    else:
        command = [cli_bin("cursor"), "about"]
    started = time.monotonic()
    try:
        completed = subprocess.run(
            command,
            env=account_env(account),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=PROBE_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        return {"auth_ok": False, "auth_error": f"{type(error).__name__}: {error}"[:ERROR_CHARS]}, None
    text = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", completed.stdout + "\n" + completed.stderr)
    if vendor == "cursor" and account.get("auth") == "api-key":
        ok = completed.returncode == 0 and not AUTH_RE.search(text)
        identity = {}
    elif vendor == "cursor":
        email = re.search(r"^User Email\s+(\S+@\S+)\s*$", text, re.M)
        tier = re.search(r"^Subscription Tier\s+(.+?)\s*$", text, re.M)
        ok = completed.returncode == 0 and email is not None
        identity = {"email": email.group(1)} if email else {}
        if tier:
            identity["tier"] = tier.group(1)
    else:
        ok = completed.returncode == 0 and re.search(r"^\s*Logged in", text, re.M) is not None
        identity = {}
        for field, label in (("email", "Email"), ("tier", "Tier"), ("plan", "Plan")):
            found = re.search(rf"^\s*{label}:\s*(.+?)\s*$", text, re.M)
            if found:
                identity[field] = found.group(1)
    result: dict[str, Any] = {
        "auth_ok": ok,
        "auth_checked_at": iso(now()),
        "probe_ms": round((time.monotonic() - started) * 1000),
        "identity": identity,
        "auth_error": None if ok else (text.strip().splitlines() or ["no output"])[0][:ERROR_CHARS],
    }
    return result, text


def probe_account(account: dict[str, Any]) -> dict[str, Any]:
    return run_probe(account)[0]


def apply_probe(account_id: str, probe: dict[str, Any]) -> None:
    def apply(registry: list[dict[str, Any]], state: dict[str, Any]) -> None:
        if any(account["id"] == account_id for account in registry):
            state["accounts"].setdefault(account_id, {}).update(probe)

    update_state(apply)


def command_probe(args: argparse.Namespace) -> int:
    registry = load_registry()
    results = {}
    for account in registry:
        if args.vendor and account.get("vendor") != args.vendor:
            continue
        if account.get("enabled", True) is False:
            continue
        probe = probe_account(account)
        apply_probe(account["id"], probe)
        results[account["id"]] = probe
    if args.json:
        print(json.dumps(results, indent=2, sort_keys=True))
    else:
        for account_id, probe in results.items():
            verdict = "ok" if probe["auth_ok"] else f"FAILED ({probe.get('auth_error')})"
            print(f"{account_id:<24} {verdict}")
    return EXIT_OK if all(probe["auth_ok"] for probe in results.values()) else EXIT_FAILED


# --- accounts and usage ----------------------------------------------------------


def usage_since(record: dict[str, Any], since: datetime) -> dict[str, Any]:
    runs = [run for run in record.get("runs") or [] if (parse_ts(run.get("ts")) or since) > since]
    return {
        "runs": len(runs),
        "ok": sum(1 for run in runs if run.get("ok")),
        "wall_s": round(sum(float(run.get("wall_s") or 0) for run in runs), 1),
        "tokens_in": sum(int(run.get("tokens_in") or 0) for run in runs),
        "tokens_out": sum(int(run.get("tokens_out") or 0) for run in runs),
    }


def cooling(record: dict[str, Any]) -> datetime | None:
    until = parse_ts(record.get("cooldown_until"))
    return until if until and until > now() else None


def active_leases(state: dict[str, Any], account_id: str, current: datetime) -> list[dict[str, Any]]:
    return [
        lease
        for lease in state.get("leases", {}).values()
        if lease.get("account") == account_id
        and lease.get("released_at") is None
        and (parse_ts(lease.get("expires_at")) or current) > current
    ]


def command_accounts(args: argparse.Namespace) -> int:
    registry = load_registry()
    state = load_state()
    day_ago = now() - timedelta(hours=24)
    rows = []
    for account in registry:
        record = state["accounts"].get(account["id"], {})
        until = cooling(record)
        leases = active_leases(state, account["id"], now())
        rows.append(
            {
                "id": account["id"],
                "vendor": account.get("vendor"),
                "auth": account.get("auth"),
                "enabled": account.get("enabled", True) is not False,
                "auth_ok": record.get("auth_ok"),
                "auth_checked_at": record.get("auth_checked_at"),
                "identity": record.get("identity") or {},
                "cooldown_until": iso(until) if until else None,
                "last_error": record.get("last_error"),
                "last_run_at": record.get("last_run_at"),
                "last_24h": usage_since(record, day_ago),
                "leases": {
                    "active": len(leases),
                    "next_expiry": min((lease["expires_at"] for lease in leases), default=None),
                },
            }
        )
    if args.json:
        print(json.dumps({"state": str(state_path()), "accounts": rows}, indent=2, sort_keys=True))
        return EXIT_OK
    print(
        f"{'account':<22} {'vendor':<7} {'auth':<8} {'status':<22} "
        f"{'24h runs':>8} {'tok in':>9} {'tok out':>8} {'leases':>6}"
    )
    for row in rows:
        if not row["enabled"]:
            status = "disabled"
        elif row["cooldown_until"]:
            status = f"cooling to {row['cooldown_until'][11:16]}Z"
        elif row["auth_ok"] is False:
            status = "re-login needed"
        elif row["auth_ok"] is None:
            status = "not probed"
        else:
            status = "ok " + (row["identity"].get("tier") or "")
        usage = row["last_24h"]
        print(
            f"{row['id']:<22} {row['vendor']:<7} {row['auth']:<8} {status:<22} "
            f"{usage['runs']:>8} {usage['tokens_in']:>9} {usage['tokens_out']:>8} {row['leases']['active']:>6}"
        )
    return EXIT_OK


def command_add(args: argparse.Namespace) -> int:
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,40}", args.id):
        fail("account id must be lowercase letters, digits and dashes")
    account: dict[str, Any] = {"id": args.id, "vendor": args.vendor, "enabled": True, "added_at": iso(now())}
    if args.vendor == "cursor":
        if args.api_key_prompt:
            key = getpass.getpass(f"Cursor user API key for {args.id} (input hidden): ").strip()
            if not key:
                fail("no key entered")
            key_file = seat_home() / "keys" / f"{args.id}.key"
            account.update({"auth": "api-key", "key_file": str(key_file)})
        elif args.api_key_file:
            key_file = Path(args.api_key_file).expanduser()
            if not key_file.is_file():
                fail(f"{key_file} does not exist")
            if key_file.stat().st_mode & 0o077:
                fail(f"{key_file} is readable by others; chmod 600 it first")
            account.update({"auth": "api-key", "key_file": str(key_file)})
        else:
            account["auth"] = "login"
    else:
        account["auth"] = "data-dir"
        if args.data_dir:
            account["data_dir"] = str(Path(args.data_dir).expanduser())

    def add(registry: list[dict[str, Any]], state: dict[str, Any]) -> None:
        if any(a["id"] == args.id for a in registry):
            fail(f"account {args.id} already registered")
        if args.vendor == "cursor" and account["auth"] == "login":
            if any(a.get("vendor") == "cursor" and a.get("auth") == "login" for a in registry):
                fail("a Cursor login account exists already; extra Cursor accounts need --api-key-prompt")
        if args.vendor == "devin" and not account.get("data_dir"):
            if any(a.get("vendor") == "devin" and not a.get("data_dir") for a in registry):
                fail("a Devin account on the default data dir exists already; pass --data-dir for this one")
        if args.vendor == "cursor" and args.api_key_prompt:
            key_file.parent.mkdir(parents=True, exist_ok=True)
            descriptor = os.open(key_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
                stream.write(key + "\n")
        registry.append(account)
        write_json(registry_path(), {"version": 1, "accounts": registry})

    update_state(add)
    probe = probe_account(account)
    apply_probe(args.id, probe)
    print(f"registered {args.id} ({args.vendor}, {account['auth']}): auth {'ok' if probe['auth_ok'] else 'FAILED'}")
    return EXIT_OK if probe["auth_ok"] else EXIT_FAILED


def command_set(args: argparse.Namespace) -> int:
    def apply(registry: list[dict[str, Any]], state: dict[str, Any]) -> dict[str, Any]:
        account = next((entry for entry in registry if entry["id"] == args.id), None)
        if account is None:
            fail(f"no account {args.id} registered", EXIT_NO_ACCOUNT)
        if args.tier is not None:
            account["tier"] = args.tier
        if args.cycle_day is not None:
            account["cycle_day"] = args.cycle_day
        write_json(registry_path(), {"version": 1, "accounts": registry})
        return {"id": args.id, "tier": account.get("tier"), "cycle_day": account.get("cycle_day")}

    result = update_state(apply)
    print(json.dumps(result, sort_keys=True) if args.json else f"updated {args.id}")
    return EXIT_OK


def record_run(record: dict[str, Any], run: dict[str, Any]) -> None:
    run = dict(run)
    for field in ("tokens_in", "tokens_out", "cache_read"):
        try:
            run[field] = int(run.get(field) or 0)
        except (TypeError, ValueError, OverflowError):
            run[field] = 0
    record["runs"] = ((record.get("runs") or []) + [run])[-RUNS_KEPT:]
    if run.get("model"):
        day = (parse_ts(run.get("ts")) or now()).astimezone(timezone.utc).date().isoformat()
        bucket = (
            record.setdefault("daily", {})
            .setdefault(day, {})
            .setdefault(run["model"], {"runs": 0, "tokens_in": 0, "tokens_out": 0, "cache_read": 0})
        )
        bucket["runs"] += 1
        for field in ("tokens_in", "tokens_out", "cache_read"):
            bucket[field] += int(run.get(field) or 0)


def release_usage(model: str | None, path: str | None) -> dict[str, Any]:
    empty = {"model": None, "tokens_in": None, "tokens_out": None, "cache_read": None}
    if not model or not path:
        return empty
    try:
        usage = json.loads(Path(path).expanduser().read_text(encoding="utf-8"))
        if not isinstance(usage, dict):
            return empty
        counts = {
            field: usage.get(source)
            for field, source in (
                ("tokens_in", "tokens_in"),
                ("tokens_out", "tokens_out"),
                ("cache_read", "cache_read_tokens"),
            )
        }
        counts = {
            field: int(value) if type(value) is float and value.is_integer() else value
            for field, value in counts.items()
        }
        if any(value is not None and (type(value) is not int or value < 0) for value in counts.values()):
            return empty
        return {"model": model, **counts}
    except (OSError, UnicodeError, json.JSONDecodeError):
        return empty


# --- run -------------------------------------------------------------------------


def resolve_model(vendor: str, model: str) -> str:
    """Family aliases go through `route resolve`, which also refuses retired models."""
    route = os.environ.get("ROUTE_BIN") or str(Path.home() / ".agent-lb" / "bin" / "route")
    try:
        completed = subprocess.run([route, "resolve", model], capture_output=True, text=True, timeout=90, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(f"route resolve {model} failed: {error}")
    if completed.returncode != 0:
        fail(completed.stderr.strip() or f"route resolve {model} exited {completed.returncode}")
    resolved = completed.stdout.strip().splitlines()[-1]
    if vendor == "devin" and not DEVIN_FREE_MODEL.match(resolved):
        fail(f"{resolved} is billed per token on Devin; the devin seat runs only SWE-2 (swe-2-high|medium|max)")
    return resolved


_CURSOR_MODELS: dict[str, tuple[str, ...]] = {}


def cursor_models(account: dict[str, Any]) -> tuple[str, ...]:
    """Discover served ids once per account; unavailable lists do not block dispatch."""
    account_id = account["id"]
    if account_id in _CURSOR_MODELS:
        return _CURSOR_MODELS[account_id]
    _CURSOR_MODELS[account_id] = ()
    try:
        result = subprocess.run(
            [cli_bin("cursor"), "models"], capture_output=True, text=True,
            env=account_env(account), stdin=subprocess.DEVNULL,
            timeout=PROBE_TIMEOUT_SECONDS, check=False,
        )
    except (OSError, RuntimeError, subprocess.SubprocessError):
        return ()
    if result.returncode != 0:
        return ()
    text = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", result.stdout)
    ids = [line.split(" - ", 1)[0].strip() for line in text.splitlines() if " - " in line]
    _CURSOR_MODELS[account_id] = tuple(dict.fromkeys(
        value for value in ids if re.fullmatch(r"[\w.\-]+", value)
    ))
    return _CURSOR_MODELS[account_id]


def check_cursor_model(model: str, candidates: list[dict[str, Any]]) -> list[dict[str, Any]]:
    lists = [(account, cursor_models(account)) for account in candidates]
    listed = tuple(dict.fromkeys(value for _, models in lists for value in models))
    family = re.match(r"^(claude-(?:opus|sonnet)|[a-z]+)-", model)
    prefix = family.group(1) + "-" if family else model.split("-", 1)[0] + "-"
    older = re.fullmatch(r"claude-(opus|sonnet)-5-(?!5(?:-|$)).*?(low|medium|high|xhigh)", model)
    if older:
        name, effort = older.groups()
        pattern = re.compile(rf"^claude-{name}-(\d+)(?:-(\d{{1,2}}))?-{effort}$")
        candidates = []
        for value in listed:
            match = pattern.fullmatch(value)
            if match and (int(match[1]), int(match[2] or 0)) > (5, 0):
                candidates.append(((int(match[1]), int(match[2] or 0)), value))
        newest = max(candidates)[1] if candidates else f"claude-{name}-5-5-{effort}"
        print(f"seat: {model} is superseded by {newest}", file=sys.stderr)
    supported = [account for account, models in lists if not models or model in models]
    if not supported:
        closest = [value for value in listed if value.startswith(prefix)][:3]
        fail(f"{model} is not a Cursor model; closest: {', '.join(closest) or 'none'}")
    return supported


def build_command(vendor: str, model: str, mode: str, prompt_file: Path, export_file: Path) -> list[str]:
    if vendor == "cursor":
        command = [cli_bin("cursor"), "-p", "--trust", "--output-format", "json", "--model", model]
        command += ["--mode", "ask"] if mode == "ask" else ["--force"]
        return command
    # Devin's `auto` rejects every shell call in print mode, `ls` included, so a read-only
    # task cannot finish; `smart` runs what Devin's own safety model judges safe.
    permission = "smart" if mode == "ask" else "dangerous"
    return [
        cli_bin("devin"),
        "-p",
        "--model",
        model,
        "--permission-mode",
        permission,
        "--export",
        str(export_file),
        "--prompt-file",
        str(prompt_file),
    ]


def classify(text: str) -> str | None:
    if AUTH_RE.search(text):
        return "auth"
    if LIMIT_RE.search(text):
        return "limit"
    return None


def cooldown_until(text: str) -> datetime:
    match = RETRY_AFTER_RE.search(text)
    if match:
        unit = {"second": "seconds", "minute": "minutes", "hour": "hours"}[match.group(2).lower()]
        return now() + timedelta(**{unit: int(match.group(1))})
    return now() + DEFAULT_COOLDOWN


def parse_outcome(vendor: str, completed: subprocess.CompletedProcess[str], export_file: Path) -> dict[str, Any]:
    outcome: dict[str, Any] = {
        "ok": False,
        "result": None,
        "session_id": None,
        "tokens_in": None,
        "tokens_out": None,
        "cache_read_tokens": None,
        "error": None,
    }
    stderr = completed.stderr.strip()
    if vendor == "cursor":
        try:
            envelope = json.loads(completed.stdout.strip().splitlines()[-1]) if completed.stdout.strip() else {}
        except json.JSONDecodeError:
            envelope = {}
        usage = envelope.get("usage") if isinstance(envelope.get("usage"), dict) else {}
        outcome.update(
            result=envelope.get("result"),
            session_id=envelope.get("session_id"),
            tokens_in=usage.get("inputTokens"),
            tokens_out=usage.get("outputTokens"),
            cache_read_tokens=usage.get("cacheReadTokens"),
            ok=completed.returncode == 0 and envelope.get("is_error") is False,
        )
        if not outcome["ok"]:
            outcome["error"] = (
                stderr or str(envelope.get("result") or completed.stdout.strip()) or f"exit {completed.returncode}"
            )[:ERROR_CHARS]
        return outcome
    export = read_json(export_file, {}) if export_file.is_file() else {}
    metrics = export.get("final_metrics") if isinstance(export, dict) else None
    metrics = metrics if isinstance(metrics, dict) else {}
    outcome.update(
        result=completed.stdout.strip(),
        session_id=export.get("session_id") if isinstance(export, dict) else None,
        tokens_in=metrics.get("total_prompt_tokens"),
        tokens_out=metrics.get("total_completion_tokens"),
        cache_read_tokens=metrics.get("total_cached_tokens"),
        ok=completed.returncode == 0 and bool(completed.stdout.strip()),
    )
    if not outcome["ok"]:
        outcome["error"] = (stderr or completed.stdout.strip() or f"exit {completed.returncode}")[:ERROR_CHARS]
    return outcome


def order_accounts(registry: list[dict[str, Any]], state: dict[str, Any], vendor: str) -> list[dict[str, Any]]:
    """Healthy accounts of the vendor, least used in the last five hours first."""
    window = now() - timedelta(hours=5)
    ready = []
    for account in registry:
        if account.get("vendor") != vendor or account.get("enabled", True) is False:
            continue
        record = state["accounts"].get(account["id"], {})
        if record.get("auth_ok") is False or cooling(record):
            continue
        leases = [lease for lease in state.get("leases", {}).values() if lease.get("account") == account["id"]]
        recent = usage_since(record, window)["runs"] + len(active_leases(state, account["id"], now()))
        last_use = max([record.get("last_run_at") or ""] + [lease.get("created_at") or "" for lease in leases])
        ready.append((recent, last_use, account))
    ready.sort(key=lambda item: (item[0], item[1]))
    return [account for _, _, account in ready]


def append_ledger(rows: list[dict[str, Any]]) -> None:
    path = ledger_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as stream:
        for row in rows:
            stream.write(json.dumps(row, sort_keys=True) + "\n")


def lease_error(
    code: str, vendor: str, message: str, json_output: bool, skipped: list[dict[str, str]] | None = None
) -> Any:
    print(f"seat: {message}", file=sys.stderr)
    if json_output:
        result: dict[str, Any] = {"error": code, "vendor": vendor, "message": message}
        if skipped is not None:
            result["skipped"] = skipped
        print(json.dumps(result, sort_keys=True))
    raise SystemExit(EXIT_NO_ACCOUNT if code in ("no_account", "unknown_account", "not_leasable") else EXIT_FAILED)


def leasable(account: dict[str, Any]) -> bool:
    return (account.get("vendor"), account.get("auth")) in (("cursor", "api-key"), ("devin", "data-dir"))


def bundle_secret(account: dict[str, Any]) -> str | bytes:
    if account["vendor"] == "cursor":
        return read_cursor_key(account)
    try:
        return (devin_data_dir(account) / "devin" / "credentials.toml").read_bytes()
    except OSError:
        raise RuntimeError(f"credentials missing for {account['id']}") from None


def skip_reason(account: dict[str, Any], state: dict[str, Any]) -> str | None:
    if not leasable(account):
        return "login_not_leasable"
    if account.get("enabled", True) is False:
        return "disabled"
    record = state["accounts"].get(account["id"], {})
    if record.get("auth_ok") is False:
        return "auth_failed"
    if cooling(record):
        return "cooling"
    try:
        bundle_secret(account)
    except RuntimeError as error:
        return (
            "key_file_empty"
            if "empty" in str(error)
            else ("key_file_missing" if account["vendor"] == "cursor" else "credentials_missing")
        )
    return None


def private_file(path: Path, content: bytes) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as stream:
            fd = -1
            stream.write(content)
    finally:
        if fd >= 0:
            os.close(fd)


def private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    path.chmod(0o700)


def write_bundle(
    out: Path, account: dict[str, Any], secret: str | bytes, trusts: list[str], meta: dict[str, str]
) -> None:
    written: list[Path] = []
    try:
        private_dir(out)
        private_dir(out / "data")
        if account["vendor"] == "cursor":
            env = f"CURSOR_API_KEY={shlex.quote(secret)}\nAGENT_CLI_CREDENTIAL_STORE=memory\n".encode()
        else:
            env = b""
            private_dir(out / "data" / "devin")
            private_dir(out / "data" / "devin" / "cli")
            credentials = out / "data" / "devin" / "credentials.toml"
            written.append(credentials)
            private_file(credentials, secret)
            trusted = out / "data" / "devin" / "cli" / "trusted_workspaces.json"
            written.append(trusted)
            private_file(
                trusted, (json.dumps({"trusted_paths": list(dict.fromkeys(trusts))}, indent=2) + "\n").encode()
            )
        env_path = out / "env"
        written.append(env_path)
        private_file(env_path, env)
        metadata = out / "lease.json"
        written.append(metadata)
        private_file(metadata, (json.dumps(meta, indent=2, sort_keys=True) + "\n").encode())
    except OSError:
        for path in written:
            try:
                path.unlink(missing_ok=True)
            except OSError:
                pass
        raise RuntimeError("cannot write lease bundle") from None


def command_lease(args: argparse.Namespace) -> int:
    def apply(registry: list[dict[str, Any]], state: dict[str, Any]) -> dict[str, Any]:
        vendor_accounts = [a for a in registry if a.get("vendor") == args.vendor]
        if args.account:
            candidates = [a for a in vendor_accounts if a["id"] == args.account]
            if not candidates:
                lease_error(
                    "unknown_account", args.vendor, f"no {args.vendor} account {args.account} registered", args.json
                )
            if not leasable(candidates[0]):
                lease_error("not_leasable", args.vendor, f"account {args.account} is not leasable", args.json)
        else:
            candidates = [a for a in order_accounts(registry, state, args.vendor) if leasable(a)]
        selected = None
        secret = None
        for account in candidates:
            try:
                secret = bundle_secret(account)
            except RuntimeError:
                continue
            selected = account
            break
        if selected is None:
            skipped = [
                {"account": a["id"], "reason": skip_reason(a, state) or "credentials_missing"} for a in vendor_accounts
            ]
            if args.account:
                lease_error("no_account", args.vendor, f"no credentials for {args.account}", args.json, skipped)
            message = f"no {args.vendor} account can be leased"
            if skipped:
                message += ": " + ", ".join(f"{s['account']} ({s['reason']})" for s in skipped)
            if args.vendor == "cursor" and skipped and all(s["reason"] == "login_not_leasable" for s in skipped):
                message += (
                    "; keychain login stays on this machine; add an API-key account with "
                    "seat add <id> --vendor cursor --api-key-prompt"
                )
            lease_error("no_account", args.vendor, message, args.json, skipped)
        created = now()
        lease_id = "lease-" + uuid.uuid4().hex
        expiry = iso(created + timedelta(seconds=args.ttl))
        meta = {"lease": lease_id, "vendor": args.vendor, "account": selected["id"], "expires_at": expiry}
        try:
            write_bundle(Path(args.out).expanduser(), selected, secret, args.trust, meta)
        except RuntimeError:
            lease_error("out_failed", args.vendor, "cannot write lease bundle", args.json)
        state["leases"][lease_id] = {
            "vendor": args.vendor,
            "account": selected["id"],
            "for": args.for_id,
            "created_at": iso(created),
            "expires_at": expiry,
            "released_at": None,
            "outcome": None,
        }
        return meta

    try:
        meta = update_state(apply)
    except (OSError, ValueError, TypeError) as error:
        lease_error("state_failed", args.vendor, f"cannot read registry or state: {type(error).__name__}", args.json)
    lease_id = meta["lease"]
    append_ledger(
        [
            {
                "ts": iso(now()),
                "event": "lease",
                "session_id": lease_id,
                "lease": lease_id,
                "subagent_type": SEAT_FOR_VENDOR[args.vendor],
                "vendor": args.vendor,
                "account": meta["account"],
                "for": args.for_id,
                "expires_at": meta["expires_at"],
                "source": "seat",
            }
        ]
    )
    if args.json:
        print(json.dumps(meta, sort_keys=True))
    else:
        print(f"leased {meta['account']} ({args.vendor}) as {lease_id} until {meta['expires_at']}")
    return EXIT_OK


def release_error(lease_id: str, json_output: bool) -> Any:
    message = f"no lease {lease_id}"
    print(f"seat: {message}", file=sys.stderr)
    if json_output:
        print(json.dumps({"error": "unknown_lease", "message": message}, sort_keys=True))
    raise SystemExit(EXIT_NO_ACCOUNT)


def release_diagnostic(kind: str, text: str, reported: bool) -> str:
    if reported:
        return f"outcome {kind} reported by caller"
    if kind == "error":
        return "seat failed; no limit or auth text in its log"
    match = (AUTH_RE if kind == "auth" else LIMIT_RE).search(text)
    diagnostic = f"{kind} in seat log: {match.group(0)}"
    retry = RETRY_AFTER_RE.search(text) if kind == "limit" else None
    return diagnostic + (f"; {retry.group(0)}" if retry else "")


def release_log(path: str | None) -> tuple[str, bool]:
    if path is None:
        return "", False
    try:
        with Path(path).expanduser().open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            stream.seek(max(0, stream.tell() - 65536))
            text = stream.read().decode("utf-8", errors="replace")
        return re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text), True
    except OSError:
        return "", False


def command_release(args: argparse.Namespace) -> int:
    text, log_read = release_log(args.log)
    usage = release_usage(args.model, args.usage_file)
    outcome = args.outcome or ((classify(text) or "error") if log_read else "unknown")
    snapshot = load_state().get("leases", {}).get(args.lease)
    if snapshot is None:
        release_error(args.lease, args.json)

    def already(lease: dict[str, Any]) -> dict[str, Any]:
        return {
            "lease": args.lease,
            "released": False,
            "reason": "already_released",
            "outcome": lease["outcome"],
            "released_at": lease["released_at"],
        }

    if snapshot.get("released_at") is not None:
        result = already(snapshot)
    else:
        probe_status = None
        if outcome == "auth":
            account = next((a for a in load_registry() if a["id"] == snapshot["account"]), None)
            if account is not None:
                probe, probe_text = run_probe(account)
                if probe.get("auth_ok") is True:
                    probe_status = "ok"
                elif probe_text is not None and classify(probe_text) == "auth" and probe.get("auth_ok") is False:
                    probe_status = "rejected"
            probe_status = probe_status or "inconclusive"

        def apply(registry: list[dict[str, Any]], state: dict[str, Any]) -> dict[str, Any]:
            lease = state["leases"].get(args.lease)
            if lease is None:
                release_error(args.lease, args.json)
            if lease.get("released_at") is not None:
                return already(lease)
            stamp = now()
            ts = iso(stamp)
            wall = round((stamp - (parse_ts(lease["created_at"]) or stamp)).total_seconds(), 1)
            expired = (parse_ts(lease["expires_at"]) or stamp) <= stamp
            lease["released_at"] = ts
            lease["outcome"] = outcome
            record = None
            ok = True if outcome == "ok" else (None if outcome == "unknown" else False)
            if any(a["id"] == lease["account"] for a in registry):
                record = state["accounts"].setdefault(lease["account"], {})
                record["last_run_at"] = ts
                record_run(record, {"ts": ts, **usage, "ok": ok, "wall_s": wall, "run_id": args.lease})
                if outcome == "ok":
                    record["last_error"] = None
                    record["auth_ok"] = True
                elif outcome in ("limit", "auth", "error"):
                    kind = "auth_unconfirmed" if outcome == "auth" and probe_status != "rejected" else outcome
                    record["last_error"] = {
                        "ts": ts,
                        "kind": kind,
                        "text": release_diagnostic(outcome, text, args.outcome is not None),
                    }
                    if outcome == "limit":
                        record["cooldown_until"] = iso(cooldown_until(text))
                    elif outcome == "auth" and probe_status in ("rejected", "ok"):
                        record["auth_ok"] = probe_status == "ok"
                        record["auth_checked_at"] = ts
                        record["auth_error"] = (
                            "rejected by probe after a leased run" if probe_status == "rejected" else None
                        )
            result = {
                "lease": args.lease,
                "vendor": lease["vendor"],
                "account": lease["account"],
                "for": lease["for"],
                "released": True,
                "outcome": outcome,
                "expired": expired,
                "log_read": log_read,
                "auth_probe": probe_status if outcome == "auth" else None,
                "auth_confirmed": probe_status == "rejected" if outcome == "auth" else None,
                "auth_ok": record.get("auth_ok") if record else None,
                "cooldown_until": record.get("cooldown_until") if record else None,
            }
            result["ledger"] = {
                "ts": ts,
                "event": "release",
                **usage,
                "session_id": args.lease,
                "lease": args.lease,
                "subagent_type": SEAT_FOR_VENDOR[lease["vendor"]],
                "vendor": lease["vendor"],
                "account": lease["account"],
                "for": lease["for"],
                "outcome": outcome,
                "ok": ok,
                "wall_s": wall,
                "expired": expired,
                "source": "seat",
            }
            return result

        result = update_state(apply)
    ledger = result.pop("ledger", None)
    if ledger:
        append_ledger([ledger])
    if args.json:
        print(json.dumps(result, sort_keys=True))
    elif result["released"]:
        print(f"released {args.lease} ({result['account']}): {outcome}")
    else:
        print(f"lease {args.lease} already released")
    return EXIT_OK


def command_run(args: argparse.Namespace) -> int:
    if args.prompt_file:
        prompt_path = Path(args.prompt_file).expanduser()
        prompt = prompt_path.read_text(encoding="utf-8")
    else:
        prompt = " ".join(args.prompt).strip()
    if not prompt:
        fail("empty prompt: pass --prompt-file or a prompt after --")
    cwd = Path(args.cwd or os.getcwd()).expanduser().resolve()
    model = resolve_model(args.vendor, args.model)
    registry = load_registry()
    state = load_state()
    if args.account:
        candidates = [a for a in registry if a["id"] == args.account and a.get("vendor") == args.vendor]
        if not candidates:
            fail(f"no {args.vendor} account {args.account!r} registered", EXIT_NO_ACCOUNT)
    else:
        candidates = order_accounts(registry, state, args.vendor)
    if not candidates:
        fail(f"no {args.vendor} account is ready (see `seat accounts`)", EXIT_NO_ACCOUNT)
    if args.vendor == "cursor":
        candidates = check_cursor_model(model, candidates)

    run_id = f"seat-{uuid.uuid4()}"
    seat = SEAT_FOR_VENDOR[args.vendor]
    prompt_sha = hashlib.sha256(prompt.encode("utf-8")).hexdigest()
    base = {
        "session_id": run_id,
        "name": None,
        "subagent_type": seat,
        "task_class": args.task_class,
        "model": model,
        "vendor": args.vendor,
        "source": "seat",
        "prompt_sha256": prompt_sha,
        "cwd": str(cwd),
    }
    append_ledger([{**base, "ts": iso(now()), "event": "dispatch", "accounts": [a["id"] for a in candidates]}])

    attempts: list[dict[str, Any]] = []
    changes: dict[str, dict[str, Any]] = {}
    outcome: dict[str, Any] = {}
    account: dict[str, Any] = candidates[0]
    started_all = time.monotonic()
    with tempfile.TemporaryDirectory(prefix="seat-") as scratch:
        prompt_file = Path(scratch) / "prompt.md"
        prompt_file.write_text(prompt, encoding="utf-8")
        for account in candidates:
            if args.vendor == "devin" and not devin_trusted(account, cwd):
                attempts.append({"account": account["id"], "outcome": "untrusted_workspace"})
                outcome = {
                    "ok": False,
                    "error": f"{cwd} is not a trusted Devin workspace for {account['id']}; "
                    "open `devin` there once interactively to trust it",
                }
                continue
            export_file = Path(scratch) / f"{account['id']}.export.json"
            command = build_command(args.vendor, model, args.mode, prompt_file, export_file)
            started = time.monotonic()
            try:
                completed = subprocess.run(
                    command,
                    cwd=cwd,
                    env=account_env(account),
                    input=prompt_file.read_text(encoding="utf-8") if args.vendor == "cursor" else None,
                    stdin=None if args.vendor == "cursor" else subprocess.DEVNULL,
                    capture_output=True,
                    text=True,
                    timeout=args.timeout,
                    check=False,
                )
                outcome = parse_outcome(args.vendor, completed, export_file)
            except subprocess.TimeoutExpired:
                outcome = {"ok": False, "error": f"timeout after {args.timeout:.0f}s"}
            except (OSError, RuntimeError) as error:
                outcome = {"ok": False, "error": f"{type(error).__name__}: {error}"[:ERROR_CHARS]}
            wall = round(time.monotonic() - started, 1)
            kind = None if outcome["ok"] else classify(outcome.get("error") or "")
            change = changes.setdefault(account["id"], {"fields": {}, "runs": []})
            fields = change["fields"]
            fields["last_run_at"] = iso(now())
            change["runs"].append(
                {
                    "ts": iso(now()),
                    "model": model,
                    "ok": outcome["ok"],
                    "wall_s": wall,
                    "tokens_in": outcome.get("tokens_in"),
                    "tokens_out": outcome.get("tokens_out"),
                    "cache_read": outcome.get("cache_read_tokens"),
                    "run_id": run_id,
                }
            )
            attempts.append(
                {"account": account["id"], "outcome": "ok" if outcome["ok"] else (kind or "error"), "wall_s": wall}
            )
            if outcome["ok"]:
                fields["last_error"] = None
                fields["auth_ok"] = True
                break
            fields["last_error"] = {"ts": iso(now()), "kind": kind or "error", "text": outcome.get("error")}
            if kind == "limit":
                fields["cooldown_until"] = iso(cooldown_until(outcome.get("error") or ""))
            elif kind == "auth":
                fields["auth_ok"] = False
            else:
                # A task failure is not the account's fault; another account would repeat it.
                break

    def apply_run(fresh_registry: list[dict[str, Any]], fresh: dict[str, Any]) -> None:
        known = {entry["id"] for entry in fresh_registry}
        for account_id, change in changes.items():
            if account_id not in known:
                continue
            record = fresh["accounts"].setdefault(account_id, {})
            record.update(change["fields"])
            for run in change["runs"]:
                record_run(record, run)

    update_state(apply_run)
    wall_all = round(time.monotonic() - started_all, 1)
    closeout = {
        **base,
        "ts": iso(now()),
        "event": "closeout",
        # The account that answered, or the last one tried when none did.
        "account": attempts[-1]["account"] if attempts else None,
        "attempts": attempts,
        "vendor_session_id": outcome.get("session_id"),
        "duration_s": wall_all,
        "wall_s": wall_all,
        "tokens_in": outcome.get("tokens_in"),
        "tokens_out": outcome.get("tokens_out"),
        "cache_read_tokens": outcome.get("cache_read_tokens"),
        "ok": bool(outcome.get("ok")),
        "error": outcome.get("error"),
    }
    append_ledger([closeout])
    envelope = {
        "ok": closeout["ok"],
        "vendor": args.vendor,
        "account": closeout["account"],
        "model": model,
        "run_id": run_id,
        "vendor_session_id": closeout["vendor_session_id"],
        "wall_s": wall_all,
        "tokens_in": closeout["tokens_in"],
        "tokens_out": closeout["tokens_out"],
        "attempts": attempts,
        "error": closeout["error"],
        "result": outcome.get("result"),
    }
    print(json.dumps(envelope, indent=2))
    if closeout["ok"]:
        return EXIT_OK
    exhausted = attempts and all(a["outcome"] in ("limit", "auth", "untrusted_workspace") for a in attempts)
    return EXIT_NO_ACCOUNT if exhausted else EXIT_FAILED


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="seat", description="Run Cursor and Devin seats on registered accounts.")
    commands = parser.add_subparsers(dest="command", required=True)

    accounts = commands.add_parser("accounts", help="registry, auth, cooldowns and observed usage")
    accounts.add_argument("--json", action="store_true")
    accounts.set_defaults(handler=command_accounts)

    add = commands.add_parser("add", help="register an account")
    add.add_argument("id")
    add.add_argument("--vendor", choices=VENDORS, required=True)
    add.add_argument("--api-key-file", help="Cursor: a 0600 file holding a Cursor user API key")
    add.add_argument("--api-key-prompt", action="store_true", help="Cursor: type the key at a hidden prompt")
    add.add_argument("--data-dir", help="Devin: XDG_DATA_HOME this account logged in under")
    add.set_defaults(handler=command_add)

    setting = commands.add_parser("set", help="set an account's tier and monthly cycle day")
    setting.add_argument("id")
    setting.add_argument("--tier")
    setting.add_argument("--cycle-day", type=int, choices=range(1, 32))
    setting.add_argument("--json", action="store_true")
    setting.set_defaults(handler=command_set)

    probe = commands.add_parser("probe", help="check each account's auth and record it")
    probe.add_argument("--vendor", choices=VENDORS)
    probe.add_argument("--json", action="store_true")
    probe.set_defaults(handler=command_probe)

    lease = commands.add_parser("lease", help="lease one account to a remote attempt")
    lease.add_argument("--vendor", choices=VENDORS, required=True)
    lease.add_argument("--account", help="pin an account, ignoring its health")
    lease.add_argument("--for", dest="for_id", required=True)
    lease.add_argument("--ttl", type=int, required=True)
    lease.add_argument("--trust", action="append", default=[])
    lease.add_argument("--out", required=True)
    lease.add_argument("--json", action="store_true")
    lease.set_defaults(handler=command_lease)

    release = commands.add_parser("release", help="record the outcome of a leased attempt")
    release.add_argument("lease")
    release.add_argument("--log")
    release.add_argument("--model")
    release.add_argument("--usage-file")
    release.add_argument("--outcome", choices=("ok", "limit", "auth", "error"))
    release.add_argument("--json", action="store_true")
    release.set_defaults(handler=command_release)

    run = commands.add_parser("run", help="dispatch one task to a vendor seat")
    run.add_argument("--vendor", choices=VENDORS, required=True)
    run.add_argument("--model", required=True, help="model id or family alias (grok-latest, swe-latest)")
    run.add_argument("--account", help="pin one account; no failover")
    run.add_argument("--class", dest="task_class", help="task class for the ledger (mechanical, explore, ...)")
    run.add_argument("--cwd", help="working directory (default: current)")
    run.add_argument(
        "--mode",
        choices=("ask", "write"),
        default="write",
        help="ask: read-only tools; write: edits and shell (default)",
    )
    run.add_argument("--timeout", type=float, default=DEFAULT_RUN_TIMEOUT_SECONDS)
    run.add_argument("--prompt-file")
    run.add_argument("prompt", nargs="*")
    run.set_defaults(handler=command_run)
    args = parser.parse_args(argv)
    if args.command == "lease":
        if args.ttl < 1:
            parser.error("--ttl must be at least 1")
        if not FOR_RE.fullmatch(args.for_id):
            parser.error("--for must be a valid attempt id")
        if any(not trust.startswith("/") or "\n" in trust for trust in args.trust):
            parser.error("--trust must be an absolute path without a newline")
        if args.vendor == "devin" and not args.trust:
            parser.error("--vendor devin requires at least one --trust")
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    return args.handler(args)


if __name__ == "__main__":
    raise SystemExit(main())
