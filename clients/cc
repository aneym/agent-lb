#!/usr/bin/env python3
"""cc: canonical Claude Code harness with Opus 5.5 as the driver (owner, 2026-09-22)."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> None:
    opus = Path(__file__).resolve().with_name("opus")
    os.execv(opus, [str(opus), *sys.argv[1:]])


if __name__ == "__main__":
    main()
