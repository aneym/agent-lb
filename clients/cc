#!/usr/bin/env python3
"""cc: canonical Claude Code harness with Fable 5 as the driver."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> None:
    fable = Path(__file__).resolve().with_name("fable")
    os.execv(fable, [str(fable), *sys.argv[1:]])


if __name__ == "__main__":
    main()
