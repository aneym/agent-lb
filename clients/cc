#!/usr/bin/env python3
"""cc: canonical Claude Code harness with Opus 5.5 as the driver."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> None:
    argv = list(sys.argv[1:])
    if not any(arg == "--autocompact" or arg.startswith("--autocompact=") for arg in argv):
        argv = ["--autocompact", "1m", *argv]
    launcher = Path(__file__).resolve().with_name("claude-lb-launch")
    os.execv(launcher, [str(launcher), *argv])


if __name__ == "__main__":
    main()
