#!/usr/bin/env python3
"""cc: canonical Claude Code harness with Opus 5.5 as the driver (owner, 2026-09-22)."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path


def build_args(argv: list[str]) -> list[str]:
    """Keep ordinary cc unchanged except for the approved auto-mode default.

    --codex-lane explicitly loads the reviewed local plugin for this session.
    This never installs a plugin, accepts folder trust, or changes credentials.
    """
    args = list(argv)
    lane = "--codex-lane" in args
    if lane:
        args.remove("--codex-lane")
        plugin = Path.home() / ".agent-lb/plugins/codex-plugin-cc/plugins/codex"
        if not (plugin / ".claude-plugin/plugin.json").is_file():
            raise SystemExit(f"cc: reviewed Codex plugin is missing at {plugin}; stop and restore it")
        args = ["--plugin-dir", str(plugin), *args]
    if not any(arg == "--permission-mode" or arg.startswith("--permission-mode=")
               or arg == "--dangerously-skip-permissions" for arg in args):
        args = ["--permission-mode", "auto", *args]
    return args


def pane_policy() -> str:
    """The factory's agent-pane-policy helper, or exit: an unattended launch never runs without it."""
    for found in (os.environ.get("AGENT_PANE_POLICY_BIN"), shutil.which("agent-pane-policy"),
                  str(Path.home() / ".agent-rails/factory-runtime/bin/agent-pane-policy")):
        if found and os.access(found, os.X_OK):
            return found
    raise SystemExit("cc: --unattended needs agent-pane-policy (factory bin) and it is missing; stop and install it")


def main() -> None:
    opus = Path(__file__).resolve().with_name("opus")
    argv = sys.argv[1:]
    # factory-operations 103 (2026-10-09): an unattended CoS, scoping or lead launch (--unattended or
    # AGENT_UNATTENDED=1) runs under `agent-pane-policy exec`; a tab Alex talks to stays plain cc.
    unattended = "--unattended" in argv or os.environ.get("AGENT_UNATTENDED") == "1"
    argv = [arg for arg in argv if arg != "--unattended"]
    args = build_args(argv)
    if unattended:
        helper = pane_policy()
        os.execv(helper, [helper, "exec", "--", str(opus), *args])
    os.execv(opus, [str(opus), *args])


if __name__ == "__main__":
    main()
