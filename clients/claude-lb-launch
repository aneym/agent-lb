#!/usr/bin/env python3

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from claude_lb_common import (  # pyrefly: ignore[missing-import]
    CA_CERT,
    CCGPT_MODE,
    EXIT_TEMPFAIL,
    SHIM_START_TIMEOUT_DEFAULT,
    STALL_TIMEOUT_DEFAULT,
    LaunchConfig,
    activity_path,
    arg_value,
    env_float,
    headless_invocation,
    proxy_ready_path,
    raise_fd_soft_limit,
)
from claude_lb_endpoints import prepare_ccgpt_endpoint, prepare_interactive_endpoint, print_lb_banner  # pyrefly: ignore[missing-import]
from claude_lb_snapshot import bounded_process_snapshots
from claude_lb_gpt_stream import run_gpt_stream
from claude_lb_network import bypass_anthropic_proxy, lb_enabled, run_opus_doctor, schedule_opus_doctor  # pyrefly: ignore[missing-import]
from claude_lb_process import (  # pyrefly: ignore[missing-import]
    auto_resume_enabled,
    build_command,
    claude_session_args,
    derive_session_id,
    run_headless_with_resume,
    run_supervised,
)
from claude_lb_proxy import run_lb_proxy, start_lb_proxy  # pyrefly: ignore[missing-import]
from claude_lb_quota import anthropic_quota_key, requested_effort, requested_model  # pyrefly: ignore[missing-import]
from claude_lb_tags import resolve_lane_tags, safe_tag, tag_headers  # pyrefly: ignore[missing-import]


def check_working_directory() -> None:
    try:
        os.getcwd()
        with os.scandir(".") as entries:
            next(entries, None)
    except OSError as error:
        print(
            f"cc: cannot read the current working directory: {error.strerror}. "
            "Change to an accessible directory and retry. Claude was not started; "
            "raising file-descriptor limits will not fix directory access.",
            file=sys.stderr,
        )
        raise SystemExit(1) from error


def main() -> None:
    for name in ("GH_TOKEN", "GITHUB_TOKEN"):
        os.environ.pop(name, None)
    if len(sys.argv) >= 6 and sys.argv[1] == "--lb-proxy":
        run_lb_proxy(sys.argv[2], sys.argv[3], int(sys.argv[4]), sys.argv[5])
        return
    if len(sys.argv) >= 2 and sys.argv[1] == "--desktop-proxy":
        listen_port = int(sys.argv[2] if len(sys.argv) >= 3 else os.environ.get("CLAUDE_LB_DESKTOP_PROXY_PORT", "2458"))
        upstream = (sys.argv[3] if len(sys.argv) >= 4 else LaunchConfig.base_url).rstrip("/")
        run_lb_proxy(
            str(proxy_ready_path("desktop")),
            "",
            None,
            upstream,
            listen_port=listen_port,
            shared=True,
        )
        return

    check_working_directory()
    raise_fd_soft_limit(65536)

    if sys.argv[1:] == ["--doctor"]:
        sys.exit(run_opus_doctor())
    if sys.argv[1:] == ["--doctor-nightly"]:
        sys.exit(run_opus_doctor(nightly=True))

    schedule_opus_doctor()

    argv = sys.argv[1:]
    if not headless_invocation(argv):
        os.environ.setdefault("CLAUDE_CODE_NO_FLICKER", "1")
    tag_reason = resolve_lane_tags(argv)
    resolved_tags = tag_headers(os.environ)
    custom_tags = {name: value for name, value in resolved_tags.items() if "\r" not in value and "\n" not in value}
    if custom_tags:
        custom_headers = [
            line
            for line in os.environ.get("ANTHROPIC_CUSTOM_HEADERS", "").splitlines()
            if line.partition(":")[0].strip().lower() not in custom_tags
        ]
        custom_headers.extend(f"{name}: {value}" for name, value in custom_tags.items())
        os.environ["ANTHROPIC_CUSTOM_HEADERS"] = "\n".join(custom_headers)
    routed = False
    session_id = ""
    if lb_enabled():
        session_id = derive_session_id(argv)
        if CCGPT_MODE:
            endpoint_ready = prepare_ccgpt_endpoint()
        elif headless_invocation(argv):
            endpoint_ready = print_lb_banner(argv, session_id)
        else:
            endpoint_ready = prepare_interactive_endpoint()
        if endpoint_ready:
            try:
                proxy_url = start_lb_proxy(session_id)

                os.environ["HTTPS_PROXY"] = proxy_url
                os.environ["https_proxy"] = proxy_url

                for name in ("NO_PROXY", "no_proxy"):
                    exclusions = [entry.strip() for entry in os.environ.get(name, "").split(",") if entry.strip()]
                    for host in ("127.0.0.1", "localhost"):
                        if not any(entry.lower() == host for entry in exclusions):
                            exclusions.append(host)
                    os.environ[name] = ",".join(exclusions)

                os.environ["NODE_EXTRA_CA_CERTS"] = str(CA_CERT)

                os.environ.pop("ANTHROPIC_BASE_URL", None)
                os.environ.pop("ANTHROPIC_UNIX_SOCKET", None)
                os.environ.pop("_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL", None)
                os.environ.pop("CLAUDE_CODE_OAUTH_TOKEN", None)

                os.environ.pop("ANTHROPIC_AUTH_TOKEN", None)
                os.environ.pop("ANTHROPIC_API_KEY", None)
                routed = True
            except RuntimeError as error:
                label = "ccgpt" if CCGPT_MODE else "cc"
                if os.environ.get("CLAUDE_LB_ALLOW_FALLBACK") != "1":
                    timeout = env_float("CLAUDE_LB_SHIM_START_TIMEOUT", SHIM_START_TIMEOUT_DEFAULT)
                    print(
                        f"{label}: proxy did not start within {timeout:g} seconds "
                        "(CLAUDE_LB_SHIM_START_TIMEOUT); exit 75 (retryable). "
                        "Set CLAUDE_LB_ALLOW_FALLBACK=1 to allow plain Claude fallback",
                        file=sys.stderr,
                    )
                    sys.exit(EXIT_TEMPFAIL)
                print(f"{label}: {error}", file=sys.stderr)
        if not routed:
            if CCGPT_MODE or os.environ.get("CLAUDE_LB_REQUIRE") == "1":
                label = "ccgpt" if CCGPT_MODE else "cc"
                print(f"{label}: refusing to bypass agent-lb or fall back to Claude", file=sys.stderr)
                sys.exit(1)
            print(
                "cc: falling back to plain claude (load balancer unavailable; using your normal Claude auth)",
                file=sys.stderr,
            )

    elif CCGPT_MODE or os.environ.get("CLAUDE_LB_REQUIRE") == "1":
        label = "ccgpt" if CCGPT_MODE else "cc"
        print(f"{label}: CLAUDE_LB_DISABLE is not allowed for this fail-closed command", file=sys.stderr)
        sys.exit(1)

    if not routed:
        bypass_anthropic_proxy()

    os.environ.pop("AGENT_LB_INTENT", None)
    os.environ.pop("AGENT_LB_LANE", None)
    command = build_command(argv)
    if os.environ.get("CLAUDE_LB_DRY_RUN") == "1":
        print(" ".join(command))
        print(
            f"agent-lb tags: intent={safe_tag(resolved_tags.get('x-agent-lb-intent', 'none'))} "
            f"lane={safe_tag(resolved_tags.get('x-agent-lb-lane', 'none'))} reason={tag_reason}",
            file=sys.stderr,
        )
        return
    if headless_invocation(argv):
        with bounded_process_snapshots():
            if routed and CCGPT_MODE and arg_value(argv, "--output-format") == "stream-json":
                sys.exit(run_gpt_stream(command))
            if routed and not CCGPT_MODE and headless_invocation(argv):
                if auto_resume_enabled():
                    model = requested_model(argv)
                    quota_key, _ = anthropic_quota_key(model, requested_effort(argv))
                    sys.exit(run_headless_with_resume(command, argv, session_id, model, quota_key))
                command, claude_session_id = claude_session_args(argv, command)
                sys.exit(
                    run_supervised(
                        command,
                        activity_path(session_id, os.getpid()),
                        env_float("CLAUDE_LB_STALL_TIMEOUT", STALL_TIMEOUT_DEFAULT),
                        session_id=claude_session_id,
                    )
                )
            sys.exit(subprocess.call(command))
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
