def _probe_ccgpt_at(base_url: str, *, timeout: float) -> tuple[bool, str]:
    payload = json.dumps({"model": CCGPT_MODEL, "messages": []}).encode()
    request = urllib.request.Request(
        f"{base_url}/v1/ccgpt/messages/count_tokens",
        data=payload,
        headers={"content-type": "application/json", "accept": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            body = json.loads(response.read().decode("utf-8") or "{}")
    except (OSError, urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
        return False, f"ccgpt compatibility probe failed: {error}"
    count = body.get("input_tokens") if isinstance(body, dict) else None
    if not isinstance(count, int):
        return False, "ccgpt compatibility probe returned an invalid response"
    try:
        accounts = lb_json("/api/accounts", timeout=timeout, base_url=base_url).get("accounts") or []
    except (OSError, urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
        return False, f"ccgpt account-pool probe failed: {error}"
    if not any(
        account.get("provider") == "openai"
        and str(account.get("status", "")).lower() == "active"
        and str(account.get("routingPolicy", "normal")).lower() not in {"paused", "disabled"}
        for account in accounts
    ):
        return False, "no active OpenAI accounts"
    return True, ""


class CcgptModelViolation(ValueError):
    pass


def _ccgpt_upstream_path(path: str, body: bytes | None = None) -> str:
    if not CCGPT_MODE:
        return path
    parsed = urllib.parse.urlsplit(path)
    if parsed.scheme or parsed.netloc:
        return path
    exact_paths = {
        "/v1/messages",
        "/v1/messages/",
        "/v1/messages/count_tokens",
        "/v1/messages/count_tokens/",
    }
    if parsed.path not in exact_paths:
        return path
    normalized = parsed.path[:-1] if parsed.path.endswith("/") else parsed.path
    suffix = path[len(parsed.path) :]
    trailing_slash = "/" if parsed.path.endswith("/") else ""
    if normalized == "/v1/messages/count_tokens":
        return f"/v1/ccgpt/messages/count_tokens{trailing_slash}{suffix}"
    requested = _ccgpt_request_model(body)
    if not requested or not CCGPT_MODEL_NAME.match(requested):
        label = requested or "missing model"
        raise CcgptModelViolation(f"CCGPT only permits GPT models; rejected Messages request for {label}")
    return f"/v1/ccgpt/messages{trailing_slash}{suffix}"


def _ccgpt_request_model(body: bytes | None) -> str | None:
    if not body:
        return None
    try:
        payload = json.loads(body)
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    model = payload.get("model") if isinstance(payload, dict) else None
    return model if isinstance(model, str) else None


def _without_option(argv: list[str], option: str) -> list[str]:
    cleaned: list[str] = []
    skip_next = False
    for argument in argv:
        if skip_next:
            skip_next = False
            continue
        if argument == option:
            skip_next = True
            continue
        if argument.startswith(option + "="):
            continue
        cleaned.append(argument)
    return cleaned


def claude_executable() -> str:
    own = Path(__file__).resolve()
    shadowed = False
    for entry in os.environ.get("PATH", os.defpath).split(os.pathsep):
        candidate = Path(entry or ".") / "claude"
        if not (candidate.is_file() and os.access(candidate, os.X_OK)):
            continue
        if candidate.resolve() == own:
            shadowed = True
            continue
        return str(candidate) if shadowed else "claude"
    if shadowed:
        print(
            f"cc: every claude on PATH is this launcher ({own}); refusing to start itself. "
            "Put the real Claude Code binary on PATH.",
            file=sys.stderr,
        )
        raise SystemExit(127)
    return "claude"


def build_command(argv: list[str]) -> list[str]:
    command = [claude_executable()]
    if CCGPT_MODE:
        argv = _without_option(_without_option(argv, "--model"), "--effort")
        command.extend(["--model", CCGPT_MODEL, "--effort", "high"])
    else:
        if arg_value(argv, "--model", "-m") is None and not os.environ.get("ANTHROPIC_MODEL"):
            command.extend(["--model", DEFAULT_CLAUDE_MODEL])
        effort_arg = arg_value(argv, "--effort")
        effort_env = (os.environ.get("CC_EFFORT_LEVEL") or "").strip()


        if effort_arg is None:
            if effort_env.lower() not in {"", "none", "off"}:
                command.extend(["--effort", effort_env])
            elif effort_env.lower() in {"none", "off"}:
                pass
            else:
                command.extend(["--effort", DEFAULT_CLAUDE_EFFORT])
        elif effort_arg.lower() in {"none", "off"}:
            argv = _without_option(argv, "--effort")
    permission_mode = None if CCGPT_MODE else os.environ.get("CC_PERMISSION_MODE")
    if CCGPT_MODE and not _has_permission_option(argv):
        permission_mode = "bypassPermissions"
    if permission_mode:
        command.extend(["--permission-mode", permission_mode])
    command.extend(argv)
    return command


def _has_permission_option(argv: list[str]) -> bool:
    return any(
        argument == "--permission-mode"
        or argument.startswith("--permission-mode=")
        or argument == "--dangerously-skip-permissions"
        for argument in argv
    )


def headless_invocation(argv: list[str]) -> bool:
    return "-p" in argv or "--print" in argv


def derive_session_id(argv: list[str]) -> str:

    explicit = os.environ.get("CLAUDE_LB_SESSION_ID")
    if explicit:
        return explicit
    if headless_invocation(argv):
        digest = hashlib.sha256(os.getcwd().encode()).hexdigest()[:12]
        return f"cc-headless-{digest}"
    return f"cc-{os.getpid()}-{int(time.time())}"


def auto_resume_enabled() -> bool:
    value = (os.environ.get("CLAUDE_LB_AUTO_RESUME") or "1").strip().lower()
    return value not in {"0", "never", "off", "false"}


def build_resume_command(argv: list[str], claude_session_id: str) -> list[str]:
    command = [claude_executable()]
    effort = (os.environ.get("CC_EFFORT_LEVEL") or "").strip()
    if effort and effort.lower() not in {"none", "off"}:
        command.extend(["--effort", effort])
    permission_mode = os.environ.get("CC_PERMISSION_MODE")
    if permission_mode:
        command.extend(["--permission-mode", permission_mode])
    for flag in ("--model", "--output-format"):
        value = arg_value(argv, flag)
        if value:
            command.extend([flag, value])
    command.extend(
        [
            "--resume",
            claude_session_id,
            "-p",
            "You were interrupted by a usage limit that has now reset. Continue the task exactly where you left off.",
        ]
    )
    return command


def _stop_child(child: subprocess.Popen[bytes], *, interrupt: bool = False) -> None:
    if child.poll() is None:
        if not interrupt:
            child.terminate()
        try:
            child.wait(timeout=10)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()


def _transcript_mtime(session_dir: Path, session_id: str) -> float | None:

    latest = None
    paths = [session_dir / f"{session_id}.jsonl"]
    subtree = session_dir / session_id

    remaining = 10000
    for root, dirs, files in os.walk(subtree, onerror=lambda error: None):
        paths.extend(Path(root) / name for name in files[:remaining])
        remaining -= min(len(files), remaining)
        if remaining <= 0:
            dirs.clear()
            break
        dirs[:] = dirs[:remaining]
        remaining -= len(dirs)
    for path in paths:
        try:
            modified = path.stat().st_mtime
        except OSError:
            continue
        if latest is None or modified > latest:
            latest = modified
    return latest


def _parse_elapsed(text: str) -> int:

    match = re.fullmatch(r"(?:(\d+)-)?(?:(\d+):)?(\d+):(\d+)", text)
    if match is None:
        raise ValueError("invalid ps etime")
    days, hours, minutes, seconds = match.groups()
    return int(days or 0) * 86400 + int(hours or 0) * 3600 + int(minutes) * 60 + int(seconds)


def _shell_command_process(args: str) -> bool:

    words = args.split()
    if not words:
        return False
    shell = os.path.basename(words[0]).lstrip("-")
    if shell not in {"sh", "bash", "zsh", "dash", "ksh", "fish"}:
        return False
    index = 1
    while index < len(words):
        word = words[index]
        if word == "--" or not word.startswith(("-", "+")):
            return False
        if word in {"-o", "+o", "-O", "+O", "--rcfile", "--init-file"}:
            index += 2
            continue
        if word.startswith("-") and not word.startswith("--") and word[1:].isalpha() and "c" in word[1:]:
            return True
        index += 1
    return False


def _work_process_alive(child_pid: int) -> bool:

    try:
        output = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,etime=,args="], capture_output=True, text=True, timeout=5,
        )
        if output.returncode != 0:
            return True
        processes = {}
        for line in output.stdout.splitlines():
            pid, ppid, age, *args = line.split(maxsplit=3)
            processes[int(pid)] = (int(ppid), _parse_elapsed(age), args[0] if args else "")
        if child_pid not in processes:
            return True
        parent_age = processes[child_pid][1]
        children = {}
        for pid, (ppid, age, args) in processes.items():
            children.setdefault(ppid, []).append((pid, age, args))
        descendants = [child_pid]
        while descendants:
            parent = descendants.pop()
            for pid, age, args in children.get(parent, ()):
                if _shell_command_process(args) or age < parent_age - STALL_STARTUP_GRACE:
                    return True
                descendants.append(pid)
        return False
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return True


def _activity_life(path: Path, now: float, wall_now: float, stall_timeout: float) -> float | None:
    try:
        inflight_text, progress_text = path.read_text().split()
        inflight = int(inflight_text)
        progress = float(progress_text)
        if inflight < 0 or not math.isfinite(progress):
            raise ValueError("invalid activity")
    except (OSError, ValueError):
        return None
    if inflight == 0:
        return now
    if wall_now - progress < stall_timeout:
        return now - max(0, wall_now - progress)
    return None


def run_supervised(
    command: list[str], activity: Path, stall_timeout: float, session_id: str | None = None,
) -> int:
    if not math.isfinite(stall_timeout) or stall_timeout <= 0:
        try:
            return subprocess.run(command).returncode
        finally:
            try:
                activity.unlink()
            except OSError:
                pass
    client_activity = client_activity_path(session_id) if session_id is not None else None
    if client_activity is not None:
        try:
            client_activity.touch()
        except OSError:
            pass
    start = time.monotonic()
    last_life = start
    session_dir = None
    next_lookup = start
    work_seen = False
    work_interval = min(WORK_PROCESS_POLL_SECONDS, stall_timeout / 4)
    next_work_check = start
    if session_id is not None:
        projects = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "projects"
        session_dir = projects / re.sub(r"[^A-Za-z0-9]", "-", os.getcwd())
    try:
        child = subprocess.Popen(command)
        while True:
            try:
                return child.wait(timeout=min(1.0, stall_timeout / 4))
            except subprocess.TimeoutExpired:
                pass
            now = time.monotonic()
            wall_now = time.time()
            for path in (activity, client_activity):
                if path is not None:
                    life = _activity_life(path, now, wall_now, stall_timeout)
                    if life is not None:
                        last_life = max(last_life, life)
            if session_dir is not None and session_id is not None:
                primary = session_dir / f"{session_id}.jsonl"
                if not primary.exists() and now >= next_lookup:
                    next_lookup = now + 30
                    try:
                        discovered = next(projects.glob(f"*/{session_id}.jsonl"), None)
                    except OSError:
                        discovered = None
                    if discovered is not None:
                        session_dir = discovered.parent
                modified = _transcript_mtime(session_dir, session_id)
                if modified is not None and wall_now - modified < stall_timeout:
                    last_life = max(last_life, now - max(0, wall_now - modified))
            if now - last_life >= stall_timeout or (
                now >= next_work_check and (work_seen or now - last_life >= work_interval)
            ):
                alive = _work_process_alive(child.pid)
                if alive or work_seen:
                    last_life = now
                work_seen = alive
                next_work_check = now + work_interval
            if now - last_life >= stall_timeout:
                print(
                    f"cc: no agent-lb traffic, transcript writes or tool processes for {stall_timeout:g}s "
                    f"(CLAUDE_LB_STALL_TIMEOUT); stopping claude, exit {EXIT_TEMPFAIL} (retryable)",
                    file=sys.stderr,
                )
                _stop_child(child)
                return EXIT_TEMPFAIL
    except KeyboardInterrupt:
        _stop_child(child, interrupt=True)
        return 130
    finally:
        for path in (activity, client_activity):
            if path is not None:
                try:
                    path.unlink()
                except OSError:
                    pass


def claude_session_args(argv: list[str], command: list[str]) -> tuple[list[str], str | None]:
    explicit_id = arg_value(argv, "--session-id")
    if explicit_id is not None:
        return command, explicit_id
    if "--fork-session" not in argv:
        resume_id = arg_value(argv, "--resume", "-r")
        if resume_id is not None:
            return command, resume_id
        if "--continue" in argv or "-c" in argv:
            return command, None
    session_id = str(uuid.uuid4())
    return [*command, "--session-id", session_id], session_id


def run_headless_with_resume(
    command: list[str],
    argv: list[str],
    session_id: str,
    model: str,
    quota_key: str,
) -> int:

    command, claude_session_id = claude_session_args(argv, command)
    deadline = time.time() + wait_max_seconds()
    current = command
    activity = activity_path(session_id, os.getpid())
    stall_timeout = _env_float("CLAUDE_LB_STALL_TIMEOUT", STALL_TIMEOUT_DEFAULT)
    for attempt in range(RESUME_MAX_ATTEMPTS + 1):
        returncode = run_supervised(current, activity, stall_timeout, session_id=claude_session_id)
        if returncode in (0, EXIT_TEMPFAIL) or claude_session_id is None:
            return returncode


        claim, _, retry_at = claim_session_route(session_id, model, quota_key, AGENT_LB_BASE_URL)
        if claim is not None or not should_wait_for_reset(retry_at, deadline):
            return returncode
        if attempt == RESUME_MAX_ATTEMPTS:
            return returncode
        try:
            wait_until_reset(retry_at, "Claude run interrupted by account limits.")
        except KeyboardInterrupt:
            print("cc: aborted while waiting for limits to reset", file=sys.stderr)
            return 130
        print(f"cc: resuming session {claude_session_id} (attempt {attempt + 1})", file=sys.stderr)
        current = build_resume_command(argv, claude_session_id)
    return 1


def _check_working_directory() -> None:
    try:
        os.getcwd()
        with os.scandir(".") as entries:
            next(entries, None)
    except OSError as error:
        print(
            f"cc: cannot read the current working directory: {error.strerror}. "
            "Change to an accessible directory and retry. Claude was not started; "
            "raising file-descriptor limits will not fix directory access.",
            file=sys.stderr,
        )
        raise SystemExit(1) from error


def main() -> None:
    for name in ("GH_TOKEN", "GITHUB_TOKEN"):
        os.environ.pop(name, None)
    if len(sys.argv) >= 6 and sys.argv[1] == "--lb-proxy":
        run_lb_proxy(sys.argv[2], sys.argv[3], int(sys.argv[4]), sys.argv[5])
        return
    if len(sys.argv) >= 2 and sys.argv[1] == "--desktop-proxy":


        listen_port = int(
            sys.argv[2] if len(sys.argv) >= 3 else os.environ.get("CLAUDE_LB_DESKTOP_PROXY_PORT", "2458")
        )
        upstream = (sys.argv[3] if len(sys.argv) >= 4 else AGENT_LB_BASE_URL).rstrip("/")
        run_lb_proxy(
            str(proxy_ready_path("desktop")),
            "",
            None,
            upstream,
            listen_port=listen_port,
            shared=True,
        )
        return

    _check_working_directory()
    _raise_fd_soft_limit(65536)

    if sys.argv[1:] == ["--doctor"]:
        sys.exit(run_opus_doctor())
    if sys.argv[1:] == ["--doctor-nightly"]:
        sys.exit(run_opus_doctor(nightly=True))

    schedule_opus_doctor()

    argv = sys.argv[1:]
    if not headless_invocation(argv):
        os.environ.setdefault("CLAUDE_CODE_NO_FLICKER", "1")
    tag_reason = resolve_lane_tags(argv)
    resolved_tags = tag_headers(os.environ)
    custom_tags = {
        name: value for name, value in resolved_tags.items() if "\r" not in value and "\n" not in value
    }
    if custom_tags:
        custom_headers = [
            line
            for line in os.environ.get("ANTHROPIC_CUSTOM_HEADERS", "").splitlines()
            if line.partition(":")[0].strip().lower() not in custom_tags
        ]
        custom_headers.extend(f"{name}: {value}" for name, value in custom_tags.items())
        os.environ["ANTHROPIC_CUSTOM_HEADERS"] = "\n".join(custom_headers)
    routed = False
    session_id = ""
    if lb_enabled():
        session_id = derive_session_id(argv)
        if CCGPT_MODE:
            endpoint_ready = prepare_ccgpt_endpoint()
        elif headless_invocation(argv):
            endpoint_ready = print_lb_banner(argv, session_id)
        else:
            endpoint_ready = prepare_interactive_endpoint()
        if endpoint_ready:
            try:
                proxy_url = start_lb_proxy(session_id)


                os.environ["HTTPS_PROXY"] = proxy_url
                os.environ["https_proxy"] = proxy_url


                for name in ("NO_PROXY", "no_proxy"):
                    exclusions = [entry.strip() for entry in os.environ.get(name, "").split(",") if entry.strip()]
                    for host in ("127.0.0.1", "localhost"):
                        if not any(entry.lower() == host for entry in exclusions):
                            exclusions.append(host)
                    os.environ[name] = ",".join(exclusions)


                os.environ["NODE_EXTRA_CA_CERTS"] = str(CA_CERT)


                os.environ.pop("ANTHROPIC_BASE_URL", None)
                os.environ.pop("ANTHROPIC_UNIX_SOCKET", None)
                os.environ.pop("_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL", None)
                os.environ.pop("CLAUDE_CODE_OAUTH_TOKEN", None)


                os.environ.pop("ANTHROPIC_AUTH_TOKEN", None)
                os.environ.pop("ANTHROPIC_API_KEY", None)
                routed = True
            except RuntimeError as error:
                label = "ccgpt" if CCGPT_MODE else "cc"
                if os.environ.get("CLAUDE_LB_ALLOW_FALLBACK") != "1":
                    timeout = _env_float("CLAUDE_LB_SHIM_START_TIMEOUT", SHIM_START_TIMEOUT_DEFAULT)
                    print(
                        f"{label}: proxy did not start within {timeout:g} seconds "
                        "(CLAUDE_LB_SHIM_START_TIMEOUT); exit 75 (retryable). "
                        "Set CLAUDE_LB_ALLOW_FALLBACK=1 to allow plain Claude fallback",
                        file=sys.stderr,
                    )
                    sys.exit(EXIT_TEMPFAIL)
                print(f"{label}: {error}", file=sys.stderr)
        if not routed:
            if CCGPT_MODE or os.environ.get("CLAUDE_LB_REQUIRE") == "1":
                label = "ccgpt" if CCGPT_MODE else "cc"
                print(f"{label}: refusing to bypass agent-lb or fall back to Claude", file=sys.stderr)
                sys.exit(1)
            print(
                "cc: falling back to plain claude (load balancer unavailable; using your normal Claude auth)",
                file=sys.stderr,
            )

    elif CCGPT_MODE or os.environ.get("CLAUDE_LB_REQUIRE") == "1":
        label = "ccgpt" if CCGPT_MODE else "cc"
        print(f"{label}: CLAUDE_LB_DISABLE is not allowed for this fail-closed command", file=sys.stderr)
        sys.exit(1)

    if not routed:
        bypass_anthropic_proxy()


    os.environ.pop("AGENT_LB_INTENT", None)
    os.environ.pop("AGENT_LB_LANE", None)
    command = build_command(argv)
    if os.environ.get("CLAUDE_LB_DRY_RUN") == "1":
        print(" ".join(command))
        print(
            f"agent-lb tags: intent={_safe_tag(resolved_tags.get('x-agent-lb-intent', 'none'))} "
            f"lane={_safe_tag(resolved_tags.get('x-agent-lb-lane', 'none'))} reason={tag_reason}",
            file=sys.stderr,
        )
        return
    if routed and not CCGPT_MODE and headless_invocation(argv):
        if auto_resume_enabled():
            model = requested_model(argv)
            quota_key, _ = anthropic_quota_key(model, requested_effort(argv))
            sys.exit(run_headless_with_resume(command, argv, session_id, model, quota_key))
        command, claude_session_id = claude_session_args(argv, command)
        sys.exit(run_supervised(
            command, activity_path(session_id, os.getpid()),
            _env_float("CLAUDE_LB_STALL_TIMEOUT", STALL_TIMEOUT_DEFAULT),
            session_id=claude_session_id,
        ))
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
