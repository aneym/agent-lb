#!/bin/sh
set -eu
repo=$(git rev-parse --show-toplevel)
checker="$repo/bin/no-new-comments"
if [ ! -f "$checker" ]; then checker="$repo/engine/bin/no-new-comments"; fi
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$remote_sha" in
    0000000000000000000000000000000000000000) base=$(git merge-base "$local_sha" origin/main) ;;
    *) base=$remote_sha ;;
  esac
  python3 "$checker" --repo "$repo" "$base" "$local_sha"
done
