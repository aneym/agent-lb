+// In a linked worktree, .git is a file pointing at <main>/.git/worktrees/<name>, and fetch,
+// commit and ref updates write there and in the common dir, both outside the workspace.
+function worktreeWritableRoots(cwd, sandbox) {
+  if (sandbox !== "workspace-write" || !cwd) {
+    return [];
+  }
+  const result = runCommand("git", ["rev-parse", "--path-format=absolute", "--git-dir", "--git-common-dir"], {
+    cwd,
+    shell: false
+  });
+  if (result.error || result.status !== 0) {
+    return [];
+  }
+  const [gitDir, commonDir] = result.stdout.split(/\r?\n/).filter(Boolean).map((dir) => path.resolve(dir));
+  if (!gitDir || !commonDir || gitDir === commonDir) {
+    return [];
+  }
+  return [gitDir, commonDir];
+}
+
+// A config override replaces the writable_roots array instead of extending it, so the roots the
+// user already configured are read back from the app-server and kept ahead of the git dirs.
+async function sandboxConfig(client, cwd, sandbox) {
+  const gitRoots = worktreeWritableRoots(cwd, sandbox);
+  if (gitRoots.length === 0) {
+    return {};
+  }
+  let configured;
+  try {
+    const response = await client.request("config/read", { includeLayers: false, cwd });
+    configured = response?.config?.sandbox_workspace_write?.writable_roots ?? [];
+  } catch {
+    return {};
+  }
+  const writableRoots = [...new Set([...configured, ...gitRoots])];
+  return { config: { sandbox_workspace_write: { writable_roots: writableRoots } } };
+}
